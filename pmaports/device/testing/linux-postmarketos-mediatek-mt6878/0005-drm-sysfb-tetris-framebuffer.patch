From 0000000000000000000000000000000000000012 Mon Sep 17 00:00:00 2001
From: postmarketOS Porting <porting@localhost>
Date: Sat, 25 Jul 2026 00:00:00 +0300
Subject: [PATCH] drm/sysfb: add full-frame update quirk

The inherited framebuffer on the Nothing Tetris becomes
corrupted when userspace starts issuing partial damage updates. Allow a
simple-framebuffer node to request full-frame copies and make sure all
framebuffer writes are visible before returning from the atomic update.
---
 .../boot/dts/mediatek/mt6878-nothing-tetris.dts    |  1 +
 drivers/gpu/drm/sysfb/drm_sysfb_helper.h           |  1 +
 drivers/gpu/drm/sysfb/drm_sysfb_modeset.c          | 21 ++++++++++++++++++---
 drivers/gpu/drm/sysfb/simpledrm.c                  |  2 ++
 4 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts
--- a/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts
@@ -34,6 +34,7 @@
 			stride = <(1088 * 4)>;
 			format = "a8r8g8b8";
 			panel = <&fb_panel>;
+			linux,force-full-frame-updates;
 
 			fb_panel: fb-panel {
 				width-mm = <75>;
diff --git a/drivers/gpu/drm/sysfb/drm_sysfb_helper.h b/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
--- a/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
+++ b/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
@@ -80,6 +80,7 @@ struct drm_sysfb_device {
 	const struct drm_format_info *fb_format;
 	unsigned int fb_pitch;
 	unsigned int fb_gamma_lut_size;
+	bool force_full_frame_updates;
 
 	/* hardware-framebuffer kernel address */
 	struct iosys_map fb_addr;
diff --git a/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c b/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c
--- a/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c
+++ b/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c
@@ -1,5 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
+#include <asm/barrier.h>
+
 #include <linux/export.h>
 #include <linux/slab.h>
 
@@ -251,17 +253,30 @@ void drm_sysfb_plane_helper_atomic_update(struct drm_plane *plane, struct drm_at
 		goto out_drm_gem_fb_end_cpu_access;
 
-	drm_atomic_helper_damage_iter_init(&iter, old_plane_state, plane_state);
-	drm_atomic_for_each_plane_damage(&iter, &damage) {
+	if (sysfb->force_full_frame_updates) {
 		struct iosys_map dst = sysfb->fb_addr;
 		struct drm_rect dst_clip = plane_state->dst;
+
+		damage = plane_state->dst;
+		iosys_map_incr(&dst, drm_fb_clip_offset(dst_pitch, dst_format, &dst_clip));
+		drm_fb_blit(&dst, &dst_pitch, dst_format->format, shadow_plane_state->data, fb,
+			    &damage, &shadow_plane_state->fmtcnv_state);
+	} else {
+		drm_atomic_helper_damage_iter_init(&iter, old_plane_state, plane_state);
+		drm_atomic_for_each_plane_damage(&iter, &damage) {
+			struct iosys_map dst = sysfb->fb_addr;
+			struct drm_rect dst_clip = plane_state->dst;
 
-		if (!drm_rect_intersect(&dst_clip, &damage))
-			continue;
+			if (!drm_rect_intersect(&dst_clip, &damage))
+				continue;
 
-		iosys_map_incr(&dst, drm_fb_clip_offset(dst_pitch, dst_format, &dst_clip));
-		drm_fb_blit(&dst, &dst_pitch, dst_format->format, shadow_plane_state->data, fb,
-			    &damage, &shadow_plane_state->fmtcnv_state);
+			iosys_map_incr(&dst,
+				      drm_fb_clip_offset(dst_pitch, dst_format, &dst_clip));
+			drm_fb_blit(&dst, &dst_pitch, dst_format->format,
+				    shadow_plane_state->data, fb, &damage,
+				    &shadow_plane_state->fmtcnv_state);
+		}
 	}
+	wmb();
 
 	drm_dev_exit(idx);
 out_drm_gem_fb_end_cpu_access:
diff --git a/drivers/gpu/drm/sysfb/simpledrm.c b/drivers/gpu/drm/sysfb/simpledrm.c
--- a/drivers/gpu/drm/sysfb/simpledrm.c
+++ b/drivers/gpu/drm/sysfb/simpledrm.c
@@ -678,5 +678,7 @@ static struct simpledrm_device *simpledrm_device_create(struct drm_driver *drv,
 	sysfb->fb_format = format;
 	sysfb->fb_pitch = stride;
+	sysfb->force_full_frame_updates = of_node &&
+		of_property_read_bool(of_node, "linux,force-full-frame-updates");
 
 	drm_dbg(dev, "display mode={" DRM_MODE_FMT "}\n", DRM_MODE_ARG(&sysfb->fb_mode));
 	drm_dbg(dev, "framebuffer format=%p4cc, size=%dx%d, stride=%d byte\n",
-- 
