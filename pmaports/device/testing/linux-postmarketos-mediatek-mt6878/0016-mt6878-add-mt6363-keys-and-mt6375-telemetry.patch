@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __LINUX_MFD_MT6363_REGISTERS_H
+#define __LINUX_MFD_MT6363_REGISTERS_H
+
+#define MT6363_TOPSTATUS			0x001e
+#define MT6363_TOP_INT_STATUS1			0x004e
+#define MT6363_RCS_INT_DONE			0x041b
+#define MT6363_PSC_TOP_INT_CON0			0x090f
+#define MT6363_PSC_TOP_INT_STATUS0		0x091b
+
+#endif
--- /dev/null
+++ b/drivers/mfd/mt6363-spmi.c
@@ -0,0 +1,261 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal MT6363 SPMI PMIC core for the Nothing Tetris bring-up.
+ * Only the PMIC key interrupt group is exposed initially.
+ */
+
+#include <linux/bitops.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/mfd/core.h>
+#include <linux/mfd/mt6363/registers.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of_irq.h>
+#include <linux/regmap.h>
+#include <linux/spmi.h>
+
+#define MT6363_SWCID				0x000b
+#define MT6363_IRQ_COUNT			108
+#define MT6363_IRQ_PWRKEY			48
+#define MT6363_IRQ_HOMEKEY			49
+#define MT6363_IRQ_PWRKEY_R			51
+#define MT6363_IRQ_HOMEKEY_R			52
+#define MT6363_PSC_IRQ_COUNT			12
+#define MT6363_IRQ_REG_WIDTH			8
+#define MT6363_IRQ_ENABLE_STRIDE		3
+#define MT6363_PSC_TOP_BIT			2
+
+struct mt6363 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct irq_domain *domain;
+	bool enabled[MT6363_PSC_IRQ_COUNT];
+	bool cached[MT6363_PSC_IRQ_COUNT];
+	struct mutex irq_lock;
+};
+
+static const struct resource mt6363_key_resources[] = {
+	DEFINE_RES_IRQ_NAMED(MT6363_IRQ_PWRKEY, "powerkey"),
+	DEFINE_RES_IRQ_NAMED(MT6363_IRQ_HOMEKEY, "homekey"),
+	DEFINE_RES_IRQ_NAMED(MT6363_IRQ_PWRKEY_R, "powerkey_r"),
+	DEFINE_RES_IRQ_NAMED(MT6363_IRQ_HOMEKEY_R, "homekey_r"),
+};
+
+static const struct mfd_cell mt6363_cells[] = {
+	{
+		.name = "mtk-pmic-keys",
+		.of_compatible = "mediatek,mt6363-keys",
+		.resources = mt6363_key_resources,
+		.num_resources = ARRAY_SIZE(mt6363_key_resources),
+	},
+};
+
+static void mt6363_irq_enable(struct irq_data *data)
+{
+	struct mt6363 *pmic = irq_data_get_irq_chip_data(data);
+	unsigned int offset = irqd_to_hwirq(data) - MT6363_IRQ_PWRKEY;
+
+	if (offset < ARRAY_SIZE(pmic->enabled))
+		pmic->enabled[offset] = true;
+}
+
+static void mt6363_irq_disable(struct irq_data *data)
+{
+	struct mt6363 *pmic = irq_data_get_irq_chip_data(data);
+	unsigned int offset = irqd_to_hwirq(data) - MT6363_IRQ_PWRKEY;
+
+	if (offset < ARRAY_SIZE(pmic->enabled))
+		pmic->enabled[offset] = false;
+}
+
+static void mt6363_irq_bus_lock(struct irq_data *data)
+{
+	struct mt6363 *pmic = irq_data_get_irq_chip_data(data);
+
+	mutex_lock(&pmic->irq_lock);
+}
+
+static void mt6363_irq_bus_sync_unlock(struct irq_data *data)
+{
+	struct mt6363 *pmic = irq_data_get_irq_chip_data(data);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(pmic->enabled); i++) {
+		unsigned int reg;
+		unsigned int bit;
+
+		if (pmic->enabled[i] == pmic->cached[i])
+			continue;
+
+		reg = MT6363_PSC_TOP_INT_CON0 +
+		      (i / MT6363_IRQ_REG_WIDTH) * MT6363_IRQ_ENABLE_STRIDE;
+		bit = BIT(i % MT6363_IRQ_REG_WIDTH);
+		regmap_update_bits(pmic->regmap, reg, bit,
+				   pmic->enabled[i] ? bit : 0);
+		pmic->cached[i] = pmic->enabled[i];
+	}
+
+	mutex_unlock(&pmic->irq_lock);
+}
+
+static struct irq_chip mt6363_irq_chip = {
+	.name = "mt6363-pmic",
+	.flags = IRQCHIP_SKIP_SET_WAKE,
+	.irq_enable = mt6363_irq_enable,
+	.irq_disable = mt6363_irq_disable,
+	.irq_bus_lock = mt6363_irq_bus_lock,
+	.irq_bus_sync_unlock = mt6363_irq_bus_sync_unlock,
+};
+
+static int mt6363_irq_domain_map(struct irq_domain *domain,
+				 unsigned int virq, irq_hw_number_t hwirq)
+{
+	struct mt6363 *pmic = domain->host_data;
+
+	irq_set_chip_data(virq, pmic);
+	irq_set_chip_and_handler(virq, &mt6363_irq_chip, handle_level_irq);
+	irq_set_nested_thread(virq, true);
+	irq_set_noprobe(virq);
+
+	return 0;
+}
+
+static const struct irq_domain_ops mt6363_irq_domain_ops = {
+	.map = mt6363_irq_domain_map,
+	.xlate = irq_domain_xlate_twocell,
+};
+
+static irqreturn_t mt6363_irq_thread(int irq, void *data)
+{
+	struct mt6363 *pmic = data;
+	unsigned int pending;
+	unsigned int status;
+	unsigned int top;
+	unsigned int i;
+	int ret;
+
+	ret = regmap_read(pmic->regmap, MT6363_TOP_INT_STATUS1, &top);
+	if (ret)
+		return IRQ_NONE;
+
+	if (top & BIT(MT6363_PSC_TOP_BIT)) {
+		ret = regmap_read(pmic->regmap, MT6363_PSC_TOP_INT_STATUS0,
+				  &status);
+		if (ret)
+			return IRQ_NONE;
+
+		pending = status;
+		while (pending) {
+			unsigned int virq;
+
+			i = __ffs(pending);
+			virq = irq_find_mapping(pmic->domain,
+						MT6363_IRQ_PWRKEY + i);
+			if (virq)
+				handle_nested_irq(virq);
+			pending &= ~BIT(i);
+		}
+
+		regmap_write(pmic->regmap, MT6363_PSC_TOP_INT_STATUS0,
+			     status);
+	}
+
+	regmap_write(pmic->regmap, MT6363_RCS_INT_DONE, 1);
+	return IRQ_HANDLED;
+}
+
+static void mt6363_remove_irq_domain(void *data)
+{
+	irq_domain_remove(data);
+}
+
+static int mt6363_spmi_probe(struct spmi_device *sdev)
+{
+	static const struct regmap_config regmap_config = {
+		.reg_bits = 16,
+		.val_bits = 8,
+		.max_register = 0xffff,
+		.fast_io = true,
+	};
+	struct mt6363 *pmic;
+	unsigned int chip_id;
+	int irq;
+	int ret;
+
+	pmic = devm_kzalloc(&sdev->dev, sizeof(*pmic), GFP_KERNEL);
+	if (!pmic)
+		return -ENOMEM;
+
+	pmic->dev = &sdev->dev;
+	mutex_init(&pmic->irq_lock);
+
+	pmic->regmap = devm_regmap_init_spmi_ext(sdev, &regmap_config);
+	if (IS_ERR(pmic->regmap))
+		return dev_err_probe(&sdev->dev, PTR_ERR(pmic->regmap),
+				     "failed to initialize regmap\n");
+
+	ret = regmap_read(pmic->regmap, MT6363_SWCID, &chip_id);
+	if (ret || !chip_id)
+		return dev_err_probe(&sdev->dev, ret ?: -ENODEV,
+				     "failed to read chip ID\n");
+
+	pmic->domain = irq_domain_create_linear(dev_fwnode(&sdev->dev),
+						MT6363_IRQ_COUNT,
+						&mt6363_irq_domain_ops, pmic);
+	if (!pmic->domain)
+		return -ENOMEM;
+
+	ret = devm_add_action_or_reset(&sdev->dev, mt6363_remove_irq_domain,
+					pmic->domain);
+	if (ret)
+		return ret;
+
+	irq = of_irq_get(sdev->dev.of_node, 0);
+	if (irq < 0)
+		return irq;
+
+	regmap_write(pmic->regmap, MT6363_PSC_TOP_INT_CON0, 0);
+	regmap_write(pmic->regmap,
+		     MT6363_PSC_TOP_INT_CON0 + MT6363_IRQ_ENABLE_STRIDE, 0);
+	regmap_write(pmic->regmap, MT6363_PSC_TOP_INT_STATUS0, 0xff);
+	regmap_write(pmic->regmap, MT6363_PSC_TOP_INT_STATUS0 + 1, 0xff);
+	regmap_write(pmic->regmap, MT6363_RCS_INT_DONE, 1);
+
+	ret = devm_request_threaded_irq(&sdev->dev, irq, NULL,
+					mt6363_irq_thread, IRQF_ONESHOT,
+					"mt6363-pmic", pmic);
+	if (ret)
+		return ret;
+
+	dev_set_drvdata(&sdev->dev, pmic);
+	ret = devm_mfd_add_devices(&sdev->dev, PLATFORM_DEVID_AUTO,
+				   mt6363_cells, ARRAY_SIZE(mt6363_cells),
+				   NULL, 0, pmic->domain);
+	if (ret)
+		return ret;
+
+	device_init_wakeup(&sdev->dev, true);
+	dev_info(&sdev->dev, "MT6363 chip ID 0x%x, PMIC keys enabled\n",
+		 chip_id);
+	return 0;
+}
+
+static const struct of_device_id mt6363_spmi_of_match[] = {
+	{ .compatible = "mediatek,mt6363" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6363_spmi_of_match);
+
+static struct spmi_driver mt6363_spmi_driver = {
+	.driver = {
+		.name = "mt6363-spmi",
+		.of_match_table = mt6363_spmi_of_match,
+	},
+	.probe = mt6363_spmi_probe,
+};
+module_spmi_driver(mt6363_spmi_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6363 SPMI PMIC key core");
+MODULE_LICENSE("GPL");
