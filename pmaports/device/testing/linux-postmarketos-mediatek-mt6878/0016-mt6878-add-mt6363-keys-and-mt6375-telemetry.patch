+	arb->rcs_domain = irq_domain_create_linear(dev_fwnode(&pdev->dev),
+						   SPMI_MAX_SLAVE_ID,
+						   &mtk_spmi_rcs_irq_domain_ops,
+						   arb);
+	if (!arb->rcs_domain)
+		return -ENOMEM;
+
+	ret = devm_add_action_or_reset(&pdev->dev,
