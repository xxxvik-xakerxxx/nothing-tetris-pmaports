+	arb->rcs_irq_chip.name = "mtk-spmi-rcs";
+	arb->rcs_irq_chip.flags = IRQCHIP_SKIP_SET_WAKE;
+	arb->rcs_irq_chip.irq_enable = mtk_spmi_rcs_irq_enable;
+	arb->rcs_irq_chip.irq_disable = mtk_spmi_rcs_irq_disable;
+	arb->rcs_irq_chip.irq_bus_lock = mtk_spmi_rcs_irq_lock;
+	arb->rcs_irq_chip.irq_bus_sync_unlock =
