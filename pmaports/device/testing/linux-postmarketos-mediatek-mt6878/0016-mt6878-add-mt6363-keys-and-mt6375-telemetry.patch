+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _DT_BINDINGS_IIO_ADC_MEDIATEK_MT6375_H
+#define _DT_BINDINGS_IIO_ADC_MEDIATEK_MT6375_H
+
+#define MT6375_ADC_VBATMON	0
+#define MT6375_ADC_CHGVIN	1
+#define MT6375_ADC_USBDP	2
+#define MT6375_ADC_VSYS		3
+#define MT6375_ADC_VBAT		4
+#define MT6375_ADC_IBUS		5
+#define MT6375_ADC_IBAT		6
+#define MT6375_ADC_USBDM	7
+#define MT6375_ADC_TEMPJC	8
+#define MT6375_ADC_VREFTS	9
+#define MT6375_ADC_TS		10
+#define MT6375_ADC_PDVBUS	11
+#define MT6375_ADC_CC1		12
+#define MT6375_ADC_CC2		13
+#define MT6375_ADC_SBU1		14
+#define MT6375_ADC_SBU2		15
+#define MT6375_ADC_FGCIC1	16
+#define MT6375_ADC_MAX_CHANNEL	17
+
+#endif
--- /dev/null
+++ b/drivers/iio/adc/mt6375-adc.c
@@ -0,0 +1,220 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6375 direct-mode ADC telemetry.
+ */
+
+#include <dt-bindings/iio/adc/mediatek,mt6375-adc.h>
+#include <linux/iio/iio.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
+#include <linux/regmap.h>
+
+#define MT6375_REG_ADC_MONRPTH	0x019c
+#define MT6375_REG_ADC_CFG1	0x01a4
+#define MT6375_REG_ADC_CFG3	0x01a6
+#define MT6375_REG_ADC_CHEN	0x01a7
+#define MT6375_REG_ADC_CH1RPTH	0x01aa
+
+#define MT6375_ADCEN_MASK	BIT(7)
+#define MT6375_ZCVEN_MASK	BIT(6)
+#define MT6375_ONESHOT_MASK	GENMASK(7, 4)
+#define MT6375_ONESHOT_SHIFT	4
+#define MT6375_CHANNEL_OFFSET	1
+
+struct mt6375_adc {
+	struct device *dev;
+	struct regmap *regmap;
+	struct mutex lock;
+};
+
+static int mt6375_adc_read_channel(struct mt6375_adc *adc,
+				   unsigned int channel, int *value)
+{
+	unsigned int addr = MT6375_REG_ADC_MONRPTH;
+	unsigned int regval;
+	__be16 raw;
+	int ret;
+
+	mutex_lock(&adc->lock);
+	pm_stay_awake(adc->dev);
+
+	if (channel != MT6375_ADC_FGCIC1) {
+		ret = regmap_write(adc->regmap, MT6375_REG_ADC_CFG3,
+				   channel << MT6375_ONESHOT_SHIFT);
+		if (ret)
+			goto out;
+
+		usleep_range(4400, 6600);
+	}
+
+	ret = regmap_read_poll_timeout(adc->regmap, MT6375_REG_ADC_CFG3,
+				       regval,
+				       !(regval & MT6375_ONESHOT_MASK),
+				       100, 2000);
+	if (ret && ret != -ETIMEDOUT)
+		goto out;
+
+	if (channel != MT6375_ADC_VBATMON)
+		addr = MT6375_REG_ADC_CH1RPTH +
+		       (channel - MT6375_CHANNEL_OFFSET) * 2;
+
+	ret = regmap_raw_read(adc->regmap, addr, &raw, sizeof(raw));
+	if (!ret) {
+		*value = be16_to_cpu(raw);
+		ret = IIO_VAL_INT;
+	}
+
+out:
+	pm_relax(adc->dev);
+	mutex_unlock(&adc->lock);
+	return ret;
+}
+
+static int mt6375_adc_scale(unsigned int channel, int *value)
+{
+	switch (channel) {
+	case MT6375_ADC_VBATMON:
+	case MT6375_ADC_VSYS:
+	case MT6375_ADC_VBAT:
+	case MT6375_ADC_VREFTS:
+	case MT6375_ADC_TS:
+		*value = 1250;
+		break;
+	case MT6375_ADC_CHGVIN:
+		*value = 6250;
+		break;
+	case MT6375_ADC_PDVBUS:
+		*value = 25000;
+		break;
+	case MT6375_ADC_TEMPJC:
+	case MT6375_ADC_FGCIC1:
+		*value = 1;
+		break;
+	default:
+		*value = 2500;
+		break;
+	}
+
+	return IIO_VAL_INT;
+}
+
+static int mt6375_adc_read_raw(struct iio_dev *indio_dev,
+			       const struct iio_chan_spec *channel,
+			       int *value, int *value2, long mask)
+{
+	struct mt6375_adc *adc = iio_priv(indio_dev);
+
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+		return mt6375_adc_read_channel(adc, channel->channel, value);
+	case IIO_CHAN_INFO_SCALE:
+		return mt6375_adc_scale(channel->channel, value);
+	case IIO_CHAN_INFO_OFFSET:
+		*value = channel->channel == MT6375_ADC_TEMPJC ? -56 : 0;
+		return IIO_VAL_INT;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct iio_info mt6375_adc_info = {
+	.read_raw = mt6375_adc_read_raw,
+};
+
+static int mt6375_adc_reset(struct mt6375_adc *adc)
+{
+	__be16 channels = 0;
+	int ret;
+
+	ret = regmap_update_bits(adc->regmap, MT6375_REG_ADC_CFG1,
+				 MT6375_ADCEN_MASK | MT6375_ZCVEN_MASK,
+				 MT6375_ADCEN_MASK);
+	if (ret)
+		return ret;
+
+	return regmap_raw_write(adc->regmap, MT6375_REG_ADC_CHEN,
+				&channels, sizeof(channels));
+}
+
+#define MT6375_CHANNEL(_name, _type) {				\
+	.type = _type,							\
+	.channel = MT6375_ADC_##_name,					\
+	.datasheet_name = #_name,					\
+	.indexed = 1,							\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |		\
+			      BIT(IIO_CHAN_INFO_SCALE) |		\
+			      BIT(IIO_CHAN_INFO_OFFSET),			\
+}
+
+static const struct iio_chan_spec mt6375_adc_channels[] = {
+	MT6375_CHANNEL(VBATMON, IIO_VOLTAGE),
+	MT6375_CHANNEL(CHGVIN, IIO_VOLTAGE),
+	MT6375_CHANNEL(USBDP, IIO_VOLTAGE),
+	MT6375_CHANNEL(VSYS, IIO_VOLTAGE),
+	MT6375_CHANNEL(VBAT, IIO_VOLTAGE),
+	MT6375_CHANNEL(IBUS, IIO_CURRENT),
+	MT6375_CHANNEL(IBAT, IIO_CURRENT),
+	MT6375_CHANNEL(USBDM, IIO_VOLTAGE),
+	MT6375_CHANNEL(TEMPJC, IIO_TEMP),
+	MT6375_CHANNEL(VREFTS, IIO_VOLTAGE),
+	MT6375_CHANNEL(TS, IIO_VOLTAGE),
+	MT6375_CHANNEL(PDVBUS, IIO_VOLTAGE),
+	MT6375_CHANNEL(CC1, IIO_VOLTAGE),
+	MT6375_CHANNEL(CC2, IIO_VOLTAGE),
+	MT6375_CHANNEL(SBU1, IIO_VOLTAGE),
+	MT6375_CHANNEL(SBU2, IIO_VOLTAGE),
+	MT6375_CHANNEL(FGCIC1, IIO_CURRENT),
+};
+
+static int mt6375_adc_probe(struct platform_device *pdev)
+{
+	struct mt6375_adc *adc;
+	struct iio_dev *indio_dev;
+	int ret;
+
+	indio_dev = devm_iio_device_alloc(&pdev->dev, sizeof(*adc));
+	if (!indio_dev)
+		return -ENOMEM;
+
+	adc = iio_priv(indio_dev);
+	adc->dev = &pdev->dev;
+	adc->regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!adc->regmap)
+		return -ENODEV;
+
+	mutex_init(&adc->lock);
+	device_init_wakeup(&pdev->dev, true);
+
+	ret = mt6375_adc_reset(adc);
+	if (ret)
+		return ret;
+
+	indio_dev->name = "mt6375-adc";
+	indio_dev->info = &mt6375_adc_info;
+	indio_dev->modes = INDIO_DIRECT_MODE;
+	indio_dev->channels = mt6375_adc_channels;
+	indio_dev->num_channels = ARRAY_SIZE(mt6375_adc_channels);
+
+	return devm_iio_device_register(&pdev->dev, indio_dev);
+}
+
+static const struct of_device_id mt6375_adc_of_match[] = {
+	{ .compatible = "mediatek,mt6375-adc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6375_adc_of_match);
+
+static struct platform_driver mt6375_adc_driver = {
+	.probe = mt6375_adc_probe,
+	.driver = {
+		.name = "mt6375-adc",
+		.of_match_table = mt6375_adc_of_match,
+	},
+};
+module_platform_driver(mt6375_adc_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6375 direct ADC telemetry");
+MODULE_LICENSE("GPL");
