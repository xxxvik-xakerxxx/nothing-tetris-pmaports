@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal MT6375 multi-bank I2C regmap.
+ *
+ * Charger, Type-C and interrupt control are intentionally not exposed by
+ * this bring-up driver. Only explicitly described telemetry children probe.
+ */
+
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of_platform.h>
+#include <linux/regmap.h>
+
+#define MT6375_SLAVEID_TCPC	0x4e
+#define MT6375_SLAVEID_PMU	0x34
+#define MT6375_SLAVEID_BM	0x1a
+#define MT6375_SLAVEID_HK1	0x4a
+#define MT6375_SLAVEID_HK2	0x64
+#define MT6375_SLAVEID_TM	0x3f
+
+#define MT6375_VID		0x70
+#define MT6375_REG_DEV_INFO	0x0100
+#define MT6375_REG_HK2_END	0x04ff
+#define MT6375_BANK_TCPC_RT2	0xf2
+#define MT6375_REG_RT2_START	0xf200
+#define MT6375_REG_RT2_END	0xf2ff
+
+enum mt6375_slave {
+	MT6375_SLAVE_TCPC,
+	MT6375_SLAVE_PMU,
+	MT6375_SLAVE_BM,
+	MT6375_SLAVE_HK1,
+	MT6375_SLAVE_HK2,
+	MT6375_SLAVE_TM,
+	MT6375_SLAVE_MAX,
+};
+
+struct mt6375 {
+	struct i2c_client *clients[MT6375_SLAVE_MAX];
+};
+
+static const u8 mt6375_slave_addr[MT6375_SLAVE_MAX] = {
+	MT6375_SLAVEID_TCPC,
+	MT6375_SLAVEID_PMU,
+	MT6375_SLAVEID_BM,
+	MT6375_SLAVEID_HK1,
+	MT6375_SLAVEID_HK2,
+	MT6375_SLAVEID_TM,
+};
+
+static struct i2c_client *mt6375_bank_client(struct mt6375 *mt6375, u8 bank)
+{
+	if (bank == MT6375_BANK_TCPC_RT2)
+		return mt6375->clients[MT6375_SLAVE_TCPC];
+	if (bank >= MT6375_SLAVE_MAX)
+		return NULL;
+	return mt6375->clients[bank];
+}
+
+static int mt6375_regmap_write(void *context, const void *data, size_t count)
+{
+	struct mt6375 *mt6375 = context;
+	const u8 *buf = data;
+	struct i2c_client *client;
+	int ret;
+
+	if (count < 3)
+		return -EINVAL;
+
+	client = mt6375_bank_client(mt6375, buf[0]);
+	if (!client)
+		return -EINVAL;
+
+	if (buf[0] == MT6375_BANK_TCPC_RT2) {
+		ret = i2c_master_send(client, buf, count);
+		return ret < 0 ? ret : ret == count ? 0 : -EIO;
+	}
+
+	return i2c_smbus_write_i2c_block_data(client, buf[1], count - 2,
+					       buf + 2);
+}
+
+static int mt6375_regmap_read(void *context, const void *reg_buf,
+			      size_t reg_size, void *val_buf, size_t val_size)
+{
+	struct mt6375 *mt6375 = context;
+	const u8 *reg = reg_buf;
+	struct i2c_client *client;
+	int ret;
+
+	if (reg_size != 2)
+		return -EINVAL;
+
+	client = mt6375_bank_client(mt6375, reg[0]);
+	if (!client)
+		return -EINVAL;
+
+	if (reg[0] == MT6375_BANK_TCPC_RT2) {
+		u8 addr[2] = { reg[0], reg[1] };
+		struct i2c_msg msgs[] = {
+			{
+				.addr = client->addr,
+				.len = sizeof(addr),
+				.buf = addr,
+			}, {
+				.addr = client->addr,
+				.flags = I2C_M_RD,
+				.len = val_size,
+				.buf = val_buf,
+			},
+		};
+
+		ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+		return ret < 0 ? ret : ret == ARRAY_SIZE(msgs) ? 0 : -EIO;
+	}
+
+	ret = i2c_smbus_read_i2c_block_data(client, reg[1], val_size,
+					     val_buf);
+	return ret < 0 ? ret : ret == val_size ? 0 : -EIO;
+}
+
+static const struct regmap_bus mt6375_regmap_bus = {
+	.write = mt6375_regmap_write,
+	.read = mt6375_regmap_read,
+};
+
+static bool mt6375_accessible_reg(struct device *dev, unsigned int reg)
+{
+	return reg <= MT6375_REG_HK2_END ||
+	       (reg >= MT6375_REG_RT2_START && reg <= MT6375_REG_RT2_END);
+}
+
+static const struct regmap_config mt6375_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.reg_format_endian = REGMAP_ENDIAN_BIG,
+	.max_register = MT6375_REG_RT2_END,
+	.readable_reg = mt6375_accessible_reg,
+	.writeable_reg = mt6375_accessible_reg,
+};
+
+static int mt6375_probe(struct i2c_client *client)
+{
+	struct mt6375 *mt6375;
+	struct regmap *regmap;
+	unsigned int id;
+	unsigned int i;
+	int ret;
+
+	mt6375 = devm_kzalloc(&client->dev, sizeof(*mt6375), GFP_KERNEL);
+	if (!mt6375)
+		return -ENOMEM;
+
+	for (i = 0; i < MT6375_SLAVE_MAX; i++) {
+		if (i == MT6375_SLAVE_PMU) {
+			mt6375->clients[i] = client;
+			continue;
+		}
+
+		mt6375->clients[i] =
+			devm_i2c_new_dummy_device(&client->dev, client->adapter,
+						  mt6375_slave_addr[i]);
+		if (IS_ERR(mt6375->clients[i]))
+			return dev_err_probe(&client->dev,
+					     PTR_ERR(mt6375->clients[i]),
+					     "failed to claim bank 0x%02x\n",
+					     mt6375_slave_addr[i]);
+	}
+
+	regmap = devm_regmap_init(&client->dev, &mt6375_regmap_bus, mt6375,
+				  &mt6375_regmap_config);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	ret = regmap_read(regmap, MT6375_REG_DEV_INFO, &id);
+	if (ret)
+		return dev_err_probe(&client->dev, ret,
+				     "failed to read device ID\n");
+	if ((id & 0xf0) != MT6375_VID)
+		return dev_err_probe(&client->dev, -ENODEV,
+				     "unexpected device ID 0x%02x\n", id);
+
+	i2c_set_clientdata(client, mt6375);
+	dev_info(&client->dev, "MT6375 revision %u, telemetry-only mode\n",
+		 id & 0x0f);
+
+	return devm_of_platform_populate(&client->dev);
+}
+
+static const struct of_device_id mt6375_of_match[] = {
+	{ .compatible = "mediatek,mt6375" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6375_of_match);
+
+static struct i2c_driver mt6375_driver = {
+	.probe = mt6375_probe,
+	.driver = {
+		.name = "mt6375",
+		.of_match_table = mt6375_of_match,
+	},
+};
+module_i2c_driver(mt6375_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6375 telemetry-only PMIC core");
+MODULE_LICENSE("GPL");
