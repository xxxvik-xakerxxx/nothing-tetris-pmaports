+};
+
+static irqreturn_t mtk_spmi_rcs_irq_thread(int irq, void *data)
+{
+	struct pmif *arb = data;
+	bool handled = false;
+	unsigned int sid;
+
+	for (sid = 0; sid < SPMI_MAX_SLAVE_ID; sid++) {
+		enum spmi_regs reg = SPMI_SLV_3_0_EINT + sid / 4;
+		unsigned int shift = (sid % 4) * 8;
+		unsigned int status;
+		unsigned int virq;
+
+		status = (mtk_spmi_readl(arb, reg) >> shift) & 0xff;
+		if (!status)
+			continue;
+
+		mtk_spmi_writel(arb, 0xffU << shift, reg);
+		handled = true;
+
+		if (!arb->rcs_irq_enabled[sid])
+			continue;
+
+		virq = irq_find_mapping(arb->rcs_domain, sid);
+		if (virq)
+			handle_nested_irq(virq);
+	}
+
+	return handled ? IRQ_HANDLED : IRQ_NONE;
+}
