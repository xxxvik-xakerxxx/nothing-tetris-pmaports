+// SPDX-License-Identifier: GPL-2.0
+//
+// Copyright (c) 2026
+
+#include <linux/mfd/core.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/spmi.h>
+
+static const struct mfd_cell mt6369_devs[] = {
+	{ .name = "mt6369-regulator" },
+	{
+		.name = "mt6369-consys",
+		.of_compatible = "mediatek,mt6369-consys",
+	},
+	{
+		.name = "mt6369-sound",
+		.of_compatible = "mediatek,mt6369-sound",
+	},
+};
+
+static const struct regmap_config mt6369_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.max_register = 0xffff,
+};
+
+static int mt6369_spmi_probe(struct spmi_device *sdev)
+{
+	struct regmap *regmap;
+
+	regmap = devm_regmap_init_spmi_ext(sdev, &mt6369_regmap_config);
+	if (IS_ERR(regmap))
+		return dev_err_probe(&sdev->dev, PTR_ERR(regmap),
+				     "failed to initialize regmap\n");
+
+	return devm_mfd_add_devices(&sdev->dev, PLATFORM_DEVID_AUTO,
+				    mt6369_devs, ARRAY_SIZE(mt6369_devs),
+				    NULL, 0, NULL);
+}
+
+static const struct of_device_id mt6369_spmi_of_match[] = {
+	{ .compatible = "mediatek,mt6369" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6369_spmi_of_match);
+
+static struct spmi_driver mt6369_spmi_driver = {
+	.driver = {
+		.name = "mt6369-spmi",
+		.of_match_table = mt6369_spmi_of_match,
+	},
+	.probe = mt6369_spmi_probe,
+};
+module_spmi_driver(mt6369_spmi_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6369 SPMI PMIC core");
+MODULE_LICENSE("GPL");
