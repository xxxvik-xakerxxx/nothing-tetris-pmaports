From 0000000000000000000000000000000000000014 Mon Sep 17 00:00:00 2001
From: postmarketOS Porting <porting@localhost>
Date: Sat, 25 Jul 2026 20:30:00 +0300
Subject: [PATCH] drm/sysfb: limit cache clean to damage

Cleaning the complete 10 MiB framebuffer after every atomic update makes
the Nothing Tetris reboot under the graphical session. The firmware display path only cleans
the cache lines covered by accumulated damage.

Keep the WB mapping, but use normal DRM damage updates and clean the
contiguous physical range spanning the damaged rows. This includes some
stride padding for partial rectangles, but avoids per-row barriers and
the full-frame work on every small UI update.
---
 drivers/gpu/drm/sysfb/drm_sysfb_helper.h  |  1 +
 drivers/gpu/drm/sysfb/drm_sysfb_modeset.c | 24 +++++++++++++++++++++---
 drivers/gpu/drm/sysfb/simpledrm.c         |  6 +++---
 3 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/sysfb/drm_sysfb_helper.h b/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
--- a/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
+++ b/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
@@ -81,6 +81,7 @@ struct drm_sysfb_device {
 	unsigned int fb_pitch;
 	unsigned int fb_gamma_lut_size;
 	bool force_full_frame_updates;
+	bool flush_framebuffer_cache;
 	phys_addr_t fb_phys;
 	size_t fb_size;
 
diff --git a/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c b/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c
--- a/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c
+++ b/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c
@@ -233,6 +233,26 @@ int drm_sysfb_plane_helper_atomic_check(struct drm_plane *plane,
 }
 EXPORT_SYMBOL(drm_sysfb_plane_helper_atomic_check);
 
+static void drm_sysfb_flush_damage(struct drm_sysfb_device *sysfb,
+				   const struct drm_format_info *format,
+				   const struct drm_rect *damage)
+{
+	phys_addr_t start;
+	size_t size;
+
+	if (!sysfb->flush_framebuffer_cache ||
+	    damage->x1 >= damage->x2 || damage->y1 >= damage->y2)
+		return;
+
+	start = sysfb->fb_phys + damage->y1 * sysfb->fb_pitch +
+		damage->x1 * format->cpp[0];
+	size = (damage->y2 - damage->y1 - 1) * sysfb->fb_pitch +
+		(damage->x2 - damage->x1) * format->cpp[0];
+
+	wmb();
+	arch_sync_dma_for_device(start, size, DMA_TO_DEVICE);
+}
+
 void drm_sysfb_plane_helper_atomic_update(struct drm_plane *plane, struct drm_atomic_state *state)
 {
 	struct drm_device *dev = plane->dev;
@@ -276,12 +296,10 @@ void drm_sysfb_plane_helper_atomic_update(struct drm_plane *plane, struct drm_at
 			drm_fb_blit(&dst, &dst_pitch, dst_format->format,
 				    shadow_plane_state->data, fb, &damage,
 				    &shadow_plane_state->fmtcnv_state);
+			drm_sysfb_flush_damage(sysfb, dst_format, &damage);
 		}
 	}
 	wmb();
-	if (sysfb->force_full_frame_updates)
-		arch_sync_dma_for_device(sysfb->fb_phys, sysfb->fb_size,
-					 DMA_TO_DEVICE);
 
 	drm_dev_exit(idx);
 out_drm_gem_fb_end_cpu_access:
diff --git a/drivers/gpu/drm/sysfb/simpledrm.c b/drivers/gpu/drm/sysfb/simpledrm.c
--- a/drivers/gpu/drm/sysfb/simpledrm.c
+++ b/drivers/gpu/drm/sysfb/simpledrm.c
@@ -680,7 +680,7 @@ static struct simpledrm_device *simpledrm_device_create(struct drm_driver *drv,
 	sysfb->fb_mode = drm_sysfb_mode(width, height, width_mm, height_mm);
 	sysfb->fb_format = format;
 	sysfb->fb_pitch = stride;
-	sysfb->force_full_frame_updates = of_node &&
+	sysfb->flush_framebuffer_cache = of_node &&
 		of_property_read_bool(of_node, "linux,force-full-frame-updates");
 
 	drm_dbg(dev, "display mode={" DRM_MODE_FMT "}\n", DRM_MODE_ARG(&sysfb->fb_mode));
@@ -703,6 +703,6 @@ static struct simpledrm_device *simpledrm_device_create(struct drm_driver *drv,
 
 		screen_base = devm_memremap(dev->dev, mem->start, resource_size(mem),
-					   sysfb->force_full_frame_updates ?
+					   sysfb->flush_framebuffer_cache ?
 					   MEMREMAP_WB : MEMREMAP_WC);
 		if (IS_ERR(screen_base))
 			return screen_base;
@@ -711,6 +711,6 @@ static struct simpledrm_device *simpledrm_device_create(struct drm_driver *drv,
 
 		iosys_map_set_vaddr(&sysfb->fb_addr, screen_base);
-		if (sysfb->force_full_frame_updates) {
+		if (sysfb->flush_framebuffer_cache) {
 			sysfb->fb_phys = mem->start;
 			sysfb->fb_size = resource_size(mem);
 		}
-- 
