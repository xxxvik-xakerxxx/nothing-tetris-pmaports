+
+struct rt6010 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct gpio_desc *enable_gpio;
+	struct input_dev *input;
+	struct mutex lock;
+	/* Protects requested_strong and requested_weak in atomic context. */
+	spinlock_t request_lock;
+	struct work_struct play_work;
+	u16 requested_strong;
+	u16 requested_weak;
+	u32 efs_data;
+	u8 efs_ver;
+	u8 revision;
+	bool initialized;
+	bool suspended;
+};
+
+static const struct regmap_config rt6010_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = RT6010_MAX_REGISTER,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int rt6010_write8(struct rt6010 *rt, unsigned int reg, unsigned int val)
+{
+	return regmap_write(rt->regmap, reg, val & 0xff);
+}
+
+static int rt6010_write16_regs(struct rt6010 *rt, unsigned int high_reg,
+			       unsigned int low_reg, u16 val)
+{
+	int error;
+
+	error = rt6010_write8(rt, high_reg, val >> 8);
+	if (error)
+		return error;
+
+	return rt6010_write8(rt, low_reg, val);
+}
+
+static int rt6010_efuse_read(struct rt6010 *rt, u8 index, u8 *data)
+{
+	unsigned int val;
+	int error;
+	int tries;
+
+	error = rt6010_write8(rt, RT6010_REG_EFS_ADDR_INDEX, index);
+	if (error)
+		return error;
+
+	error = rt6010_write8(rt, RT6010_REG_EFS_MODE_CTRL, BIT(1));
+	if (error)
+		return error;
+
+	for (tries = 0; tries < RT6010_EFS_RETRIES; tries++) {
+		usleep_range(10, 20);
+
+		error = regmap_read(rt->regmap, RT6010_REG_EFS_MODE_CTRL, &val);
+		if (error)
+			return error;
+
+		if (!(val & BIT(1))) {
+			error = regmap_read(rt->regmap, RT6010_REG_EFS_RD_DATA,
+					    &val);
+			if (error)
+				return error;
+
+			*data = val;
+			return 0;
+		}
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int rt6010_apply_trim(struct rt6010 *rt)
+{
+	u8 *efs = (u8 *)&rt->efs_data;
+	u8 trim;
+	unsigned int val;
+	int error;
+	int i;
+
+	error = rt6010_write8(rt, RT6010_REG_SOFT_RESET, 0x01);
+	if (error)
+		return error;
+
+	usleep_range(1000, 2000);
+
+	for (i = 0; i < RT6010_EFS_BYTES; i++) {
+		error = rt6010_efuse_read(rt, i, &efs[i]);
+		if (error)
+			return error;
+	}
+
+	rt->efs_ver = (rt->efs_data & RT6010_EFS_VERSION_MASK) >>
+		      RT6010_EFS_VERSION_OFFSET;
+
+	error = regmap_read(rt->regmap, RT6010_REG_PMU_CFG3, &val);
+	if (error)
+		return error;
+
+	val &= 0x4f;
+	trim = (rt->efs_data & RT6010_EFS_OSC_LDO_TRIM_MASK) >>
+	       RT6010_EFS_OSC_LDO_TRIM_OFFSET;
+	val |= trim << 7;
+	trim = (rt->efs_data & RT6010_EFS_PMU_LDO_TRIM_MASK) >>
+	       RT6010_EFS_PMU_LDO_TRIM_OFFSET;
+	val |= trim << 4;
+
+	error = rt6010_write8(rt, RT6010_REG_PMU_CFG3, val);
+	if (error)
+		return error;
+
+	trim = (rt->efs_data & RT6010_EFS_BIAS_1P2V_TRIM_MASK) >>
+	       RT6010_EFS_BIAS_1P2V_TRIM_OFFSET;
+	val = trim << 4;
+	trim = (rt->efs_data & RT6010_EFS_BIAS_I_TRIM_MASK) >>
+	       RT6010_EFS_BIAS_I_TRIM_OFFSET;
+	val |= trim;
+
+	error = rt6010_write8(rt, RT6010_REG_PMU_CFG4, val);
+	if (error)
+		return error;
+
+	trim = (rt->efs_data & RT6010_EFS_OSC_TRIM_MASK) >>
+	       RT6010_EFS_OSC_TRIM_OFFSET;
+	error = rt6010_write8(rt, RT6010_REG_OSC_CFG1, trim ^ 0x80);
+	if (error)
+		return error;
+
+	error = rt6010_write8(rt, RT6010_REG_BEMF_CFG2, 0x03);
+	if (error)
+		return error;
+	error = rt6010_write8(rt, RT6010_REG_BEMF_CFG2, 0x01);
+	if (error)
+		return error;
+
+	error = rt6010_write8(rt, RT6010_REG_BOOST_CFG1, 0x01);
+	if (error)
+		return error;
+	error = rt6010_write8(rt, RT6010_REG_BOOST_CFG2, 0x05);
+	if (error)
+		return error;
+	error = rt6010_write8(rt, RT6010_REG_BOOST_CFG3, RT6010_DEFAULT_BOOST);
+	if (error)
+		return error;
+
+	if (rt->efs_ver == 0x01) {
+		error = rt6010_write8(rt, 0x2a, 0x0f);
+		if (error)
+			return error;
+		error = rt6010_write8(rt, RT6010_REG_BEMF_CFG1, 0x00);
+		if (error)
+			return error;
+		error = rt6010_write8(rt, RT6010_REG_BOOST_CFG4, 0x50);
+		if (error)
+			return error;
+	} else {
+		error = rt6010_write8(rt, 0x2a, 0x0b);
+		if (error)
+			return error;
+		error = rt6010_write8(rt, RT6010_REG_BEMF_CFG1, 0x06);
+		if (error)
+			return error;
+		error = rt6010_write8(rt, RT6010_REG_BOOST_CFG4, 0x58);
+		if (error)
+			return error;
+	}
+
+	error = rt6010_write8(rt, RT6010_REG_BOOST_CFG5, 0x1c);
+	if (error)
+		return error;
+	error = rt6010_write8(rt, RT6010_REG_PA_CFG1, 0x2c);
+	if (error)
+		return error;
+	error = rt6010_write8(rt, RT6010_REG_PA_CFG2, 0x03);
+	if (error)
+		return error;
+
+	return rt6010_write8(rt, RT6010_REG_PMU_CFG2, 0x1c);
+}
+
+static int rt6010_write_ram(struct rt6010 *rt, u16 addr, const u8 *data,
+			    size_t len)
+{
+	int error;
+
+	if (addr + len > RT6010_MAX_RAM_SIZE)
+		return -EINVAL;
+
+	error = rt6010_write16_regs(rt, RT6010_REG_RAM_ADDR_H,
+				    RT6010_REG_RAM_ADDR_L, addr);
+	if (error)
+		return error;
+
+	return regmap_raw_write(rt->regmap, RT6010_REG_RAM_DATA, data, len);
+}
+
+static int rt6010_clear_protection_locked(struct rt6010 *rt)
+{
+	unsigned int val;
+	int error;
+
+	error = regmap_read(rt->regmap, RT6010_REG_BEMF_CFG2, &val);
+	if (error)
+		return error;
+
+	error = rt6010_write8(rt, RT6010_REG_BEMF_CFG2, val | BIT(1));
+	if (error)
+		return error;
+
+	return rt6010_write8(rt, RT6010_REG_BEMF_CFG2, val & ~BIT(1));
+}
+
+static void rt6010_log_status(struct rt6010 *rt, const char *prefix)
+{
+	unsigned int int_status;
+	unsigned int prot1;
+	unsigned int prot2;
+	unsigned int error_code;
+
+	if (regmap_read(rt->regmap, RT6010_REG_INT_STATUS, &int_status))
+		int_status = 0xff;
+	if (regmap_read(rt->regmap, RT6010_REG_PROTECTION_STATUS1, &prot1))
+		prot1 = 0xff;
+	if (regmap_read(rt->regmap, RT6010_REG_PROTECTION_STATUS2, &prot2))
+		prot2 = 0xff;
+	if (regmap_read(rt->regmap, RT6010_REG_ERROR_CODE, &error_code))
+		error_code = 0xff;
+
+	dev_info(rt->dev, "%s: int=%#02x prot=%#02x/%#02x error=%#02x\n",
+		 prefix, int_status, prot1, prot2, error_code);
+}
+
+static int rt6010_init_chip(struct rt6010 *rt)
+{
+	unsigned int chip_id;
+	int error;
+
+	error = regmap_read(rt->regmap, RT6010_REG_DEV_ID, &chip_id);
+	if (error)
+		return error;
+
+	if (chip_id != RT6010_DEVICE_ID)
+		return dev_err_probe(rt->dev, -ENODEV,
+				     "unexpected device ID %#x\n", chip_id);
+
+	error = regmap_read(rt->regmap, RT6010_REG_REV_ID, &chip_id);
+	if (error)
+		return error;
+	rt->revision = chip_id;
+
+	error = rt6010_apply_trim(rt);
+	if (error)
+		return error;
+
+	error = rt6010_write8(rt, RT6010_REG_RAM_CFG, 0x08);
+	if (error)
+		return error;
+
+	error = rt6010_write16_regs(rt, RT6010_REG_LIST_BASE_ADDR_H,
+				    RT6010_REG_LIST_BASE_ADDR_L,
+				    RT6010_LIST_BASE_ADDR);
+	if (error)
+		return error;
+	error = rt6010_write16_regs(rt, RT6010_REG_WAVE_BASE_ADDR_H,
+				    RT6010_REG_WAVE_BASE_ADDR_L,
+				    RT6010_WAVE_BASE_ADDR);
+	if (error)
+		return error;
+	error = rt6010_write16_regs(rt, RT6010_REG_FIFO_AE_H,
+				    RT6010_REG_FIFO_AE_L, RT6010_FIFO_AE);
+	if (error)
+		return error;
+	error = rt6010_write16_regs(rt, RT6010_REG_FIFO_AF_H,
+				    RT6010_REG_FIFO_AF_L, RT6010_FIFO_AF);
+	if (error)
+		return error;
+
+	error = rt6010_write8(rt, RT6010_REG_GAIN_CFG, RT6010_DEFAULT_GAIN);
+	if (error)
+		return error;
+	error = rt6010_write16_regs(rt, RT6010_REG_LRA_F0_CFG2,
+				    RT6010_REG_LRA_F0_CFG1, RT6010_PRE_F0);
+	if (error)
+		return error;
+
+	error = rt6010_write_ram(rt, RT6010_WAVE_BASE_ADDR, rt6010_waveform,
+				 sizeof(rt6010_waveform));
+	if (error)
+		return error;
+
+	error = rt6010_clear_protection_locked(rt);
+	if (error)
+		return error;
+
+	rt->initialized = true;
+	return 0;
+}
+
+static int rt6010_stop_locked(struct rt6010 *rt)
+{
+	int error;
+
+	error = rt6010_write8(rt, RT6010_REG_PLAY_CTRL, RT6010_GO_STOP);
+	if (error)
+		return error;
+
+	return 0;
+}
+
+static int rt6010_start_locked(struct rt6010 *rt, u16 strong, u16 weak)
+{
+	const u8 playlist[] = {
+		0x01, 0x00, RT6010_RAM_REPEAT_COUNT, RT6010_RAM_WAVE_INDEX,
+		0x00, 0x00,
+	};
+	u8 gain;
+	u32 level = max(strong, weak);
+	int error;
+
+	if (!rt->initialized)
+		return -ENODEV;
+
+	gain = RT6010_MIN_GAIN +
+	       level * (RT6010_MAX_GAIN - RT6010_MIN_GAIN) / 0xffff;
+
+	error = rt6010_stop_locked(rt);
+	if (error)
+		return error;
+	error = rt6010_clear_protection_locked(rt);
+	if (error)
+		return error;
+	error = rt6010_write8(rt, RT6010_REG_GAIN_CFG, gain);
+	if (error)
+		return error;
+	error = rt6010_write_ram(rt, RT6010_LIST_BASE_ADDR, playlist,
+				 sizeof(playlist));
+	if (error)
+		return error;
+	error = rt6010_write8(rt, RT6010_REG_PLAY_MODE,
+			      RT6010_PLAY_MODE_RAM);
+	if (error)
+		return error;
+	error = rt6010_write8(rt, RT6010_REG_PLAY_CTRL, RT6010_GO_START);
+	if (error)
+		goto out_stop;
+
+	rt6010_log_status(rt, "start");
+	return 0;
+
+out_stop:
+	rt6010_stop_locked(rt);
+	rt6010_log_status(rt, "start failed");
+	return error;
+}
+
+static void rt6010_play_work(struct work_struct *work)
+{
+	struct rt6010 *rt = container_of(work, struct rt6010, play_work);
+	unsigned long flags;
+	u16 strong;
+	u16 weak;
+	int error;
+	int stop_error;
+
+	spin_lock_irqsave(&rt->request_lock, flags);
+	strong = rt->requested_strong;
+	weak = rt->requested_weak;
+	spin_unlock_irqrestore(&rt->request_lock, flags);
+
+	if (READ_ONCE(rt->suspended))
+		return;
+
+	mutex_lock(&rt->lock);
+	if (READ_ONCE(rt->suspended)) {
+		mutex_unlock(&rt->lock);
+		return;
+	}
+
+	if (!strong && !weak)
+		error = rt6010_stop_locked(rt);
+	else
+		error = rt6010_start_locked(rt, strong, weak);
+
+	if (error) {
+		stop_error = rt6010_stop_locked(rt);
+		dev_err_ratelimited(rt->dev,
+				    "failed to %s haptics: %d (stop: %d)\n",
+				    strong || weak ? "start" : "stop",
+				    error, stop_error);
+	}
+	mutex_unlock(&rt->lock);
+}
+
+static int rt6010_play_effect(struct input_dev *input, void *data,
+			      struct ff_effect *effect)
+{
+	struct rt6010 *rt = data;
+	unsigned long flags;
+
+	if (READ_ONCE(rt->suspended))
+		return -EHOSTDOWN;
+
+	/* ff-memless invokes this callback with input->event_lock held. */
+	spin_lock_irqsave(&rt->request_lock, flags);
+	rt->requested_strong = effect->u.rumble.strong_magnitude;
+	rt->requested_weak = effect->u.rumble.weak_magnitude;
+	spin_unlock_irqrestore(&rt->request_lock, flags);
+	schedule_work(&rt->play_work);
+
+	return 0;
+}
+
+static void rt6010_input_close(struct input_dev *input)
+{
+	struct rt6010 *rt = input_get_drvdata(input);
+	unsigned long flags;
+	int error;
+
+	spin_lock_irqsave(&rt->request_lock, flags);
+	rt->requested_strong = 0;
+	rt->requested_weak = 0;
+	spin_unlock_irqrestore(&rt->request_lock, flags);
+	cancel_work_sync(&rt->play_work);
+
+	mutex_lock(&rt->lock);
+	error = rt6010_stop_locked(rt);
+	mutex_unlock(&rt->lock);
+	if (error)
+		dev_err_ratelimited(rt->dev, "failed to stop haptics: %d\n",
+				    error);
+}
+
+static irqreturn_t rt6010_irq_thread(int irq, void *data)
+{
+	struct rt6010 *rt = data;
+	unsigned int status;
+	int clear_error = 0;
+	int error;
+	int stop_error = 0;
+
+	mutex_lock(&rt->lock);
+	error = regmap_read(rt->regmap, RT6010_REG_INT_STATUS, &status);
+	if (!error && (status & RT6010_INT_PROTECTION)) {
+		stop_error = rt6010_stop_locked(rt);
+		clear_error = rt6010_clear_protection_locked(rt);
+	}
+	mutex_unlock(&rt->lock);
+
+	if (error) {
+		dev_err_ratelimited(rt->dev, "failed to read IRQ status: %d\n",
+				    error);
+		return IRQ_HANDLED;
+	}
+
+	if (status & RT6010_INT_PROTECTION) {
+		dev_warn_ratelimited(rt->dev,
+				     "protection IRQ (stop: %d, clear: %d)\n",
+				     stop_error, clear_error);
+	} else if (status & ~(RT6010_INT_PLAY_DONE | RT6010_INT_FIFO_AE |
+			      RT6010_INT_FIFO_AF)) {
+		dev_warn_ratelimited(rt->dev, "unknown IRQ status %#02x\n",
+				     status);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static void rt6010_disable(void *data)
+{
+	struct rt6010 *rt = data;
+
+	WRITE_ONCE(rt->suspended, true);
+	cancel_work_sync(&rt->play_work);
+	mutex_lock(&rt->lock);
+	rt6010_stop_locked(rt);
+	mutex_unlock(&rt->lock);
+	gpiod_set_value_cansleep(rt->enable_gpio, 0);
+}
+
+static int rt6010_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct rt6010 *rt;
+	int error;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
+		return dev_err_probe(dev, -EOPNOTSUPP,
+				     "byte register access is unavailable\n");
+
+	rt = devm_kzalloc(dev, sizeof(*rt), GFP_KERNEL);
+	if (!rt)
+		return -ENOMEM;
+
+	rt->dev = dev;
+	mutex_init(&rt->lock);
+	spin_lock_init(&rt->request_lock);
+	INIT_WORK(&rt->play_work, rt6010_play_work);
+	i2c_set_clientdata(client, rt);
+
+	rt->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(rt->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(rt->enable_gpio),
+				     "failed to acquire enable GPIO\n");
+
+	rt->regmap = devm_regmap_init_i2c(client, &rt6010_regmap_config);
+	if (IS_ERR(rt->regmap))
+		return dev_err_probe(dev, PTR_ERR(rt->regmap),
+				     "failed to initialize regmap\n");
+
+	gpiod_set_value_cansleep(rt->enable_gpio, 1);
+	usleep_range(RT6010_ENABLE_DELAY_US, RT6010_ENABLE_DELAY_US + 1000);
+
+	error = devm_add_action_or_reset(dev, rt6010_disable, rt);
+	if (error)
+		return error;
+
+	error = rt6010_init_chip(rt);
+	if (error)
+		return dev_err_probe(dev, error, "failed to initialize RT6010\n");
+
+	if (client->irq <= 0)
+		return dev_err_probe(dev, -EINVAL, "missing haptic IRQ\n");
+
+	error = devm_request_threaded_irq(dev, client->irq, NULL,
+					  rt6010_irq_thread, IRQF_ONESHOT,
+					  dev_name(dev), rt);
+	if (error)
+		return dev_err_probe(dev, error, "failed to request haptic IRQ\n");
+
+	rt->input = devm_input_allocate_device(dev);
+	if (!rt->input)
+		return -ENOMEM;
+
+	rt->input->name = "RT6010 haptics";
+	rt->input->id.bustype = BUS_I2C;
+	rt->input->close = rt6010_input_close;
+	input_set_drvdata(rt->input, rt);
+	input_set_capability(rt->input, EV_FF, FF_RUMBLE);
+
+	error = input_ff_create_memless(rt->input, rt, rt6010_play_effect);
+	if (error)
+		return dev_err_probe(dev, error,
+				     "failed to create FF_RUMBLE frontend\n");
+
+	error = input_register_device(rt->input);
+	if (error)
+		return dev_err_probe(dev, error,
+				     "failed to register input device\n");
+
+	dev_info(dev, "RT6010 revision %#02x initialized for FF_RUMBLE\n",
+		 rt->revision);
+
+	return 0;
+}
+
+static int rt6010_suspend(struct device *dev)
+{
+	struct rt6010 *rt = dev_get_drvdata(dev);
+	unsigned long flags;
+	int error;
+
+	WRITE_ONCE(rt->suspended, true);
+	disable_irq(to_i2c_client(dev)->irq);
+
+	spin_lock_irqsave(&rt->request_lock, flags);
+	rt->requested_strong = 0;
+	rt->requested_weak = 0;
+	spin_unlock_irqrestore(&rt->request_lock, flags);
+	cancel_work_sync(&rt->play_work);
+
+	mutex_lock(&rt->lock);
+	error = rt6010_stop_locked(rt);
+	rt->initialized = false;
+	gpiod_set_value_cansleep(rt->enable_gpio, 0);
+	mutex_unlock(&rt->lock);
+
+	if (error)
+		dev_warn(dev, "failed to stop haptics for suspend: %d\n", error);
+
+	return 0;
+}
+
+static int rt6010_resume(struct device *dev)
+{
+	struct rt6010 *rt = dev_get_drvdata(dev);
+	int error;
+
+	mutex_lock(&rt->lock);
+	gpiod_set_value_cansleep(rt->enable_gpio, 1);
+	usleep_range(RT6010_ENABLE_DELAY_US, RT6010_ENABLE_DELAY_US + 1000);
+	error = rt6010_init_chip(rt);
+	if (error)
+		gpiod_set_value_cansleep(rt->enable_gpio, 0);
+	mutex_unlock(&rt->lock);
+
+	if (error)
+		return dev_err_probe(dev, error,
+				     "failed to reinitialize RT6010 after resume\n");
+
+	WRITE_ONCE(rt->suspended, false);
+	enable_irq(to_i2c_client(dev)->irq);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(rt6010_pm_ops, rt6010_suspend, rt6010_resume);
+
+static const struct of_device_id rt6010_of_match[] = {
+	{ .compatible = "richtek,rt6010" },
+	{ .compatible = "ics,haptic-rt6010" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, rt6010_of_match);
+
+static const struct i2c_device_id rt6010_i2c_id[] = {
+	{ "rt6010" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, rt6010_i2c_id);
+
+static struct i2c_driver rt6010_driver = {
+	.driver = {
+		.name = "rt6010-haptics",
+		.of_match_table = rt6010_of_match,
+		.pm = pm_sleep_ptr(&rt6010_pm_ops),
+	},
+	.probe = rt6010_probe,
+	.id_table = rt6010_i2c_id,
+};
+module_i2c_driver(rt6010_driver);
+
+MODULE_DESCRIPTION("RT6010 haptics driver");
+MODULE_AUTHOR("xxxvik-xakerxxx <xxxviktor.lyskoxxx@gmail.com>");
+MODULE_LICENSE("GPL");

