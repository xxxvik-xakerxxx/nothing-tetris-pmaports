+#define RT6010_EFS_BIAS_I_TRIM_MASK		0x000000f0
+#define RT6010_EFS_PMU_LDO_TRIM_MASK		0x00000100
+#define RT6010_EFS_OSC_LDO_TRIM_MASK		0x00000200
+#define RT6010_EFS_OSC_TRIM_MASK		0x0003fc00
+#define RT6010_EFS_VERSION_MASK			0xc0000000
+
+#define RT6010_LIST_BASE_ADDR		0x0400
+#define RT6010_WAVE_BASE_ADDR		0x0420
+#define RT6010_FIFO_AE			0x0200
+#define RT6010_FIFO_AF			0x0300
+#define RT6010_PRE_F0			817
+#define RT6010_MIN_GAIN			0x08
+#define RT6010_DEFAULT_GAIN		0x7f
+#define RT6010_MAX_GAIN			0x7f
+#define RT6010_DEFAULT_BOOST		0x08
+#define RT6010_RAM_REPEAT_COUNT		0x7f
+#define RT6010_RAM_WAVE_INDEX		0x01
+static const u8 rt6010_waveform[] = {
+	0x04, 0x30, 0x00, 0x80, 0x04, 0xb0, 0x00, 0x80,
+	0x05, 0x30, 0x00, 0x23, 0x05, 0x53, 0x00, 0x14,
+	0x00, 0x0a, 0x13, 0x1b, 0x21, 0x26, 0x28, 0x28,
+	0x25, 0x20, 0x19, 0x11, 0x07, 0xfe, 0xf4, 0xeb,
+	0xe3, 0xdd, 0xda, 0xd8, 0xd9, 0xdc, 0xe1, 0xe9,
+	0xf1, 0xfb, 0x05, 0x0e, 0x17, 0x1e, 0x24, 0x27,
+	0x28, 0x27, 0x23, 0x1d, 0x15, 0x0d, 0x03, 0xf9,
+	0xf0, 0xe7, 0xe0, 0xdb, 0xd9, 0xd8, 0xda, 0xde,
+	0xe5, 0xed, 0xf6, 0xff, 0x09, 0x12, 0x1a, 0x21,
+	0x25, 0x28, 0x28, 0x25, 0x20, 0x1a, 0x11, 0x08,
+	0xfe, 0xf5, 0xec, 0xe4, 0xde, 0xda, 0xd8, 0xd9,
+	0xdc, 0xe1, 0xe8, 0xf1, 0xfa, 0x04, 0x0e, 0x16,
+	0x1e, 0x23, 0x27, 0x28, 0x27, 0x23, 0x1d, 0x16,
+	0x0d, 0x04, 0xfa, 0xf0, 0xe8, 0xe1, 0xdc, 0xd9,
+	0xd8, 0xda, 0xde, 0xe4, 0xec, 0xf5, 0xff, 0x09,
+	0x12, 0x1a, 0x21, 0x25, 0x28, 0x28, 0x25, 0x21,
+	0x1a, 0x12, 0x09, 0xff, 0xf5, 0xec, 0xe4, 0xde,
+	0xda, 0xd8, 0xd9, 0xdc, 0xe1, 0xe8, 0xf0, 0xfa,
+	0x00, 0x1f, 0x3c, 0x56, 0x6b, 0x79, 0x7f, 0x7f,
+	0x76, 0x66, 0x51, 0x36, 0x18, 0xf9, 0xda, 0xbd,
+	0xa5, 0x91, 0x85, 0x80, 0x83, 0x8d, 0x9e, 0xb5,
+	0xd1, 0xef, 0x0f, 0x2d, 0x49, 0x60, 0x72, 0x7d,
+	0x7f, 0x7b, 0x70, 0x5d, 0x45, 0x28, 0x09, 0xea,
+	0xcc, 0xb1, 0x9b, 0x8b, 0x82, 0x80, 0x87, 0x94,
+	0xa8, 0xc2, 0xdf, 0xfe, 0x1d, 0x3b, 0x55, 0x69,
+	0x78, 0x7f, 0x7f, 0x77, 0x68, 0x52, 0x38, 0x1a,
+	0xfb, 0xdc, 0xbf, 0xa6, 0x93, 0x86, 0x80, 0x82,
+	0x8c, 0x9d, 0xb4, 0xcf, 0xed, 0x0d, 0x2b, 0x47,
+	0x5f, 0x71, 0x7c, 0x7f, 0x7c, 0x70, 0x5e, 0x46,
+	0x2a, 0x0b, 0xec, 0xce, 0xb3, 0x9c, 0x8c, 0x82,
+	0x80, 0x86, 0x93, 0xa7, 0xc0, 0xdd, 0xfc, 0x1b,
+	0x39, 0x53, 0x68, 0x77, 0x7f, 0x7f, 0x77, 0x69,
+	0x54, 0x3a, 0x1c, 0xfd, 0xde, 0xc1, 0xa7, 0x94,
+	0x86, 0x80, 0x82, 0x8b, 0x9c, 0xb2, 0xcd, 0xeb,
+	0x00, 0x16, 0x2c, 0x40, 0x52, 0x62, 0x6f, 0x78,
+	0x7d, 0x7e, 0x7c, 0x75, 0x6b, 0x5d, 0x4c, 0x39,
+	0x24, 0x0e, 0xf9, 0xe2, 0xcd, 0xb9, 0xa8, 0x99,
+	0x8e, 0x86, 0x82, 0x82, 0x86, 0x8e, 0x9a, 0xa9,
+	0xba, 0xce, 0xe3, 0x00, 0x27, 0x4a, 0x66, 0x78,
+	0x7f, 0x78, 0x66, 0x4a, 0x27, 0x00, 0xd9, 0xb6,
