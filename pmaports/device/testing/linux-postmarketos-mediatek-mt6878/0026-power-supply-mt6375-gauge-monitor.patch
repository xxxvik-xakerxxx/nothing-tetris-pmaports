diff --git a/drivers/power/supply/mt6375-gauge-monitor.c b/drivers/power/supply/mt6375-gauge-monitor.c
new file mode 100644
index 0000000..2c773d0
--- /dev/null
+++ b/drivers/power/supply/mt6375-gauge-monitor.c
@@ -0,0 +1,350 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Read-only MT6375 battery gauge telemetry for Nothing Tetris.
+ */
+
+#include <linux/iio/consumer.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+
+#define MT6375_FGADC_CON2		0x26f
+#define MT6375_FG_LATCHDATA_ST		BIT(7)
+#define MT6375_FGADC_CON3		0x270
+#define MT6375_FG_SW_CLEAR		BIT(3)
+#define MT6375_FG_SW_READ_PRE		BIT(0)
+#define MT6375_FGADC_CAR_CON0		0x278
+#define MT6375_FGADC_CUR_CON0		0x2e7
+
+#define MT6375_FG_CURRENT_NA_LSB	610352
+#define MT6375_FG_CHARGE_NAH_LSB	85
+#define MT6375_NTC_PULLUP_OHM		24000
+#define MT6375_NTC_VREF_MIN_MV		1700
+#define MT6375_NTC_VREF_MAX_MV		2000
+
+struct mt6375_ntc_point {
+	int temperature_c;
+	int resistance_ohm;
+};
+
+static const struct mt6375_ntc_point mt6375_tetris_ntc[] = {
+	{ -40, 195652 }, { -35, 148171 }, { -30, 113347 },
+	{ -25, 87559 }, { -20, 68237 }, { -15, 53650 },
+	{ -10, 42506 }, { -5, 33892 }, { 0, 27219 },
+	{ 5, 22021 }, { 10, 17926 }, { 15, 14674 },
+	{ 20, 12081 }, { 25, 10000 }, { 30, 8315 },
+	{ 35, 6948 }, { 40, 5834 }, { 45, 4917 },
+	{ 50, 4161 }, { 55, 3535 }, { 60, 3014 },
+	{ 65, 2586 }, { 70, 2227 }, { 75, 1924 },
+};
+
+struct mt6375_gauge_monitor {
+	struct regmap *regmap;
+	struct iio_channel *battery_voltage;
+	struct iio_channel *battery_temperature;
+	struct iio_channel *reference_voltage;
+	struct power_supply *psy;
+	struct mutex latch_lock; /* Serialize hardware latch sequences. */
+};
+
+static int mt6375_gauge_release(struct mt6375_gauge_monitor *monitor)
+{
+	unsigned int value;
+	int poll_ret;
+	int ret;
+
+	ret = regmap_update_bits(monitor->regmap, MT6375_FGADC_CON3,
+				 MT6375_FG_SW_CLEAR | MT6375_FG_SW_READ_PRE,
+				 MT6375_FG_SW_CLEAR);
+	if (ret)
+		return ret;
+
+	usleep_range(100, 150);
+
+	poll_ret = regmap_read_poll_timeout(monitor->regmap, MT6375_FGADC_CON2,
+					    value,
+					    !(value & MT6375_FG_LATCHDATA_ST),
+					    50, 200);
+
+	ret = regmap_update_bits(monitor->regmap, MT6375_FGADC_CON3,
+				 MT6375_FG_SW_CLEAR, 0);
+	return poll_ret ? poll_ret : ret;
+}
+
+static int mt6375_gauge_latch(struct mt6375_gauge_monitor *monitor)
+{
+	unsigned int value;
+	int ret;
+
+	ret = regmap_read(monitor->regmap, MT6375_FGADC_CON3, &value);
+	if (ret)
+		return ret;
+	if (value & (MT6375_FG_SW_CLEAR | MT6375_FG_SW_READ_PRE))
+		return -EBUSY;
+
+	ret = regmap_update_bits(monitor->regmap, MT6375_FGADC_CON3,
+				 MT6375_FG_SW_CLEAR | MT6375_FG_SW_READ_PRE,
+				 MT6375_FG_SW_READ_PRE);
+	if (ret)
+		return ret;
+
+	usleep_range(100, 150);
+
+	ret = regmap_read_poll_timeout(monitor->regmap, MT6375_FGADC_CON2,
+				       value, value & MT6375_FG_LATCHDATA_ST,
+				       50, 200);
+	if (ret)
+		mt6375_gauge_release(monitor);
+
+	return ret;
+}
+
+static int mt6375_gauge_read_latched(struct mt6375_gauge_monitor *monitor,
+				     unsigned int reg, void *value,
+				     size_t value_len)
+{
+	int release_ret;
+	int ret;
+
+	mutex_lock(&monitor->latch_lock);
+
+	ret = mt6375_gauge_latch(monitor);
+	if (ret)
+		goto unlock;
+
+	ret = regmap_raw_read(monitor->regmap, reg, value, value_len);
+	release_ret = mt6375_gauge_release(monitor);
+	if (!ret)
+		ret = release_ret;
+
+unlock:
+	mutex_unlock(&monitor->latch_lock);
+	return ret;
+}
+
+static int mt6375_gauge_current_ua(struct mt6375_gauge_monitor *monitor,
+				   int *current_ua)
+{
+	s64 current_raw;
+	__le16 raw_le;
+	u16 raw;
+	int ret;
+	const unsigned int reg = MT6375_FGADC_CUR_CON0;
+
+	ret = mt6375_gauge_read_latched(monitor, reg, &raw_le, sizeof(raw_le));
+	if (ret)
+		return ret;
+
+	raw = le16_to_cpu(raw_le);
+	if (raw & BIT(15))
+		current_raw = -(s64)(U16_MAX - raw);
+	else
+		current_raw = raw;
+
+	current_raw *= MT6375_FG_CURRENT_NA_LSB;
+	*current_ua = div_s64(current_raw, 1000);
+
+	return 0;
+}
+
+static int mt6375_gauge_charge_uah(struct mt6375_gauge_monitor *monitor,
+				   int *charge_uah)
+{
+	s64 charge_raw;
+	__le32 raw_le;
+	u32 raw;
+	int ret;
+	const unsigned int reg = MT6375_FGADC_CAR_CON0;
+
+	ret = mt6375_gauge_read_latched(monitor, reg, &raw_le, sizeof(raw_le));
+	if (ret)
+		return ret;
+
+	raw = le32_to_cpu(raw_le);
+	if (raw & BIT(31))
+		charge_raw = -(s64)(S32_MAX - (raw & S32_MAX));
+	else
+		charge_raw = raw;
+
+	charge_raw *= MT6375_FG_CHARGE_NAH_LSB;
+	*charge_uah = div_s64(charge_raw, 1000);
+
+	return 0;
+}
+
+static int mt6375_gauge_voltage_uv(struct mt6375_gauge_monitor *monitor,
+				   int *voltage_uv)
+{
+	int voltage_mv;
+	int ret;
+
+	ret = iio_read_channel_processed(monitor->battery_voltage, &voltage_mv);
+	if (ret)
+		return ret;
+	if (voltage_mv < 2500 || voltage_mv > 5500)
+		return -ERANGE;
+
+	*voltage_uv = voltage_mv * 1000;
+	return 0;
+}
+
+static int mt6375_ntc_temperature(int resistance_ohm, int *temperature)
+{
+	int i;
+
+	if (resistance_ohm > mt6375_tetris_ntc[0].resistance_ohm ||
+	    resistance_ohm < mt6375_tetris_ntc[ARRAY_SIZE(mt6375_tetris_ntc) - 1].resistance_ohm)
+		return -ERANGE;
+
+	for (i = 1; i < ARRAY_SIZE(mt6375_tetris_ntc); i++) {
+		const struct mt6375_ntc_point *cold = &mt6375_tetris_ntc[i - 1];
+		const struct mt6375_ntc_point *warm = &mt6375_tetris_ntc[i];
+		s64 offset;
+
+		if (resistance_ohm < warm->resistance_ohm)
+			continue;
+
+		offset = (s64)(cold->resistance_ohm - resistance_ohm) *
+			 (warm->temperature_c - cold->temperature_c) * 10;
+		*temperature = cold->temperature_c * 10 +
+			div_s64(offset, cold->resistance_ohm - warm->resistance_ohm);
+		return 0;
+	}
+
+	return -ERANGE;
+}
+
+static int mt6375_gauge_temperature(struct mt6375_gauge_monitor *monitor,
+				    int *temperature)
+{
+	s64 resistance_ohm;
+	int baton_mv;
+	int vref_mv;
+	int ret;
+
+	ret = iio_read_channel_processed(monitor->reference_voltage, &vref_mv);
+	if (ret)
+		return ret;
+	if (vref_mv < MT6375_NTC_VREF_MIN_MV ||
+	    vref_mv > MT6375_NTC_VREF_MAX_MV)
+		return -ERANGE;
+
+	ret = iio_read_channel_processed(monitor->battery_temperature,
+					 &baton_mv);
+	if (ret)
+		return ret;
+	if (baton_mv <= 0 || baton_mv >= vref_mv)
+		return -ERANGE;
+
+	resistance_ohm = div_s64((s64)MT6375_NTC_PULLUP_OHM * baton_mv,
+				 vref_mv - baton_mv);
+	if (resistance_ohm > INT_MAX)
+		return -ERANGE;
+
+	return mt6375_ntc_temperature(resistance_ohm, temperature);
+}
+
+static enum power_supply_property mt6375_gauge_properties[] = {
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_COUNTER,
+};
+
+static int mt6375_gauge_get_property(struct power_supply *psy,
+				     enum power_supply_property property,
+				     union power_supply_propval *value)
+{
+	struct mt6375_gauge_monitor *monitor = power_supply_get_drvdata(psy);
+
+	switch (property) {
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		return mt6375_gauge_voltage_uv(monitor, &value->intval);
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		return mt6375_gauge_current_ua(monitor, &value->intval);
+	case POWER_SUPPLY_PROP_TEMP:
+		return mt6375_gauge_temperature(monitor, &value->intval);
+	case POWER_SUPPLY_PROP_CHARGE_COUNTER:
+		return mt6375_gauge_charge_uah(monitor, &value->intval);
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct power_supply_desc mt6375_gauge_desc = {
+	.name = "mt6375-gauge",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = mt6375_gauge_properties,
+	.num_properties = ARRAY_SIZE(mt6375_gauge_properties),
+	.get_property = mt6375_gauge_get_property,
+};
+
+static int mt6375_gauge_probe(struct platform_device *pdev)
+{
+	struct power_supply_config config = {};
+	struct mt6375_gauge_monitor *monitor;
+
+	monitor = devm_kzalloc(&pdev->dev, sizeof(*monitor), GFP_KERNEL);
+	if (!monitor)
+		return -ENOMEM;
+
+	monitor->regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!monitor->regmap)
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "failed to get parent regmap\n");
+
+	monitor->battery_voltage =
+		devm_iio_channel_get(&pdev->dev, "battery-voltage");
+	if (IS_ERR(monitor->battery_voltage))
+		return dev_err_probe(&pdev->dev, PTR_ERR(monitor->battery_voltage),
+				     "failed to get battery voltage channel\n");
+
+	monitor->battery_temperature =
+		devm_iio_channel_get(&pdev->dev, "battery-temperature");
+	if (IS_ERR(monitor->battery_temperature))
+		return dev_err_probe(&pdev->dev,
+				     PTR_ERR(monitor->battery_temperature),
+				     "failed to get battery temperature channel\n");
+
+	monitor->reference_voltage =
+		devm_iio_channel_get(&pdev->dev, "reference-voltage");
+	if (IS_ERR(monitor->reference_voltage))
+		return dev_err_probe(&pdev->dev,
+				     PTR_ERR(monitor->reference_voltage),
+				     "failed to get reference voltage channel\n");
+
+	mutex_init(&monitor->latch_lock);
+	config.drv_data = monitor;
+
+	monitor->psy = devm_power_supply_register(&pdev->dev,
+						  &mt6375_gauge_desc,
+						  &config);
+	if (IS_ERR(monitor->psy))
+		return dev_err_probe(&pdev->dev, PTR_ERR(monitor->psy),
+				     "failed to register gauge\n");
+
+	platform_set_drvdata(pdev, monitor);
+	return 0;
+}
+
+static const struct of_device_id mt6375_gauge_of_match[] = {
+	{ .compatible = "nothing,tetris-mt6375-gauge-monitor" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6375_gauge_of_match);
+
+static struct platform_driver mt6375_gauge_driver = {
+	.probe = mt6375_gauge_probe,
+	.driver = {
+		.name = "mt6375-gauge-monitor",
+		.of_match_table = mt6375_gauge_of_match,
+	},
+};
+module_platform_driver(mt6375_gauge_driver);
+
+MODULE_DESCRIPTION("Nothing Tetris MT6375 read-only battery gauge monitor");
+MODULE_LICENSE("GPL");
