+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/nothing,tetris-mt6375-gauge-monitor.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Nothing Tetris MT6375 read-only battery gauge monitor
+
+maintainers:
+  - xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
+
+description:
+  Read-only access to the MT6375 fuel-gauge current and coulomb counters and
+  to the Nothing Tetris battery thermistor. The monitor is a child of the
+  MT6375 PMIC and does not control charging or estimate state of charge.
+
+properties:
+  compatible:
+    const: nothing,tetris-mt6375-gauge-monitor
+
+  io-channels:
+    minItems: 3
+    maxItems: 3
+
+  io-channel-names:
+    items:
+      - const: battery-voltage
+      - const: battery-temperature
+      - const: reference-voltage
+
+required:
+  - compatible
+  - io-channels
+  - io-channel-names
+
+additionalProperties: false
+
+...
