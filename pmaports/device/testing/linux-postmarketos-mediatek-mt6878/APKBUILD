maintainer="BotchedRPR <igor.belwon@mentallysanemainliners.org>"
pkgname=linux-postmarketos-mediatek-mt6878
pkgver=6.18
pkgrel=85
pkgdesc="Mainline Linux kernel for MediaTek MT6878 devices"
arch="aarch64"
_carch="arm64"
_flavor="postmarketos-mediatek-mt6878"
url="https://github.com/MT6878-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native pmb:kconfigcheck-community"
subpackages="
	$pkgname-pmic:_pmic
	$pkgname-connectivity:_connectivity
	$pkgname-audio:_audio
"
makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	flex
	kmod
	lld
	llvm
	openssl-dev
	perl
	python3
"

_repository="linux"
_commit="d84b264a54a37611f2f46bc19363cb9b41606205"
_connmods_commit="e96f60dc081ae3525ef43d4bcf0ee5ee97e53835"
_devmods_commit="ee2be53cb75670b548948636a0db1d1ff112bf12"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/MT6878-mainline/$_repository/archive/$_commit.tar.gz
	android-kernel-modules-$_connmods_commit.tar.gz::https://github.com/NothingOSS/android_kernel_modules_nothing_mt6878/archive/$_connmods_commit.tar.gz
	android-kernel-device-modules-$_devmods_commit.tar.gz::https://github.com/NothingOSS/android_kernel_device_modules_6.1_nothing_mt6878/archive/$_devmods_commit.tar.gz
	$_config
	0001-input-touchscreen-ft3519t-tetris.patch
	0002-mfd-mt6369-spmi-pmic.patch
	0003-mfd-mt6363-keys-mt6375-telemetry.patch
	0004-arm64-dts-mt6878-tetris-disabled-peripherals.patch
	0005-drm-sysfb-tetris-framebuffer.patch
	0006-pinctrl-mediatek-mt6878-eint.patch
	0007-power-supply-mt6375-monitor.patch
	0008-connectivity-mt6878-mt6631-connsys.patch
	0009-clk-mediatek-mt6878-mfg.patch
	0010-audio-mt6878-aw88261.patch
	0011-input-rt6010-haptics-tetris.patch
	0012-usb-typec-mt6375-tcpc-tetris.patch
	0013-iio-nvmem-mt6369-calibration.patch
	0014-mmc-mt6878-tetris-sdcard.patch
	0015-leds-flash-lm3644-tetris.patch
	0016-usb-typec-hl5280-audio-switch.patch
	0017-mfd-mt6363-auxadc-registers.patch
	1001-vendor-connectivity-linux-6.18-compat.patch.vendor
	1101-vendor-audio-optional-calibration.patch.vendor
	1102-vendor-audio-linux-6.18-api.patch.vendor
"
builddir="$srcdir/$_repository-$_commit"
_connmods_dir="$srcdir/android_kernel_modules_nothing_mt6878-$_connmods_commit"
_devmods_dir="$srcdir/android_kernel_device_modules_6.1_nothing_mt6878-$_devmods_commit"
_android_top="$srcdir/android-top"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config

	mkdir -p "$_android_top"/vendor/mediatek/kernel_modules
	ln -snf "$_connmods_dir"/connectivity \
		"$_android_top"/vendor/mediatek/kernel_modules/connectivity

	patch -p1 -d "$_connmods_dir" \
		< "$srcdir"/1001-vendor-connectivity-linux-6.18-compat.patch.vendor
	patch -p1 -d "$_devmods_dir" \
		< "$srcdir"/1101-vendor-audio-optional-calibration.patch.vendor
	patch -p1 -d "$_devmods_dir" \
		< "$srcdir"/1102-vendor-audio-linux-6.18-api.patch.vendor
}

_vendor_kcflags() {
	printf '%s' \
		'-Wno-error=format ' \
		'-Wno-error=format-extra-args ' \
		'-Wno-error=missing-prototypes'
}

_connectivity_make() {
	_moddir="$1"
	shift

	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	make -j"$_jobs" -C "$builddir" M="$_moddir" \
		ARCH="$_carch" LLVM=1 \
		KERNEL_SRC="$builddir" \
		KERNEL_OUT="$builddir" \
		KO_CODE_PATH="$_moddir" \
		DEVICE_MODULES_PATH="$_devmods_dir" \
		TOP="$_android_top" \
		MTK_PLATFORM=mt6878 \
		MTK_PLATFORM_WMT=mt6878 \
		CONFIG_MTK_PLATFORM=mt6878 \
		TARGET_BOARD_PLATFORM_WMT=mt6878 \
		TARGET_BUILD_VARIANT=user \
		CONFIG_ARM64=y \
		CONFIG_MTK_COMBO=y \
		CONFIG_MTK_COMBO_WIFI=m \
		CONFIG_MTK_COMBO_CHIP_CONSYS_6878=y \
		CONFIG_MTK_COMBO_WIFI_HIF=axi \
		CONFIG_MTK_CONNINFRA=m \
		CONFIG_CONNINFRA_PLAT_BUILD_MODE=module \
		CONFIG_WLAN_DRV_BUILD_IN=n \
		MTK_CONSYS_ADIE=MT6631 \
		KCFLAGS="$(_vendor_kcflags)" \
		"$@" modules
}

_build_connectivity_modules() {
	_conn="$_connmods_dir"/connectivity
	_symbols=""

	_connectivity_make "$_conn"/conninfra
	_symbols="$_conn/conninfra/Module.symvers"

	_connectivity_make "$_conn"/connfem KBUILD_EXTRA_SYMBOLS="$_symbols"
	_symbols="$_symbols $_conn/connfem/Module.symvers"

	_connectivity_make "$_conn"/common KBUILD_EXTRA_SYMBOLS="$_symbols"
	_symbols="$_symbols $_conn/common/Module.symvers"

	_connectivity_make "$_conn"/wlan/adaptor \
		CONNAC_VER=2_0 \
		MODULE_NAME=wmtWifi \
		KBUILD_EXTRA_SYMBOLS="$_symbols"
	_symbols="$_symbols $_conn/wlan/adaptor/Module.symvers"

	_connectivity_make "$_conn"/wlan/core/gen4m \
		MODULE_NAME=wlan_drv_gen4m_6878 \
		WLAN_CHIP_ID=6878 \
		MTK_COMBO_CHIP=CONNAC2X2_SOC7_0 \
		WIFI_IP_SET=1 \
		MTK_ANDROID_WMT=y \
		MTK_ANDROID_EMI=n \
		KBUILD_EXTRA_SYMBOLS="$_symbols"
	_symbols="$_symbols $_conn/wlan/core/gen4m/Module.symvers"

	_connectivity_make "$_conn"/bt/mt66xx/6878 \
		BT_PLATFORM=6878 \
		LOG_TAG=bt_drv_6878 \
		KBUILD_EXTRA_SYMBOLS="$_symbols"
}

_pmic_make() {
	_moddir="$1"
	shift

	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	make -j"$_jobs" -C "$builddir" M="$_moddir" \
		ARCH="$_carch" LLVM=1 \
		KERNEL_SRC="$builddir" \
		KERNEL_OUT="$builddir" \
		DEVICE_MODULES_PATH="$_devmods_dir" \
		CONFIG_ARM64=y \
		KCFLAGS="-I$_devmods_dir/include $(_vendor_kcflags)" \
		"$@" modules
}

_build_pmic_modules() {
	_pmic="$_devmods_dir"/drivers

	_pmic_make "$_pmic"/iio/adc \
		CONFIG_MEDIATEK_SPMI_PMIC_ADC=m
	_pmic_make "$_pmic"/nvmem \
		CONFIG_MT635X_EFUSE=m
}

_audio_make() {
	_moddir="$1"
	shift

	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	make -j"$_jobs" -C "$builddir" M="$_moddir" \
		ARCH="$_carch" LLVM=1 \
		KERNEL_SRC="$builddir" \
		KERNEL_OUT="$builddir" \
		DEVICE_MODULES_PATH="$_devmods_dir" \
		MTK_PLATFORM=mt6878 \
		CONFIG_ARM64=y \
		CONFIG_DEVICE_MODULES_SND_SOC_MEDIATEK=m \
		CONFIG_SND_SOC_MTK_SRAM=m \
		CONFIG_SND_SOC_MTK_SMART_PHONE=m \
		CONFIG_DEVICE_MODULES_SND_SOC_MT6369=m \
		CONFIG_DEVICE_MODULES_SND_SOC_MT6878=m \
		CONFIG_DEVICE_MODULES_SND_SOC_MT6878_MT6369=m \
		CONFIG_MEDIATEK_SPMI_PMIC_ADC=m \
		CONFIG_MT635X_EFUSE=m \
		CONFIG_SND_SOC_MT6369_ACCDET=n \
		KCFLAGS="-I$_devmods_dir/include \
			-I$_devmods_dir/drivers/misc/mediatek/include \
			$(_vendor_kcflags)" \
		"$@" modules
}

_build_audio_modules() {
	_audio="$_devmods_dir"/sound/soc
	_symbols="$_devmods_dir/drivers/iio/adc/Module.symvers"
	_symbols="$_symbols $_devmods_dir/drivers/nvmem/Module.symvers"

	_audio_make "$_audio"/mediatek/common
	_symbols="$_symbols $_audio/mediatek/common/Module.symvers"

	_audio_make "$_audio"/codecs KBUILD_EXTRA_SYMBOLS="$_symbols"
	_symbols="$_symbols $_audio/codecs/Module.symvers"

	_audio_make "$_audio"/mediatek/mt6878 \
		KBUILD_EXTRA_SYMBOLS="$_symbols"
}

build() {
	unset LDFLAGS
	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	make -j"$_jobs" ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor" \
		Image.gz modules \
		mediatek/mt6878-nothing-tetris.dtb
	_build_pmic_modules
	_build_connectivity_modules
	_build_audio_modules
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
				   "$pkgdir/boot/vmlinuz"

	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	make -j"$_jobs" modules_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		LLVM=1
	install -Dm644 "$builddir/arch/$_carch/boot/dts/mediatek/mt6878-nothing-tetris.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6878-nothing-tetris.dtb"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	_release="$(cat "$builddir"/include/config/kernel.release)"
	_extra="$pkgdir/lib/modules/$_release/extra/mediatek-pmic"
	for _module in \
		"$_devmods_dir"/drivers/iio/adc/mtk-spmi-pmic-adc.ko \
		"$_devmods_dir"/drivers/nvmem/nvmem-mt635x-efuse.ko; do
		install -Dm644 "$_module" "$_extra/${_module##*/}"
	done
	_extra="$pkgdir/lib/modules/$_release/extra/mediatek-connectivity"
	for _module in \
		"$_connmods_dir"/connectivity/conninfra/conninfra.ko \
		"$_connmods_dir"/connectivity/connfem/connfem.ko \
		"$_connmods_dir"/connectivity/common/wmt_drv.ko \
		"$_connmods_dir"/connectivity/wlan/adaptor/wmtWifi.ko \
		"$_connmods_dir"/connectivity/wlan/core/gen4m/wlan_drv_gen4m_6878.ko \
		"$_connmods_dir"/connectivity/bt/mt66xx/6878/bt_drv_6878.ko; do
		install -Dm644 "$_module" "$_extra/${_module##*/}"
	done
	_extra="$pkgdir/lib/modules/$_release/extra/mediatek-audio"
	for _module in \
		"$_devmods_dir"/sound/soc/mediatek/common/snd-soc-mtk-common.ko \
		"$_devmods_dir"/sound/soc/mediatek/common/mtk-afe-external.ko \
		"$_devmods_dir"/sound/soc/mediatek/common/mtk-sp-spk-amp.ko \
		"$_devmods_dir"/sound/soc/codecs/snd-soc-mt6369.ko \
		"$_devmods_dir"/sound/soc/mediatek/mt6878/snd-soc-mt6878-afe.ko \
		"$_devmods_dir"/sound/soc/mediatek/mt6878/mt6878-mt6369.ko; do
		install -Dm644 "$_module" "$_extra/${_module##*/}"
	done
	depmod -b "$pkgdir" "$_release"

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

_connectivity() {
	pkgdesc="Nothing Tetris MT6878/MT6631 vendor connectivity modules"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove "lib/modules/*/extra/mediatek-connectivity"
}

_pmic() {
	pkgdesc="Nothing Tetris MT6369 ADC and efuse calibration modules"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove "lib/modules/*/extra/mediatek-pmic"
}

_audio() {
	pkgdesc="Nothing Tetris MT6878 vendor ASoC modules"
	depends="
		$pkgname=$pkgver-r$pkgrel
		$pkgname-pmic=$pkgver-r$pkgrel
	"

	amove "lib/modules/*/extra/mediatek-audio"
}

