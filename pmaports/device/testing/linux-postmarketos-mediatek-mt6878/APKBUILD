maintainer="BotchedRPR <igor.belwon@mentallysanemainliners.org>"
pkgname=linux-postmarketos-mediatek-mt6878
pkgver=6.18
pkgrel=61
pkgdesc="Mainline Linux kernel for MediaTek MT6878 devices"
arch="aarch64"
_carch="arm64"
_flavor="postmarketos-mediatek-mt6878"
url="https://github.com/MT6878-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native pmb:kconfigcheck-community"
makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	flex
	lld
	llvm
	openssl-dev
	perl
	python3
"

_repository="linux"
_commit="d84b264a54a37611f2f46bc19363cb9b41606205"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/MT6878-mainline/$_repository/archive/$_commit.tar.gz
	$_config
	0001-arm64-dts-mt6878-nothing-tetris-add-FT3519-touch.patch
	0002-input-touchscreen-add-focaltech-ft3519t.patch
	0003-mt6878-add-mt6369-spmi-pmic.patch
	0011-arm64-dts-mt6878-nothing-tetris-add-disabled-peripherals.patch
	0012-drm-sysfb-add-full-frame-update-quirk.patch
	0013-drm-sysfb-flush-inherited-framebuffer-cache.patch
	0014-drm-sysfb-limit-cache-clean-to-damage.patch
	0015-drm-sysfb-use-iomem-copy-for-tetris.patch
	0016-mt6878-add-mt6363-keys-and-mt6375-telemetry.patch
	0025-pinctrl-mediatek-mt6878-fill-eint-table-holes.patch
	0029-power-supply-mt6375-add-read-only-monitor.patch
	0030-regulator-mt6363-add-connectivity-rails.patch
	0032-power-supply-mt6375-register-monitor-on-platform-bus.patch
	0033-asoc-aw88261-identify-tetris-speaker-amp.patch
	0034-clk-mediatek-mt6878-add-mfg-plls.patch
	0035-input-rt6010-haptics.patch
	0036-arm64-dts-mt6878-tetris-enable-rt6010-haptics.patch
	0037-clk-mediatek-mt6878-audiosys.patch
	0038-arm64-dts-mt6878-tetris-add-rt1711h-typec-inventory.patch
	0039-usb-typec-mt6375-tcpc.patch
	0040-soc-mediatek-mt6878-add-consys-bringup-driver.patch
"
builddir="$srcdir/$_repository-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	make -j"$_jobs" ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor" \
		Image.gz modules \
		mediatek/mt6878-nothing-tetris.dtb
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
				   "$pkgdir/boot/vmlinuz"

	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	make -j"$_jobs" modules_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		LLVM=1
	install -Dm644 "$builddir/arch/$_carch/boot/dts/mediatek/mt6878-nothing-tetris.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6878-nothing-tetris.dtb"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

