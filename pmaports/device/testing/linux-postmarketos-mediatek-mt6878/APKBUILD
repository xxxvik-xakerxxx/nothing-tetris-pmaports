_vendor_kcflags() {
	printf '%s' \
		'-DCONFIG_MTK_COMBO_CHIP_CONSYS_6878=1 ' \
		'-Wno-error=format ' \
		'-Wno-error=format-extra-args ' \
		'-Wno-error=missing-prototypes'
}

_connectivity_make() {
	_moddir="$1"
	shift

	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	make -j"$_jobs" -C "$builddir" M="$_moddir" \
		ARCH="$_carch" LLVM=1 \
		KERNEL_SRC="$builddir" \
		KERNEL_OUT="$builddir" \
		KO_CODE_PATH="$_moddir" \
		DEVICE_MODULES_PATH="$_devmods_dir" \
		TOP="$_android_top" \
		MTK_PLATFORM=mt6878 \
		MTK_PLATFORM_WMT=mt6878 \
		CONFIG_MTK_PLATFORM=mt6878 \
		TARGET_BOARD_PLATFORM_WMT=mt6878 \
		TARGET_BUILD_VARIANT=user \
		CONFIG_ARM64=y \
		CONFIG_MTK_COMBO=y \
		CONFIG_MTK_COMBO_WIFI=m \
		CONFIG_MTK_COMBO_CHIP_CONSYS_6878=y \
		CONFIG_MTK_COMBO_WIFI_HIF=axi \
		CONFIG_MTK_BTIF=n \
		CONFIG_MTK_CONNINFRA=m \
		CONFIG_CONNINFRA_PLAT_BUILD_MODE=module \
		CONFIG_WLAN_DRV_BUILD_IN=n \
		MTK_CONSYS_ADIE=MT6631 \
		KCFLAGS="$(_vendor_kcflags)" \
		"$@" modules
}

_build_connectivity_modules() {
	_conn="$_connmods_dir"/connectivity
	_connadp="$_devmods_dir"/drivers/misc/mediatek/connectivity
	_symbols=""

	_connectivity_make "$_connadp" \
		CONFIG_MTK_COMBO=m \
		CONFIG_WLAN_DRV_BUILD_IN=n
	_symbols="$_connadp/Module.symvers"

	_connectivity_make "$_conn"/conninfra KBUILD_EXTRA_SYMBOLS="$_symbols"
	_symbols="$_symbols $_conn/conninfra/Module.symvers"

	_connectivity_make "$_conn"/connfem KBUILD_EXTRA_SYMBOLS="$_symbols"
	_symbols="$_symbols $_conn/connfem/Module.symvers"

	_connectivity_make "$_conn"/wlan/adaptor \
		CONNAC_VER=2_0 \
		MODULE_NAME=wmtWifi \
		KBUILD_EXTRA_SYMBOLS="$_symbols"
	_symbols="$_symbols $_conn/wlan/adaptor/Module.symvers"

	_connectivity_make "$_conn"/wlan/core/gen4m \
		MODULE_NAME=wlan_drv_gen4m_6878 \
		WLAN_CHIP_ID=6878 \
		MTK_COMBO_CHIP=CONNAC2X2_SOC7_0 \
		WIFI_IP_SET=1 \
		MTK_ANDROID_WMT=y \
		MTK_ANDROID_EMI=n \
		CONFIG_MTK_CONNSYS_DEDICATED_LOG_PATH=y \
		CONFIG_MTK_WIFI_POWER_THROTTLING=n \
		CONFIG_MODIFY_TX_POWER_BY_BAT_VOLT=n \
		KBUILD_EXTRA_SYMBOLS="$_symbols"
	_symbols="$_symbols $_conn/wlan/core/gen4m/Module.symvers"

	_connectivity_make "$_conn"/bt/mt66xx/6878 \
		BT_PLATFORM=6878 \
		LOG_TAG=bt_drv_6878 \
		USE_DEVICE_NODE=0 \
		KBUILD_EXTRA_SYMBOLS="$_symbols"

	_connectivity_make "$_conn"/gps/data_link/plat/v051 \
		CONFIG_MTK_GPS_SUPPORT=y \
		KBUILD_EXTRA_SYMBOLS="$_symbols"
	CC="${HOSTCC:-cc}" \
		sh "$_conn"/gps/data_link/tests/run_gpsdl_v051_abi_test.sh
}

