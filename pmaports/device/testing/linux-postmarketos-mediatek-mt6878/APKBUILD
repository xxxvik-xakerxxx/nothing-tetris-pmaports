	_pmic="$_devmods_dir"/drivers

	_pmic_make "$_pmic"/iio/adc \
		CONFIG_MEDIATEK_SPMI_PMIC_ADC=m
	_pmic_make "$_pmic"/nvmem \
		CONFIG_MT635X_EFUSE=m
}

