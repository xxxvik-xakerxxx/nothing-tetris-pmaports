_build_ccci_modem_common_compile_only() {
	_moddir="$_devmods_dir"/drivers/misc/mediatek/eccci
	_hifdir="$_moddir"/hif
	_fsmdir="$_moddir"/fsm
	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"

	test -s "$builddir"/Module.symvers || \
		die "CCCI modem common validation requires the fully built kernel Module.symvers"
	make -j"$_jobs" -C "$builddir" M="$_moddir" \
		ARCH="$_carch" LLVM=1 \
		KERNEL_SRC="$builddir" \
		KERNEL_OUT="$builddir" \
		DEVICE_MODULES_PATH="$_devmods_dir" \
		CONFIG_ARM64=y \
		CONFIG_MTK_ECCCI_DRIVER=m \
		CONFIG_MTK_SECURITY_SW_SUPPORT=n \
		CONFIG_MTK_SEC_MODEM_NVRAM_ANTI_CLONE=n \
		CONFIG_MTK_AEE_IPANIC=n \
		KCFLAGS="-Werror=implicit-function-declaration \
			-Werror=incompatible-pointer-types \
			-Werror=int-conversion \
			$(_vendor_kcflags)" \
		ccci_modem.o hif/ccci_hif.o fsm/ap_md_mem.o

	for _object in \
		"$_moddir"/ccci_modem.o \
		"$_hifdir"/ccci_hif.o \
		"$_fsmdir"/ap_md_mem.o; do
		test -s "$_object" || \
			die "CCCI modem common compile-only object is missing: ${_object##*/}"
	done
	llvm-nm --defined-only "$_moddir"/ccci_modem.o | \
		grep -Eq '[[:space:]]ccci_get_per_md_data$' || \
		die "CCCI modem registry symbol is missing"
	llvm-nm --defined-only "$_hifdir"/ccci_hif.o | \
		grep -Eq '[[:space:]]ccci_hif_register$' || \
		die "CCCI common HIF registration symbol is missing"
	llvm-nm --defined-only "$_fsmdir"/ap_md_mem.o | \
		grep -Eq '[[:space:]]ap_md_mem_init$' || \
		die "CCCI AP/MD memory initialization symbol is missing"
	if find "$_moddir" -name '*.ko' -print -quit | grep -q .; then
		die "CCCI modem common compile-only validation emitted a loadable module"
	fi
}

_build_ccci_fsm_port_dpmaif_compile_only() {
	_moddir="$_devmods_dir"/drivers/misc/mediatek/eccci
	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"

	test -s "$builddir"/Module.symvers || \
		die "CCCI FSM/port/DPMAIF validation requires the fully built kernel Module.symvers"
	make -j"$_jobs" -C "$builddir" M="$_moddir" \
		ARCH="$_carch" LLVM=1 \
		KERNEL_SRC="$builddir" KERNEL_OUT="$builddir" \
		DEVICE_MODULES_PATH="$_devmods_dir" \
		CONFIG_ARM64=y CONFIG_MTK_ECCCI_DRIVER=m CONFIG_PAGE_POOL=n \
		CONFIG_MTK_SECURITY_SW_SUPPORT=n \
		CONFIG_MTK_SEC_MODEM_NVRAM_ANTI_CLONE=n CONFIG_MTK_AEE_IPANIC=n \
		KCFLAGS="-Werror=implicit-function-declaration \
			-Werror=incompatible-pointer-types \
			-Werror=int-conversion \
			$(_vendor_kcflags)" \
		fsm/ccci_fsm.o fsm/ccci_fsm_ioctl.o \
		fsm/ccci_fsm_monitor.o fsm/ccci_fsm_poller.o \
		fsm/ccci_fsm_ee.o fsm/ccci_fsm_sys.o \
		fsm/mdee_dumper_v1.o fsm/mdee_dumper_v2.o \
		fsm/mdee_dumper_v3.o fsm/mdee_dumper_v5.o \
		fsm/mdee_dumper_v6.o fsm/modem_sys1.o \
		fsm/md_sys1_platform.o fsm/ap_md_reg_dump.o \
		port/port_cfg.o port/port_char.o port/port_ctlmsg.o \
		port/port_udc.o port/port_ipc.o port/port_net.o \
		port/port_poller.o port/port_proxy.o port/port_rpc.o \
		port/port_smem.o port/port_sysmsg.o port/ccci_swtp.o \
		port/port_kernel_interface.o \
		hif/net_pool.o hif/md_spd_dvfs_fn.o \
		hif/md_spd_dvfs_method.o hif/net_speed.o \
		hif/ccci_dpmaif_com.o hif/ccci_dpmaif_bat.o \
		hif/ccci_dpmaif_debug.o hif/ccci_dpmaif_resv_mem.o \
		hif/ccci_dpmaif_drv_com.o hif/ccci_dpmaif_drv_v1.o \
		hif/ccci_dpmaif_drv_v2.o hif/ccci_dpmaif_drv_v3.o

	test "$(find "$_moddir"/fsm -maxdepth 1 -name '*.o' -type f | wc -l)" -eq 15 || \
		die "CCCI FSM compile-only object closure is incomplete"
	test "$(find "$_moddir"/port -maxdepth 1 -name '*.o' -type f | wc -l)" -eq 13 || \
		die "CCCI port compile-only object closure is incomplete"
	test "$(find "$_moddir"/hif -maxdepth 1 \
		\( -name 'ccci_dpmaif*.o' -o -name 'net_pool.o' \
		-o -name 'net_speed.o' -o -name 'md_spd_dvfs_*.o' \) \
		-type f | wc -l)" -eq 12 || \
		die "CCCI DPMAIF compile-only object closure is incomplete"
	llvm-nm --defined-only "$_moddir"/fsm/ccci_fsm.o | \
		grep -Eq '[[:space:]]ccci_fsm_init$' || \
		die "CCCI FSM initialization symbol is missing"
	llvm-nm --defined-only "$_moddir"/port/port_proxy.o | \
		grep -Eq '[[:space:]]ccci_port_init$' || \
		die "CCCI port initialization symbol is missing"
	llvm-nm --defined-only "$_moddir"/hif/ccci_dpmaif_drv_v3.o | \
		grep -Eq '[[:space:]]ccci_dpmaif_drv3_init$' || \
		die "CCCI DPMAIF v3 initialization symbol is missing"
	if find "$_moddir" -name '*.ko' -print -quit | grep -q .; then
		die "CCCI FSM/port/DPMAIF compile-only validation emitted a loadable module"
	fi
}

_build_mt6375_bc12_compile_only() {
	_decode_object="$builddir/drivers/power/supply/mt6375-bc12-decode.o"
	_lifecycle_object="$builddir/drivers/power/supply/mt6375-bc12-lifecycle.o"
	_test_source="$builddir/tools/testing/selftests/power_supply/mt6375-bc12-lifecycle-test.c"
	_test_binary="$builddir/tools/testing/selftests/power_supply/mt6375-bc12-lifecycle-test"
	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"

	rm -f "$_decode_object" "$_lifecycle_object" "$_test_binary" \
		"$builddir/drivers/power/supply/mt6375-bc12-decode.ko" \
		"$builddir/drivers/power/supply/mt6375-bc12-lifecycle.ko"
	make -j"$_jobs" -C "$builddir" \
		ARCH="$_carch" LLVM=1 \
		drivers/power/supply/mt6375-bc12-decode.o \
		drivers/power/supply/mt6375-bc12-lifecycle.o

	test -s "$_decode_object" || die "MT6375 BC1.2 decoder object is missing"
	test -s "$_lifecycle_object" || \
		die "MT6375 BC1.2 lifecycle object is missing"
	test ! -e "$builddir/drivers/power/supply/mt6375-bc12-decode.ko" || \
		die "MT6375 BC1.2 validation must not produce a module"
	test ! -e "$builddir/drivers/power/supply/mt6375-bc12-lifecycle.ko" || \
		die "MT6375 BC1.2 lifecycle validation must not produce a module"
	llvm-nm --defined-only "$_decode_object" | \
		grep -Eq '[[:space:]]mt6375_bc12_decode_port_stat$' || \
		die "MT6375 BC1.2 decoder symbol is missing"
	llvm-nm --defined-only "$_lifecycle_object" | \
		grep -Eq '[[:space:]]mt6375_bc12_check_timeout$' || \
		die "MT6375 BC1.2 bounded-timeout symbol is missing"
	llvm-nm --defined-only "$_lifecycle_object" | \
		grep -Eq '[[:space:]]mt6375_bc12_cleanup_result$' || \
		die "MT6375 BC1.2 retryable-cleanup symbol is missing"
	test -z "$(llvm-nm --undefined-only "$_decode_object")" || \
		die "MT6375 BC1.2 decoder must not acquire runtime dependencies"
	test -z "$(llvm-nm --undefined-only "$_lifecycle_object")" || \
		die "MT6375 BC1.2 lifecycle must not acquire runtime dependencies"

	clang -std=c11 -Wall -Wextra -Werror "$_test_source" -o "$_test_binary"
	"$_test_binary" || die "MT6375 BC1.2 lifecycle host tests failed"
}

_build_pd9302a_compile_only() {
	_object="$builddir/drivers/media/i2c/pd9302a.o"
	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"

	make -j"$_jobs" -C "$builddir" \
		ARCH="$_carch" LLVM=1 \
		CONFIG_MEDIA_SUPPORT=y \
		CONFIG_MEDIA_CAMERA_SUPPORT=y \
		CONFIG_MEDIA_CONTROLLER=y \
		CONFIG_VIDEO_DEV=y \
		CONFIG_VIDEO_V4L2_SUBDEV_API=y \
		CONFIG_VIDEO_CAMERA_LENS=y \
		CONFIG_VIDEO_PD9302A=m \
		drivers/media/i2c/pd9302a.o

	test -s "$_object" || die "PD9302A compile-only object is missing"
	test ! -e "$builddir/drivers/media/i2c/pd9302a.ko" || \
		die "PD9302A compile-only validation must not produce a module"
}

_build_imx882_identity_compile_only() {
	_object="$builddir/drivers/media/i2c/imx882-identity.o"
	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"

	if grep -Eq '^CONFIG_VIDEO_IMX882_IDENTITY=(y|m)$' .config; then
		die "IMX882 identity probe must stay disabled in the shipped kernel"
	fi
	make -j"$_jobs" -C "$builddir" \
		ARCH="$_carch" LLVM=1 \
		CONFIG_I2C=y \
		CONFIG_OF=y \
		CONFIG_GPIOLIB=y \
		CONFIG_COMMON_CLK=y \
		CONFIG_REGULATOR=y \
		CONFIG_PINCTRL=y \
		CONFIG_VIDEO_IMX882_IDENTITY=m \
		drivers/media/i2c/imx882-identity.o

	test -s "$_object" || die "IMX882 identity compile-only object is missing"
	test ! -e "$builddir/drivers/media/i2c/imx882-identity.ko" || \
		die "IMX882 identity validation must not produce a module"
}

_build_tetris_camera_audit_compile_only() {
	_moddir="$_connmods_dir"/mtkcam/tetris-audit
	_object="$_moddir"/tetris-camera-audit.o
	_camera="$_connmods_dir"/mtkcam
	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"

	make -j"$_jobs" -C "$builddir" M="$_moddir" \
		ARCH="$_carch" LLVM=1 \
		KERNEL_SRC="$builddir" \
		KERNEL_OUT="$builddir" \
		DEVICE_MODULES_PATH="$_devmods_dir" \
		tetris-camera-audit.o

	test -s "$_object" || die "Tetris camera audit object is missing"
	test ! -e "$_moddir"/tetris-camera-audit.ko || \
		die "Tetris camera audit must not produce a module"

	for _variant in \
		imx882_mipi_raw imx882txd_mipi_raw \
		gc16b3c_mipi_raw gc16b3ctxd_mipi_raw \
		sc202cs_mipi_raw sc202cssj_mipi_raw; do
		test -s "$_camera/imgsensor/src-v4l2/common/$_variant/Makefile" || \
			die "missing Tetris sensor variant: $_variant"
	done
	for _layout in \
		imx882_mtk_eeprom imx882txd_mtk_eeprom \
		gc16b3c_mtk_eeprom gc16b3ctxd_mtk_eeprom; do
		_layout_file="$_camera/cam_cal/src_v4l2/custom/layout/$_layout.c"
		test -s "$_layout_file" || \
			die "missing Tetris cam_cal layout: $_layout"
		grep -Fq '.i2c_write_id = 0xA0' "$_layout_file"
		grep -Fq '.max_size = 0x4000' "$_layout_file"
		grep -Fq '.preload_size = 0x1500' "$_layout_file"
	done

	test ! -e "$_camera/cam_cal/src_v4l2/custom/layout/sc202cs_mtk_eeprom.c" || \
		die "unexpected SC202CS cam_cal layout needs source review"
	test ! -e "$_camera/cam_cal/src_v4l2/custom/layout/sc202cssj_mtk_eeprom.c" || \
		die "unexpected SC202CSSJ cam_cal layout needs source review"
	grep -Fq '#ifdef CAMSYS_ISP7SP_MT6878' \
		"$_camera/camsys/isp7sp/cam/mtk_cam.c"
	grep -Fq 'struct camsys_platform_data mt6878_data' \
		"$_camera/camsys/isp7sp/cam/mtk_cam-plat-mt6878.c"
}

build() {
	unset LDFLAGS
	export PATH="/usr/lib/llvm21/bin:$PATH"
	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	make -j"$_jobs" ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor" \
		Image.gz modules \
		mediatek/mt6878-nothing-tetris-native.dtb
	grep -q 'clang version 21' include/generated/compile.h || \
		die "kernel must be built with the hardware-tested LLVM 21 toolchain"
	_build_tetris_camera_audit_compile_only
	_build_imx882_identity_compile_only
	_build_pd9302a_compile_only
	_build_ccci_util_compile_only
	_build_ccci_core_compile_only
	_build_ccci_ccif_compile_only
	_build_ccci_modem_common_compile_only
	_build_ccci_fsm_port_dpmaif_compile_only
	_build_mt6375_bc12_compile_only
	_build_pmic_modules
	_build_connectivity_modules
	_build_audio_modules
	_build_sensor_modules
}

package() {
	export PATH="/usr/lib/llvm21/bin:$PATH"
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
				   "$pkgdir/boot/vmlinuz"

	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	make -j"$_jobs" modules_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		LLVM=1
	if find "$pkgdir/lib/modules" -name 'clk-mt6878-cam.ko*' \
		-print -quit | grep -q .; then
		die "compile-only MT6878 camera clock module must not be packaged"
	fi
	install -Dm644 "$builddir/arch/$_carch/boot/dts/mediatek/mt6878-nothing-tetris-native.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6878-nothing-tetris-native.dtb"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	_release="$(cat "$builddir"/include/config/kernel.release)"
	_extra="$pkgdir/lib/modules/$_release/extra/mediatek-pmic"
	for _module in \
		"$_devmods_dir"/drivers/iio/adc/mtk-spmi-pmic-adc.ko \
		"$_devmods_dir"/drivers/nvmem/nvmem-mt635x-efuse.ko; do
		install -Dm644 "$_module" "$_extra/${_module##*/}"
	done
	_extra="$pkgdir/lib/modules/$_release/extra/mediatek-connectivity"
	for _module in \
		"$_devmods_dir"/drivers/misc/mediatek/connectivity/connadp.ko \
		"$_connmods_dir"/connectivity/conninfra/conninfra.ko \
		"$_connmods_dir"/connectivity/connfem/connfem.ko \
		"$_connmods_dir"/connectivity/wlan/adaptor/wmtWifi.ko \
		"$_connmods_dir"/connectivity/wlan/core/gen4m/wlan_drv_gen4m_6878.ko \
		"$_connmods_dir"/connectivity/bt/mt66xx/6878/bt_drv_6878.ko \
		"$_connmods_dir"/connectivity/gps/data_link/plat/v051/gps_drv_dl_v051.ko; do
		install -Dm644 "$_module" "$_extra/${_module##*/}"
	done
	_extra="$pkgdir/lib/modules/$_release/extra/mediatek-audio"
	for _module in \
		"$_devmods_dir"/drivers/mfd/mt6685-core.ko \
		"$_devmods_dir"/drivers/mfd/mt6685-audclk.ko \
		"$_devmods_dir"/sound/soc/mediatek/common/snd-soc-mtk-common.ko \
		"$_devmods_dir"/sound/soc/mediatek/common/mtk-afe-external.ko \
		"$_devmods_dir"/sound/soc/mediatek/common/mtk-sp-spk-amp.ko \
		"$_devmods_dir"/sound/soc/codecs/snd-soc-mt6369.ko \
		"$_devmods_dir"/sound/soc/mediatek/mt6878/snd-soc-mt6878-afe.ko \
		"$_devmods_dir"/sound/soc/mediatek/mt6878/mt6878-mt6369.ko; do
		install -Dm644 "$_module" "$_extra/${_module##*/}"
	done
	_extra="$pkgdir/lib/modules/$_release/extra/mediatek-sensors"
	for _module in \
		"$_devmods_dir"/drivers/soc/mediatek/mtk-mbox.ko \
		"$_devmods_dir"/drivers/rpmsg/mtk_rpmsg_mbox.ko \
		"$_devmods_dir"/drivers/soc/mediatek/mtk_tinysys_ipi.ko \
		"$_devmods_dir"/drivers/misc/mediatek/scp/rv/scp.ko \
		"$_devmods_dir"/drivers/misc/mediatek/sensor/2.0/core/hf_manager.ko \
		"$_devmods_dir"/drivers/misc/mediatek/sensor/2.0/sensorhub/sensorhub.ko; do
		install -Dm644 "$_module" "$_extra/${_module##*/}"
	done
	depmod -b "$pkgdir" "$_release"

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

