_build_camera_clk_compile_only() (
	_out=$(mktemp -d "$srcdir/mt6878-camera-clk.XXXXXX")
	trap 'rm -rf "$_out"' EXIT
	_jobs="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)}"
	_config_file="$srcdir/config-$_flavor.$arch"

	grep -Fxq '# CONFIG_COMMON_CLK_MT6878_CAM is not set' "$_config_file"
	if grep -Eq '^CONFIG_COMMON_CLK_MT6878_CAM=[ym]$' "$_config_file"; then
		die "MT6878 camera clock provider must stay disabled in the package"
	fi

	cp "$_config_file" "$_out/.config"
	"$builddir/scripts/config" --file "$_out/.config" \
		-e COMMON_CLK_MT6878 \
		-m COMMON_CLK_MT6878_CAM
	make -j"$_jobs" -C "$builddir" O="$_out" \
		ARCH="$_carch" LLVM=1 olddefconfig
	make -j"$_jobs" -C "$builddir" O="$_out" \
		ARCH="$_carch" LLVM=1 \
		drivers/clk/mediatek/clk-mt6878-cam.o

	test -s "$_out/drivers/clk/mediatek/clk-mt6878-cam.o" || \
		die "MT6878 camera clock compile-only object is missing"
	test ! -e "$_out/drivers/clk/mediatek/clk-mt6878-cam.ko" || \
		die "MT6878 camera clock gate must not produce a module"
)

