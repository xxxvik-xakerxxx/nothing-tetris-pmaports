From: Tetris port maintainers
Subject: [PATCH] eccci: use the Linux 6.18 timer container API in CLDMA

The full module build reaches CLDMA, unlike the earlier object-only gate.
Use the same timer_container_of conversion already applied to CCIF. The
callback, enclosing object and timer member are unchanged.

diff --git a/drivers/misc/mediatek/eccci/hif/ccci_hif_cldma.c b/drivers/misc/mediatek/eccci/hif/ccci_hif_cldma.c
--- a/drivers/misc/mediatek/eccci/hif/ccci_hif_cldma.c
+++ b/drivers/misc/mediatek/eccci/hif/ccci_hif_cldma.c
@@ -516,7 +516,8 @@ void md_cd_traffic_monitor_func(struct timer_list *t)
 {
 	int i;
 	//struct md_cd_ctrl *md_ctrl = (struct md_cd_ctrl *)data;
-	struct md_cd_ctrl *md_ctrl = from_timer(md_ctrl, t, traffic_monitor);
+	struct md_cd_ctrl *md_ctrl =
+		timer_container_of(md_ctrl, t, traffic_monitor);
 
 	struct ccci_hif_traffic *tinfo = &md_ctrl->traffic_info;
 	unsigned long q_rx_rem_nsec[CLDMA_RXQ_NUM] = {0};
