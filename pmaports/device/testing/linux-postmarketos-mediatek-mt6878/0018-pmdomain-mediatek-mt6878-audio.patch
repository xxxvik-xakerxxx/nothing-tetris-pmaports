From: xxxvik-xakerxxx <xxxviktor.lyskoxxx@gmail.com>
Subject: [PATCH] pmdomain: mediatek: add the MT6878 audio domain

Describe the MT6878 audio power domain and attach the AFE to it. The
register layout and protection bit follow the Nothing OS 4.1 Tetris power
controller data; exposing the domain lets runtime PM sequence audiosys
without relying on bootloader state.

--- a/arch/arm64/boot/dts/mediatek/mt6878.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6878.dtsi
@@ -10,5 +10,6 @@
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/phy/phy.h>
+#include <dt-bindings/power/mediatek,mt6878-power.h>
 #include <dt-bindings/reset/ti-syscon.h>
 #include "mt6878-pinfunc.h"
 
@@ -397,13 +398,18 @@
 		};
 
 		audiosys: syscon@11050000 {
-			compatible = "mediatek,mt6878-audiosys", "syscon";
+			compatible = "mediatek,mt6878-audiosys", "syscon", "simple-mfd";
 			reg = <0x11050000 0x9000>;
 			#clock-cells = <1>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0 0x11050000 0x9000>;
 
-			afe: audio-controller {
+			afe: audio-controller@0 {
 				compatible = "mediatek,mt6878-sound", "mediatek,mt6878-afe";
+				reg = <0 0x9000>;
 				interrupts = <GIC_SPI 392 IRQ_TYPE_LEVEL_HIGH 0>;
+				power-domains = <&spm MT6878_POWER_DOMAIN_AUDIO>;
 				clocks = <&audiosys CLK_AFE_AUDIO_HOPPING>,
 					 <&audiosys CLK_AFE_AUDIO_F26M>,
 					 <&audiosys CLK_AFE_DL0_DAC>,
@@ -739,6 +746,26 @@
 			};
 		};
 
+		scpsys: syscon@1c001000 {
+			compatible = "mediatek,mt6878-scpsys", "syscon", "simple-mfd";
+			reg = <0x1c001000 0x1000>;
+
+			spm: power-controller {
+				compatible = "mediatek,mt6878-power-controller";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				#power-domain-cells = <1>;
+				access-controllers = <&infracfg_ao>;
+
+				power-domain@MT6878_POWER_DOMAIN_AUDIO {
+					reg = <MT6878_POWER_DOMAIN_AUDIO>;
+					clocks = <&topckgen CLK_TOP_AUD_INTBUS_SEL>;
+					clock-names = "audio";
+					#power-domain-cells = <0>;
+				};
+			};
+		};
+
 		watchdog: watchdog@1c00a000 {
 			compatible = "mediatek,mt6878-wdt",
 				     "mediatek,mt6589-wdt",
--- a/drivers/pmdomain/mediatek/mtk-pm-domains.c
+++ b/drivers/pmdomain/mediatek/mtk-pm-domains.c
@@ -18,6 +18,7 @@
 
 #include "mt6735-pm-domains.h"
 #include "mt6795-pm-domains.h"
+#include "mt6878-pm-domains.h"
 #include "mt6893-pm-domains.h"
 #include "mt8167-pm-domains.h"
 #include "mt8173-pm-domains.h"
@@ -936,6 +937,10 @@
 		.compatible = "mediatek,mt6795-power-controller",
 		.data = &mt6795_scpsys_data,
 	},
+	{
+		.compatible = "mediatek,mt6878-power-controller",
+		.data = &mt6878_scpsys_data,
+	},
 	{
 		.compatible = "mediatek,mt6893-power-controller",
 		.data = &mt6893_scpsys_data,
--- /dev/null
+++ b/drivers/pmdomain/mediatek/mt6878-pm-domains.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __PMDOMAIN_MEDIATEK_MT6878_PM_DOMAINS_H
+#define __PMDOMAIN_MEDIATEK_MT6878_PM_DOMAINS_H
+
+#include <dt-bindings/power/mediatek,mt6878-power.h>
+
+#include "mtk-pm-domains.h"
+
+#define MT6878_PERI_PROT_AUDIO		BIT(6)
+#define MT6878_PERI_PROT_SET		0x0c84
+#define MT6878_PERI_PROT_CLR		0x0c88
+#define MT6878_PERI_PROT_STA		0x0c8c
+
+static enum scpsys_bus_prot_block scpsys_bus_prot_blocks_mt6878[] = {
+	BUS_PROT_BLOCK_INFRA,
+};
+
+static const struct scpsys_domain_data
+scpsys_domain_data_mt6878[MT6878_POWER_DOMAIN_NR] = {
+	[MT6878_POWER_DOMAIN_AUDIO] = {
+		.name = "audio",
+		.sta_mask = GENMASK(31, 30),
+		.ctl_offs = 0x0e18,
+		.pwr_sta_offs = 0x0e18,
+		.pwr_sta2nd_offs = 0x0e18,
+		.sram_pdn_bits = BIT(8),
+		.sram_pdn_ack_bits = BIT(12),
+		.bp_cfg = {
+			BUS_PROT_WR_IGN(INFRA, MT6878_PERI_PROT_AUDIO,
+					MT6878_PERI_PROT_SET,
+					MT6878_PERI_PROT_CLR,
+					MT6878_PERI_PROT_STA),
+		},
+		.caps = MTK_SCPD_STATUS_IN_CTL,
+	},
+};
+
+static const struct scpsys_soc_data mt6878_scpsys_data = {
+	.domains_data = scpsys_domain_data_mt6878,
+	.num_domains = ARRAY_SIZE(scpsys_domain_data_mt6878),
+	.bus_prot_blocks = scpsys_bus_prot_blocks_mt6878,
+	.num_bus_prot_blocks = ARRAY_SIZE(scpsys_bus_prot_blocks_mt6878),
+};
+
+#endif /* __PMDOMAIN_MEDIATEK_MT6878_PM_DOMAINS_H */
--- /dev/null
+++ b/include/dt-bindings/power/mediatek,mt6878-power.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _DT_BINDINGS_POWER_MEDIATEK_MT6878_POWER_H
+#define _DT_BINDINGS_POWER_MEDIATEK_MT6878_POWER_H
+
+#define MT6878_POWER_DOMAIN_MD			0
+#define MT6878_POWER_DOMAIN_CONN		1
+#define MT6878_POWER_DOMAIN_AUDIO		2
+#define MT6878_POWER_DOMAIN_CSI_RX		3
+#define MT6878_POWER_DOMAIN_SSR			4
+#define MT6878_POWER_DOMAIN_SSUSB		5
+#define MT6878_POWER_DOMAIN_MFG0_SHUTDOWN	6
+#define MT6878_POWER_DOMAIN_MM_INFRA		7
+#define MT6878_POWER_DOMAIN_DISP		8
+#define MT6878_POWER_DOMAIN_VEN0		9
+#define MT6878_POWER_DOMAIN_CAM_VCORE		10
+#define MT6878_POWER_DOMAIN_CAM_CCU		11
+#define MT6878_POWER_DOMAIN_CAM_CCU_AO		12
+#define MT6878_POWER_DOMAIN_CAM_MAIN		13
+#define MT6878_POWER_DOMAIN_CAM_SUBA		14
+#define MT6878_POWER_DOMAIN_CAM_SUBB		15
+#define MT6878_POWER_DOMAIN_ISP_VCORE		16
+#define MT6878_POWER_DOMAIN_ISP_MAIN		17
+#define MT6878_POWER_DOMAIN_ISP_DIP1		18
+#define MT6878_POWER_DOMAIN_VDE0		19
+#define MT6878_POWER_DOMAIN_MM_PROC_DORMANT	20
+#define MT6878_POWER_DOMAIN_APU			21
+
+#define MT6878_POWER_DOMAIN_NR			22
+
+#endif /* _DT_BINDINGS_POWER_MEDIATEK_MT6878_POWER_H */
