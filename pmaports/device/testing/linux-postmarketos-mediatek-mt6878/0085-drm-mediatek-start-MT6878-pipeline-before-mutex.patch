From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Wed, 9 Sep 2026 13:30:00 +0300
Subject: [PATCH] drm: mediatek: start MT6878 pipeline before mutex

The MT6878 native pipeline currently enables the display mutex before OVL,
DSC and DSI have been configured and before an active plane is present. That
exposes an empty first SOF to the pipeline. On Nothing Tetris the resulting
cold-start state is persistent: OVL reports valid without ready, DSC reports
abnormal EOF without frame done, and DSI observes a 1x1 input stream.

The NothingOS B4.1 DRM v2 sequence restores the active planes before its
per-frame CMDQ transaction releases the mutex trigger. Match that ordering
for mt6878-mmsys0 while preserving the existing ordering for every other
MediaTek display controller.

Signed-off-by: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
---
 drivers/gpu/drm/mediatek/mtk_crtc.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_crtc.c b/drivers/gpu/drm/mediatek/mtk_crtc.c
index 34ca1c100000..34ca1c100001 100644
--- a/drivers/gpu/drm/mediatek/mtk_crtc.c
+++ b/drivers/gpu/drm/mediatek/mtk_crtc.c
@@ -344,6 +344,7 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 	struct drm_encoder *encoder;
 	struct drm_connector_list_iter conn_iter;
 	const struct drm_dsc_config *dsc = NULL;
+	bool start_before_mutex;
 	unsigned int width, height, vrefresh, bpc = MTK_MAX_BPC;
 	int ret;
 	int i;
@@ -400,7 +401,11 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 	}
 	if (!mtk_ddp_comp_add(mtk_crtc->ddp_comp[i], mtk_crtc->mutex))
 		mtk_mutex_add_comp(mtk_crtc->mutex, mtk_crtc->ddp_comp[i]->id);
-	mtk_mutex_enable(mtk_crtc->mutex);
+	start_before_mutex =
+		of_device_is_compatible(mtk_crtc->mmsys_dev->of_node,
+					"mediatek,mt6878-mmsys0");
+	if (!start_before_mutex)
+		mtk_mutex_enable(mtk_crtc->mutex);
 
 	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
 		if (mtk_crtc->ddp_comp[i]->id == DDP_COMPONENT_DSI0) {
@@ -429,14 +434,19 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 
 		plane_state = to_mtk_plane_state(plane->state);
 
-		/* should not enable layer before crtc enabled */
-		plane_state->pending.enable = false;
+		/* MT6878 must present the active plane before its first SOF. */
+		if (!start_before_mutex)
+			plane_state->pending.enable = false;
 		comp = mtk_ddp_comp_for_plane(crtc, plane, &local_layer);
 		if (comp)
 			mtk_ddp_comp_layer_config(comp, local_layer,
 						  plane_state, NULL);
 	}
 
+	/* Release MT6878 only after the first complete scanout is configured. */
+	if (start_before_mutex)
+		mtk_mutex_enable(mtk_crtc->mutex);
+
 	return 0;
 
 err_mutex_unprepare:
