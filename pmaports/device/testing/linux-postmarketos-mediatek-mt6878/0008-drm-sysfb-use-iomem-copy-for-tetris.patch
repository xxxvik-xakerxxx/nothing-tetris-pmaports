From 0000000000000000000000000000000000000015 Mon Sep 17 00:00:00 2001
From: postmarketOS Porting <porting@localhost>
Date: Sat, 25 Jul 2026 22:30:00 +0300
Subject: [PATCH] drm/sysfb: use iomem copy for Tetris

Cacheable mappings and explicit cache cleaning reset the Nothing Tetris
before userspace starts. Keep the framebuffer write-combined, but mark
the mapping as I/O memory so drm_fb_blit uses the memcpy_toio path
instead of ordinary memcpy.
---
 arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts |  2 +-
 drivers/gpu/drm/sysfb/drm_sysfb_helper.h               |  1 +
 drivers/gpu/drm/sysfb/simpledrm.c                      | 27 +++++++++++++++++++--------
 3 files changed, 21 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts
--- a/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts
@@ -34,7 +34,7 @@
 			stride = <(1088 * 4)>;
 			format = "a8r8g8b8";
 			panel = <&fb_panel>;
-			linux,force-full-frame-updates;
+			linux,force-iomem-updates;
 
 			fb_panel: fb-panel {
 				width-mm = <75>;
diff --git a/drivers/gpu/drm/sysfb/drm_sysfb_helper.h b/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
--- a/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
+++ b/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
@@ -82,6 +82,7 @@ struct drm_sysfb_device {
 	unsigned int fb_gamma_lut_size;
 	bool force_full_frame_updates;
 	bool flush_framebuffer_cache;
+	bool force_iomem_updates;
 	phys_addr_t fb_phys;
 	size_t fb_size;
 
diff --git a/drivers/gpu/drm/sysfb/simpledrm.c b/drivers/gpu/drm/sysfb/simpledrm.c
--- a/drivers/gpu/drm/sysfb/simpledrm.c
+++ b/drivers/gpu/drm/sysfb/simpledrm.c
@@ -680,8 +680,9 @@ static struct simpledrm_device *simpledrm_device_create(struct drm_driver *drv,
 	sysfb->fb_mode = drm_sysfb_mode(width, height, width_mm, height_mm);
 	sysfb->fb_format = format;
 	sysfb->fb_pitch = stride;
-	sysfb->flush_framebuffer_cache = of_node &&
-		of_property_read_bool(of_node, "linux,force-full-frame-updates");
+	sysfb->force_iomem_updates = of_node &&
+		of_property_read_bool(of_node, "linux,force-iomem-updates");
+	sysfb->force_full_frame_updates = sysfb->force_iomem_updates;
 
 	drm_dbg(dev, "display mode={" DRM_MODE_FMT "}\n", DRM_MODE_ARG(&sysfb->fb_mode));
 	drm_dbg(dev, "framebuffer format=%p4cc, size=%dx%d, stride=%d byte\n",
@@ -702,13 +702,24 @@ static struct simpledrm_device *simpledrm_device_create(struct drm_driver *drv,
 
 		drm_dbg(dev, "using system memory framebuffer at %pr\n", mem);
 
-		screen_base = devm_memremap(dev->dev, mem->start, resource_size(mem),
-					   sysfb->flush_framebuffer_cache ?
-					   MEMREMAP_WB : MEMREMAP_WC);
-		if (IS_ERR(screen_base))
-			return screen_base;
+		if (sysfb->force_iomem_updates) {
+			void __iomem *screen_base_io;
 
-		iosys_map_set_vaddr(&sysfb->fb_addr, screen_base);
+			screen_base_io = devm_ioremap_wc(dev->dev, mem->start,
+							resource_size(mem));
+			if (!screen_base_io)
+				return ERR_PTR(-ENOMEM);
+
+			iosys_map_set_vaddr_iomem(&sysfb->fb_addr, screen_base_io);
+		} else {
+			screen_base = devm_memremap(dev->dev, mem->start,
+						   resource_size(mem), MEMREMAP_WC);
+			if (IS_ERR(screen_base))
+				return screen_base;
+
+			iosys_map_set_vaddr(&sysfb->fb_addr, screen_base);
+		}
+
 		if (sysfb->flush_framebuffer_cache) {
 			sysfb->fb_phys = mem->start;
 			sysfb->fb_size = resource_size(mem);
-- 
2.50.1
