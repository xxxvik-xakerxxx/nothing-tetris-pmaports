+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/nothing,tetris-imx882-identity.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Nothing Tetris IMX882 identity probe
+
+maintainers:
+  - xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
+
+description:
+  Identity-only description of the main IMX882 camera sensor on Nothing
+  Tetris. This binding is limited to a bounded physical ID read and does not
+  describe a media graph or streaming interface.
+
+properties:
+  compatible:
+    const: nothing,tetris-imx882-identity
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: xclk
+
+  afvdd-supply:
+    description: 2.8 V autofocus supply
+
+  avdd-supply:
+    description: 2.8 V analog supply
+
+  dvdd-supply:
+    description: 1.2 V digital core supply
+
+  dovdd-supply:
+    description: 1.8 V digital I/O supply
+
+  reset-gpios:
+    maxItems: 1
+
+  pinctrl-names:
+    items:
+      - const: mclk-off
+      - const: mclk-4ma
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - afvdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - reset-gpios
+  - pinctrl-names
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@1a {
+            compatible = "nothing,tetris-imx882-identity";
+            reg = <0x1a>;
+            clocks = <&camera_clk>;
+            clock-names = "xclk";
+            afvdd-supply = <&camera_afvdd>;
+            avdd-supply = <&camera_avdd>;
+            dvdd-supply = <&camera_dvdd>;
+            dovdd-supply = <&camera_dovdd>;
+            reset-gpios = <&gpio 25 0>;
+            pinctrl-names = "mclk-off", "mclk-4ma";
+            pinctrl-0 = <&camera_mclk_off>;
+            pinctrl-1 = <&camera_mclk_4ma>;
+        };
+    };
+...
 };
 
 &pio {
+	camera_mclk_off: camera-mclk-off {
+		pins {
+			pinmux = <PINMUX_GPIO93__FUNC_GPIO93>;
+			output-low;
+		};
+	};
+
+	camera_mclk_4ma: camera-mclk-4ma {
+		pins {
+			pinmux = <PINMUX_GPIO93__FUNC_CMMCLK1>;
+			drive-strength = <4>;
+		};
+	};
+
 	gps_pins_default: gps-default {
 	};
 
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 78018da..26f35f3 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -775,6 +775,15 @@ config VIDEO_VGXY61
 	  This is a Video4Linux2 sensor driver for the ST VGXY61
 	  camera sensor.
 
+config VIDEO_IMX882_IDENTITY
+	tristate "Nothing Tetris IMX882 identity probe"
+	depends on I2C && OF && GPIOLIB && COMMON_CLK && REGULATOR && PINCTRL
+	help
+	  Build a bounded identity-only probe for the main IMX882 sensor on
+	  Nothing Tetris. The driver powers the sensor only long enough to read
+	  its physical ID, never initializes or streams it, and is intended for
+	  explicitly selected bring-up device trees only.
+
 source "drivers/media/i2c/ccs/Kconfig"
 source "drivers/media/i2c/et8ek8/Kconfig"
 
