diff --git a/drivers/clk/mediatek/Kconfig b/drivers/clk/mediatek/Kconfig
index c3fd34870..8c7166bf6 100644
--- a/drivers/clk/mediatek/Kconfig
+++ b/drivers/clk/mediatek/Kconfig
@@ -382,5 +382,15 @@ config COMMON_CLK_MT6878
 	  This driver supports MediaTek MT6878 basic clocks.
 
+config COMMON_CLK_MT6878_CAM
+	tristate "Clock driver for MediaTek MT6878 camera main system"
+	depends on COMMON_CLK_MT6878
+	help
+	  This driver supports the main camera clock gates on MediaTek MT6878.
+	  The provider covers the interconnect, SENINF and CAMSV gates in the
+	  CAMSYS_MAIN register block. It does not cover RAW, YUV, MRAW, CCU or
+	  camera power domains. Hardware remains idle without a device-tree node
+	  and consumer drivers.
+
 config COMMON_CLK_MT7622
 	tristate "Clock driver for MediaTek MT7622"
 	depends on ARCH_MEDIATEK || COMPILE_TEST
diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index c022506df..b4abe7594 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
@@ -38,2 +38,3 @@
 obj-$(CONFIG_COMMON_CLK_MT2701) += clk-mt2701.o
+obj-$(CONFIG_COMMON_CLK_MT6878_CAM) += clk-mt6878-cam.o
 obj-$(CONFIG_COMMON_CLK_MT2701_AUDSYS) += clk-mt2701-aud.o
diff --git a/drivers/clk/mediatek/clk-mt6878-cam.c b/drivers/clk/mediatek/clk-mt6878-cam.c
new file mode 100644
index 000000000..3f0c80b76
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6878-cam.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2023 MediaTek Inc.
+ * Author: Chuan-wen Chen <chuan-wen.chen@mediatek.com>
+ */
+
+#include <dt-bindings/clock/mediatek,mt6878-clock.h>
+
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include "clk-gate.h"
+#include "clk-mtk.h"
+
+static const struct mtk_gate_regs cam_m0_cg_regs = {
+	.set_ofs = 0x4,
+	.clr_ofs = 0x8,
+	.sta_ofs = 0x0,
+};
+
+static const struct mtk_gate_regs cam_m1_cg_regs = {
+	.set_ofs = 0x50,
+	.clr_ofs = 0x54,
+	.sta_ofs = 0x4c,
+};
+
+#define GATE_CAM_M0(_id, _name, _parent, _shift) \
+	GATE_MTK(_id, _name, _parent, &cam_m0_cg_regs, _shift, \
+		 &mtk_clk_gate_ops_setclr)
+
+#define GATE_CAM_M1(_id, _name, _parent, _shift) \
+	GATE_MTK(_id, _name, _parent, &cam_m1_cg_regs, _shift, \
+		 &mtk_clk_gate_ops_setclr)
+
+static const struct mtk_gate cam_main_clks[] = {
+	GATE_CAM_M0(CLK_CAM_MAIN_LARB13, "cam_main_larb13", "cam_sel", 0),
+	GATE_CAM_M0(CLK_CAM_MAIN_LARB14, "cam_main_larb14", "cam_sel", 1),
+	GATE_CAM_M0(CLK_CAM_MAIN_LARB29, "cam_main_larb29", "cam_sel", 3),
+	GATE_CAM_M0(CLK_CAM_MAIN_CAM, "cam_main_cam", "cam_sel", 4),
+	GATE_CAM_M0(CLK_CAM_MAIN_CAM_SUBA, "cam_main_cam_suba", "cam_sel", 5),
+	GATE_CAM_M0(CLK_CAM_MAIN_CAM_SUBB, "cam_main_cam_subb", "cam_sel", 6),
+	GATE_CAM_M0(CLK_CAM_MAIN_CAM_MRAW, "cam_main_cam_mraw", "cam_sel", 8),
+	GATE_CAM_M0(CLK_CAM_MAIN_CAMTG, "cam_main_camtg", "camtm_sel", 9),
+	GATE_CAM_M0(CLK_CAM_MAIN_SENINF, "cam_main_seninf", "cam_sel", 10),
+	GATE_CAM_M0(CLK_CAM_MAIN_CAMSV_TOP, "cam_main_camsv", "cam_sel", 11),
+	GATE_CAM_M0(CLK_CAM_MAIN_CAM2MM0_GALS, "cam_main_cam2mm0_gals",
+		    "cam_sel", 16),
+	GATE_CAM_M0(CLK_CAM_MAIN_CAM2MM1_GALS, "cam_main_cam2mm1_gals",
+		    "cam_sel", 17),
+	GATE_CAM_M0(CLK_CAM_MAIN_CCUSYS, "cam_main_ccusys", "ccusys_sel", 20),
+	GATE_CAM_M0(CLK_CAM_MAIN_CAM_ASG, "cam_main_cam_asg", "cam_sel", 27),
+	GATE_CAM_M1(CLK_CAM_MAIN_CAMSV_A_CON_1, "cam_main_camsv_a_con_1",
+		    "cam_sel", 0),
+	GATE_CAM_M1(CLK_CAM_MAIN_CAMSV_B_CON_1, "cam_main_camsv_b_con_1",
+		    "cam_sel", 1),
+	GATE_CAM_M1(CLK_CAM_MAIN_CAMSV_C_CON_1, "cam_main_camsv_c_con_1",
+		    "cam_sel", 2),
+	GATE_CAM_M1(CLK_CAM_MAIN_CAMSV_D_CON_1, "cam_main_camsv_d_con_1",
+		    "cam_sel", 3),
+	GATE_CAM_M1(CLK_CAM_MAIN_CAMSV_E_CON_1, "cam_main_camsv_e_con_1",
+		    "cam_sel", 4),
+	GATE_CAM_M1(CLK_CAM_MAIN_CAMSV_CON_1, "cam_main_camsv_con_1",
+		    "cam_sel", 5),
+};
+
+static const struct mtk_clk_desc cam_main_desc = {
+	.clks = cam_main_clks,
+	.num_clks = ARRAY_SIZE(cam_main_clks),
+};
+
+static const struct of_device_id of_match_clk_mt6878_cam[] = {
+	{ .compatible = "mediatek,mt6878-camsys", .data = &cam_main_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6878_cam);
+
+static struct platform_driver clk_mt6878_cam_drv = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt6878-cam",
+		.of_match_table = of_match_clk_mt6878_cam,
+	},
+};
+module_platform_driver(clk_mt6878_cam_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6878 camera main clocks driver");
+MODULE_LICENSE("GPL");
