From: xxxvik-xakerxxx <xxxviktor.lyskoxxx@gmail.com>
Subject: [PATCH] arm64: dts: mt6878: enable RT6010 haptics

The populated Tetris haptic controller was identified read-only as an
RT6010 with device ID 0x6b. Enable the node for the native FF_RUMBLE
driver.

--- a/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts
@@ -107,12 +107,12 @@
 	clock-frequency = <400000>;
 
 	haptic@5f {
-		compatible = "ics,haptic_rt";
+		compatible = "richtek,rt6010";
 		reg = <0x5f>;
 		enable-gpios = <&pio 74 GPIO_ACTIVE_HIGH>;
 		interrupt-parent = <&pio>;
 		interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
-		status = "disabled";
+		status = "okay";
 	};
 };
