diff --git a/drivers/media/i2c/pd9302a.c b/drivers/media/i2c/pd9302a.c
new file mode 100644
index 0000000..32be820
--- /dev/null
+++ b/drivers/media/i2c/pd9302a.c
@@ -0,0 +1,368 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Puya Semiconductor PD9302A voice coil motor driver
+ *
+ * The register sequence and motion limits are derived from the shipping
+ * Nothing/MediaTek driver. This implementation exposes only standard V4L2
+ * controls and runtime power management.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+
+#define PD9302A_REG_REVISION		0x00
+#define PD9302A_REG_CONTROL		0x02
+#define PD9302A_REG_POSITION		0x03
+#define PD9302A_REG_CONFIG_1		0x06
+#define PD9302A_REG_CONFIG_2		0x07
+
+#define PD9302A_CONTROL_RESET		0x01
+#define PD9302A_CONTROL_ACTIVE		0x02
+#define PD9302A_CONTROL_STANDBY		0x20
+#define PD9302A_REVISION_F0		0xf0
+#define PD9302A_CONFIG_1_F0		0x10
+#define PD9302A_CONFIG_2_F0		0x6f
+#define PD9302A_CONFIG_1_DEFAULT	0x80
+#define PD9302A_CONFIG_2_DEFAULT	0x39
+
+#define PD9302A_MAX_FOCUS_POS		1023
+#define PD9302A_ORIGIN_FOCUS_POS	512
+#define PD9302A_MOVE_STEP		100
+#define PD9302A_MOVE_DELAY_US		5000
+#define PD9302A_POWER_DELAY_US		10000
+
+static const char * const pd9302a_supply_names[] = {
+	"vin",
+	"vdd",
+};
+
+struct pd9302a_device {
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_subdev sd;
+	struct v4l2_ctrl *focus;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(pd9302a_supply_names)];
+	u16 position;
+	bool position_valid;
+	bool active;
+};
+
+static inline struct pd9302a_device *to_pd9302a(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct pd9302a_device, sd);
+}
+
+static int pd9302a_write8(struct pd9302a_device *pd9302a, u8 reg, u8 value)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&pd9302a->sd);
+	u8 buf[] = { reg, value };
+	int ret;
+
+	ret = i2c_master_send(client, buf, sizeof(buf));
+	if (ret < 0)
+		return ret;
+	if (ret != sizeof(buf))
+		return -EIO;
+
+	return 0;
+}
+
+static int pd9302a_read8(struct pd9302a_device *pd9302a, u8 reg)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&pd9302a->sd);
+
+	return i2c_smbus_read_byte_data(client, reg);
+}
+
+static int pd9302a_set_position(struct pd9302a_device *pd9302a, u16 position)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&pd9302a->sd);
+	u8 buf[] = { PD9302A_REG_POSITION, position >> 8, position & 0xff };
+	int ret;
+
+	ret = i2c_master_send(client, buf, sizeof(buf));
+	if (ret < 0)
+		return ret;
+	if (ret != sizeof(buf))
+		return -EIO;
+
+	pd9302a->position = position;
+	pd9302a->position_valid = true;
+	return 0;
+}
+
+static int pd9302a_initialize(struct pd9302a_device *pd9302a)
+{
+	u8 config_1;
+	u8 config_2;
+	int revision;
+	int ret;
+
+	ret = pd9302a_write8(pd9302a, PD9302A_REG_CONTROL,
+			     PD9302A_CONTROL_RESET);
+	if (ret)
+		return ret;
+
+	ret = pd9302a_write8(pd9302a, PD9302A_REG_CONTROL, 0x00);
+	if (ret)
+		return ret;
+	usleep_range(100, 200);
+
+	ret = pd9302a_write8(pd9302a, PD9302A_REG_CONTROL,
+			     PD9302A_CONTROL_ACTIVE);
+	if (ret)
+		return ret;
+
+	revision = pd9302a_read8(pd9302a, PD9302A_REG_REVISION);
+	if (revision < 0)
+		return revision;
+
+	if (revision == PD9302A_REVISION_F0) {
+		config_1 = PD9302A_CONFIG_1_F0;
+		config_2 = PD9302A_CONFIG_2_F0;
+	} else {
+		config_1 = PD9302A_CONFIG_1_DEFAULT;
+		config_2 = PD9302A_CONFIG_2_DEFAULT;
+	}
+
+	ret = pd9302a_write8(pd9302a, PD9302A_REG_CONFIG_1, config_1);
+	if (ret)
+		return ret;
+	ret = pd9302a_write8(pd9302a, PD9302A_REG_CONFIG_2, config_2);
+	if (ret)
+		return ret;
+	usleep_range(100, 200);
+
+	return 0;
+}
+
+static int pd9302a_park(struct pd9302a_device *pd9302a)
+{
+	int position = pd9302a->position;
+	int ret;
+
+	if (!pd9302a->position_valid)
+		return 0;
+
+	while (abs(position - PD9302A_ORIGIN_FOCUS_POS) > PD9302A_MOVE_STEP) {
+		position += position < PD9302A_ORIGIN_FOCUS_POS ?
+			PD9302A_MOVE_STEP : -PD9302A_MOVE_STEP;
+		ret = pd9302a_set_position(pd9302a, position);
+		if (ret)
+			return ret;
+		usleep_range(PD9302A_MOVE_DELAY_US,
+			     PD9302A_MOVE_DELAY_US + 1000);
+	}
+
+	return pd9302a_set_position(pd9302a, PD9302A_ORIGIN_FOCUS_POS);
+}
+
+static int pd9302a_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct pd9302a_device *pd9302a = container_of(ctrl->handler,
+							 struct pd9302a_device, ctrls);
+
+	if (ctrl->id != V4L2_CID_FOCUS_ABSOLUTE)
+		return -EINVAL;
+
+	if (!pd9302a->active)
+		return -EHOSTDOWN;
+
+	return pd9302a_set_position(pd9302a, ctrl->val);
+}
+
+static const struct v4l2_ctrl_ops pd9302a_ctrl_ops = {
+	.s_ctrl = pd9302a_set_ctrl,
+};
+
+static int pd9302a_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	return pm_runtime_resume_and_get(sd->dev);
+}
+
+static int pd9302a_close(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	pm_runtime_put(sd->dev);
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops pd9302a_internal_ops = {
+	.open = pd9302a_open,
+	.close = pd9302a_close,
+};
+
+static const struct v4l2_subdev_ops pd9302a_subdev_ops = { };
+
+static int pd9302a_suspend(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct pd9302a_device *pd9302a = to_pd9302a(sd);
+	int disable_ret;
+	int ret;
+
+	if (!pd9302a->active)
+		return 0;
+
+	ret = pd9302a_park(pd9302a);
+	if (ret)
+		dev_warn(dev, "failed to park lens: %d\n", ret);
+	else
+		ret = pd9302a_write8(pd9302a, PD9302A_REG_CONTROL,
+				     PD9302A_CONTROL_STANDBY);
+	if (ret)
+		dev_warn(dev, "failed to enter standby: %d\n", ret);
+
+	disable_ret = regulator_bulk_disable(ARRAY_SIZE(pd9302a_supply_names),
+					     pd9302a->supplies);
+	if (disable_ret)
+		return ret ? ret : disable_ret;
+
+	pd9302a->active = false;
+
+	return ret;
+}
+
+static int pd9302a_resume(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct pd9302a_device *pd9302a = to_pd9302a(sd);
+	int ret;
+
+	if (pd9302a->active)
+		return 0;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(pd9302a_supply_names),
+				    pd9302a->supplies);
+	if (ret)
+		return ret;
+
+	usleep_range(PD9302A_POWER_DELAY_US, PD9302A_POWER_DELAY_US + 500);
+
+	ret = pd9302a_initialize(pd9302a);
+	if (ret)
+		goto disable_supplies;
+
+	pd9302a->active = true;
+	return 0;
+
+disable_supplies:
+	regulator_bulk_disable(ARRAY_SIZE(pd9302a_supply_names),
+			       pd9302a->supplies);
+	pd9302a->active = false;
+	return ret;
+}
+
+static void pd9302a_cleanup(struct pd9302a_device *pd9302a)
+{
+	v4l2_async_unregister_subdev(&pd9302a->sd);
+	v4l2_ctrl_handler_free(&pd9302a->ctrls);
+#if IS_ENABLED(CONFIG_MEDIA_CONTROLLER)
+	media_entity_cleanup(&pd9302a->sd.entity);
+#endif
+}
+
+static int pd9302a_probe(struct i2c_client *client)
+{
+	struct pd9302a_device *pd9302a;
+	unsigned int i;
+	int ret;
+
+	pd9302a = devm_kzalloc(&client->dev, sizeof(*pd9302a), GFP_KERNEL);
+	if (!pd9302a)
+		return -ENOMEM;
+
+	for (i = 0; i < ARRAY_SIZE(pd9302a_supply_names); i++)
+		pd9302a->supplies[i].supply = pd9302a_supply_names[i];
+
+	ret = devm_regulator_bulk_get(&client->dev,
+				      ARRAY_SIZE(pd9302a_supply_names),
+				      pd9302a->supplies);
+	if (ret)
+		return dev_err_probe(&client->dev, ret,
+				     "failed to get regulators\n");
+
+	v4l2_i2c_subdev_init(&pd9302a->sd, client, &pd9302a_subdev_ops);
+	pd9302a->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	pd9302a->sd.internal_ops = &pd9302a_internal_ops;
+#if IS_ENABLED(CONFIG_MEDIA_CONTROLLER)
+	pd9302a->sd.entity.function = MEDIA_ENT_F_LENS;
+#endif
+	pd9302a->position = PD9302A_ORIGIN_FOCUS_POS;
+
+	v4l2_ctrl_handler_init(&pd9302a->ctrls, 1);
+	pd9302a->focus = v4l2_ctrl_new_std(&pd9302a->ctrls,
+					   &pd9302a_ctrl_ops,
+					  V4L2_CID_FOCUS_ABSOLUTE, 0,
+					  PD9302A_MAX_FOCUS_POS, 1, 0);
+	if (pd9302a->ctrls.error) {
+		ret = pd9302a->ctrls.error;
+		goto free_ctrls;
+	}
+	pd9302a->sd.ctrl_handler = &pd9302a->ctrls;
+
+#if IS_ENABLED(CONFIG_MEDIA_CONTROLLER)
+	ret = media_entity_pads_init(&pd9302a->sd.entity, 0, NULL);
+	if (ret)
+		goto free_ctrls;
+#endif
+
+	ret = v4l2_async_register_subdev(&pd9302a->sd);
+	if (ret)
+		goto cleanup_entity;
+
+	ret = pm_runtime_set_suspended(&client->dev);
+	if (ret)
+		goto unregister_subdev;
+	pm_runtime_enable(&client->dev);
+
+	return 0;
+
+unregister_subdev:
+	v4l2_async_unregister_subdev(&pd9302a->sd);
+cleanup_entity:
+#if IS_ENABLED(CONFIG_MEDIA_CONTROLLER)
+	media_entity_cleanup(&pd9302a->sd.entity);
+#endif
+free_ctrls:
+	v4l2_ctrl_handler_free(&pd9302a->ctrls);
+	return ret;
+}
+
+static void pd9302a_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct pd9302a_device *pd9302a = to_pd9302a(sd);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		pd9302a_suspend(&client->dev);
+	pd9302a_cleanup(pd9302a);
+}
+
+static const struct of_device_id pd9302a_of_match[] = {
+	{ .compatible = "puya,pd9302a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, pd9302a_of_match);
+
+static DEFINE_RUNTIME_DEV_PM_OPS(pd9302a_pm_ops, pd9302a_suspend,
+				 pd9302a_resume, NULL);
+
+static struct i2c_driver pd9302a_i2c_driver = {
+	.driver = {
+		.name = "pd9302a",
+		.of_match_table = pd9302a_of_match,
+		.pm = pm_ptr(&pd9302a_pm_ops),
+	},
+	.probe = pd9302a_probe,
+	.remove = pd9302a_remove,
+};
+module_i2c_driver(pd9302a_i2c_driver);
+
+MODULE_AUTHOR("xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>");
+MODULE_DESCRIPTION("Puya Semiconductor PD9302A VCM driver");
+MODULE_LICENSE("GPL");
