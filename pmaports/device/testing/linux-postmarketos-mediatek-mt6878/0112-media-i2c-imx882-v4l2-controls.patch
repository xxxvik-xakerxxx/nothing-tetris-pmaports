--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/nothing,tetris-imx882-stream.yaml
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/nothing,tetris-imx882-stream.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Nothing Tetris IMX882 C-PHY streaming candidate
+
+maintainers:
+  - xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
+
+description: |
+  Explicit main-module streaming candidate, not an identity probe or an
+  automatic board activation. Board integration must establish module
+  supplier, reset polarity, owned power and an MT6878 capture receiver.
+  Normal binned modes emit RAW10 and PDAF on virtual channel zero.
+
+properties:
+  compatible:
+    const: nothing,tetris-imx882-stream
+  reg:
+    maxItems: 1
+  clocks:
+    maxItems: 1
+  clock-names:
+    const: xclk
+  clock-frequency:
+    const: 24000000
+  afvdd-supply:
+    description: Autofocus supply, 2.8 V
+  avdd-supply:
+    description: Analog supply, 2.8 V
+  dvdd-supply:
+    description: Digital core supply, 1.2 V
+  dovdd-supply:
+    description: Digital I/O supply, 1.8 V
+  reset-gpios:
+    description: Active-low reset, logical assertion holds the sensor in reset
+    maxItems: 1
+  pinctrl-names:
+    items:
+      - const: mclk-off
+      - const: mclk-4ma
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    unevaluatedProperties: false
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+        properties:
+          bus-type:
+            const: 1
+          data-lanes:
+            items:
+              - const: 0
+              - const: 1
+              - const: 2
+        required:
+          - bus-type
+          - data-lanes
+          - remote-endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - clock-frequency
+  - afvdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - reset-gpios
+  - pinctrl-names
+  - port
+
+additionalProperties: false
+...
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -786,3 +786,14 @@
 	  explicitly selected bring-up device trees only.
 
+config VIDEO_IMX882_TETRIS
+	tristate "Nothing Tetris IMX882 V4L2 streaming candidate"
+	depends on I2C && OF && GPIOLIB && COMMON_CLK && REGULATOR && PINCTRL
+	depends on VIDEO_DEV && MEDIA_CONTROLLER
+	select V4L2_FWNODE
+	help
+	  Unenabled C-PHY sensor candidate. Requires explicit board power
+	  ownership and a compatible receiver. Does not enable any DT nodes.
+	  Supports binned 30 fps modes and standard exposure/gain controls.
+	  Per-unit calibration and receiver DMA bring-up are separate tasks.
+
 source "drivers/media/i2c/ccs/Kconfig"
