From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Thu, 4 Sep 2026 13:00:00 +0300
Subject: [PATCH] power: supply: add compile-only MT6375 BC1.2 decode

Record the MT6375 BC1.2 status encoding used by Nothing OS 4.1 and keep
the translation to Linux power-supply types independently compilable.

This translation unit is deliberately absent from Kconfig and Makefile.
It has no registration, module metadata, hardware access or runtime path.
Unknown and incomplete detector states translate to UNKNOWN with a zero
current limit.

The register offsets, completion interrupt and PORT_STAT values come from
NothingOSS android_kernel_device_modules_6.1_nothing_mt6878 revision
ee2be53cb75670b548948636a0db1d1ff112bf12, specifically
drivers/power/supply/mt6375-charger.c and include/dt-bindings/mfd/mt6375.h.

Signed-off-by: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
---
 drivers/power/supply/mt6375-bc12-decode.c | 85 +++++++++++++++++++++++
 1 file changed, 85 insertions(+)
 create mode 100644 drivers/power/supply/mt6375-bc12-decode.c

diff --git a/drivers/power/supply/mt6375-bc12-decode.c b/drivers/power/supply/mt6375-bc12-decode.c
new file mode 100644
--- /dev/null
+++ b/drivers/power/supply/mt6375-bc12-decode.c
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Compile-only MT6375 BC1.2 status decoder.
+ *
+ * Source provenance:
+ * NothingOSS android_kernel_device_modules_6.1_nothing_mt6878
+ * commit ee2be53cb75670b548948636a0db1d1ff112bf12
+ * drivers/power/supply/mt6375-charger.c
+ * include/dt-bindings/mfd/mt6375.h
+ *
+ * This file is intentionally not referenced by Kconfig or Makefile. It has no
+ * driver registration, module metadata, hardware access or runtime path.
+ */
+
+#include <linux/build_bug.h>
+#include <linux/compiler_attributes.h>
+#include <linux/power_supply.h>
+#include <linux/types.h>
+
+#define MT6375_REG_BC12_FUNC		0x150
+#define MT6375_REG_BC12_STAT		0x151
+#define MT6375_FL_BC12_DN		31
+
+#define MT6375_BC12_SDP_CURRENT_UA	500000
+#define MT6375_BC12_CDP_CURRENT_UA	1500000
+#define MT6375_BC12_DCP_CURRENT_UA	2000000
+
+enum mt6375_bc12_port_stat {
+	MT6375_PORT_STAT_NOINFO,
+	MT6375_PORT_STAT_APPLE_10W = 8,
+	MT6375_PORT_STAT_SAMSUNG,
+	MT6375_PORT_STAT_APPLE_5W,
+	MT6375_PORT_STAT_APPLE_12W,
+	MT6375_PORT_STAT_UNKNOWN_TA,
+	MT6375_PORT_STAT_SDP,
+	MT6375_PORT_STAT_CDP,
+	MT6375_PORT_STAT_DCP,
+};
+
+struct mt6375_bc12_result {
+	enum power_supply_usb_type usb_type;
+	u32 current_max_ua;
+};
+
+static_assert(MT6375_REG_BC12_FUNC == 0x150);
+static_assert(MT6375_REG_BC12_STAT == 0x151);
+static_assert(MT6375_FL_BC12_DN == 31);
+static_assert(MT6375_PORT_STAT_APPLE_10W == 8);
+static_assert(MT6375_PORT_STAT_UNKNOWN_TA == 12);
+static_assert(MT6375_PORT_STAT_SDP == 13);
+static_assert(MT6375_PORT_STAT_CDP == 14);
+static_assert(MT6375_PORT_STAT_DCP == 15);
+
+static __used struct mt6375_bc12_result
+mt6375_bc12_decode_port_stat(u8 port_stat)
+{
+	switch (port_stat) {
+	case MT6375_PORT_STAT_SDP:
+		return (struct mt6375_bc12_result) {
+			.usb_type = POWER_SUPPLY_USB_TYPE_SDP,
+			.current_max_ua = MT6375_BC12_SDP_CURRENT_UA,
+		};
+	case MT6375_PORT_STAT_CDP:
+		return (struct mt6375_bc12_result) {
+			.usb_type = POWER_SUPPLY_USB_TYPE_CDP,
+			.current_max_ua = MT6375_BC12_CDP_CURRENT_UA,
+		};
+	case MT6375_PORT_STAT_APPLE_10W:
+	case MT6375_PORT_STAT_SAMSUNG:
+	case MT6375_PORT_STAT_APPLE_5W:
+	case MT6375_PORT_STAT_APPLE_12W:
+	case MT6375_PORT_STAT_UNKNOWN_TA:
+	case MT6375_PORT_STAT_DCP:
+		return (struct mt6375_bc12_result) {
+			.usb_type = POWER_SUPPLY_USB_TYPE_DCP,
+			.current_max_ua = MT6375_BC12_DCP_CURRENT_UA,
+		};
+	case MT6375_PORT_STAT_NOINFO:
+	default:
+		return (struct mt6375_bc12_result) {
+			.usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN,
+			.current_max_ua = 0,
+		};
+	}
+}
-- 
