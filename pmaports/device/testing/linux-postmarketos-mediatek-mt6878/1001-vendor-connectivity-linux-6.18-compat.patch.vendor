From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Subject: [PATCH] vendor: connectivity: adapt Tetris 16b modules to Linux 6.18

Keep the official Nothing MT6878 connectivity implementation buildable against
the postmarketOS kernel without mutating sources from APKBUILD. This updates
removed kernel APIs, supplies the MT6878 SMC IDs, drops unavailable Android EMI
and CCCI integration, and uses the current platform remove callback contract.

This is a downstream compatibility patch for the module-first bring-up path.
The individual hardware blocks remain candidates for native subsystem ports.

diff --git a/connectivity/bt/linux_v2/Kbuild b/connectivity/bt/linux_v2/Kbuild
index 19c762f..420cc82 100644
--- a/connectivity/bt/linux_v2/Kbuild
+++ b/connectivity/bt/linux_v2/Kbuild
@@ -178,7 +178,7 @@ ifeq ($(CONFIG_SUPPORT_DEVICE_NODE), y)
   ccflags-y += -I$(CONN_FEM_SRC)/include
 endif
 
-ccflags-y += -Werror
+ccflags-y += -Wno-error
 
 $(MOD_NAME)-objs := $(CFILES:.c=.o)
 
diff --git a/connectivity/bt/linux_v2/btmtk_char_dev.c b/connectivity/bt/linux_v2/btmtk_char_dev.c
index 2d2d062..c2de4f2 100644
--- a/connectivity/bt/linux_v2/btmtk_char_dev.c
+++ b/connectivity/bt/linux_v2/btmtk_char_dev.c
@@ -636,7 +636,7 @@ int BT_init(void)
 	if (cdv_err)
 		goto cdv_error;
 
-	BT_class = class_create(THIS_MODULE, BT_DRIVER_NODE_NAME);
+	BT_class = class_create(BT_DRIVER_NODE_NAME);
 	if (IS_ERR(BT_class))
 		goto create_node_error;
 	BT_dev = device_create(BT_class, NULL, dev, NULL, BT_DRIVER_NODE_NAME);
diff --git a/connectivity/bt/linux_v2/btmtk_chip_reset.c b/connectivity/bt/linux_v2/btmtk_chip_reset.c
index 4eacbf3..558b31c 100644
--- a/connectivity/bt/linux_v2/btmtk_chip_reset.c
+++ b/connectivity/bt/linux_v2/btmtk_chip_reset.c
@@ -53,7 +53,7 @@ void btmtk_reset_timer_update(struct btmtk_dev *bdev)
 void btmtk_reset_timer_del(struct btmtk_dev *bdev)
 {
 	if (timer_pending(&bdev->chip_reset_timer)) {
-		del_timer_sync(&bdev->chip_reset_timer);
+		timer_delete_sync(&bdev->chip_reset_timer);
 		BTMTK_INFO("%s exit", __func__);
 	}
 }
diff --git a/connectivity/bt/linux_v2/btmtk_fw_log.c b/connectivity/bt/linux_v2/btmtk_fw_log.c
index f2346ae..c205a96 100644
