 $(MOD_NAME)-objs := $(CFILES:.c=.o)
 
diff --git a/connectivity/bt/linux_v2/proj/btmtk_proj_sp.c b/connectivity/bt/linux_v2/proj/btmtk_proj_sp.c
--- a/connectivity/bt/linux_v2/proj/btmtk_proj_sp.c
