diff --git a/connectivity/bt/linux_v2/sdio/btmtksdio.c b/connectivity/bt/linux_v2/sdio/btmtksdio.c
index e902d8b..2477c8e 100644
--- a/connectivity/bt/linux_v2/sdio/btmtksdio.c
+++ b/connectivity/bt/linux_v2/sdio/btmtksdio.c
@@ -355,7 +355,7 @@ static void btmtk_fw_own_timer(unsigned long arg)
 #else
 static void btmtk_fw_own_timer(struct timer_list *timer)
 {
-	struct btmtk_sdio_dev *cif_dev = from_timer(cif_dev, timer, fw_own_timer);
+	struct btmtk_sdio_dev *cif_dev = timer_container_of(cif_dev, timer, fw_own_timer);
 
 	atomic_set(&cif_dev->fw_own_timer_flag, FW_OWN_TIMER_RUNNING);
 	wake_up_interruptible(&cif_dev->sdio_thread.wait_q);
@@ -383,7 +383,7 @@ static void btmtk_sdio_create_fw_own_timer(struct btmtk_sdio_dev *cif_dev)
 
 static void btmtk_sdio_delete_fw_own_timer(struct btmtk_sdio_dev *cif_dev)
 {
-	del_timer_sync(&cif_dev->fw_own_timer);
+	timer_delete_sync(&cif_dev->fw_own_timer);
 	BTMTK_INFO("%s end", __func__);
 }
 
diff --git a/connectivity/bt/linux_v2/uart/btmtktty.c b/connectivity/bt/linux_v2/uart/btmtktty.c
index e282b54..207348b 100644
--- a/connectivity/bt/linux_v2/uart/btmtktty.c
+++ b/connectivity/bt/linux_v2/uart/btmtktty.c
