 CFLAGS = \
 		 -g \
 		 -Wall \
-		 -Werror \
+		 -Wno-error \
 		 $(NULL)
 
 #---------------------------------------------------------------------------
diff --git a/connectivity/bt/mt66xx/6878/Kbuild b/connectivity/bt/mt66xx/6878/Kbuild
--- a/connectivity/bt/mt66xx/6878/Kbuild
+++ b/connectivity/bt/mt66xx/6878/Kbuild
@@ -1,4 +1,4 @@
 BT_PLATFORM := 6878
 LOG_TAG := [BT_Drv][btif]
 
-include $(srctree)/$(src)/../btif/Kbuild
+include $(M)/../btif/Kbuild
diff --git a/connectivity/bt/mt66xx/include/btmtk_chip_if.h b/connectivity/bt/mt66xx/include/btmtk_chip_if.h
--- a/connectivity/bt/mt66xx/include/btmtk_chip_if.h
+++ b/connectivity/bt/mt66xx/include/btmtk_chip_if.h
@@ -16,7 +16,7 @@
 #include "btmtk_btif.h"
 #define CFG_SUPPORT_BT_DL_WIFI_PATCH    0
 #define CFG_SUPPORT_DVT                 0
-#define CFG_SUPPORT_BLUEZ               0
+#define CFG_SUPPORT_BLUEZ               1
 
 #if (CONNAC20_CHIPID == 6885)
 	#include "platform_6885.h"
diff --git a/connectivity/bt/mt66xx/btif/Kbuild b/connectivity/bt/mt66xx/btif/Kbuild
--- a/connectivity/bt/mt66xx/btif/Kbuild
+++ b/connectivity/bt/mt66xx/btif/Kbuild
@@ -13,7 +13,11 @@
 LINUXINCLUDE := $(DEVCIE_MODULES_INCLUDE) $(LINUXINCLUDE)
 TOP := $(srctree)/..
 endif
+ifneq ($(KBUILD_EXTMOD),)
+KO_PATH := $(M)
+else
 KO_PATH := $(if $(filter /%,$(src)),,$(srctree)/)$(src)
+endif
 $(info [bt_drv] btif/Kbuild KO_PATH=$(KO_PATH) DEVICE_MODULES_PATH=$(DEVICE_MODULES_PATH))
 
 ifndef TOP
@@ -98,7 +102,8 @@
 ccflags-y += -D CHIP_IF_BTIF
 
 # Use device node or hci_dev as native interface
-ccflags-y += -D USE_DEVICE_NODE=1
+USE_DEVICE_NODE ?= 1
+ccflags-y += -D USE_DEVICE_NODE=$(USE_DEVICE_NODE)
 
 # Customized fw update feature
 ccflags-y += -D CUSTOMER_FW_UPDATE=0
diff --git a/connectivity/bt/mt66xx/btif/btmtk_beif.c b/connectivity/bt/mt66xx/btif/btmtk_beif.c
--- a/connectivity/bt/mt66xx/btif/btmtk_beif.c
+++ b/connectivity/bt/mt66xx/btif/btmtk_beif.c
@@ -3,6 +3,8 @@
  * Copyright (c) 2019 MediaTek Inc.
  */
 #if SUPPORT_BEIF
+#include <linux/vmalloc.h>
+
 #include "btmtk_beif_plat.h"
 #include "btmtk_beif.h"
 
@@ -613,12 +615,8 @@
 #ifndef BEIF_CTP_LOAD
 static int beif_rx_thread(void *p_data)
 {
-	struct sched_param sch_param;
-	int ret;
-
-	sch_param.sched_priority = MAX_RT_PRIO - 10;
-	ret = sched_setscheduler(current, SCHED_RR, &sch_param);
-	pr_info("%s prio = %d, ret = %d\n", __func__, sch_param.sched_priority, ret);
+	sched_set_fifo(current);
+	pr_info("%s running with FIFO scheduling\n", __func__);
 
 	while (1) {
 		wait_for_completion_interruptible(&rx_comp);
diff --git a/connectivity/bt/mt66xx/btif/btmtk_btif_main.c b/connectivity/bt/mt66xx/btif/btmtk_btif_main.c
--- a/connectivity/bt/mt66xx/btif/btmtk_btif_main.c
