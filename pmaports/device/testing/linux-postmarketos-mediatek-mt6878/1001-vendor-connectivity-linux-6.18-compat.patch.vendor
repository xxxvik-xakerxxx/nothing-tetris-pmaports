+++ b/connectivity/common/common_main/linux/wmt_alarm.c
@@ -64,8 +64,7 @@ static void wmt_alarm_dmp_info_handler(struct work_struct *work)
 	}
 }
 
-static enum alarmtimer_restart alarm_timer_handler(struct alarm *alarm,
-	ktime_t now)
+static void alarm_timer_handler(struct alarm *alarm, ktime_t now)
 {
 	ktime_t kt;
 
@@ -77,7 +76,6 @@ static enum alarmtimer_restart alarm_timer_handler(struct alarm *alarm,
 
 	spin_unlock_irqrestore(&g_wmt_alarm.alarm_lock, g_wmt_alarm.flags);
 
