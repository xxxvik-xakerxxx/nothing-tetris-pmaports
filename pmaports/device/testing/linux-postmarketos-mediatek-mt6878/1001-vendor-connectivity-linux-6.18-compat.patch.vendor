 #include <linux/of.h>
 #include <linux/notifier.h>
 #include <linux/fb.h>
+#ifndef FB_EVENT_BLANK
+#define FB_EVENT_BLANK 0x09
+#endif
 #include <linux/timer.h>
 #include <linux/suspend.h>
 #include <linux/module.h>
@@ -25,7 +28,8 @@
 #endif
 #include "connectivity_build_in_adapter.h"
 #include "connsys_debug_utility.h"
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0) && \
+	defined(CONFIG_MTK_DISP_NOTIFIER)
 #include "mtk_disp_notify.h"
 #endif
 
@@ -160,7 +164,8 @@
 	return 0;
 }
 
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0) && \
+	defined(CONFIG_MTK_DISP_NOTIFIER)
 int btmtk_disp_notify_cb(struct notifier_block *nb, unsigned long value, void *v)
 {
 	int *data = (int *)v;
@@ -586,7 +591,7 @@
  *     0 if success, otherwise error code
  *
  */
-void bt_report_hw_error()
+void bt_report_hw_error(void)
 {
 	const uint8_t HCI_EVT_HW_ERROR[] = {0x04, 0x10, 0x01, 0x00};
 	btmtk_recv(g_sbdev->hdev, HCI_EVT_HW_ERROR, sizeof(HCI_EVT_HW_ERROR));
@@ -1035,6 +1040,14 @@
 {
 	int err = 0;
 #if (USE_DEVICE_NODE == 0)
+	/* MT6631 advertises Synchronization Train but rejects opcode 0x0c77. */
+	if (skb->len >= 16 && skb->data[0] == 0x0e &&
+	    skb->data[3] == 0x04 && skb->data[4] == 0x10 &&
+	    skb->data[5] == 0x00 && skb->data[6] == 0x02 &&
+	    (skb->data[8] & 0x04)) {
+		skb->data[8] &= ~0x04;
+		BTMTK_INFO("Mask unsupported Synchronization Train feature");
+	}
 	err = hci_recv_frame(hdev, skb);
 #else
 	err = rx_skb_enqueue(skb);
@@ -1674,12 +1687,8 @@
 		return -1;
 	}
 
-	/* 2. Init HCI device */
+	/* 2. Allocate HCI device */
 	btmtk_allocate_hci_device(g_sbdev, HCI_UART);
-#if (USE_DEVICE_NODE == 0)
-	SET_HCIDEV_DEV(g_sbdev->hdev, BTMTK_GET_DEV(cif_dev));
-	btmtk_register_hci_device(g_sbdev);
-#endif
 
 	/* 3. Init power manager */
 	bt_psm_init(&cif_dev->psm);
@@ -1708,7 +1713,8 @@
 
 	/* 8. Register screen on/off & suspend/wakup notify callback */
 	cif_dev->blank_state = WMT_PARA_SCREEN_ON;
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0) && \
+	defined(CONFIG_MTK_DISP_NOTIFIER)
 	if (mtk_disp_notifier_register("btmtk_disp_notifier", &btmtk_disp_notifier)) {
                 BTMTK_ERR("Register mtk_disp_notifier failed\n");
 	}
@@ -1741,6 +1751,17 @@
 	/* Set ICB cif state */
 	btmtk_set_chip_state((void *)g_sbdev, BTMTK_STATE_WORKING);
 
+#if (USE_DEVICE_NODE == 0)
+	/* hci_register_dev queues setup immediately, so register only when the
+	 * transport state and conninfra callbacks are ready.
+	 */
+	SET_HCIDEV_DEV(g_sbdev->hdev, BTMTK_GET_DEV(cif_dev));
+	if (btmtk_register_hci_device(g_sbdev)) {
+		BTMTK_ERR("%s: HCI device registration failed", __func__);
+		return -1;
+	}
+#endif
+
 	BTMTK_INFO("%s: Done", __func__);
 	return 0;
 }
@@ -1756,7 +1762,7 @@
  * Return Value:
  *     0 if success, otherwise error code
  */
-static int btmtk_cif_remove(struct platform_device *pdev)
+static void btmtk_cif_remove(struct platform_device *pdev)
 {
 	struct btmtk_btif_dev *cif_dev = (struct btmtk_btif_dev *)g_sbdev->cif_dev;
 
@@ -1766,7 +1772,8 @@
 
 	/* Unregister screen on/off & suspend/wakup notify callback */
 
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0) && \
+	defined(CONFIG_MTK_DISP_NOTIFIER)
 	mtk_disp_notifier_unregister(&btmtk_disp_notifier);
 #else
 	btmtk_fb_notify_unregister();
@@ -1787,7 +1794,6 @@
 
 	bt_reg_deinit();
 
-	return 0;
 }
 
 /* btmtk_cif_register
diff --git a/connectivity/bt/mt66xx/btif/btmtk_char_dev.c b/connectivity/bt/mt66xx/btif/btmtk_char_dev.c
--- a/connectivity/bt/mt66xx/btif/btmtk_char_dev.c
+++ b/connectivity/bt/mt66xx/btif/btmtk_char_dev.c
@@ -554,7 +554,7 @@
 	if (cdv_err)
 		goto cdv_error;
 
-	BT_class = class_create(THIS_MODULE, BT_DRIVER_NODE_NAME);
+	BT_class = class_create(BT_DRIVER_NODE_NAME);
 	if (IS_ERR(BT_class))
 		goto create_node_error;
 	BT_dev = device_create(BT_class, NULL, dev, NULL, BT_DRIVER_NODE_NAME);
diff --git a/connectivity/bt/mt66xx/btif/btmtk_mt66xx.c b/connectivity/bt/mt66xx/btif/btmtk_mt66xx.c
--- a/connectivity/bt/mt66xx/btif/btmtk_mt66xx.c
+++ b/connectivity/bt/mt66xx/btif/btmtk_mt66xx.c
@@ -9,6 +9,7 @@
 #include <linux/of_address.h>
 #include <linux/of.h>
 #include <linux/rtc.h>
+#include <linux/vmalloc.h>
 
 #include "btmtk_define.h"
 #include "btmtk_chip_if.h"
@@ -1792,11 +1793,9 @@
 int32_t btmtk_set_power_on(struct hci_dev *hdev, u_int8_t for_precal)
 {
 	int ret;
-	int sch_ret = -1;
 	unsigned int chip_id = 0, adie_id = 0;
 	bool is_wmt_power_on_fail = FALSE;
 
-	struct sched_param sch_param;
 	struct btmtk_dev *bdev = hci_get_drvdata(hdev);
 	struct btmtk_btif_dev *cif_dev = (struct btmtk_btif_dev *)g_sbdev->cif_dev;
 
@@ -1905,13 +1904,8 @@
 	}
 
 	if(g_bt_dbg_st.rt_thd_enable) {
-		sch_param.sched_priority = MAX_RT_PRIO - 20;
-		sch_ret = sched_setscheduler(cif_dev->tx_thread, SCHED_FIFO, &sch_param);
-		BTMTK_INFO("sch_ret = %d", sch_ret);
-		if (sch_ret != 0)
-			BTMTK_INFO("set RT thread failed");
-		else
-			BTMTK_INFO("set RT thread succeed");
+		sched_set_fifo(cif_dev->tx_thread);
+		BTMTK_INFO("set RT thread");
 	}
 	wake_up_process(cif_dev->tx_thread);
 #endif
diff --git a/connectivity/bt/mt66xx/btmtk_fw_log.c b/connectivity/bt/mt66xx/btmtk_fw_log.c
--- a/connectivity/bt/mt66xx/btmtk_fw_log.c
+++ b/connectivity/bt/mt66xx/btmtk_fw_log.c
@@ -128,7 +128,7 @@
 	if (cdevErr)
 		goto cdv_error;
 
-	g_fwlog->pBTClass = class_create(THIS_MODULE, BT_FWLOG_DEV_NODE);
+	g_fwlog->pBTClass = class_create(BT_FWLOG_DEV_NODE);
 	if (IS_ERR(g_fwlog->pBTClass)) {
 		BTMTK_ERR("%s: class create fail, error code(%ld)\n", __func__, PTR_ERR(g_fwlog->pBTClass));
 		goto create_node_error;
@@ -758,4 +758,3 @@
 	}
 	return 0;
 }
-
diff --git a/connectivity/bt/mt66xx/btmtk_main.c b/connectivity/bt/mt66xx/btmtk_main.c
--- a/connectivity/bt/mt66xx/btmtk_main.c
+++ b/connectivity/bt/mt66xx/btmtk_main.c
@@ -10,6 +10,7 @@
 #include <linux/pm_wakeup.h>
 #include <linux/reboot.h>
 #include <linux/string.h>
+#include <linux/vmalloc.h>
 
 #include "btmtk_define.h"
 #include "btmtk_main.h"
@@ -3713,7 +3714,26 @@
 	bdev->chip_reset = 0;
 	BTMTK_INFO("%s End", __func__);
 }
+
+static int btmtk_set_public_address(struct hci_dev *hdev,
+				    const bdaddr_t *bdaddr)
+{
+	struct sk_buff *skb;
+	long ret;
 
+	skb = __hci_cmd_sync(hdev, 0xfc1a, sizeof(*bdaddr), bdaddr,
+			     HCI_INIT_TIMEOUT);
+	if (IS_ERR(skb)) {
+		ret = PTR_ERR(skb);
+		bt_dev_err(hdev, "setting MT6631 public address failed (%ld)",
+			   ret);
+		return ret;
+	}
+	kfree_skb(skb);
+
+	return 0;
+}
+
 int btmtk_allocate_hci_device(struct btmtk_dev *bdev, int hci_bus_type)
 {
 	struct hci_dev *hdev;
@@ -3736,9 +3737,6 @@
 
 	hdev->bus = hci_bus_type;
 	hci_set_drvdata(hdev, bdev);
-
-	/* HCI_PRIMARY = 0x00 */
-	hdev->dev_type = 0x00;
 
 	bdev->hdev = hdev;
 
@@ -3748,6 +3765,8 @@
 	hdev->flush    = bt_flush;
 	hdev->send	   = bt_send_frame;
 	hdev->setup    = bt_setup;
+	hdev->set_bdaddr = btmtk_set_public_address;
+	hci_set_quirk(hdev, HCI_QUIRK_INVALID_BDADDR);
 
 	init_waitqueue_head(&bdev->p_wait_event_q);
 
diff --git a/connectivity/bt/mt66xx/include/btif/btmtk_btif.h b/connectivity/bt/mt66xx/include/btif/btmtk_btif.h
--- a/connectivity/bt/mt66xx/include/btif/btmtk_btif.h
+++ b/connectivity/bt/mt66xx/include/btif/btmtk_btif.h
@@ -204,10 +204,6 @@
 #define BT_BTIF_DUMP_LOG		0x04
 #define BT_BTIF_DUMP_DMA		0x08
 #define BT_BTIF_DUMP_ALL		0x0F
-
-struct sched_param {
-	int sched_priority;
-};
 
 struct bt_dbg_st {
 	bool rt_thd_enable;
diff --git a/connectivity/bt/mt66xx/include/btif/platform_base.h b/connectivity/bt/mt66xx/include/btif/platform_base.h
--- a/connectivity/bt/mt66xx/include/btif/platform_base.h
+++ b/connectivity/bt/mt66xx/include/btif/platform_base.h
@@ -9,6 +9,10 @@
 #include "conninfra.h"
 #include <linux/arm-smccc.h>
 #include <linux/soc/mediatek/mtk_sip_svc.h>
+
+#ifndef MTK_SIP_KERNEL_BT_CONTROL
+#define MTK_SIP_KERNEL_BT_CONTROL MTK_SIP_SMC_CMD(0x536)
+#endif
 
 #define BT_CR_DUMP_BUF_SIZE	(1024)
