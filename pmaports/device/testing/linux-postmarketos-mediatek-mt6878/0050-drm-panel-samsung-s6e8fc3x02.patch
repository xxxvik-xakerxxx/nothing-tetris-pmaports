+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,s6e8fc3x02.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S6E8FC3X02 AMOLED panel
+
+maintainers:
+  - xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,s6e8fc3x02
+
+  reg:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  vddi-en-gpios:
+    description: GPIO controlling the panel I/O supply
+    maxItems: 1
+
+  vci-en-gpios:
+    description: GPIO controlling the panel analog supply
+    maxItems: 1
+
+  samsung,refresh-rate:
+    description:
+      Fixed refresh rate selected before panel initialization. Runtime mode
+      switching requires a display-controller-specific atomic integration and
+      is intentionally not represented by this property.
+    enum: [60, 120]
+    default: 60
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - vddi-en-gpios
+  - vci-en-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "samsung,s6e8fc3x02";
+            reg = <0>;
+            reset-gpios = <&pio 90 0>;
+            vddi-en-gpios = <&pio 153 0>;
+            vci-en-gpios = <&pio 154 0>;
+            samsung,refresh-rate = <60>;
+        };
+    };
+...
