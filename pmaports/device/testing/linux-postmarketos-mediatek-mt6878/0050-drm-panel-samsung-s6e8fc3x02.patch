diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e8fc3x02.c b/drivers/gpu/drm/panel/panel-samsung-s6e8fc3x02.c
new file mode 100644
index 0000000000000000000000000000000000000000..5911d8ecf6c9e81195c38e8047f75346d76d0965
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e8fc3x02.c
@@ -0,0 +1,498 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S6E8FC3X02 AMOLED panel
+ *
+ * Hardware data and command sequences are derived from the Nothing OS 4.1
+ * Tetris source drop. This driver intentionally uses only upstream DRM, DSI,
+ * GPIO and backlight interfaces.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#include <video/mipi_display.h>
+
+#define S6E8FC3X02_WIDTH		1080
+#define S6E8FC3X02_HEIGHT		2400
+#define S6E8FC3X02_MAX_BRIGHTNESS	4095
+
+struct s6e8fc3x02 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct backlight_device *backlight;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *vddi_en_gpio;
+	struct gpio_desc *vci_en_gpio;
+	struct mutex lock; /* Protects DCS backlight transactions. */
+	u32 refresh_rate;
+	bool prepared;
+	bool enabled;
+	bool vdc_enabled;
+};
+
+static inline struct s6e8fc3x02 *to_s6e8fc3x02(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e8fc3x02, panel);
+}
+
+static void s6e8fc3x02_power_off(struct s6e8fc3x02 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(1000, 5000);
+	gpiod_set_value_cansleep(ctx->vci_en_gpio, 0);
+	usleep_range(1000, 5000);
+	gpiod_set_value_cansleep(ctx->vddi_en_gpio, 0);
+}
+
+static void s6e8fc3x02_reset(struct s6e8fc3x02 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+}
+
+static void s6e8fc3x02_set_vdc(struct mipi_dsi_multi_context *dsi_ctx,
+			       bool enable)
+{
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x89, 0xb1);
+	mipi_dsi_dcs_write_var_seq_multi(dsi_ctx, 0xb1,
+					 enable ? 0x0d : 0x2d);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf0, 0xa5, 0xa5);
+}
+
+static void s6e8fc3x02_set_brightness(struct s6e8fc3x02 *ctx,
+				      struct mipi_dsi_multi_context *dsi_ctx,
+				      u16 brightness)
+{
+	u8 brightness_cmd[] = { 0x51, 0x00, 0x00 };
+	u16 panel_level;
+
+	brightness = min_t(u16, brightness, S6E8FC3X02_MAX_BRIGHTNESS);
+	if (brightness >= 417 && brightness <= 424)
+		brightness = 425;
+
+	if (brightness > 4090 && !ctx->vdc_enabled) {
+		s6e8fc3x02_set_vdc(dsi_ctx, true);
+		ctx->vdc_enabled = true;
+	} else if (brightness <= 4090 && ctx->vdc_enabled) {
+		s6e8fc3x02_set_vdc(dsi_ctx, false);
+		ctx->vdc_enabled = false;
+	}
+
+	if (brightness > 0x7ff) {
+		panel_level = brightness - 0x800;
+		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x53, 0xe0);
+	} else {
+		panel_level = brightness;
+		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x53, 0x20);
+	}
+
+	brightness_cmd[1] = (panel_level >> 8) & 0x0f;
+	brightness_cmd[2] = panel_level & 0xff;
+	mipi_dsi_dcs_write_buffer_multi(dsi_ctx, brightness_cmd,
+					ARRAY_SIZE(brightness_cmd));
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf7, 0x0b);
+}
+
+static void s6e8fc3x02_panel_init(struct s6e8fc3x02 *ctx,
+				  struct mipi_dsi_multi_context *dsi_ctx)
+{
+	u8 refresh_cmd[] = { 0x60, ctx->refresh_rate == 120 ? 0x01 : 0x21 };
+	u16 brightness = backlight_get_brightness(ctx->backlight);
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x9f, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 20);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x35, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x01, 0x31);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xdf, 0x09, 0x30, 0x95,
+				     0x41, 0x3a, 0x41, 0x3a);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x9d, 0x01);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x9e,
+				     0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x09, 0x60,
+		0x04, 0x38, 0x00, 0x28, 0x02, 0x1c, 0x02, 0x1c,
+		0x02, 0x00, 0x02, 0x0e, 0x00, 0x20, 0x03, 0xdd,
+		0x00, 0x07, 0x00, 0x0c, 0x02, 0x77, 0x02, 0x8b,
+		0x18, 0x00, 0x10, 0xf0, 0x03, 0x0c, 0x20, 0x00,
+		0x06, 0x0b, 0x0b, 0x33, 0x0e, 0x1c, 0x2a, 0x38,
+		0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b,
+		0x7d, 0x7e, 0x01, 0x02, 0x01, 0x00, 0x09, 0x40,
+		0x09, 0xbe, 0x19, 0xfc, 0x19, 0xfa, 0x19, 0xf8,
+		0x1a, 0x38, 0x1a, 0x78, 0x1a, 0xb6, 0x2a, 0xf6,
+		0x2b, 0x34, 0x2b, 0x74, 0x3b, 0x74, 0x6b, 0xf4,
+		0x00);
+
+	/* Flat gamma control. */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x89, 0xb1);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb1, 0x2d);
+
+	mipi_dsi_dcs_write_buffer_multi(dsi_ctx, refresh_cmd,
+					ARRAY_SIZE(refresh_cmd));
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf7, 0x0b);
+
+	/* VINT voltage control. */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x11, 0xfe);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfe, 0x00);
+
+	/* Dimming settings. */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x0d, 0xb2);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x01);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x0c, 0xb2);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x20);
+
+	s6e8fc3x02_set_brightness(ctx, dsi_ctx, brightness);
+
+	/* Error-flag settings. */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xed, 0x01, 0xcd, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xe1, 0x83);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x06, 0xf4);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf4, 0x1f);
+
+	mipi_dsi_msleep(dsi_ctx, 100);
+	mipi_dsi_dcs_set_display_on_multi(dsi_ctx);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfc, 0xa5, 0xa5);
+}
+
+static int s6e8fc3x02_check_id(struct s6e8fc3x02 *ctx)
+{
+	static const u8 expected_id[] = { 0x40, 0x21, 0x01 };
+	u8 id[ARRAY_SIZE(expected_id)];
+	int ret;
+
+	ret = mipi_dsi_dcs_read(ctx->dsi, MIPI_DCS_GET_DISPLAY_ID,
+				id, sizeof(id));
+	if (ret < 0) {
+		dev_warn(&ctx->dsi->dev, "could not read panel ID: %d\n", ret);
+		return 0;
+	}
+	if (ret != sizeof(id))
+		return dev_err_probe(&ctx->dsi->dev, -EIO,
+				     "short panel ID read: %d\n", ret);
+	if (memcmp(id, expected_id, sizeof(id)))
+		return dev_err_probe(&ctx->dsi->dev, -ENODEV,
+				     "unexpected panel ID %*ph\n", (int)sizeof(id), id);
+
+	dev_info(&ctx->dsi->dev, "panel ID %*ph verified\n",
+		 (int)sizeof(id), id);
+	return 0;
+}
+
+static int s6e8fc3x02_prepare(struct drm_panel *panel)
+{
+	struct s6e8fc3x02 *ctx = to_s6e8fc3x02(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	if (ctx->prepared)
+		return 0;
+
+	gpiod_set_value_cansleep(ctx->vddi_en_gpio, 1);
+	usleep_range(1000, 5000);
+	gpiod_set_value_cansleep(ctx->vci_en_gpio, 1);
+	usleep_range(1000, 5000);
+	s6e8fc3x02_reset(ctx);
+
+	s6e8fc3x02_panel_init(ctx, &dsi_ctx);
+	if (dsi_ctx.accum_err) {
+		ret = dsi_ctx.accum_err;
+		goto err_power_off;
+	}
+
+	ret = s6e8fc3x02_check_id(ctx);
+	if (ret)
+		goto err_display_off;
+
+	ctx->prepared = true;
+	ctx->enabled = true;
+	return 0;
+
+err_display_off:
+	mipi_dsi_dcs_set_display_off(ctx->dsi);
+	mipi_dsi_dcs_enter_sleep_mode(ctx->dsi);
+	msleep(160);
+err_power_off:
+	s6e8fc3x02_power_off(ctx);
+	return ret;
+}
+
+static int s6e8fc3x02_enable(struct drm_panel *panel)
+{
+	struct s6e8fc3x02 *ctx = to_s6e8fc3x02(panel);
+
+	if (ctx->enabled)
+		return 0;
+
+	ctx->enabled = true;
+	return backlight_enable(ctx->backlight);
+}
+
+static int s6e8fc3x02_disable(struct drm_panel *panel)
+{
+	struct s6e8fc3x02 *ctx = to_s6e8fc3x02(panel);
+	int ret;
+
+	if (!ctx->enabled)
+		return 0;
+
+	ret = backlight_disable(ctx->backlight);
+	ctx->enabled = false;
+	return ret;
+}
+
+static int s6e8fc3x02_unprepare(struct drm_panel *panel)
+{
+	struct s6e8fc3x02 *ctx = to_s6e8fc3x02(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	if (!ctx->prepared)
+		return 0;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 160);
+
+	ctx->prepared = false;
+	ctx->enabled = false;
+	ctx->vdc_enabled = false;
+	s6e8fc3x02_power_off(ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static const struct drm_display_mode s6e8fc3x02_modes[] = {
+	{
+		.clock = 377349,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 173,
+		.hsync_end = 1080 + 173 + 16,
+		.htotal = 1080 + 173 + 16 + 24,
+		.vdisplay = 2400,
+		.vsync_start = 2400 + 2452,
+		.vsync_end = 2400 + 2452 + 2,
+		.vtotal = 2400 + 2452 + 2 + 10,
+		.width_mm = 83,
+		.height_mm = 148,
+	}, {
+		.clock = 377349,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 173,
+		.hsync_end = 1080 + 173 + 16,
+		.htotal = 1080 + 173 + 16 + 24,
+		.vdisplay = 2400,
+		.vsync_start = 2400 + 20,
+		.vsync_end = 2400 + 20 + 2,
+		.vtotal = 2400 + 20 + 2 + 10,
+		.width_mm = 83,
+		.height_mm = 148,
+	},
+};
+
+static int s6e8fc3x02_get_modes(struct drm_panel *panel,
+				struct drm_connector *connector)
+{
+	struct s6e8fc3x02 *ctx = to_s6e8fc3x02(panel);
+	unsigned int index = ctx->refresh_rate == 120 ? 1 : 0;
+
+	return drm_connector_helper_get_modes_fixed(connector,
+						    &s6e8fc3x02_modes[index]);
+}
+
+static const struct drm_panel_funcs s6e8fc3x02_panel_funcs = {
+	.prepare = s6e8fc3x02_prepare,
+	.enable = s6e8fc3x02_enable,
+	.disable = s6e8fc3x02_disable,
+	.unprepare = s6e8fc3x02_unprepare,
+	.get_modes = s6e8fc3x02_get_modes,
+};
+
+static int s6e8fc3x02_bl_update_status(struct backlight_device *backlight)
+{
+	struct s6e8fc3x02 *ctx = bl_get_data(backlight);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	u16 brightness = backlight_get_brightness(backlight);
+	int ret = 0;
+
+	mutex_lock(&ctx->lock);
+	if (ctx->prepared) {
+		s6e8fc3x02_set_brightness(ctx, &dsi_ctx, brightness);
+		ret = dsi_ctx.accum_err;
+	}
+	mutex_unlock(&ctx->lock);
+
+	return ret;
+}
+
+static const struct backlight_ops s6e8fc3x02_bl_ops = {
+	.update_status = s6e8fc3x02_bl_update_status,
+};
+
+static int s6e8fc3x02_init_dsc(struct s6e8fc3x02 *ctx)
+{
+	struct drm_dsc_config *dsc = &ctx->dsc;
+	int ret;
+
+	dsc->dsc_version_major = 1;
+	dsc->dsc_version_minor = 1;
+	dsc->line_buf_depth = 9;
+	dsc->bits_per_component = 8;
+	dsc->convert_rgb = true;
+	dsc->slice_count = 2;
+	dsc->slice_width = 540;
+	dsc->slice_height = 40;
+	dsc->pic_width = S6E8FC3X02_WIDTH;
+	dsc->pic_height = S6E8FC3X02_HEIGHT;
+	dsc->bits_per_pixel = 8 << 4;
+	dsc->block_pred_enable = true;
+
+	drm_dsc_set_const_params(dsc);
+	drm_dsc_set_rc_buf_thresh(dsc);
+	ret = drm_dsc_setup_rc_params(dsc, DRM_DSC_1_1_PRE_SCR);
+	if (ret)
+		return ret;
+
+	dsc->initial_xmit_delay = 512;
+	dsc->initial_dec_delay = 526;
+	dsc->initial_scale_value = 32;
+	dsc->scale_increment_interval = 989;
+	dsc->scale_decrement_interval = 7;
+	dsc->first_line_bpg_offset = 12;
+	dsc->nfl_bpg_offset = 631;
+	dsc->slice_bpg_offset = 651;
+	dsc->initial_offset = 6144;
+	dsc->final_offset = 4336;
+	dsc->flatness_min_qp = 3;
+	dsc->flatness_max_qp = 12;
+	dsc->rc_model_size = 8192;
+	dsc->rc_edge_factor = 6;
+	dsc->rc_quant_incr_limit0 = 11;
+	dsc->rc_quant_incr_limit1 = 11;
+	dsc->rc_tgt_offset_high = 3;
+	dsc->rc_tgt_offset_low = 3;
+	dsc->slice_chunk_size = 540;
+
+	return 0;
+}
+
+static int s6e8fc3x02_probe(struct mipi_dsi_device *dsi)
+{
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = S6E8FC3X02_MAX_BRIGHTNESS,
+		.brightness = 0,
+	};
+	struct device *dev = &dsi->dev;
+	struct s6e8fc3x02 *ctx;
+	u32 refresh_rate = 60;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e8fc3x02, panel,
+				   &s6e8fc3x02_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	ctx->vddi_en_gpio = devm_gpiod_get(dev, "vddi-en", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->vddi_en_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddi_en_gpio),
+				     "failed to get VDDI enable GPIO\n");
+
+	ctx->vci_en_gpio = devm_gpiod_get(dev, "vci-en", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->vci_en_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vci_en_gpio),
+				     "failed to get VCI enable GPIO\n");
+
+	ret = of_property_read_u32(dev->of_node, "samsung,refresh-rate",
+				   &refresh_rate);
+	if (ret && ret != -EINVAL)
+		return dev_err_probe(dev, ret, "failed to read refresh rate\n");
+	if (refresh_rate != 60 && refresh_rate != 120)
+		return dev_err_probe(dev, -EINVAL,
+				     "refresh rate must be 60 or 120 Hz\n");
+
+	ctx->dsi = dsi;
+	ctx->refresh_rate = refresh_rate;
+	mutex_init(&ctx->lock);
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->backlight =
+		devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
+					       &s6e8fc3x02_bl_ops, &props);
+	if (IS_ERR(ctx->backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->backlight),
+				     "failed to register backlight\n");
+	ctx->panel.backlight = ctx->backlight;
+
+	ret = s6e8fc3x02_init_dsc(ctx);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to initialize DSC\n");
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	dsi->dsc = &ctx->dsc;
+
+	drm_panel_add(&ctx->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void s6e8fc3x02_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e8fc3x02 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret)
+		dev_err(&dsi->dev, "failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e8fc3x02_of_match[] = {
+	{ .compatible = "samsung,s6e8fc3x02" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s6e8fc3x02_of_match);
+
+static struct mipi_dsi_driver s6e8fc3x02_driver = {
+	.probe = s6e8fc3x02_probe,
+	.remove = s6e8fc3x02_remove,
+	.driver = {
+		.name = "panel-samsung-s6e8fc3x02",
+		.of_match_table = s6e8fc3x02_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e8fc3x02_driver);
