From: Tetris Linux bring-up
Subject: [PATCH] remoteproc: mediatek: stage bounded RV33 signed firmware inputs

Provide the real request_firmware/release_firmware ingress for an MT6878
GPUEB owner, retaining immutable offsets into the firmware object rather than
creating an untracked DMA copy. Validate the six MTK section headers, roles,
sizes and padding. A successful staging operation is NOT authentication or
permission to load/start a remote processor. Do not use the remoteproc ELF
default loader on the encrypted RV33 payload.

There is deliberately no platform binding, resource claim, DT activation,
remoteproc start/stop operation, transform command, or claim of physical OFF.
Those require an audited GPUEB-specific secure/boot/reset sequence.

--- a/drivers/remoteproc/Kconfig
+++ b/drivers/remoteproc/Kconfig
@@ -1,4 +1,14 @@
 # SPDX-License-Identifier: GPL-2.0-only
 menu "Remoteproc drivers"
+
+config MTK_MT6878_GPUEB_FW
+	tristate "MediaTek MT6878 GPUEB signed firmware staging"
+	depends on FW_LOADER && (ARM64 || COMPILE_TEST)
+	help
+	  Bounded request_firmware ingress for the RV33 signed container.
+	  This helper neither authenticates nor starts GPUEB. An audited
+	  secure transform and physical power/reset owner are still required.
+	  No devices are bound or activated by enabling this option.
+
 
 config REMOTEPROC
--- a/drivers/remoteproc/Makefile
+++ b/drivers/remoteproc/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
 #
+obj-$(CONFIG_MTK_MT6878_GPUEB_FW) += mtk_gpueb_fw.o
 # Generic framework for controlling remote processors
 #
diff --git a/include/linux/soc/mediatek/mt6878-gpueb-firmware.h b/include/linux/soc/mediatek/mt6878-gpueb-firmware.h
--- /dev/null
+++ b/include/linux/soc/mediatek/mt6878-gpueb-firmware.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MT6878_GPUEB_FIRMWARE_H
+#define __MT6878_GPUEB_FIRMWARE_H
+
+#include <linux/types.h>
+
+struct device;
+struct firmware;
+
+#define MT6878_GPUEB_FW_SECTIONS 6
+#define MT6878_GPUEB_FW_MAX_SIZE (2U * 1024U * 1024U)
+#define MT6878_GPUEB_FW_MAX_CERT 16384U
+
+struct mt6878_gpueb_fw_section {
+	u32 header_offset;
+	u32 payload_offset;
+	u32 payload_size;
+};
+
+/* Immutable staging only: no authenticated/plaintext/boot-ready flags. */
+struct mt6878_gpueb_firmware {
+	const struct firmware *firmware;
+	struct mt6878_gpueb_fw_section sections[MT6878_GPUEB_FW_SECTIONS];
+};
+
+int mt6878_gpueb_fw_parse(const u8 *data, size_t size,
+			struct mt6878_gpueb_fw_section *sections);
+int mt6878_gpueb_fw_request(struct device *dev, const char *name,
+			  struct mt6878_gpueb_firmware **out);
+void mt6878_gpueb_fw_release(struct mt6878_gpueb_firmware *image);
+
+/* No ELF/resource-table parsing, DMA mapping or memory writes are allowed here.
+ * The owner must authenticate ciphertext/header before invoking any transform.
+ */
+
+#endif
diff --git a/drivers/remoteproc/mtk_gpueb_fw.c b/drivers/remoteproc/mtk_gpueb_fw.c
--- /dev/null
+++ b/drivers/remoteproc/mtk_gpueb_fw.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/errno.h>
+#include <linux/firmware.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/soc/mediatek/mt6878-gpueb-firmware.h>
+#include <linux/unaligned.h>
+
+static bool gpueb_fw_zero(const u8 *data, size_t size)
+{
+	while (size--)
+		if (*data++)
+			return false;
+	return true;
+}
+
+int mt6878_gpueb_fw_parse(const u8 *data, size_t size,
+			struct mt6878_gpueb_fw_section *sections)
+{
+	static const char names[MT6878_GPUEB_FW_SECTIONS][32] = {
+		"tinysys-gpueb-RV33_A", "cert1", "cert2",
+		"tinysys-gpueb-RV33_A_xfile", "cert1", "cert2",
+	};
+	struct mt6878_gpueb_fw_section parsed[MT6878_GPUEB_FW_SECTIONS] = {};
+	size_t offset = 0, end, aligned;
+	unsigned int i;
+	u32 payload, role;
+	const u8 *header;
+
+	if (!sections)
+		return -EINVAL;
+	memset(sections, 0, sizeof(parsed));
+	if (!data || !size || size > MT6878_GPUEB_FW_MAX_SIZE)
+		return -EINVAL;
+	for (i = 0; i < MT6878_GPUEB_FW_SECTIONS; i++) {
+		if (size - offset < 512)
+			return -EINVAL;
+		header = data + offset;
+		payload = get_unaligned_le32(header + 4);
+		role = i % 3 == 0 ? 0 : (i % 3 == 1 ? 0x02000000 : 0x02000002);
+		if (get_unaligned_le32(header) != 0x58881688 ||
+		    memcmp(header + 8, names[i], 32) ||
+		    get_unaligned_le32(header + 48) != 0x58891689 ||
+		    get_unaligned_le32(header + 52) != 512 ||
+		    get_unaligned_le32(header + 56) != 1 ||
+		    get_unaligned_le32(header + 60) != role ||
+		    get_unaligned_le32(header + 68) != 16 ||
+		    get_unaligned_le32(header + 72) != 0 ||
+		    get_unaligned_le32(header + 76) != (i % 3 ? 0x22345678 : 0) ||
+		    !payload || payload > size - offset - 512)
+			return -EINVAL;
+		if (i % 3 && payload > MT6878_GPUEB_FW_MAX_CERT)
+			return -EFBIG;
+		if (!i && (payload & 15))
+			return -EINVAL;
+		end = offset + 512 + payload;
+		aligned = (end + 15) & ~(size_t)15;
+		if (aligned > size || !gpueb_fw_zero(data + end, aligned - end))
+			return -EINVAL;
+		parsed[i].header_offset = offset;
+		parsed[i].payload_offset = offset + 512;
+		parsed[i].payload_size = payload;
+		offset = aligned;
+	}
+	if (!gpueb_fw_zero(data + offset, size - offset))
+		return -EINVAL;
+	memcpy(sections, parsed, sizeof(parsed));
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6878_gpueb_fw_parse);
+
+int mt6878_gpueb_fw_request(struct device *dev, const char *name,
+			  struct mt6878_gpueb_firmware **out)
+{
+	struct mt6878_gpueb_firmware *image;
+	const struct firmware *firmware;
+	int ret;
+
+	if (!out)
+		return -EINVAL;
+	*out = NULL;
+	if (!dev || !name || !*name)
+		return -EINVAL;
+	image = kzalloc(sizeof(*image), GFP_KERNEL);
+	if (!image)
+		return -ENOMEM;
+	ret = request_firmware(&firmware, name, dev);
+	if (ret)
+		goto free;
+	ret = mt6878_gpueb_fw_parse(firmware->data, firmware->size, image->sections);
+	if (ret)
+		goto release;
+	image->firmware = firmware;
+	*out = image;
+	return 0;
+release:
+	release_firmware(firmware);
+free:
+	kfree(image);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6878_gpueb_fw_request);
+
+void mt6878_gpueb_fw_release(struct mt6878_gpueb_firmware *image)
+{
+	if (!image)
+		return;
+	release_firmware(image->firmware);
+	kfree(image);
+}
+EXPORT_SYMBOL_GPL(mt6878_gpueb_fw_release);
+
+MODULE_DESCRIPTION("MT6878 GPUEB bounded signed-container staging; no boot activation");
+MODULE_LICENSE("GPL");
