--- a/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris.dts
@@ -97,6 +97,185 @@
 	regulator-max-microvolt = <3000000>;
 };
 
+/*
+ * Downstream hardware inventory. Keep these nodes disabled until their
+ * drivers have been ported and validated independently on the device.
+ */
+&i2c0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+
+	haptic@5f {
+		compatible = "ics,haptic_rt";
+		reg = <0x5f>;
+		enable-gpios = <&pio 74 GPIO_ACTIVE_HIGH>;
+		interrupt-parent = <&pio>;
+		interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
+		status = "disabled";
+	};
+};
+
+&i2c3 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+
+	audio-switch@42 {
+		compatible = "mediatek,hl5280-audioswitch";
+		reg = <0x42>;
+		status = "disabled";
+	};
+};
+
+&i2c5 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <1000000>;
+
+	mt6375: pmic@34 {
+		compatible = "mediatek,mt6375";
+		reg = <0x34>;
+		interrupt-parent = <&pio>;
+		interrupts = <15 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		wakeup-source;
+
+		mt6375_adc: adc {
+			compatible = "mediatek,mt6375-adc";
+			#io-channel-cells = <1>;
+		};
+	};
+};
+
+&i2c6 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+
+	speaker-amp@34 {
+		compatible = "awinic,aw882xx_smartpa";
+		reg = <0x34>;
+		interrupt-parent = <&pio>;
+		interrupts = <41 IRQ_TYPE_EDGE_FALLING>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	speaker-amp@5c {
+		compatible = "richtek,rt5512";
+		reg = <0x5c>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+};
+
+&{/} {
+	consys: consys@18000000 {
+		compatible = "mediatek,mt6878-6631-consys";
+		#thermal-sensor-cells = <0>;
+		reg = <0 0x18000000 0 0x470>,
+		      <0 0x10001000 0 0xee4>,
+		      <0 0x10005000 0 0xa7c>,
+		      <0 0x11ec0000 0 0xa04>,
+		      <0 0x18001000 0 0x658>,
+		      <0 0x18003000 0 0x204>,
+		      <0 0x1800e000 0 0x118>,
+		      <0 0x18011000 0 0x138>,
+		      <0 0x18012000 0 0x98>,
+		      <0 0x18020000 0 0x4c>,
+		      <0 0x18023000 0 0xe28>,
+		      <0 0x1803b000 0 0x18>,
+		      <0 0x18040000 0 0x2c>,
+		      <0 0x18041000 0 0x140>,
+		      <0 0x18042000 0 0x324>,
+		      <0 0x18046000 0 0x324>,
+		      <0 0x1804b000 0 0x414>,
+		      <0 0x1804d000 0 0x41c>,
+		      <0 0x1804f000 0 0x148>,
+		      <0 0x18053800 0 0x1000>,
+		      <0 0x18060000 0 0xbf8>,
+		      <0 0x18070000 0 0x8004>,
+		      <0 0x1c001000 0 0xfd0>,
+		      <0 0x1c00a000 0 0x51c>,
+		      <0 0x1803c000 0 0x34>,
+		      <0 0x1803e000 0 0x34>;
+		power-domains = <&scpsys MT6878_POWER_DOMAIN_CONN>;
+		emi-addr = <0>;
+		emi-size = <0x0c00000>;
+		ro-bt-emi-size = <0x2e0000>;
+		ro-gps-emi-size = <0x0a0000>;
+		ro-wifi-emi-size = <0x300000>;
+		ro-emi-size = <0x680000>;
+		rw-emi-size = <0x480000>;
+		emi-alignment = <0x100000>;
+		emi-max-addr = <0x90000000>;
+		hwid-node = <92>;
+		adie-sku = <0 1>;
+		vcn13-supply = <&mt6363_vcn13>;
+		vrfio18-supply = <&mt6363_vrfio18>;
+		vcn33-1-supply = <&mt6369_vcn33_1>;
+		vcn33-2-supply = <&mt6369_vcn33_2>;
+		status = "okay";
+	};
+
+	bt: bluetooth@18800000 {
+		compatible = "mediatek,bt";
+		reg = <0 0x18800000 0 0x1000>,
+		      <0 0x18000000 0 0x1000>,
+		      <0 0x18001000 0 0x1000>,
+		      <0 0x18051000 0 0x1000>,
+		      <0 0x18060000 0 0x1000>,
+		      <0 0x18812000 0 0x1000>,
+		      <0 0x10001000 0 0x1000>;
+		interrupts = <GIC_SPI 693 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 132 IRQ_TYPE_LEVEL_HIGH 0>;
+		status = "disabled";
+	};
+
+	wifi: wifi@18400000 {
+		compatible = "mediatek,wifi";
+		remap-idx = <1>;
+		reg = <0 0x18400000 0 0>,
+		      <0 0x18000000 0 0x700000>;
+		interrupts = <GIC_SPI 484 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 692 IRQ_TYPE_LEVEL_HIGH 0>;
+		emi-addr = <0>;
+		emi-size = <0x1400000>;
+		emi-alignment = <0x1000000>;
+		emi-max-addr = <0xc0000000>;
+		status = "disabled";
+	};
+
+	gps: gnss@18c00000 {
+		compatible = "mediatek,mt6878-gps";
+		reg = <0 0x18c00000 0 0x100000>,
+		      <0 0x18000000 0 0x100000>,
+		      <0 0x1c000000 0 0x4>,
+		      <0 0x1c013058 0 0x4>,
+		      <0 0x1c013060 0 0x4>,
+		      <0 0x1c0130f8 0 0x28>;
+		reg-names = "conn_gps_base", "conn_infra_base",
+			    "status_dummy_cr", "tia2_gps_on", "tia2_gps_rc_sel",
+			    "tia2_gps_debug";
+		interrupts = <GIC_SPI 379 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 380 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 381 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 382 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 383 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 389 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH 0>;
+		emi-connac-ver = <2>;
+		emi-addr = <0>;
+		emi-size = <0x100000>;
+		emi-alignment = <0x100000>;
+		emi-max-addr = <0xc0000000>;
+		b13b14-status-addr = <0x1c000008>;
+		status = "disabled";
+	};
+};
