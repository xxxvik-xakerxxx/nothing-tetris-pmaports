From 65839d49c1f1461465a6ad32fd8a80fa3e82c05a Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Sun, 6 Sep 2026 07:35:00 +0300
Subject: [PATCH 1/3] dt-bindings: mediatek: add bounded MT6878 display DMA

Document the MT6878 display IOMMU, Gen3 SMI common and larb compatibles.
The initial memory-port namespace is intentionally limited to the two
OVL0_2L ports used by the native display path.

Signed-off-by: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
---
 Documentation/devicetree/bindings/iommu/mediatek,iommu.yaml | 3 +++
 Documentation/devicetree/bindings/memory-controllers/mediatek,smi-common.yaml | 3 +++
 Documentation/devicetree/bindings/memory-controllers/mediatek,smi-larb.yaml | 2 ++
 include/dt-bindings/memory/mediatek,mt6878-memory-port.h | 10 ++++++++++
 4 files changed, 18 insertions(+)

diff --git a/Documentation/devicetree/bindings/iommu/mediatek,iommu.yaml b/Documentation/devicetree/bindings/iommu/mediatek,iommu.yaml
index f49ed8a..15106a9 100644
--- a/Documentation/devicetree/bindings/iommu/mediatek,iommu.yaml
+++ b/Documentation/devicetree/bindings/iommu/mediatek,iommu.yaml
@@ -74,6 +74,7 @@ properties:
           - mediatek,mt2712-m4u  # generation two
           - mediatek,mt6779-m4u  # generation two
           - mediatek,mt6795-m4u  # generation two
+          - mediatek,mt6878-disp-iommu  # generation two page table format
           - mediatek,mt6893-iommu-mm         # generation two
           - mediatek,mt8167-m4u  # generation two
           - mediatek,mt8173-m4u  # generation two
@@ -132,6 +133,7 @@ properties:
       dt-binding/memory/mt2712-larb-port.h for mt2712,
       dt-binding/memory/mt6779-larb-port.h for mt6779,
       dt-binding/memory/mt6795-larb-port.h for mt6795,
+      dt-binding/memory/mediatek,mt6878-memory-port.h for mt6878,
       dt-binding/memory/mediatek,mt6893-memory-port.h for mt6893,
       dt-binding/memory/mt8167-larb-port.h for mt8167,
       dt-binding/memory/mt8173-larb-port.h for mt8173,
@@ -177,6 +179,7 @@ allOf:
         compatible:
           enum:
             - mediatek,mt6893-iommu-mm
+            - mediatek,mt6878-disp-iommu
             - mediatek,mt8186-iommu-mm
             - mediatek,mt8188-iommu-vdo
             - mediatek,mt8188-iommu-vpp
diff --git a/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-common.yaml b/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-common.yaml
index 0762e0f..f6ae6ae 100644
--- a/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-common.yaml
+++ b/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-common.yaml
@@ -17,6 +17,7 @@ description: |
   which generation the SoCs use:
   generation 1: mt2701 and mt7623.
   generation 2: mt2712, mt6779, mt8167, mt8173, mt8183, mt8186, mt8188, mt8192 and mt8195.
+  generation 3: mt6878.
 
   There's slight differences between the two SMI, for generation 2, the
   register which control the iommu port is at each larb's register base. But
@@ -33,6 +34,7 @@ properties:
           - mediatek,mt2712-smi-common
           - mediatek,mt6779-smi-common
           - mediatek,mt6795-smi-common
+          - mediatek,mt6878-smi-common
           - mediatek,mt6893-smi-common
           - mediatek,mt8167-smi-common
           - mediatek,mt8173-smi-common
@@ -155,6 +157,7 @@ allOf:
           enum:
             - mediatek,mt2712-smi-common
             - mediatek,mt6795-smi-common
+            - mediatek,mt6878-smi-common
             - mediatek,mt8167-smi-common
             - mediatek,mt8173-smi-common
 
diff --git a/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-larb.yaml b/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-larb.yaml
index 2e7fac4..16c6b18 100644
--- a/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-larb.yaml
+++ b/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-larb.yaml
@@ -21,6 +21,7 @@ properties:
           - mediatek,mt2712-smi-larb
           - mediatek,mt6779-smi-larb
           - mediatek,mt6795-smi-larb
+          - mediatek,mt6878-smi-larb
           - mediatek,mt6893-smi-larb
           - mediatek,mt8167-smi-larb
           - mediatek,mt8173-smi-larb
@@ -117,6 +118,7 @@ allOf:
               - mediatek,mt2701-smi-larb
               - mediatek,mt2712-smi-larb
               - mediatek,mt6779-smi-larb
+              - mediatek,mt6878-smi-larb
               - mediatek,mt8186-smi-larb
               - mediatek,mt8188-smi-larb
               - mediatek,mt8192-smi-larb
diff --git a/include/dt-bindings/memory/mediatek,mt6878-memory-port.h b/include/dt-bindings/memory/mediatek,mt6878-memory-port.h
new file mode 100644
index 000000000..9e5f546bd
--- /dev/null
+++ b/include/dt-bindings/memory/mediatek,mt6878-memory-port.h
@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+#ifndef __DT_BINDINGS_MEMORY_MEDIATEK_MT6878_MEMORY_PORT_H
+#define __DT_BINDINGS_MEMORY_MEDIATEK_MT6878_MEMORY_PORT_H
+
+#include <dt-bindings/memory/mtk-memory-port.h>
+
+#define M4U_L0_P1_DISP_OVL0_2L_HDR	MTK_M4U_ID(0, 1)
+#define M4U_L0_P2_DISP_OVL0_2L_RDMA0	MTK_M4U_ID(0, 2)
+
+#endif
