+	GATE_AFE1(CLK_AFE_APLL2, "afe_apll2_ck", "aud_2_ck", 3),
+	GATE_AFE1(CLK_AFE_H208M, "afe_h208m_ck", "audio_h_ck", 4),
+	GATE_AFE1(CLK_AFE_APLL_TUNER2, "afe_apll_tuner2",
+		  "aud_engen2_ck", 12),
+	GATE_AFE1(CLK_AFE_APLL_TUNER1, "afe_apll_tuner1",
