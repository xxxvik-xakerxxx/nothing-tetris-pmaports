diff --git a/drivers/power/supply/mt6375-charger.c b/drivers/power/supply/mt6375-charger.c
new file mode 100644
index 0000000000000000000000000000000000000000..bab5d928049bc1790b08f38a8dea823fab740824
--- /dev/null
+++ b/drivers/power/supply/mt6375-charger.c
@@ -0,0 +1,385 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6375 charger controller
+ *
+ * Source detection and charging policy are intentionally left to userspace
+ * or a separate policy driver.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/linear_range.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+
+#define MT6375_REG_CHG_TOP1	0x120
+#define MT6375_REG_CHG_AICR	0x122
+#define MT6375_REG_CHG_MIVR	0x123
+#define MT6375_REG_CHG_VCHG	0x125
+#define MT6375_REG_CHG_ICHG	0x126
+#define MT6375_REG_CHG_STAT	0x134
+
+enum mt6375_charger_field_id {
+	MT6375_FIELD_CHG_EN,
+	MT6375_FIELD_AICR,
+	MT6375_FIELD_MIVR,
+	MT6375_FIELD_CV,
+	MT6375_FIELD_ICHG,
+	MT6375_FIELD_STATUS,
+	MT6375_FIELD_MAX,
+};
+
+enum mt6375_charger_status {
+	MT6375_STATUS_SLEEP,
+	MT6375_STATUS_VBUS_READY,
+	MT6375_STATUS_TRICKLE,
+	MT6375_STATUS_PRECHARGE,
+	MT6375_STATUS_FAST_CHARGE,
+	MT6375_STATUS_EOC,
+	MT6375_STATUS_BACKGROUND,
+	MT6375_STATUS_DONE,
+	MT6375_STATUS_FAULT,
+	MT6375_STATUS_OTG = 15,
+};
+
+struct mt6375_charger_range {
+	struct linear_range range;
+	bool round_up;
+};
+
+struct mt6375_charger_field {
+	const struct reg_field field;
+	const struct mt6375_charger_range *range;
+};
+
+struct mt6375_charger {
+	struct regmap_field *fields[MT6375_FIELD_MAX];
+	struct power_supply *psy;
+};
+
+static const struct mt6375_charger_range mt6375_aicr_range = {
+	.range = LINEAR_RANGE(100000, 2, 127, 25000),
+};
+
+static const struct mt6375_charger_range mt6375_ichg_range = {
+	.range = LINEAR_RANGE(300000, 6, 63, 50000),
+};
+
+static const struct mt6375_charger_range mt6375_mivr_range = {
+	.range = LINEAR_RANGE(3900000, 0, 95, 100000),
+	.round_up = true,
+};
+
+static const struct mt6375_charger_range mt6375_cv_range = {
+	.range = LINEAR_RANGE(3900000, 0, 81, 10000),
+};
+
+static const struct mt6375_charger_field mt6375_charger_fields[] = {
+	[MT6375_FIELD_CHG_EN] = {
+		.field = REG_FIELD(MT6375_REG_CHG_TOP1, 0, 0),
+	},
+	[MT6375_FIELD_AICR] = {
+		.field = REG_FIELD(MT6375_REG_CHG_AICR, 0, 6),
+		.range = &mt6375_aicr_range,
+	},
+	[MT6375_FIELD_MIVR] = {
+		.field = REG_FIELD(MT6375_REG_CHG_MIVR, 0, 6),
+		.range = &mt6375_mivr_range,
+	},
+	[MT6375_FIELD_CV] = {
+		.field = REG_FIELD(MT6375_REG_CHG_VCHG, 0, 6),
+		.range = &mt6375_cv_range,
+	},
+	[MT6375_FIELD_ICHG] = {
+		.field = REG_FIELD(MT6375_REG_CHG_ICHG, 0, 5),
+		.range = &mt6375_ichg_range,
+	},
+	[MT6375_FIELD_STATUS] = {
+		.field = REG_FIELD(MT6375_REG_CHG_STAT, 0, 3),
+	},
+};
+
+static unsigned int
+mt6375_charger_selector_to_value(const struct mt6375_charger_range *range,
+				 unsigned int selector)
+{
+	const struct linear_range *r = &range->range;
+
+	selector = clamp(selector, r->min_sel, r->max_sel);
+
+	return r->min + (selector - r->min_sel) * r->step;
+}
+
+static unsigned int
+mt6375_charger_value_to_selector(const struct mt6375_charger_range *range,
+				 int value)
+{
+	const struct linear_range *r = &range->range;
+	unsigned int delta;
+	unsigned int selector;
+	unsigned int maximum;
+
+	maximum = linear_range_get_max_value(r);
+	if (value <= r->min)
+		return r->min_sel;
+	if (value >= maximum)
+		return r->max_sel;
+
+	delta = value - r->min;
+	selector = range->round_up ? DIV_ROUND_UP(delta, r->step) :
+				     delta / r->step;
+
+	return clamp(r->min_sel + selector, r->min_sel, r->max_sel);
+}
+
+static int mt6375_charger_field_read(struct mt6375_charger *charger,
+				     enum mt6375_charger_field_id id,
+				     unsigned int *value)
+{
+	const struct mt6375_charger_field *field = &mt6375_charger_fields[id];
+	unsigned int selector;
+	int ret;
+
+	ret = regmap_field_read(charger->fields[id], &selector);
+	if (ret)
+		return ret;
+
+	*value = field->range ?
+		mt6375_charger_selector_to_value(field->range, selector) :
+		selector;
+
+	return 0;
+}
+
+static int mt6375_charger_field_write(struct mt6375_charger *charger,
+				      enum mt6375_charger_field_id id,
+				      int value)
+{
+	const struct mt6375_charger_field *field = &mt6375_charger_fields[id];
+	unsigned int selector;
+
+	selector = field->range ?
+		mt6375_charger_value_to_selector(field->range, value) : !!value;
+
+	return regmap_field_write(charger->fields[id], selector);
+}
+
+static int mt6375_charger_get_status(struct mt6375_charger *charger,
+				     union power_supply_propval *value)
+{
+	unsigned int enabled;
+	unsigned int status;
+	int ret;
+
+	ret = mt6375_charger_field_read(charger, MT6375_FIELD_CHG_EN,
+					&enabled);
+	if (ret)
+		return ret;
+
+	ret = mt6375_charger_field_read(charger, MT6375_FIELD_STATUS, &status);
+	if (ret)
+		return ret;
+
+	switch (status) {
+	case MT6375_STATUS_OTG:
+		value->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		break;
+	case MT6375_STATUS_VBUS_READY:
+	case MT6375_STATUS_TRICKLE:
+	case MT6375_STATUS_PRECHARGE:
+	case MT6375_STATUS_FAST_CHARGE:
+	case MT6375_STATUS_EOC:
+	case MT6375_STATUS_BACKGROUND:
+		value->intval = enabled ? POWER_SUPPLY_STATUS_CHARGING :
+					   POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	case MT6375_STATUS_DONE:
+		value->intval = POWER_SUPPLY_STATUS_FULL;
+		break;
+	case MT6375_STATUS_SLEEP:
+	case MT6375_STATUS_FAULT:
+		value->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	default:
+		value->intval = POWER_SUPPLY_STATUS_UNKNOWN;
+		break;
+	}
+
+	return 0;
+}
+
+static enum power_supply_property mt6375_charger_properties[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+	POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE,
+};
+
+static int mt6375_charger_get_property(struct power_supply *psy,
+				       enum power_supply_property property,
+				       union power_supply_propval *value)
+{
+	struct mt6375_charger *charger = power_supply_get_drvdata(psy);
+	unsigned int enabled;
+	unsigned int raw;
+	int ret;
+
+	switch (property) {
+	case POWER_SUPPLY_PROP_STATUS:
+		return mt6375_charger_get_status(charger, value);
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		ret = mt6375_charger_field_read(charger, MT6375_FIELD_CHG_EN,
+						&enabled);
+		if (ret)
+			return ret;
+		value->intval = enabled ? POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO :
+					  POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+		return 0;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		ret = mt6375_charger_field_read(charger, MT6375_FIELD_AICR, &raw);
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		ret = mt6375_charger_field_read(charger, MT6375_FIELD_ICHG, &raw);
+		break;
+	case POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT:
+		ret = mt6375_charger_field_read(charger, MT6375_FIELD_MIVR, &raw);
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		ret = mt6375_charger_field_read(charger, MT6375_FIELD_CV, &raw);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (!ret)
+		value->intval = raw;
+
+	return ret;
+}
+
+static int mt6375_charger_set_property(struct power_supply *psy,
+				       enum power_supply_property property,
+				       const union power_supply_propval *value)
+{
+	struct mt6375_charger *charger = power_supply_get_drvdata(psy);
+	enum mt6375_charger_field_id id;
+
+	switch (property) {
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		switch (value->intval) {
+		case POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO:
+			return mt6375_charger_field_write(charger,
+							  MT6375_FIELD_CHG_EN, 1);
+		case POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE:
+			return mt6375_charger_field_write(charger,
+							  MT6375_FIELD_CHG_EN, 0);
+		default:
+			return -EINVAL;
+		}
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		id = MT6375_FIELD_AICR;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		id = MT6375_FIELD_ICHG;
+		break;
+	case POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT:
+		id = MT6375_FIELD_MIVR;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		id = MT6375_FIELD_CV;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return mt6375_charger_field_write(charger, id, value->intval);
+}
+
+static int mt6375_charger_property_is_writeable(struct power_supply *psy,
+						enum power_supply_property property)
+{
+	switch (property) {
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+	case POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT:
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static const struct power_supply_desc mt6375_charger_desc = {
+	.name = "mt6375-charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.charge_behaviours = BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO) |
+			     BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE),
+	.properties = mt6375_charger_properties,
+	.num_properties = ARRAY_SIZE(mt6375_charger_properties),
+	.get_property = mt6375_charger_get_property,
+	.set_property = mt6375_charger_set_property,
+	.property_is_writeable = mt6375_charger_property_is_writeable,
+};
+
+static int mt6375_charger_probe(struct platform_device *pdev)
+{
+	struct power_supply_config config = {};
+	struct mt6375_charger *charger;
+	struct regmap *regmap;
+	unsigned int i;
+
+	regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!regmap)
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "parent regmap is unavailable\n");
+
+	charger = devm_kzalloc(&pdev->dev, sizeof(*charger), GFP_KERNEL);
+	if (!charger)
+		return -ENOMEM;
+
+	for (i = 0; i < MT6375_FIELD_MAX; i++) {
+		charger->fields[i] =
+			devm_regmap_field_alloc(&pdev->dev, regmap,
+						mt6375_charger_fields[i].field);
+		if (IS_ERR(charger->fields[i]))
+			return dev_err_probe(&pdev->dev,
+					     PTR_ERR(charger->fields[i]),
+					     "failed to allocate field %u\n", i);
+	}
+
+	config.drv_data = charger;
+	charger->psy = devm_power_supply_register(&pdev->dev,
+						  &mt6375_charger_desc,
+						  &config);
+	if (IS_ERR(charger->psy))
+		return dev_err_probe(&pdev->dev, PTR_ERR(charger->psy),
+				     "failed to register power supply\n");
+
+	platform_set_drvdata(pdev, charger);
+	return 0;
+}
+
+static const struct of_device_id mt6375_charger_of_match[] = {
+	{ .compatible = "mediatek,mt6375-charger" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6375_charger_of_match);
+
+static struct platform_driver mt6375_charger_driver = {
+	.probe = mt6375_charger_probe,
+	.driver = {
+		.name = "mt6375-charger",
+		.of_match_table = mt6375_charger_of_match,
+	},
+};
+module_platform_driver(mt6375_charger_driver);
+
+MODULE_AUTHOR("xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>");
+MODULE_DESCRIPTION("MediaTek MT6375 charger controller");
+MODULE_LICENSE("GPL");
