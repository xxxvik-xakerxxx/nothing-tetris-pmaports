diff --git a/connectivity/gps/data_link/linux/inc/uapi/gpsdl_v051.h b/connectivity/gps/data_link/linux/inc/uapi/gpsdl_v051.h
new file mode 100644
index 0000000..1919e0c
--- /dev/null
+++ b/connectivity/gps/data_link/linux/inc/uapi/gpsdl_v051.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * Read-only userspace ABI for the MediaTek GPS data-link v051 driver.
+ *
+ * The driver intentionally uses plain integer ioctl command values rather
+ * than _IO*()-encoded commands. Keep these values and layouts stable.
+ */
+
+#ifndef _UAPI_GPSDL_V051_H
+#define _UAPI_GPSDL_V051_H
+
+#include <linux/types.h>
+
+#define GPSDL_V051_IOC_QUERY_STATUS		13U
+#define GPSDL_V051_IOC_GET_DSP_BOOTUP_INFO	23U
+#define GPSDL_V051_IOC_GET_BOOT_TIME		28U
+
+struct gpsdl_v051_boot_time {
+	__s64 now_time;
+	__s64 arch_counter;
+};
+
+struct gpsdl_v051_bootup_info {
+	__u32 code_size;
+	__u32 start_addr;
+	__u32 exec_addr;
+	__u32 cipher_key;
+	__u32 frag_num;
+};
+
+#endif /* _UAPI_GPSDL_V051_H */
diff --git a/connectivity/gps/data_link/tests/gpsdl_v051_abi_test.c b/connectivity/gps/data_link/tests/gpsdl_v051_abi_test.c
new file mode 100644
index 0000000..f14e9bf
--- /dev/null
+++ b/connectivity/gps/data_link/tests/gpsdl_v051_abi_test.c
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <stddef.h>
+
+#include "../linux/inc/uapi/gpsdl_v051.h"
+
+_Static_assert(GPSDL_V051_IOC_QUERY_STATUS == 13U,
+	"query-status command changed");
+_Static_assert(GPSDL_V051_IOC_GET_DSP_BOOTUP_INFO == 23U,
+	"boot-info command changed");
+_Static_assert(GPSDL_V051_IOC_GET_BOOT_TIME == 28U,
+	"boot-time command changed");
+
+_Static_assert(sizeof(struct gpsdl_v051_boot_time) == 16,
+	"boot-time size changed");
+_Static_assert(offsetof(struct gpsdl_v051_boot_time, now_time) == 0,
+	"boot-time now_time offset changed");
+_Static_assert(offsetof(struct gpsdl_v051_boot_time, arch_counter) == 8,
+	"boot-time arch_counter offset changed");
+
+_Static_assert(sizeof(struct gpsdl_v051_bootup_info) == 20,
+	"boot-info size changed");
+_Static_assert(offsetof(struct gpsdl_v051_bootup_info, code_size) == 0,
+	"boot-info code_size offset changed");
+_Static_assert(offsetof(struct gpsdl_v051_bootup_info, start_addr) == 4,
+	"boot-info start_addr offset changed");
+_Static_assert(offsetof(struct gpsdl_v051_bootup_info, exec_addr) == 8,
+	"boot-info exec_addr offset changed");
+_Static_assert(offsetof(struct gpsdl_v051_bootup_info, cipher_key) == 12,
+	"boot-info cipher_key offset changed");
+_Static_assert(offsetof(struct gpsdl_v051_bootup_info, frag_num) == 16,
+	"boot-info frag_num offset changed");
+
+int main(void)
+{
+	return 0;
+}
diff --git a/connectivity/gps/data_link/tests/run_gpsdl_v051_abi_test.sh b/connectivity/gps/data_link/tests/run_gpsdl_v051_abi_test.sh
new file mode 100755
index 0000000..ae61e5f
--- /dev/null
+++ b/connectivity/gps/data_link/tests/run_gpsdl_v051_abi_test.sh
@@ -0,0 +1,31 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+
+set -eu
+
+test_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+uapi_header="$test_dir/../linux/inc/uapi/gpsdl_v051.h"
+tmp_dir=$(mktemp -d)
+trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
+
+mkdir -p "$tmp_dir/include/linux"
+cat >"$tmp_dir/include/linux/types.h" <<'EOF'
+#ifndef _HOST_TEST_LINUX_TYPES_H
+#define _HOST_TEST_LINUX_TYPES_H
+typedef signed long long __s64;
+typedef unsigned int __u32;
+#endif
+EOF
+
+"${CC:-cc}" -std=c11 -Wall -Wextra -Werror -pedantic \
+	-I"$tmp_dir/include" \
+	"$test_dir/gpsdl_v051_abi_test.c" \
+	-o "$tmp_dir/gpsdl_v051_abi_test"
+"$tmp_dir/gpsdl_v051_abi_test"
+
+test "$(grep -c '^#define GPSDL_V051_IOC_' "$uapi_header")" -eq 3
+if grep -Eq 'TRIGGER_ASSERT|HW_SUSPEND|HW_RESUME|FRAGEMENT|FWCTL|RESET|RAW|LINK_ID1' \
+	"$uapi_header"; then
+	echo "unsafe or unvalidated API leaked into gpsdl_v051.h" >&2
+	exit 1
+fi

