+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/adc/mediatek,mt6375-auxadc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6375 battery auxiliary ADC
+
+maintainers:
+  - xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
+
+description:
+  The MT6375 battery auxiliary ADC measures battery voltage, the battery
+  thermistor divider and its reference voltage. It is a child of the MT6375
+  PMIC and uses the regmap provided by the parent device.
+
+properties:
+  compatible:
+    const: mediatek,mt6375-auxadc
+
+  "#io-channel-cells":
+    const: 1
+
+required:
+  - compatible
+  - "#io-channel-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    pmic {
+        auxadc {
+            compatible = "mediatek,mt6375-auxadc";
+            #io-channel-cells = <1>;
+        };
+    };
+
+...
