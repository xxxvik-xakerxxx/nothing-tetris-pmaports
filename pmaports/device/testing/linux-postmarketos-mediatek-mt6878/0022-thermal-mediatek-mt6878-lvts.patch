diff --git a/drivers/nvmem/mtk-mt6878-devinfo.c b/drivers/nvmem/mtk-mt6878-devinfo.c
new file mode 100644
index 0000000..a4df33e
--- /dev/null
+++ b/drivers/nvmem/mtk-mt6878-devinfo.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6878 device information NVMEM provider
+ *
+ * MediaTek LK exposes these read-only SoC registers through its devinfo ABI.
+ * Keep the sparse index mapping here so Linux reads per-device calibration
+ * directly instead of depending on a bootloader-generated data blob.
+ */
+
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/nvmem-provider.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#define MT6878_DEVINFO_WORDS	199
+
+struct mt6878_devinfo_map {
+	u16 index;
+	u16 offset;
+};
+
+struct mt6878_devinfo {
+	void __iomem *base;
+};
+
+static const struct mt6878_devinfo_map mt6878_lvts_words[] = {
+	{ 80, 0x1d0 }, { 81, 0x1d4 }, { 82, 0x1d8 }, { 83, 0x1dc },
+	{ 84, 0x1e0 },
+	{ 107, 0x19c }, { 108, 0x1a0 }, { 109, 0x1a4 }, { 110, 0x1a8 },
+	{ 111, 0x1ac }, { 112, 0x1b0 }, { 113, 0x1b4 }, { 114, 0x1b8 },
+	{ 115, 0x1bc }, { 116, 0x1c0 }, { 117, 0x1c4 }, { 118, 0x1c8 },
+	{ 182, 0x304 },
+	{ 196, 0x1e8 }, { 197, 0x1ec }, { 198, 0x1f0 },
+};
+
+static const struct mt6878_devinfo_map *mt6878_devinfo_find(unsigned int index)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(mt6878_lvts_words); i++)
+		if (mt6878_lvts_words[i].index == index)
+			return &mt6878_lvts_words[i];
+
+	return NULL;
+}
+
+static int mt6878_devinfo_read(void *context, unsigned int offset,
+			       void *value, size_t bytes)
+{
+	struct mt6878_devinfo *devinfo = context;
+	u8 *out = value;
+
+	if (offset > MT6878_DEVINFO_WORDS * sizeof(u32) ||
+	    bytes > MT6878_DEVINFO_WORDS * sizeof(u32) - offset)
+		return -EINVAL;
+
+	while (bytes) {
+		const struct mt6878_devinfo_map *map;
+		unsigned int word_offset = offset % sizeof(u32);
+		size_t chunk = min_t(size_t, bytes, sizeof(u32) - word_offset);
+		u32 word;
+
+		map = mt6878_devinfo_find(offset / sizeof(u32));
+		if (!map)
+			return -EINVAL;
+
+		word = readl(devinfo->base + map->offset);
+		memcpy(out, (u8 *)&word + word_offset, chunk);
+		offset += chunk;
+		out += chunk;
+		bytes -= chunk;
+	}
+
+	return 0;
+}
+
+static int mt6878_devinfo_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mt6878_devinfo *devinfo;
+	struct nvmem_config config = {};
+	struct nvmem_device *nvmem;
+
+	devinfo = devm_kzalloc(dev, sizeof(*devinfo), GFP_KERNEL);
+	if (!devinfo)
+		return -ENOMEM;
+
+	devinfo->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(devinfo->base))
+		return PTR_ERR(devinfo->base);
+
+	config.name = "mt6878-devinfo";
+	config.dev = dev;
+	config.owner = THIS_MODULE;
+	config.read_only = true;
+	config.root_only = true;
+	config.stride = 1;
+	config.word_size = 1;
+	config.size = MT6878_DEVINFO_WORDS * sizeof(u32);
+	config.reg_read = mt6878_devinfo_read;
+	config.priv = devinfo;
+
+	nvmem = devm_nvmem_register(dev, &config);
+	if (IS_ERR(nvmem))
+		return dev_err_probe(dev, PTR_ERR(nvmem),
+				     "failed to register NVMEM provider\n");
+
+	dev_info(dev, "registered read-only LVTS calibration cells\n");
+
+	return 0;
+}
+
+static const struct of_device_id mt6878_devinfo_of_match[] = {
+	{ .compatible = "mediatek,mt6878-devinfo" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6878_devinfo_of_match);
+
+static struct platform_driver mt6878_devinfo_driver = {
+	.probe = mt6878_devinfo_probe,
+	.driver = {
+		.name = "mt6878-devinfo",
+		.of_match_table = mt6878_devinfo_of_match,
+	},
+};
+module_platform_driver(mt6878_devinfo_driver);
+
+MODULE_AUTHOR("xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>");
+MODULE_DESCRIPTION("MediaTek MT6878 device information NVMEM provider");
+MODULE_LICENSE("GPL");
