From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Tue, 4 Aug 2026 22:40:00 +0300
Subject: [PATCH] thermal: mediatek: add polling-only MT6878 LVTS

Port the MT6878 generation-v6 initialization, calibration formula, sensor map, and controller timing from Nothing OS 4.1. Read the per-device LVTS calibration directly from the MT6878 read-only devinfo registers through a sparse NVMEM provider.

Keep thermal protection IRQs and hardware trips disabled. The vendor kernel carries a reboot workaround for these domains, so this first stage only exports polled temperatures until interrupt routing is validated on hardware.

Signed-off-by: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
---
diff --git a/Documentation/devicetree/bindings/nvmem/mediatek,mt6878-devinfo.yaml b/Documentation/devicetree/bindings/nvmem/mediatek,mt6878-devinfo.yaml
new file mode 100644
index 0000000..bd62382
--- /dev/null
+++ b/Documentation/devicetree/bindings/nvmem/mediatek,mt6878-devinfo.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/nvmem/mediatek,mt6878-devinfo.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 device information registers
+
+maintainers:
+  - xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
+
+description: |
+  MT6878 stores per-device calibration words in read-only SoC registers.
+  The register addresses are indexed using the MediaTek devinfo ABI so
+  hardware drivers can consume fixed calibration cells through NVMEM.
+
+allOf:
+  - $ref: nvmem.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6878-devinfo
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    devinfo@11f10000 {
+      compatible = "mediatek,mt6878-devinfo";
+      reg = <0x11f10000 0x1000>;
+
+      nvmem-layout {
+        compatible = "fixed-layout";
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        thermal-calibration@1ac {
+          reg = <0x1ac 0x30>;
+        };
+      };
+    };
