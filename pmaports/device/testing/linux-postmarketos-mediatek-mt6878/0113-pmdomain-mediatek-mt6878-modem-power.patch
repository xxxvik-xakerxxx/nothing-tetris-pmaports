diff --git a/drivers/pmdomain/mediatek/mt6878-modem-pm.h b/drivers/pmdomain/mediatek/mt6878-modem-pm.h
new file mode 100644
--- /dev/null
+++ b/drivers/pmdomain/mediatek/mt6878-modem-pm.h
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included after scpsys types/helpers: deliberately modem-only. */
+#define MT6878_MD_CTL 0x0e00
+#define MT6878_MD_ISO 0x0f24
+#define MT6878_MD_ISO_MASK GENMASK(1, 0)
+#define MT6878_MD_ACK GENMASK(31, 30)
+
+static enum scpsys_bus_prot_block mt6878_md_blocks[] = {
+	BUS_PROT_BLOCK_INFRA, BUS_PROT_BLOCK_NEMICFG,
+};
+
+static const struct scpsys_domain_data mt6878_md_domains[] = {
+	[0] = {
+		.name = "md",
+		.sta_mask = MT6878_MD_ACK,
+		.ctl_offs = MT6878_MD_CTL,
+		.pwr_sta_offs = MT6878_MD_CTL,
+		.pwr_sta2nd_offs = MT6878_MD_CTL,
+		.caps = MTK_SCPD_MT6878_MD | MTK_SCPD_KEEP_DEFAULT_OFF |
+			MTK_SCPD_STATUS_IN_CTL | MTK_SCPD_SKIP_RESET_B,
+		.bp_cfg = {
+			BUS_PROT_WR(INFRA, BIT(9), 0x0c54, 0x0c58, 0x0c5c),
+			BUS_PROT_WR(INFRA, BIT(11), 0x0c44, 0x0c48, 0x0c4c),
+			BUS_PROT_WR(NEMICFG, BIT(6) | BIT(7), 0x84, 0x88, 0x8c),
+		},
+	},
+};
+
+static const struct scpsys_soc_data mt6878_md_scpsys_data = {
+	.domains_data = mt6878_md_domains,
+	.num_domains = ARRAY_SIZE(mt6878_md_domains),
+	.bus_prot_blocks = mt6878_md_blocks,
+	.num_bus_prot_blocks = ARRAY_SIZE(mt6878_md_blocks),
+};
+
+static int mt6878_md_check_off(struct scpsys_domain *pd)
+{
+	u32 value;
+	int i, ret;
+
+	ret = regmap_read(pd->scpsys->base, MT6878_MD_CTL, &value);
+	if (ret)
+		return ret;
+	if (value & (MT6878_MD_ACK | PWR_ON_BIT))
+		return -EBUSY;
+	ret = regmap_read(pd->scpsys->base, MT6878_MD_ISO, &value);
+	if (ret)
+		return ret;
+	if ((value & MT6878_MD_ISO_MASK) != MT6878_MD_ISO_MASK)
+		return -EBUSY;
+	for (i = 0; i < 3; i++) {
+		const struct scpsys_bus_prot_data *bp = &pd->data->bp_cfg[i];
+		struct regmap *map = scpsys_bus_protect_get_regmap(pd, bp);
+
+		ret = regmap_read(map, bp->bus_prot_sta, &value);
+		if (ret)
+			return ret;
+		if ((value & bp->bus_prot_sta_mask) != bp->bus_prot_sta_mask)
+			return -EBUSY;
+	}
+	return 0;
+}
+
+static int mt6878_md_bus(struct scpsys_domain *pd, bool protect)
+{
+	int step, ret;
+	u32 value;
+
+	for (step = 0; step < 3; step++) {
+		int index = protect ? step : 2 - step;
+		const struct scpsys_bus_prot_data *bp = &pd->data->bp_cfg[index];
+		struct regmap *map = scpsys_bus_protect_get_regmap(pd, bp);
+		u32 expected = protect ? bp->bus_prot_sta_mask : 0;
+
+		ret = regmap_write(map, protect ? bp->bus_prot_set : bp->bus_prot_clr,
+				   bp->bus_prot_set_clr_mask);
+		if (ret)
+			return ret;
+		ret = regmap_read_poll_timeout(map, bp->bus_prot_sta, value,
+				(value & bp->bus_prot_sta_mask) == expected,
+				MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int mt6878_md_power_on(struct generic_pm_domain *genpd)
+{
+	struct scpsys_domain *pd = to_scpsys_domain(genpd);
+	struct regmap *base = pd->scpsys->base;
+	u32 value;
+	int ret;
+
+	if (pd->md_error)
+		return pd->md_error;
+	if (pd->md_owned)
+		return -EBUSY;
+	ret = mt6878_md_check_off(pd);
+	if (ret)
+		goto fault;
+	ret = regmap_clear_bits(base, MT6878_MD_ISO, MT6878_MD_ISO_MASK);
+	if (ret)
+		goto fault;
+	ret = regmap_set_bits(base, MT6878_MD_CTL, PWR_ON_BIT);
+	if (ret)
+		goto fault;
+	ret = regmap_read_poll_timeout(base, MT6878_MD_CTL, value,
+			(value & MT6878_MD_ACK) == MT6878_MD_ACK,
+			MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+	if (ret)
+		goto fault;
+	ret = mt6878_md_bus(pd, false);
+	if (ret)
+		goto fault;
+	pd->md_owned = true;
+	return 0;
+fault:
+	pd->md_error = ret;
+	dev_err(pd->scpsys->dev, "modem power-on failed: %d; reboot required\n", ret);
+	return ret;
+}
+
+static int mt6878_md_power_off(struct generic_pm_domain *genpd)
+{
+	struct scpsys_domain *pd = to_scpsys_domain(genpd);
+	struct regmap *base = pd->scpsys->base;
+	u32 value;
+	int ret;
+
+	if (pd->md_error)
+		return pd->md_error;
+	if (!pd->md_owned)
+		return -EBUSY;
+	ret = mt6878_md_bus(pd, true);
+	if (ret)
+		goto fault;
+	ret = regmap_clear_bits(base, MT6878_MD_CTL, PWR_ON_BIT);
+	if (ret)
+		goto fault;
+	ret = regmap_read_poll_timeout(base, MT6878_MD_CTL, value,
+			!(value & MT6878_MD_ACK),
+			MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+	if (ret)
+		goto fault;
+	ret = regmap_set_bits(base, MT6878_MD_ISO, MT6878_MD_ISO_MASK);
+	if (ret)
+		goto fault;
+	pd->md_owned = false;
+	return 0;
+fault:
+	pd->md_error = ret;
+	dev_err(pd->scpsys->dev, "modem power-off failed: %d; reboot required\n", ret);
+	return ret;
+}
+
+static void mt6878_md_cleanup(struct scpsys_domain *pd)
+{
+	/* No status reads or fallback sequence on unowned/faulted state. */
+	if (pd->md_owned && !pd->md_error)
+		mt6878_md_power_off(&pd->genpd);
+}
