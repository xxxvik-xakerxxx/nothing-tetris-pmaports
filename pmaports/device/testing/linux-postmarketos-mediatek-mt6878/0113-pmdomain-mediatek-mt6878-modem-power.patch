 #define MTK_SCPD_INFRA_REQ_OPT		BIT(14)
+#define MTK_SCPD_MT6878_MD		BIT(15)
 #define MTK_SCPD_CAPS(_scpd, _x)	((_scpd)->data->caps & (_x))
@@ -64,2 +65,3 @@
 	BUS_PROT_BLOCK_SMI,
+	BUS_PROT_BLOCK_NEMICFG,
 	BUS_PROT_BLOCK_COUNT,
