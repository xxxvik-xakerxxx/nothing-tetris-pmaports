From cfdbfae5f62f9e80353f72fb324a3d14bbb07a98 Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Sat, 5 Sep 2026 20:59:46 +0300
Subject: [PATCH 2/4] phy: mediatek: add MT6878 MIPI TX N4 data

Add the MT6878 N4 D-PHY PLL and lane-power sequence.

Use the register layout from Nothing OS 4.1.

Keep mandatory delays in sleepable prepare and unprepare callbacks.

This adds no device-tree node or runtime activation.

Signed-off-by: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
---
 drivers/phy/mediatek/Makefile                 |   1 +
 .../phy/mediatek/phy-mtk-mipi-dsi-mt6878.c    | 152 ++++++++++++++++++
 drivers/phy/mediatek/phy-mtk-mipi-dsi.c       |   1 +
 drivers/phy/mediatek/phy-mtk-mipi-dsi.h       |   1 +
 4 files changed, 155 insertions(+)
 create mode 100644 drivers/phy/mediatek/phy-mtk-mipi-dsi-mt6878.c

diff --git a/drivers/phy/mediatek/Makefile b/drivers/phy/mediatek/Makefile
index 1b8088d..97b50af 100644
--- a/drivers/phy/mediatek/Makefile
+++ b/drivers/phy/mediatek/Makefile
@@ -21,4 +21,5 @@ obj-$(CONFIG_PHY_MTK_MIPI_CSI_0_5)	+= phy-mtk-mipi-csi-0-5.o
 phy-mtk-mipi-dsi-drv-y			:= phy-mtk-mipi-dsi.o
 phy-mtk-mipi-dsi-drv-y			+= phy-mtk-mipi-dsi-mt8173.o
 phy-mtk-mipi-dsi-drv-y			+= phy-mtk-mipi-dsi-mt8183.o
+phy-mtk-mipi-dsi-drv-y			+= phy-mtk-mipi-dsi-mt6878.o
 obj-$(CONFIG_PHY_MTK_MIPI_DSI)		+= phy-mtk-mipi-dsi-drv.o
diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt6878.c b/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt6878.c
new file mode 100644
index 0000000..1ad51f0
--- /dev/null
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt6878.c
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6878 MIPI TX N4 D-PHY
+ *
+ * Register layout and sequencing are derived from the Nothing OS 4.1
+ * MT6878 device-module source.
+ */
+
+#include "phy-mtk-io.h"
+#include "phy-mtk-mipi-dsi.h"
+
+#define MIPITX_LANE_CON			0x0004
+#define MIPITX_VOLTAGE_SEL		0x0008
+#define RG_DSI_PRD_REF_SEL		GENMASK(5, 0)
+#define RG_DSI_HSTX_LDO_REF_SEL		GENMASK(9, 6)
+#define MIPITX_PRESERVED		0x000c
+
+#define MIPITX_PLL_PWR			0x0028
+#define AD_DSI_PLL_SDM_PWR_ON		BIT(0)
+#define AD_DSI_PLL_SDM_ISO_EN		BIT(1)
+#define MIPITX_PLL_CON0			0x002c
+#define MIPITX_PLL_CON1			0x0030
+#define RG_DSI_PLL_EN			BIT(0)
+#define RG_DSI_PLL_POSDIV		GENMASK(10, 8)
+#define MIPITX_PLL_CON4			0x003c
+
+#define MIPITX_SW_CTRL_CON4		0x0050
+#define MIPITX_D2_SW_CTL_EN		0x015c
+#define MIPITX_D0_SW_CTL_EN		0x025c
+#define MIPITX_CK_CKMODE_EN		0x0320
+#define MIPITX_CK_SW_CTL_EN		0x035c
+#define MIPITX_D1_SW_CTL_EN		0x045c
+#define MIPITX_D3_SW_CTL_EN		0x055c
+#define DSI_SW_CTL_EN			BIT(0)
+#define DSI_CK_CKMODE_EN		BIT(0)
+
+static int mtk_mipi_tx_mt6878_pll_prepare(struct clk_hw *hw)
+{
+	struct mtk_mipi_tx *mipi_tx = mtk_mipi_tx_from_clk_hw(hw);
+	void __iomem *base = mipi_tx->regs;
+	unsigned int txdiv, txdiv0;
+	u64 pcw;
+
+	dev_dbg(mipi_tx->dev, "prepare: %u bps\n", mipi_tx->data_rate);
+
+	if (mipi_tx->data_rate >= 2000000000) {
+		txdiv = 1;
+		txdiv0 = 0;
+	} else if (mipi_tx->data_rate >= 1000000000) {
+		txdiv = 2;
+		txdiv0 = 1;
+	} else if (mipi_tx->data_rate >= 500000000) {
+		txdiv = 4;
+		txdiv0 = 2;
+	} else if (mipi_tx->data_rate >= 250000000) {
+		txdiv = 8;
+		txdiv0 = 3;
+	} else if (mipi_tx->data_rate >= 125000000) {
+		txdiv = 16;
+		txdiv0 = 4;
+	} else {
+		return -EINVAL;
+	}
+
+	mtk_phy_update_field(base + MIPITX_VOLTAGE_SEL,
+			     RG_DSI_PRD_REF_SEL,
+			     mipi_tx->data_rate < 2500000000ULL ? 0 : 4);
+	mtk_phy_update_field(base + MIPITX_VOLTAGE_SEL,
+			     RG_DSI_HSTX_LDO_REF_SEL,
+			     (mipi_tx->mipitx_drive - 3000) / 200);
+
+	writel(mipi_tx->data_rate < 2500000000ULL ? 0xffff00f0 : 0xffff0030,
+	       base + MIPITX_PRESERVED);
+	writel(0x00ff12e0, base + MIPITX_PLL_CON4);
+	writel(0x3fff0180, base + MIPITX_LANE_CON);
+	usleep_range(500, 600);
+	writel(0x3fff00c0, base + MIPITX_LANE_CON);
+
+	mtk_phy_set_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_PWR_ON);
+	usleep_range(30, 100);
+	mtk_phy_clear_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_ISO_EN);
+
+	/* N4 feeds the SDM with half the lane rate. */
+	pcw = div_u64(((u64)mipi_tx->data_rate * txdiv) << 24, 52000000);
+	writel(lower_32_bits(pcw), base + MIPITX_PLL_CON0);
+	mtk_phy_update_field(base + MIPITX_PLL_CON1,
+			     RG_DSI_PLL_POSDIV, txdiv0);
+	mtk_phy_set_bits(base + MIPITX_PLL_CON1, RG_DSI_PLL_EN);
+	usleep_range(50, 100);
+
+	return 0;
+}
+
+static void mtk_mipi_tx_mt6878_pll_unprepare(struct clk_hw *hw)
+{
+	struct mtk_mipi_tx *mipi_tx = mtk_mipi_tx_from_clk_hw(hw);
+	void __iomem *base = mipi_tx->regs;
+
+	mtk_phy_clear_bits(base + MIPITX_PLL_CON1, RG_DSI_PLL_EN);
+	mtk_phy_clear_bits(base + MIPITX_SW_CTRL_CON4, BIT(0));
+	mtk_phy_set_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_ISO_EN);
+	mtk_phy_clear_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_PWR_ON);
+	writel(0x3fff0180, base + MIPITX_LANE_CON);
+	writel(0x3fff0100, base + MIPITX_LANE_CON);
+}
+
+static long mtk_mipi_tx_mt6878_pll_round_rate(struct clk_hw *hw,
+					      unsigned long rate,
+					      unsigned long *prate)
+{
+	return clamp_val(rate, 125000000, 2500000000UL);
+}
+
+static const struct clk_ops mtk_mipi_tx_mt6878_pll_ops = {
+	.prepare = mtk_mipi_tx_mt6878_pll_prepare,
+	.unprepare = mtk_mipi_tx_mt6878_pll_unprepare,
+	.round_rate = mtk_mipi_tx_mt6878_pll_round_rate,
+	.set_rate = mtk_mipi_tx_pll_set_rate,
+	.recalc_rate = mtk_mipi_tx_pll_recalc_rate,
+};
+
+static void mtk_mipi_tx_mt6878_enable_signal(struct phy *phy)
+{
+	struct mtk_mipi_tx *mipi_tx = phy_get_drvdata(phy);
+	void __iomem *base = mipi_tx->regs;
+
+	mtk_phy_clear_bits(base + MIPITX_D0_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_clear_bits(base + MIPITX_D1_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_clear_bits(base + MIPITX_D2_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_clear_bits(base + MIPITX_D3_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_clear_bits(base + MIPITX_CK_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_set_bits(base + MIPITX_CK_CKMODE_EN, DSI_CK_CKMODE_EN);
+}
+
+static void mtk_mipi_tx_mt6878_disable_signal(struct phy *phy)
+{
+	struct mtk_mipi_tx *mipi_tx = phy_get_drvdata(phy);
+	void __iomem *base = mipi_tx->regs;
+
+	mtk_phy_clear_bits(base + MIPITX_CK_CKMODE_EN, DSI_CK_CKMODE_EN);
+	mtk_phy_set_bits(base + MIPITX_D0_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_set_bits(base + MIPITX_D1_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_set_bits(base + MIPITX_D2_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_set_bits(base + MIPITX_D3_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_set_bits(base + MIPITX_CK_SW_CTL_EN, DSI_SW_CTL_EN);
+}
+
+const struct mtk_mipitx_data mt6878_mipitx_data = {
+	.mipi_tx_clk_ops = &mtk_mipi_tx_mt6878_pll_ops,
+	.mipi_tx_enable_signal = mtk_mipi_tx_mt6878_enable_signal,
+	.mipi_tx_disable_signal = mtk_mipi_tx_mt6878_disable_signal,
+};
diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi.c b/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
index 065ea62..7227192 100644
--- a/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
@@ -181,6 +181,7 @@ static int mtk_mipi_tx_probe(struct platform_device *pdev)
 
 static const struct of_device_id mtk_mipi_tx_match[] = {
 	{ .compatible = "mediatek,mt2701-mipi-tx", .data = &mt2701_mipitx_data },
+	{ .compatible = "mediatek,mt6878-mipi-tx", .data = &mt6878_mipitx_data },
 	{ .compatible = "mediatek,mt8173-mipi-tx", .data = &mt8173_mipitx_data },
 	{ .compatible = "mediatek,mt8183-mipi-tx", .data = &mt8183_mipitx_data },
 	{ /* sentinel */ }
diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi.h b/drivers/phy/mediatek/phy-mtk-mipi-dsi.h
index 5d4876f..597b0a6 100644
--- a/drivers/phy/mediatek/phy-mtk-mipi-dsi.h
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi.h
@@ -40,6 +40,7 @@ unsigned long mtk_mipi_tx_pll_recalc_rate(struct clk_hw *hw,
 					  unsigned long parent_rate);
 
 extern const struct mtk_mipitx_data mt2701_mipitx_data;
+extern const struct mtk_mipitx_data mt6878_mipitx_data;
 extern const struct mtk_mipitx_data mt8173_mipitx_data;
 extern const struct mtk_mipitx_data mt8183_mipitx_data;
 
