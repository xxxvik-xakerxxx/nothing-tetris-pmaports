From a546195b08fb4935552420ce58c30cfecb7d6d1b Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Sun, 6 Sep 2026 08:02:00 +0300
Subject: [PATCH] arm64: dts: mediatek: add Nothing Tetris native display DTB

Add the native-display DTB with OVL0_2L, DSC0, DSI0, panel, display
power, clocks and bounded larb0/IOMMU DMA enabled. Remove simplefb so
the shipped device configuration uses the native DRM pipeline.

Signed-off-by: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
---
 arch/arm64/boot/dts/mediatek/Makefile | 1 +
 arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-native.dts | 139 ++++++++++++++++++++
 2 files changed, 140 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-native.dts

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index a512b4d..cc50f9e 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -7,6 +7,7 @@ dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-sony-xperia-m5.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-x20-dev.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6878-nothing-tetris.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6878-nothing-tetris-native.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt7622-rfb1.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt7622-bananapi-bpi-r64.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt7981b-cudy-wr3000-v1.dtb
diff --git a/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-native.dts b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-native.dts
new file mode 100644
index 0000000..1207ba6
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-native.dts
@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Native-display integration for Nothing Tetris.
+ */
+
+#include "mt6878-nothing-tetris.dts"
+#include <dt-bindings/power/mediatek,mt6878-power.h>
+#include "mt6878-native-display-power.dtsi"
+
+/ {
+	model = "Nothing CMF Phone 1 (native display)";
+
+	aliases {
+		ovl-2l0 = &disp_ovl0_2l;
+		dsc0 = &disp_dsc0;
+		dsi0 = &dsi0;
+	};
+};
+
+&{/chosen} {
+	/delete-node/ simplefb@fe0d0000;
+};
+
+&pio {
+	display_pins: display-pins {
+		te-pin {
+			pinmux = <PINMUX_GPIO89__FUNC_DSI_TE>;
+			input-enable;
+		};
+
+		panel-control-pins {
+			pinmux = <PINMUX_GPIO90__FUNC_GPIO90>,
+				 <PINMUX_GPIO153__FUNC_GPIO153>,
+				 <PINMUX_GPIO154__FUNC_GPIO154>;
+			output-low;
+		};
+	};
+};
+
+&soc {
+	disp_mutex0: mutex@14001000 {
+		compatible = "mediatek,mt6878-disp-mutex";
+		reg = <0x14001000 0x1000>;
+		interrupts = <GIC_SPI 303 IRQ_TYPE_LEVEL_HIGH 0>;
+		clocks = <&mmsys CLK_MM_DISP_MUTEX0>;
+		power-domains = <&disp>;
+		status = "okay";
+	};
+
+	disp_ovl0_2l: ovl@14002000 {
+		compatible = "mediatek,mt6878-disp-ovl-2l";
+		reg = <0x14002000 0x1000>;
+		interrupts = <GIC_SPI 302 IRQ_TYPE_LEVEL_HIGH 0>;
+		clocks = <&mmsys CLK_MM_DISP_OVL0_2L>;
+		power-domains = <&disp>;
+		status = "okay";
+	};
+
+	disp_dsc0: dsc@14019000 {
+		compatible = "mediatek,mt6878-disp-dsc";
+		reg = <0x14019000 0x1000>;
+		interrupts = <GIC_SPI 326 IRQ_TYPE_LEVEL_HIGH 0>;
+		clocks = <&mmsys CLK_MM_DISP_DSC_WRAP0>;
+		power-domains = <&disp>;
+		status = "okay";
+	};
+
+	dsi0: dsi@1401a000 {
+		compatible = "mediatek,mt6878-dsi";
+		reg = <0x1401a000 0x1000>;
+		interrupts = <GIC_SPI 328 IRQ_TYPE_LEVEL_HIGH 0>;
+		clocks = <&mmsys CLK_MM_DISP_DSI0>,
+			 <&mmsys CLK_MM_DSI0>,
+			 <&mipi_tx0>;
+		clock-names = "engine", "digital", "hs";
+		phys = <&mipi_tx0>;
+		phy-names = "dphy";
+		power-domains = <&disp>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&display_pins>;
+		status = "okay";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@1 {
+				reg = <1>;
+
+				dsi0_out: endpoint {
+					remote-endpoint = <&panel_in>;
+				};
+			};
+		};
+
+		panel@0 {
+			compatible = "samsung,s6e8fc3x02";
+			reg = <0>;
+			reset-gpios = <&pio 90 GPIO_ACTIVE_HIGH>;
+			vddi-en-gpios = <&pio 153 GPIO_ACTIVE_HIGH>;
+			vci-en-gpios = <&pio 154 GPIO_ACTIVE_HIGH>;
+			samsung,refresh-rate = <60>;
+			status = "okay";
+
+			port {
+				panel_in: endpoint {
+					remote-endpoint = <&dsi0_out>;
+				};
+			};
+		};
+	};
+
+	mipi_tx0: dsi-phy@11e50000 {
+		compatible = "mediatek,mt6878-mipi-tx";
+		reg = <0x11e50000 0x1000>;
+		clocks = <&clk26m>;
+		clock-output-names = "mipi_tx0_pll";
+		#clock-cells = <0>;
+		#phy-cells = <0>;
+		status = "okay";
+	};
+};
+
+#include "mt6878-native-display-dma.dtsi"
+
+&smi_disp_common {
+	status = "okay";
+};
+
+&smi_larb0 {
+	status = "okay";
+};
+
+&disp_iommu {
+	status = "okay";
+};
-- 
