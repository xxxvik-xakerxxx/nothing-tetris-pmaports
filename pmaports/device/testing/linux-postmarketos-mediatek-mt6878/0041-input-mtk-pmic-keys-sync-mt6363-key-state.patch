+static void mtk_pmic_keys_sync_state(struct mtk_pmic_keys *keys)
+{
+	struct input_dev *input_dev = keys->input_dev;
+	u32 status;
+	int i;
+
+	for (i = 0; i < MTK_PMIC_MAX_KEY_COUNT; i++) {
+		struct mtk_pmic_keys_info *info = &keys->keys[i];
+		u32 key_deb;
+		u32 pressed;
+		int ret;
+
+		if (!info->regs)
+			continue;
+
+		ret = regmap_read(keys->regmap, info->regs->deb_reg, &status);
+		if (ret)
+			continue;
+
+		key_deb = status & info->regs->deb_mask;
+		pressed = !key_deb;
+
+		input_report_key(input_dev, info->keycode, pressed);
+		dev_dbg(keys->dev, "(%s) key =%d status=0x%x using PMIC\n",
+			pressed ? "pressed" : "released", info->keycode,
+			status);
+	}
+
+	input_sync(input_dev);
+}
