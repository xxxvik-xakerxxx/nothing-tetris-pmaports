+                    fts_ts_suspend(ts_data->dev);
+                } else {
+                    queue_work(fts_data->ts_workqueue, &fts_data->resume_work);
+                }
+            }
+        } else if (event == MTK_DISP_EARLY_EVENT_BLANK) {
+            /**
+            * suspend: touch power off is before display to avoid touch report event
+            * after screen is off
+            */
+            FTS_INFO("event=%lu, MTK_DISP_EARLY_EVENT_BLANK=%d, lcm_now_state=%d\n", event, MTK_DISP_EARLY_EVENT_BLANK, lcm_now_state);
+            if (*data == MTK_DISP_BLANK_POWERDOWN) {
+                cancel_work_sync(&fts_data->resume_work);
+                fts_ts_suspend(ts_data->dev);
