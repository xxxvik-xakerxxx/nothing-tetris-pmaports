+        if (count <= 0) {
+            FTS_ERROR("find drm_panel count(%d) fail", count);
+            return -ENODEV;
+        }
+
+        for (i = 0; i < count; i++) {
+            node = of_parse_phandle(np, "panel", i);
+            panel = of_drm_find_panel(node);
+            of_node_put(node);
+            if (!IS_ERR(panel)) {
+                FTS_INFO("find drm_panel successfully");
