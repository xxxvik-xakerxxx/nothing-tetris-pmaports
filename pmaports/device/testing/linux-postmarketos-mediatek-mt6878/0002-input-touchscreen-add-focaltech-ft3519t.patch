+            FTS_TEST_DBG("reg%x=%x,retry:%d", FACTORY_REG_CLB, val, times);
+    }
+
+    if (times >= FACTORY_TEST_RETRY) {
+        FTS_TEST_SAVE_ERR("chip clb timeout\n");
+        return -EIO;
+    }
+
+    return 0;
