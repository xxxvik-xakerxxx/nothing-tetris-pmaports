+            FTS_INFO("event=%lu, MTK_DISP_EVENT_BLANK=%d, lcm_now_state=%d\n", event, MTK_DISP_EVENT_BLANK, lcm_now_state);
+            if (*data == MTK_DISP_BLANK_UNBLANK) {
