+int fts_reset_proc(struct fts_ts_data *ts_data,int hdelayms)
+{
+    FTS_DEBUG("tp reset");
+    gpio_direction_output(fts_data->pdata->reset_gpio, 0);
+    msleep(1);
+    gpio_direction_output(fts_data->pdata->reset_gpio, 1);
+    if (hdelayms) {
+        msleep(hdelayms);
+    }
+    ts_data->fod_info.fp_down_report = 0;
+    return 0;
+}
