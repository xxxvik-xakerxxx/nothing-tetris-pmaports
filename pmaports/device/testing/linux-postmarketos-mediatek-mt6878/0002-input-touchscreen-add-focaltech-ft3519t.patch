+static int fts_test_show(struct seq_file *s, void *unused)
+{
+    struct fts_ts_data *ts_data = fts_data;
+    struct input_dev *input_dev = ts_data->input_dev;
+    int ret = 0;
+    char fwname[FILE_NAME_LENGTH] = { 0 };
+
+    if (ts_data->suspended) {
+        FTS_INFO("In suspend, no test, return now");
+        return -EINVAL;
+    }
+
+    memset(fwname, 0, sizeof(fwname));
+    snprintf(fwname, FILE_NAME_LENGTH, "%s", FTS_INI_FILE_NAME);
+    fwname[sizeof(fwname) - 1] = '\0';
+    FTS_TEST_DBG("fwname:%s.", fwname);
+
+    input_dev = ts_data->input_dev;
+
+    mutex_lock(&input_dev->mutex);
+    fts_irq_disable();
+    fts_esdcheck_switch(ts_data, DISABLE);
+
+    ret = fts_enter_test_environment(1);
+    if (ret < 0) {
+        FTS_ERROR("enter test environment fail");
+    } else {
+        fts_test_entry(fwname);
+    }
+
+    ret = fts_enter_test_environment(0);
+    if (ret < 0) {
+        FTS_ERROR("enter normal environment fail");
+    }
+    fts_esdcheck_switch(ts_data, ENABLE);
+    fts_irq_enable();
+    mutex_unlock(&input_dev->mutex);
+
+    if (fts_ftest->result == TEST_RESULT_INIT) {
+        FTS_ERROR("=======Tp test has not started.\n");
+        seq_printf(s, "Tp test has not started,test fail..\n");
+    } else if (fts_ftest->result == TEST_RESULT_IN_PROGRESS) {
+        FTS_ERROR("=======Tp test is in progress.\n");
+        seq_printf(s, "Tp test is in progress,test fail..\n");
+    } else if (fts_ftest->result == TEST_RESULT_PASS) {
+        FTS_ERROR("=======Tp test pass.\n");
+        seq_printf(s, "Tp test pass.\n");
+    } else {
+        FTS_ERROR("=======Tp test fail.\n");
+        seq_printf(s, "Tp test fail.\n");
+    }
+
+    return 0;
+}
