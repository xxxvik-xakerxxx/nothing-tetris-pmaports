+
+    FTS_TEST_FUNC_ENTER();
+    //Start Scanning
+    ret = start_scan();
+    if (ret < 0) {
+        FTS_TEST_ERROR("Failed to Scan ...");
+        return ret;
+    }
+
+    /* read rawdata */
+    if (IC_HW_INCELL == tdata->func->hwtype) {
+        val = 0xAD;
+        addr = FACTORY_REG_LINE_ADDR;
+        rawdata_addr = FACTORY_REG_RAWDATA_ADDR;
+    } else if (IC_HW_MC_SC == tdata->func->hwtype) {
+        val = 0xAA;
+        addr = FACTORY_REG_LINE_ADDR;
+        rawdata_addr = FACTORY_REG_RAWDATA_ADDR_MC_SC;
+    } else {
+        val = 0x0;
+        addr = FACTORY_REG_RAWDATA_SADDR_SC;
+        rawdata_addr = FACTORY_REG_RAWDATA_ADDR_SC;
+    }
+
+    ret = read_rawdata(tdata, addr, val, rawdata_addr, byte_num, data);
+
+    if (ret < 0) {
+        FTS_TEST_ERROR("read rawdata failed");
+        return ret;
+    }
+    return ret;
+}
+
+int tp_data_dump_proc_show(struct seq_file *file, void* data)
+{
+    int *rawdata = lct_tp_data_dump_p->all_rawdata;
+    int *diffdata = lct_tp_data_dump_p->all_diffdata;
+    int i = 0;
+    int j = 0;
+    int k = 0;
+
+    if (IS_ERR_OR_NULL(rawdata) || IS_ERR_OR_NULL(diffdata)) {
+        FTS_TEST_ERROR("Data Invalid!");
+        return -1;
+    }
+
+    for (k = 0; k < FTS_DATA_WITH_DIFF_LEN; k++){
+        seq_printf(file,"\n********************DATA COUNT %d********************\n", k);
+        seq_printf(file,"\nDIFF DATA\n");
+        for (j = 0; j < FTS_RX_MAX; j++) {
+             for (i = 0; i < FTS_TX_MAX; i++){
+                 seq_printf(file, "%6d", lct_tp_data_dump_p->all_diffdata[k * FTS_TX_MAX * FTS_RX_MAX + FTS_RX_MAX * (FTS_TX_MAX - 1 - i) + j]);
+             }
+             seq_printf(file, "\n");
+        }
+        seq_printf(file, "\n");
+
+        seq_printf(file,"\nRAW DATA\n");
+        for (j = 0; j < FTS_RX_MAX; j++) {
+             for (i = 0; i < FTS_TX_MAX; i++){
+                 seq_printf(file, "%6d", lct_tp_data_dump_p->all_rawdata[k * FTS_TX_MAX * FTS_RX_MAX + FTS_RX_MAX * (FTS_TX_MAX - 1 - i) + j]);
+             }
+             seq_printf(file, "\n");
+        }
+        seq_printf(file, "\n");
+    }
+
+    //FTS_TEST_ERROR("file->size = %lu, file->count = %lu", file->size, file->count);
+    if (file->count < file->size) {
+        if (!IS_ERR_OR_NULL(lct_tp_data_dump_p->rawdata))
+            vfree(lct_tp_data_dump_p->rawdata);
+        if (!IS_ERR_OR_NULL(lct_tp_data_dump_p->diffdata))
+            vfree(lct_tp_data_dump_p->diffdata);
+        if (!IS_ERR_OR_NULL(lct_tp_data_dump_p->all_diffdata))
+            vfree(lct_tp_data_dump_p->all_diffdata);
+        if (!IS_ERR_OR_NULL(lct_tp_data_dump_p->all_rawdata))
+            vfree(lct_tp_data_dump_p->all_rawdata);
+        lct_tp_data_dump_p->rawdata = NULL;
+        lct_tp_data_dump_p->diffdata = NULL;
+        lct_tp_data_dump_p->all_diffdata= NULL;
+        lct_tp_data_dump_p->all_rawdata= NULL;
+    }
+    return 0;
+}
+
+int tp_data_dump_proc_open (struct inode* inode, struct file* file)
+{
+    int ret = 0;
+    u8 tx_num = 0;
+    u8 rx_num = 0;
+    int cnt = 0;
+    struct fts_ts_data *ts_data = fts_data;
+    struct input_dev *input_dev;
+
+    FTS_TEST_FUNC_ENTER();
+
+    if (ts_data->suspended) {
+        FTS_INFO("In suspend, no proc, return now");
+        return -EINVAL;
+    }
+
+    if (lct_tp_data_dump_p->rawdata || lct_tp_data_dump_p->diffdata || lct_tp_data_dump_p->all_diffdata || lct_tp_data_dump_p->all_rawdata) {
+        FTS_ERROR("rawdata and diffdata not free!");
+        return -EIO;
+    }
+
+    input_dev = ts_data->input_dev;
+
+    mutex_lock(&input_dev->mutex);
+    fts_irq_disable();
+
+#if defined(FTS_ESDCHECK_EN) && (FTS_ESDCHECK_EN)
+    fts_esdcheck_switch(ts_data,DISABLE);
+#endif
+
+    ret = fts_write_reg(0xEE,1);//disable Auto Clb
+    if (ret < 0) {
+        FTS_ERROR("disable auto clb fail, ret=%d", ret);
+        goto err_disable_clb_fail;
+    }
+    ret = enter_factory_mode();
+    if (ret < 0) {
+        FTS_ERROR("enter factory mode fail, ret=%d", ret);
+        goto err_enter_factory_mode_fail;
+    }
+    //get channel x/y numbers
+    ret = fts_read_reg(FACTORY_REG_CHX_NUM, &tx_num);
+    if (ret < 0) {
+        FTS_ERROR("get tx_num fail, ret=%d", ret);
+        goto err_get_channel_x_y_num_fail;
+    }
+    ret = fts_read_reg(FACTORY_REG_CHY_NUM, &rx_num);
+    if (ret < 0) {
+        FTS_ERROR("get rx_num fail, ret=%d", ret);
+        goto err_get_channel_x_y_num_fail;
+    }
+    lct_tp_data_dump_p->tx_num = tx_num;
+    lct_tp_data_dump_p->rx_num = rx_num;
+    //malloc buffer
+    lct_tp_data_dump_p->rawdata = vmalloc(tx_num * rx_num * sizeof(int));
+    if (IS_ERR_OR_NULL(lct_tp_data_dump_p->rawdata)) {
+        FTS_ERROR("malloc rawdata memory fail");
+        lct_tp_data_dump_p->rawdata = NULL;
+        ret = -ENOMEM;
+        goto err_malloc_rawdata_fail;
+    }
+
+    lct_tp_data_dump_p->diffdata = vmalloc(tx_num * rx_num * sizeof(int));
+    if (IS_ERR_OR_NULL(lct_tp_data_dump_p->diffdata)) {
+        FTS_ERROR("malloc diffdata memory fail");
+        lct_tp_data_dump_p->diffdata = NULL;
+        ret = -ENOMEM;
+        goto err_malloc_diffdata_fail;
+    }
+
+    lct_tp_data_dump_p->all_diffdata = vmalloc((FTS_DIFF_DATA_LEN) * sizeof(int));
+    if (IS_ERR_OR_NULL(lct_tp_data_dump_p->all_diffdata)) {
+        FTS_ERROR("malloc all_diffdata memory fail");
+        lct_tp_data_dump_p->all_diffdata = NULL;
+        ret = -ENOMEM;
+        goto err_malloc_all_diffdata_fail;
+    }
+
+    lct_tp_data_dump_p->all_rawdata = vmalloc((FTS_DIFF_DATA_LEN) * sizeof(int));
+    if (IS_ERR_OR_NULL(lct_tp_data_dump_p->all_rawdata)) {
+        FTS_ERROR("malloc all_diffdata memory fail");
+        lct_tp_data_dump_p->all_rawdata = NULL;
+        ret = -ENOMEM;
+        goto err_malloc_all_rawdata_fail;
+    }
+
+    memset(lct_tp_data_dump_p->all_diffdata, 0, sizeof(FTS_DIFF_DATA_LEN));
+    memset(lct_tp_data_dump_p->all_rawdata, 0, sizeof(FTS_DIFF_DATA_LEN));
+
+    do {
+         //get rawdata
+        ret = lct_tp_get_rawdata(lct_tp_data_dump_p->rawdata, tx_num * rx_num * 2);
+        if (ret < 0) {
+            FTS_ERROR("lct_tp_get_rawdata() failed, ret = %d", ret);
+            goto err_get_data_fail;
+        }
+        //get diffdata
+        ret = lct_tp_get_diffdata(lct_tp_data_dump_p->diffdata, tx_num * rx_num * 2);
+        if (ret < 0) {
+            FTS_ERROR("lct_tp_get_rawdata() failed, ret = %d", ret);
+            goto err_get_data_fail;
+        }
+
+        memcpy(&lct_tp_data_dump_p->all_diffdata[cnt * tx_num * rx_num], lct_tp_data_dump_p->diffdata, tx_num * rx_num * sizeof(int));
+        memcpy(&lct_tp_data_dump_p->all_rawdata[cnt * tx_num * rx_num], lct_tp_data_dump_p->rawdata, tx_num * rx_num * sizeof(int));
+        cnt++;
+        msleep(10);
+    } while (cnt < FTS_DATA_WITH_DIFF_LEN);
+
+    goto exit;
+
+err_get_data_fail:
+    if (!IS_ERR_OR_NULL(lct_tp_data_dump_p->all_rawdata)) {
+        vfree(lct_tp_data_dump_p->all_rawdata);
+        lct_tp_data_dump_p->all_rawdata = NULL;
+        FTS_ERROR(" free all_rawdata!");
+    }
+err_malloc_all_rawdata_fail:
+    if (!IS_ERR_OR_NULL(lct_tp_data_dump_p->all_diffdata)){
+        vfree(lct_tp_data_dump_p->all_diffdata);
+        lct_tp_data_dump_p->all_diffdata = NULL;
+        FTS_ERROR(" free all_diffdata!");
+    }
+err_malloc_all_diffdata_fail:
+    if (!IS_ERR_OR_NULL(lct_tp_data_dump_p->diffdata)) {
+        vfree(lct_tp_data_dump_p->diffdata);
+        lct_tp_data_dump_p->diffdata = NULL;
+        FTS_ERROR(" free diffdata!");
+    }
+err_malloc_diffdata_fail:
+    if (!IS_ERR_OR_NULL(lct_tp_data_dump_p->rawdata)) {
+        vfree(lct_tp_data_dump_p->rawdata);
+        lct_tp_data_dump_p->rawdata = NULL;
+        FTS_ERROR(" free rawdata!");
+    }
+err_malloc_rawdata_fail:
+err_get_channel_x_y_num_fail:
+exit:
+    enter_work_mode();
+#if defined(FTS_ESDCHECK_EN) && (FTS_ESDCHECK_EN)
+    fts_esdcheck_switch(ts_data,ENABLE);
+#endif
+
+    fts_irq_enable();
+    mutex_unlock(&input_dev->mutex);
+
+err_enter_factory_mode_fail:
+err_disable_clb_fail:
+    FTS_TEST_FUNC_EXIT();
+    return single_open(file, tp_data_dump_proc_show, NULL);
+}
+#endif
+
+int fts_test_init(struct fts_ts_data *ts_data)
+{
+    int ret = 0;
+
+    FTS_TEST_FUNC_ENTER();
+    /* get test function, must be the first step */
+    ret = fts_test_func_init(ts_data);
+    if (ret < 0) {
+        FTS_TEST_SAVE_ERR("test functions init fail");
+        return ret;
+    }
+
+    proc_tp_test = proc_mkdir("touchscreen", NULL);
+    if (!proc_tp_test) {
+        FTS_TEST_ERROR("procfs(test) create fail");
+        remove_proc_subtree("proc_tp_test", NULL);
+	return -ENOMEM;
+    } else {
+        proc_create_data("fts_test", 0664, proc_tp_test, &tp_test_fops, NULL);
+        FTS_TEST_DBG("procfs(test) create successfully");
+    }
+
+    fts_ftest->proc_csv = proc_create_data("fts_test_csv", 0777, proc_tp_test, &fts_proccsv_fops, fts_ftest);
+    if (NULL == fts_ftest->proc_csv) {
+        FTS_ERROR("create proc_csv entry fail");
+    }
+
+    FTS_TEST_FUNC_EXIT();
+
+    return ret;
+}
+
+int fts_test_exit(struct fts_ts_data *ts_data)
+{
+    FTS_TEST_FUNC_ENTER();
+
+    remove_proc_subtree("proc_tp_test", NULL);
+
+    if (fts_ftest) {
+        proc_remove(fts_ftest->proc_csv);
+        vfree(fts_ftest->csv_file_buf);
+        fts_free(fts_ftest);
+    }
+    FTS_TEST_FUNC_EXIT();
+    return 0;
+}
