--- /dev/null
+++ b/drivers/usb/typec/tcpm/tcpci_mt6375.c	2026-07-29 12:40:55
@@ -0,0 +1,265 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6375 USB Type-C Port Controller Interface driver.
+ */
+
+#include <linux/bits.h>
+#include <linux/interrupt.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeirq.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/usb/tcpci.h>
+#include <linux/usb/tcpm.h>
+
+#define MT6375_TCPC_REG(reg)		(0xf200 + (reg))
+
+#define MT6375_VENDOR_ID		0x29cf
+#define MT6375_PRODUCT_ID		0x6375
+
+#define MT6375_REG_PHYCTRL1		0x80
+#define MT6375_REG_PHYCTRL2		0x81
+#define MT6375_REG_PHYCTRL3		0x82
+#define MT6375_REG_PHYCTRL7		0x86
+#define MT6375_REG_SYSCTRL1		0x8f
+#define MT6375_REG_PHYCTRL9		0xac
+#define MT6375_REG_TCPCCTRL1		0xb1
+#define MT6375_REG_TCPCCTRL2		0xb2
+#define MT6375_REG_TCPCCTRL3		0xb3
+#define MT6375_REG_HILOCTRL9		0xc8
+
+#define MT6375_AUTOIDLE_MASK		BIT(3)
+#define MT6375_NORMAL_RP_DUTY		308
+
+struct mt6375_tcpc {
+	struct device *dev;
+	struct regmap *parent_regmap;
+	struct regmap *tcpc_regmap;
+	struct regulator *vbus;
+	struct tcpci *tcpci;
+	struct tcpci_data tcpci_data;
+	bool src_en;
+};
+
+static int mt6375_tcpc_regmap_write(void *context, const void *data,
+				    size_t count)
+{
+	struct mt6375_tcpc *tcpc = context;
+	const u8 *buf = data;
+
+	if (count < 2)
+		return -EINVAL;
+
+	return regmap_raw_write(tcpc->parent_regmap, MT6375_TCPC_REG(buf[0]),
+				buf + 1, count - 1);
+}
+
+static int mt6375_tcpc_regmap_read(void *context, const void *reg_buf,
+				   size_t reg_size, void *val_buf,
+				   size_t val_size)
+{
+	struct mt6375_tcpc *tcpc = context;
+	const u8 *reg = reg_buf;
+
+	if (reg_size != 1)
+		return -EINVAL;
+
+	return regmap_raw_read(tcpc->parent_regmap, MT6375_TCPC_REG(reg[0]),
+			       val_buf, val_size);
+}
+
+static const struct regmap_bus mt6375_tcpc_regmap_bus = {
+	.write = mt6375_tcpc_regmap_write,
+	.read = mt6375_tcpc_regmap_read,
+};
+
+static const struct regmap_config mt6375_tcpc_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+};
+
+static int mt6375_tcpc_init(struct tcpci *tcpci, struct tcpci_data *data)
+{
+	static const struct reg_sequence init[] = {
+		REG_SEQ(MT6375_REG_TCPCCTRL1, 0x0a, 0),
+		REG_SEQ(MT6375_REG_TCPCCTRL2, 0x00, 0),
+		REG_SEQ(MT6375_REG_PHYCTRL1, 0x74, 0),
+		REG_SEQ(MT6375_REG_PHYCTRL2, 0x3a, 0),
+		REG_SEQ(MT6375_REG_PHYCTRL3, 0x82, 0),
+		REG_SEQ(MT6375_REG_PHYCTRL7, 0x36, 0),
+		REG_SEQ(MT6375_REG_PHYCTRL9, 0x3c, 0),
+		REG_SEQ(MT6375_REG_HILOCTRL9, 0xaa, 0),
+		REG_SEQ(MT6375_REG_SYSCTRL1, 0xb8, 1000),
+	};
+	u8 duty[] = {
+		MT6375_NORMAL_RP_DUTY & 0xff,
+		MT6375_NORMAL_RP_DUTY >> 8,
+	};
+	int ret;
+
+	ret = regmap_register_patch(data->regmap, init, ARRAY_SIZE(init));
+	if (ret)
+		return ret;
+
+	return regmap_raw_write(data->regmap, MT6375_REG_TCPCCTRL3, duty,
+				sizeof(duty));
+}
+
+static int mt6375_tcpc_set_vconn(struct tcpci *tcpci, struct tcpci_data *data,
+				 bool enable)
+{
+	return regmap_update_bits(data->regmap, MT6375_REG_SYSCTRL1,
+				  MT6375_AUTOIDLE_MASK,
+				  enable ? 0 : MT6375_AUTOIDLE_MASK);
+}
+
+static int mt6375_tcpc_set_vbus(struct tcpci *tcpci, struct tcpci_data *data,
+				bool source, bool sink)
+{
+	struct mt6375_tcpc *tcpc = container_of(data, struct mt6375_tcpc,
+						tcpci_data);
+	int ret;
+
+	if (tcpc->src_en == source)
+		return 0;
+
+	if (source)
+		ret = regulator_enable(tcpc->vbus);
+	else
+		ret = regulator_disable(tcpc->vbus);
+
+	if (!ret)
+		tcpc->src_en = source;
+
+	return ret;
+}
+
+static irqreturn_t mt6375_tcpc_irq(int irq, void *data)
+{
+	struct mt6375_tcpc *tcpc = data;
+
+	return tcpci_irq(tcpc->tcpci);
+}
+
+static int mt6375_tcpc_check_revision(struct mt6375_tcpc *tcpc)
+{
+	u16 val;
+	int ret;
+
+	ret = regmap_raw_read(tcpc->tcpc_regmap, TCPC_VENDOR_ID, &val,
+			      sizeof(val));
+	if (ret)
+		return ret;
+	if (val != MT6375_VENDOR_ID)
+		return dev_err_probe(tcpc->dev, -ENODEV,
+				     "unexpected vendor id 0x%04x\n", val);
+
+	ret = regmap_raw_read(tcpc->tcpc_regmap, TCPC_PRODUCT_ID, &val,
+			      sizeof(val));
+	if (ret)
+		return ret;
+	if (val != MT6375_PRODUCT_ID)
+		return dev_err_probe(tcpc->dev, -ENODEV,
+				     "unexpected product id 0x%04x\n", val);
+
+	ret = regmap_raw_read(tcpc->tcpc_regmap, TCPC_BCD_DEV, &val,
+			      sizeof(val));
+	if (ret)
+		return ret;
+
+	dev_info(tcpc->dev, "MT6375 TCPC device id 0x%04x\n", val);
+	return 0;
+}
+
+static void mt6375_tcpc_unregister(void *data)
+{
+	tcpci_unregister_port(data);
+}
+
+static int mt6375_tcpc_probe(struct platform_device *pdev)
+{
+	struct mt6375_tcpc *tcpc;
+	struct device *dev = &pdev->dev;
+	int irq;
+	int ret;
+
+	tcpc = devm_kzalloc(dev, sizeof(*tcpc), GFP_KERNEL);
+	if (!tcpc)
+		return -ENOMEM;
+
+	tcpc->dev = dev;
+	tcpc->parent_regmap = dev_get_regmap(dev->parent, NULL);
+	if (!tcpc->parent_regmap)
+		return dev_err_probe(dev, -ENODEV, "missing parent regmap\n");
+
+	tcpc->tcpc_regmap = devm_regmap_init(dev, &mt6375_tcpc_regmap_bus,
+					     tcpc, &mt6375_tcpc_regmap_config);
+	if (IS_ERR(tcpc->tcpc_regmap))
+		return PTR_ERR(tcpc->tcpc_regmap);
+
+	ret = mt6375_tcpc_check_revision(tcpc);
+	if (ret)
+		return ret;
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	tcpc->tcpci_data.regmap = tcpc->tcpc_regmap;
+	tcpc->tcpci_data.auto_discharge_disconnect = 1;
+	tcpc->tcpci_data.init = mt6375_tcpc_init;
+	tcpc->tcpci_data.set_vconn = mt6375_tcpc_set_vconn;
+
+	tcpc->vbus = devm_regulator_get_optional(dev, "vbus");
+	if (!IS_ERR(tcpc->vbus))
+		tcpc->tcpci_data.set_vbus = mt6375_tcpc_set_vbus;
+
+	tcpc->tcpci = tcpci_register_port(dev, &tcpc->tcpci_data);
+	if (IS_ERR(tcpc->tcpci))
+		return dev_err_probe(dev, PTR_ERR(tcpc->tcpci),
+				     "failed to register TCPM port\n");
+
+	ret = devm_add_action_or_reset(dev, mt6375_tcpc_unregister,
+				       tcpc->tcpci);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, irq, NULL, mt6375_tcpc_irq,
+					IRQF_ONESHOT, dev_name(dev), tcpc);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request IRQ\n");
+
+	device_init_wakeup(dev, true);
+	dev_pm_set_wake_irq(dev, irq);
+
+	return 0;
+}
+
+static void mt6375_tcpc_remove(struct platform_device *pdev)
+{
+	dev_pm_clear_wake_irq(&pdev->dev);
+	device_init_wakeup(&pdev->dev, false);
+}
+
+static const struct of_device_id mt6375_tcpc_of_match[] = {
+	{ .compatible = "mediatek,mt6375-tcpc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6375_tcpc_of_match);
+
+static struct platform_driver mt6375_tcpc_driver = {
+	.driver = {
+		.name = "mt6375-tcpc",
+		.of_match_table = mt6375_tcpc_of_match,
+	},
+	.probe = mt6375_tcpc_probe,
+	.remove = mt6375_tcpc_remove,
+};
+module_platform_driver(mt6375_tcpc_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6375 USB Type-C Port Controller Interface driver");
+MODULE_LICENSE("GPL");
