From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Tue, 8 Sep 2026 22:40:00 +0300
Subject: [PATCH] drm: mediatek: bypass MT6878 OVL shadow registers

NothingOSS marks every MT6878 OVL instance as requiring shadow-register
bypass and sets bit 22 before programming a frame.  The mainline OVL start
path currently writes a literal one to OVL_EN, so the bit is absent on all
three primary OVL blocks.

Keep this behavior SoC-specific and set the bypass bit on every OVL start.
This also preserves the setting across display blank/unblank instead of
depending on bootloader state.

Signed-off-by: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
---
 drivers/gpu/drm/mediatek/mtk_disp_ovl.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
index 8f5f00000000..8f5f00000001 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
@@ -25,5 +25,6 @@
 #define DISP_REG_OVL_INTSTA			0x0008
 #define DISP_REG_OVL_EN				0x000c
+#define OVL_BYPASS_SHADOW				BIT(22)
 #define DISP_REG_OVL_RST			0x0014
 #define DISP_REG_OVL_ROI_SIZE			0x0020
 #define DISP_REG_OVL_DATAPATH_CON		0x0024
@@ -141,6 +142,7 @@ struct mtk_disp_ovl_data {
 	size_t num_formats;
 	bool supports_clrfmt_ext;
 	u32 vblank_irq_mask;
+	bool bypass_shadow;
 };
 
 /*
@@ -268,7 +270,10 @@ void mtk_ovl_start(struct device *dev)
 		reg = reg | OVL_LAYER_SMI_ID_EN;
 		writel_relaxed(reg, ovl->regs + DISP_REG_OVL_DATAPATH_CON);
 	}
-	writel_relaxed(0x1, ovl->regs + DISP_REG_OVL_EN);
+
+	writel_relaxed(0x1 | (ovl->data->bypass_shadow ?
+				 OVL_BYPASS_SHADOW : 0),
+		       ovl->regs + DISP_REG_OVL_EN);
 }
 
 void mtk_ovl_stop(struct device *dev)
@@ -686,6 +691,7 @@ static const struct mtk_disp_ovl_data mt6878_ovl_2l_driver_data = {
 	.formats = mt8173_formats,
 	.num_formats = ARRAY_SIZE(mt8173_formats),
 	.vblank_irq_mask = OVL_FME_START_INT,
+	.bypass_shadow = true,
 };
 
 static const struct mtk_disp_ovl_data mt8195_ovl_driver_data = {
