From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Tue, 1 Sep 2026 15:30:00 +0300
Subject: [PATCH] regulator: mt6363: describe the MT6878 VSRAM_CPUM rail

The MT6878 GPU uses MT6319 VBUCK2 for VGPU and MT6363 VSRAM_CPUM for
its SRAM supply. Linux already has the MT6315-compatible SPMI provider
used by MT6319, but the minimal MT6363 driver only describes the two
connectivity rails needed by the current port.

Add the VSRAM_CPUM register and voltage description from Nothing OS 4.1
Tetris device modules revision
ee2be53cb75670b548948636a0db1d1ff112bf12. Only register regulators
which have a matching child in DT. There is deliberately no VSRAM_CPUM
DT child in this patch, so this is compile-only inventory and causes no
new PMIC access, enable, voltage change or autoload at runtime.

Signed-off-by: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
---
 .../regulator/mediatek,mt6363-regulator.yaml  | 52 +++++++++++++++++++
 drivers/regulator/mt6363-regulator.c          | 42 +++++++++++++++
 include/linux/mfd/mt6363/registers.h          |  2 ++
 3 files changed, 96 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/mediatek,mt6363-regulator.yaml

diff --git a/Documentation/devicetree/bindings/regulator/mediatek,mt6363-regulator.yaml b/Documentation/devicetree/bindings/regulator/mediatek,mt6363-regulator.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/mediatek,mt6363-regulator.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/mediatek,mt6363-regulator.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6363 regulators
+
+maintainers:
+  - xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
+
+description: |
+  Regulator provider for the MT6363 SPMI PMIC. Only rails described as
+  child nodes are registered.
+
+properties:
+  compatible:
+    const: mediatek,mt6363-regulator
+
+  vcn13:
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+
+  vrfio18:
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+
+  vsram-cpum:
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    regulators {
+        compatible = "mediatek,mt6363-regulator";
+
+        vsram-cpum {
+            regulator-name = "mt6363-vsram-cpum";
+            regulator-min-microvolt = <400000>;
+            regulator-max-microvolt = <1193750>;
+        };
+    };
+
+...
diff --git a/drivers/regulator/mt6363-regulator.c b/drivers/regulator/mt6363-regulator.c
--- a/drivers/regulator/mt6363-regulator.c
+++ b/drivers/regulator/mt6363-regulator.c
@@ -22,6 +22,10 @@ static const unsigned int mt6363_vrfio18_voltages[] = {
 	1800000, 1900000, 2000000, 2100000,
 };
 
+static const struct linear_range mt6363_vsram_cpum_ranges[] = {
+	REGULATOR_LINEAR_RANGE(400000, 0, 0x7f, 6250),
+};
+
 static const struct regulator_ops mt6363_ldo_ops = {
 	.enable = regulator_enable_regmap,
 	.disable = regulator_disable_regmap,
@@ -32,6 +36,16 @@ static const struct regulator_ops mt6363_ldo_ops = {
 	.set_voltage_sel = regulator_set_voltage_sel_regmap,
 };
 
+static const struct regulator_ops mt6363_linear_ops = {
+	.enable = regulator_enable_regmap,
+	.disable = regulator_disable_regmap,
+	.is_enabled = regulator_is_enabled_regmap,
+	.list_voltage = regulator_list_voltage_linear_range,
+	.map_voltage = regulator_map_voltage_linear_range,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+};
+
 static const struct regulator_desc mt6363_regulators[] = {
 	{
 		.name = "vcn13",
@@ -72,6 +85,20 @@ static const struct regulator_desc mt6363_regulators[] = {
 		.vsel_reg = MT6363_VRFIO18_VSEL,
 		.vsel_mask = GENMASK(3, 0),
 	},
+	{
+		.name = "vsram-cpum",
+		.of_match = "vsram-cpum",
+		.ops = &mt6363_linear_ops,
+		.type = REGULATOR_VOLTAGE,
+		.owner = THIS_MODULE,
+		.linear_ranges = mt6363_vsram_cpum_ranges,
+		.n_linear_ranges = ARRAY_SIZE(mt6363_vsram_cpum_ranges),
+		.n_voltages = 0x80,
+		.enable_reg = MT6363_VSRAM_CPUM_ENABLE,
+		.enable_mask = BIT(0),
+		.vsel_reg = MT6363_VSRAM_CPUM_VSEL,
+		.vsel_mask = GENMASK(6, 0),
+	},
 };
 
 static int mt6363_regulator_probe(struct platform_device *pdev)
@@ -91,6 +118,18 @@ static int mt6363_regulator_probe(struct platform_device *pdev)
 
 	for (i = 0; i < ARRAY_SIZE(mt6363_regulators); i++) {
 		struct regulator_dev *rdev;
+		struct device_node *np;
+
+		/*
+		 * Do not register unmodelled rails. Besides keeping this provider
+		 * compile-only for VSRAM_CPUM, this prevents regulator late cleanup
+		 * from changing a bootloader-owned rail which has no DT contract.
+		 */
+		np = of_get_child_by_name(pdev->dev.of_node,
+					  mt6363_regulators[i].of_match);
+		if (!np)
+			continue;
+		of_node_put(np);
 
 		rdev = devm_regulator_register(&pdev->dev,
 					      &mt6363_regulators[i], &config);
diff --git a/include/linux/mfd/mt6363/registers.h b/include/linux/mfd/mt6363/registers.h
--- a/include/linux/mfd/mt6363/registers.h
+++ b/include/linux/mfd/mt6363/registers.h
@@ -11,6 +11,8 @@
 #define MT6363_VCN13_VSEL			0x1b3f
+#define MT6363_VSRAM_CPUM_VSEL			0x1b45
 #define MT6363_VRFIO18_ENABLE			0x1bcd
 #define MT6363_VCN13_ENABLE			0x1d07
+#define MT6363_VSRAM_CPUM_ENABLE		0x1e1d
 #define MT6363_VRFIO18_VSEL			0x1f2c
 
 #endif
-- 
2.51.0
