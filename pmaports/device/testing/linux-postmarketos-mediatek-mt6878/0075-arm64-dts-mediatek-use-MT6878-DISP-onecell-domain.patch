From 6ea20d3f1173fb84ad2909cc8493a5c1f8e8df82 Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Sun, 6 Sep 2026 21:40:00 +0300
Subject: [PATCH] arm64: dts: mediatek: use MT6878 DISP onecell domain

The MediaTek SCPSYS driver registers the power-controller node as a onecell
provider.  Its nested domain nodes describe hierarchy but are not
independent genpd providers.  Referencing the nested DISP node therefore
leaves display consumers permanently deferred in dev_pm_domain_attach().

Point the native display components and larb0 at the DISP index of the
registered SPM provider, matching the vendor DT contract.

Signed-off-by: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
---
 .../boot/dts/mediatek/mt6878-native-display-dma.dtsi | 2 +-
 .../boot/dts/mediatek/mt6878-nothing-tetris-native.dts | 8 ++++----
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6878-native-display-dma.dtsi b/arch/arm64/boot/dts/mediatek/mt6878-native-display-dma.dtsi
index 46b30b928..a510429fa 100644
--- a/arch/arm64/boot/dts/mediatek/mt6878-native-display-dma.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6878-native-display-dma.dtsi
@@ -24,7 +24,7 @@
 		clocks = <&mmsys CLK_MM_SMI_COMMON>,
 			 <&mmsys CLK_MM_SMI_COMMON>;
 		clock-names = "apb", "smi";
-		power-domains = <&disp>;
+		power-domains = <&spm MT6878_POWER_DOMAIN_DISP>;
 		status = "disabled";
 	};
 
diff --git a/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-native.dts b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-native.dts
index 8e28c95a1..96f55eb5c 100644
--- a/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-native.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-native.dts
@@ -49,7 +49,7 @@ disp_mutex0: mutex@14001000 {
 		reg = <0x14001000 0x1000>;
 		interrupts = <GIC_SPI 303 IRQ_TYPE_LEVEL_HIGH 0>;
 		clocks = <&mmsys CLK_MM_DISP_MUTEX0>;
-		power-domains = <&disp>;
+		power-domains = <&spm MT6878_POWER_DOMAIN_DISP>;
 		status = "okay";
 	};
 
@@ -59,7 +59,7 @@ disp_ovl0_2l: ovl@14002000 {
 		reg = <0x14002000 0x1000>;
 		interrupts = <GIC_SPI 302 IRQ_TYPE_LEVEL_HIGH 0>;
 		clocks = <&mmsys CLK_MM_DISP_OVL0_2L>;
-		power-domains = <&disp>;
+		power-domains = <&spm MT6878_POWER_DOMAIN_DISP>;
 		status = "okay";
 	};
 
@@ -69,7 +69,7 @@ disp_dsc0: dsc@14019000 {
 		reg = <0x14019000 0x1000>;
 		interrupts = <GIC_SPI 326 IRQ_TYPE_LEVEL_HIGH 0>;
 		clocks = <&mmsys CLK_MM_DISP_DSC_WRAP0>;
-		power-domains = <&disp>;
+		power-domains = <&spm MT6878_POWER_DOMAIN_DISP>;
 		status = "okay";
 	};
 
@@ -83,7 +83,7 @@ dsi0: dsi@1401a000 {
 		clock-names = "engine", "digital", "hs";
 		phys = <&mipi_tx0>;
 		phy-names = "dphy";
-		power-domains = <&disp>;
+		power-domains = <&spm MT6878_POWER_DOMAIN_DISP>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&display_pins>;
 		status = "okay";
-- 
