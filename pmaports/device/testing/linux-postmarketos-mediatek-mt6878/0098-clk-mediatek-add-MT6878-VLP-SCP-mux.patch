From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Mon, 21 Sep 2026 13:25:00 +0300
Subject: [PATCH] clk: mediatek: add MT6878 VLP SCP mux

The MT6878 SCP DVFS controller consumes the VLP SCP clock mux, but the
mainline MT6878 clock port does not register the VLP clock provider. Add the
single mux required by SCP bring-up using the register layout and parent set
from the matching Nothing OS 4.1 source.

This patch only registers the clock provider. It does not add an SCP or
scp-dvfs consumer and does not select, enable or change the mux at boot.

Signed-off-by: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
---
 arch/arm64/boot/dts/mediatek/mt6878.dtsi |  6 ++
 drivers/clk/mediatek/Makefile            |  2 +-
 drivers/clk/mediatek/clk-mt6878-vlp.c    | 60 +++++++++++++++++++
 3 files changed, 67 insertions(+), 1 deletion(-)
 create mode 100644 drivers/clk/mediatek/clk-mt6878-vlp.c

diff --git a/arch/arm64/boot/dts/mediatek/mt6878.dtsi b/arch/arm64/boot/dts/mediatek/mt6878.dtsi
index ab298d2b3..db63fe2db 100644
--- a/arch/arm64/boot/dts/mediatek/mt6878.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6878.dtsi
@@ -760,6 +760,12 @@ reboot-mode {
 				mode-rpmbpk = <0x8>;
 			};
 		};
+
+		vlp_cksys: clock-controller@1c012000 {
+			compatible = "mediatek,mt6878-vlp-cksys";
+			reg = <0x1c012000 0x1000>;
+			#clock-cells = <1>;
+		};
 	};
 
 	timer {
diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index 35e41e506..aabe7a12a 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
@@ -34,7 +34,7 @@ obj-$(CONFIG_COMMON_CLK_MT6797_IMGSYS) += clk-mt6797-img.o
 obj-$(CONFIG_COMMON_CLK_MT6797_MMSYS) += clk-mt6797-mm.o
 obj-$(CONFIG_COMMON_CLK_MT6797_VDECSYS) += clk-mt6797-vdec.o
 obj-$(CONFIG_COMMON_CLK_MT6797_VENCSYS) += clk-mt6797-venc.o
-obj-$(CONFIG_COMMON_CLK_MT6878) += clk-mt6878-apmixedsys.o clk-mt6878-mfg.o clk-mt6878-topckgen.o clk-mt6878-peri_ao.o clk-mt6878-ufs_ao.o clk-mt6878-ufs_pdn.o clk-mt6878-imp_iic_wrap.o clk-mt6878-audio.o clk-mt6878-mmsys.o
+obj-$(CONFIG_COMMON_CLK_MT6878) += clk-mt6878-apmixedsys.o clk-mt6878-mfg.o clk-mt6878-topckgen.o clk-mt6878-vlp.o clk-mt6878-peri_ao.o clk-mt6878-ufs_ao.o clk-mt6878-ufs_pdn.o clk-mt6878-imp_iic_wrap.o clk-mt6878-audio.o clk-mt6878-mmsys.o
 obj-$(CONFIG_COMMON_CLK_MT2701) += clk-mt2701.o
 obj-$(CONFIG_COMMON_CLK_MT2701_AUDSYS) += clk-mt2701-aud.o
 obj-$(CONFIG_COMMON_CLK_MT2701_BDPSYS) += clk-mt2701-bdp.o
diff --git a/drivers/clk/mediatek/clk-mt6878-vlp.c b/drivers/clk/mediatek/clk-mt6878-vlp.c
new file mode 100644
index 000000000..5e858dae3
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6878-vlp.c
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2026
+ */
+
+#include <dt-bindings/clock/mediatek,mt6878-clock.h>
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include "clk-mtk.h"
+#include "clk-mux.h"
+
+#define VLP_CLK_CFG_UPDATE	0x0004
+#define VLP_CLK_CFG_0		0x0008
+#define VLP_CLK_CFG_0_SET	0x000c
+#define VLP_CLK_CFG_0_CLR	0x0010
+
+static const char * const vlp_scp_parents[] = {
+	"tck_26m_mx9_ck",
+	"univpll_d4",
+	"univpll_d3",
+	"mainpll_d3",
+	"univpll_d6",
+	"apll1_ck",
+	"mainpll_d4",
+	"mainpll_d7",
+	"osc_d10",
+};
+
+static const struct mtk_mux vlp_muxes[] = {
+	MUX_GATE_CLR_SET_UPD(CLK_VLP_SCP_SEL, "vlp_scp_sel",
+			     vlp_scp_parents, VLP_CLK_CFG_0,
+			     VLP_CLK_CFG_0_SET, VLP_CLK_CFG_0_CLR,
+			     0, 4, 7, VLP_CLK_CFG_UPDATE, 0),
+};
+
+static const struct mtk_clk_desc vlp_desc = {
+	.mux_clks = vlp_muxes,
+	.num_mux_clks = ARRAY_SIZE(vlp_muxes),
+};
+
+static const struct of_device_id of_match_clk_mt6878_vlp[] = {
+	{ .compatible = "mediatek,mt6878-vlp-cksys", .data = &vlp_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6878_vlp);
+
+static struct platform_driver clk_mt6878_vlp_driver = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt6878-vlp",
+		.of_match_table = of_match_clk_mt6878_vlp,
+	},
+};
+module_platform_driver(clk_mt6878_vlp_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6878 VLP clock driver");
+MODULE_LICENSE("GPL");
-- 
2.51.0
