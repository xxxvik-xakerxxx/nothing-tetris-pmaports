From c7425ad9ef78288dc90957da682cbeefca230859 Mon Sep 17 00:00:00 2001
From: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
Date: Thu, 10 Sep 2026 19:20:00 +0300
Subject: [PATCH] drm: mediatek: clear MT6878 OVL PQ loop

Nothing OS clears the OVL PQ output-size selector during config-begin. Mainline
currently inherits this state from the bootloader, leaving the OVL PQ loop
enabled on Tetris after reset.

Clear only the defined selector bit at the authoritative Nothing OS 4.1
register offset before enabling relay output. MMSYS crossbar normalization is
kept in the route-connect lifecycle, after the display domain and clocks are
enabled.
---
 drivers/gpu/drm/mediatek/mtk_disp_ovl.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
index ae886fc..66d6cb9 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
@@ -31,2 +31,3 @@
 #define DISP_REG_OVL_DATAPATH_CON		0x0024
+#define DISP_REG_OVL_PQ_LOOP_CON		0x02e0
 #define OVL_LAYER_SMI_ID_EN				BIT(0)
@@ -284,7 +285,13 @@ void mtk_ovl_start(struct device *dev)
 		writel(0, ovl->regs + DISP_REG_OVL_INTSTA);
 	}
 
+	if (ovl->data->force_relay) {
+		unsigned int reg = readl(ovl->regs + DISP_REG_OVL_PQ_LOOP_CON);
+
+		writel_relaxed(reg & ~BIT(0), ovl->regs + DISP_REG_OVL_PQ_LOOP_CON);
+	}
+
 	writel_relaxed(0x1 | (ovl->data->bypass_shadow ?
 				 OVL_BYPASS_SHADOW : 0),
 		       ovl->regs + DISP_REG_OVL_EN);
 
