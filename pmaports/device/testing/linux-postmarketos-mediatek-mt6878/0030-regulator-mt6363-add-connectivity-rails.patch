 #define MT6363_PSC_TOP_INT_STATUS0		0x091b
 
+#define MT6363_VCN13_VSEL			0x1b3f
+#define MT6363_VRFIO18_ENABLE			0x1bcd
+#define MT6363_VCN13_ENABLE			0x1d07
+#define MT6363_VRFIO18_VSEL			0x1f2c
