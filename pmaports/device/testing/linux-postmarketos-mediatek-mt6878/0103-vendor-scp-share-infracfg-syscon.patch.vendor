 		if ((tmp & 0xA0) != 0xA0) {
 			pr_notice("%s: INFRA7_IRQ_SET %x\n", __func__, tmp);
 			break;
@@ -232,8 +241,11 @@ int scp_awake_unlock(void *_scp_id)
 		udelay(10);
 	}
 	/* clear status */
-	writel(0xA0 | (1 << AP_AWAKE_UNLOCK), INFRA_IRQ_CLEAR);
+	if (regmap_write(scpreg.scpsys, INFRA_IRQ_CLEAR,
