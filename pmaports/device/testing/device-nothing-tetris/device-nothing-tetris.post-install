#!/bin/sh
set -eu

root=${ROOT:-}
passwd=$root/etc/passwd
config=$root/var/lib/greetd/.config
dconf=$root/var/lib/greetd/.config/dconf

identity=$(awk -F: '$1 == "greetd" { print $3 ":" $4; found = 1 } END { exit found ? 0 : 1 }' "$passwd")
install -d -m 0700 "$config" "$dconf"
chown -R "$identity" "$config"
chmod 0700 "$config" "$dconf"
