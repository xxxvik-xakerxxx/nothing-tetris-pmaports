# Hide Android firmware partitions from desktop storage UIs.  The postmarketOS
# root and boot filesystems stay visible through their filesystem labels.
SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_PATH}=="platform-112b0000.ufshci-scsi-0:0:0:2", ENV{ID_FS_LABEL}!="pmOS_root", ENV{ID_FS_LABEL}!="pmOS_boot", ENV{UDISKS_IGNORE}="1"
