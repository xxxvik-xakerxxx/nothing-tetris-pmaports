#!/bin/sh
set -eu

log() {
	printf '%s\n' "nothing-tetris-connectivity: $*"
}

load_module() {
	module=$1
	if [ -d "/sys/module/$module" ]; then
		return 0
	fi
	if modprobe "$module" 2>/dev/null; then
		return 0
	fi

	release=$(uname -r)
	path=/lib/modules/$release/extra/mediatek-connectivity/$module.ko
	if [ -e "$path" ]; then
		insmod "$path" && return 0
	fi

	return 1
}

stage=${1:-base}
case "$stage" in
	base)
		modules="connadp conninfra connfem"
		;;
	wifi)
		modules="connadp conninfra connfem wmtWifi wlan_drv_gen4m_6878"
		;;
	bluetooth)
		modules="connadp conninfra connfem bt_drv_6878"
		;;
	all)
		modules="connadp conninfra connfem wmtWifi wlan_drv_gen4m_6878 bt_drv_6878"
		;;
	*)
		echo "usage: $0 {base|wifi|bluetooth|all}" >&2
		exit 2
		;;
esac

for firmware in \
	connsys_wifi_mt6878_mt6631.bin \
	connsys_bt_mt6878_mt6631.bin \
	connsys_gnss_mt6878_mt6631.bin; do
	[ -s "/usr/lib/firmware/$firmware" ] ||
		log "missing packaged firmware: $firmware"
done

log "loading $stage stage"
failures=0
for module in $modules; do
	if ! load_module "$module"; then
		log "failed to load $module"
		failures=$((failures + 1))
	fi
done

if [ "$stage" = wifi ] || [ "$stage" = all ]; then
	ip link show wlan0 >/dev/null 2>&1 &&
		log "wlan0 is present" || log "wlan0 is not present yet"
fi

[ "$failures" -eq 0 ]
