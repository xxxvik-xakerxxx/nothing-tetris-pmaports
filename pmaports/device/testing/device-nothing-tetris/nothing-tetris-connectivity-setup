#!/bin/sh
set -eu

log() {
	printf '%s\n' "nothing-tetris-connectivity: $*"
}

load_module() {
	module=$1
	if [ -d "/sys/module/$module" ]; then
		return 0
	fi

	release=$(uname -r)
	path=/lib/modules/$release/extra/mediatek-connectivity/$module.ko
	if [ -e "$path" ]; then
		insmod "$path" && return 0
	fi
	if modprobe "$module" 2>/dev/null; then
		return 0
	fi

	return 1
}

load_modules() {
	for module in "$@"; do
		if ! load_module "$module"; then
			log "failed to load $module"
			return 1
		fi
	done
}

bring_up_radios() {
	load_modules connadp conninfra connfem wmtWifi cfg80211 \
		wlan_drv_gen4m_6878

	[ -c /dev/wmtWifi ] || {
		log "/dev/wmtWifi is unavailable"
		return 1
	}

	/usr/libexec/nothing-tetris-wifi-nvram-load

	# MT6878 performs one joint Wi-Fi/BT pre-calibration. Both callbacks must
	# be registered before either radio is powered for normal operation.
	load_modules bluetooth bt_drv_6878

	tries=0
	while [ ! -d /sys/class/net/wlan0 ] || \
			[ ! -d /sys/class/bluetooth/hci0 ]; do
		tries=$((tries + 1))
		[ "$tries" -lt 150 ] || {
			log "joint radio pre-calibration did not register wlan0 and hci0"
			return 1
		}
		sleep 0.1
	done

	# The vendor cdev interprets this single byte as the Wi-Fi power-on command.
	printf '1' > /dev/wmtWifi

	tries=0
	while ! ip link show wlan0 >/dev/null 2>&1; do
		tries=$((tries + 1))
		[ "$tries" -lt 50 ] || {
			log "wlan0 disappeared after Wi-Fi power-on"
			return 1
		}
		sleep 0.1
	done
	ip link set wlan0 up
	log "wlan0 and hci0 are ready for NetworkManager and BlueZ"
}

stage=${1:-base}

missing_firmware=0
for firmware in \
	connsys_wifi_mt6878_mt6631.bin \
	connsys_bt_mt6878_mt6631.bin \
	connsys_gnss_mt6878_mt6631.bin; do
	if [ ! -s "/usr/lib/firmware/$firmware" ]; then
		log "missing packaged firmware: $firmware"
		missing_firmware=1
	fi
done
[ "$missing_firmware" -eq 0 ] || exit 1

case "$stage" in
	base)
		log "loading base stage"
		load_modules connadp conninfra connfem
		;;
	wifi)
		log "loading joint Wi-Fi/Bluetooth stage"
		bring_up_radios
		;;
	bluetooth)
		log "loading joint Wi-Fi/Bluetooth stage"
		bring_up_radios
		;;
	all)
		log "loading joint Wi-Fi/Bluetooth stage"
		bring_up_radios
		;;
	*)
		echo "usage: $0 {base|wifi|bluetooth|all}" >&2
		exit 2
		;;
esac
