#!/bin/sh
set -eu

log() {
	printf '%s\n' "nothing-tetris-connectivity: $*"
}

load_module() {
	module=$1
	if [ -d "/sys/module/$module" ]; then
		return 0
	fi

	release=$(uname -r)
	path=/lib/modules/$release/extra/mediatek-connectivity/$module.ko
	if [ -e "$path" ]; then
		insmod "$path" && return 0
	fi
	if modprobe "$module" 2>/dev/null; then
		return 0
	fi

	return 1
}

load_modules() {
	for module in "$@"; do
		if ! load_module "$module"; then
			log "failed to load $module"
			return 1
		fi
	done
}

bring_up_wifi() {
	load_modules connadp conninfra connfem wmtWifi cfg80211 \
		wlan_drv_gen4m_6878

	[ -c /dev/wmtWifi ] || {
		log "/dev/wmtWifi is unavailable"
		return 1
	}

	/usr/libexec/nothing-tetris-wifi-nvram-load

	# The vendor cdev interprets this single byte as the Wi-Fi power-on command.
	printf '1' > /dev/wmtWifi

	tries=0
	while [ ! -d /sys/class/net/wlan0 ]; do
		tries=$((tries + 1))
		[ "$tries" -lt 50 ] || {
			log "wlan0 was not registered"
			return 1
		}
		sleep 0.1
	done
	ip link set wlan0 up
	log "wlan0 is ready for the network manager"
}

bring_up_bluetooth() {
	load_modules bluetooth bt_drv_6878
	[ -d /sys/class/bluetooth/hci0 ] || {
		log "hci0 was not registered"
		return 1
	}
	log "hci0 is ready for BlueZ"
}

bring_up_all() {
	bring_up_wifi
	bring_up_bluetooth
}

stage=${1:-base}

missing_firmware=0
for firmware in \
	connsys_wifi_mt6878_mt6631.bin \
	connsys_bt_mt6878_mt6631.bin \
	connsys_gnss_mt6878_mt6631.bin; do
	if [ ! -s "/usr/lib/firmware/$firmware" ]; then
		log "missing packaged firmware: $firmware"
		missing_firmware=1
	fi
done
[ "$missing_firmware" -eq 0 ] || exit 1

case "$stage" in
	base)
		log "loading base stage"
		load_modules connadp conninfra connfem
		;;
	wifi)
		log "loading Wi-Fi stage"
		bring_up_wifi
		;;
	bluetooth)
		log "loading Bluetooth stage"
		load_modules connadp conninfra connfem
		bring_up_bluetooth
		;;
	all)
		log "loading all connectivity stages"
		bring_up_all
		;;
	*)
		echo "usage: $0 {base|wifi|bluetooth|all}" >&2
		exit 2
		;;
esac
