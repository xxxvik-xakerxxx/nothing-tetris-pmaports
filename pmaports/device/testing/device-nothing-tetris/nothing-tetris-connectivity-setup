#!/bin/sh
set -eu

log() {
	printf '%s\n' "nothing-tetris-connectivity: $*"
}

load_module() {
	module=$1
	if grep -qw "^$module" /proc/modules; then
		return 0
	fi
	if modprobe "$module" 2>/dev/null; then
		return 0
	fi

	release=$(uname -r)
	path=/lib/modules/$release/extra/mediatek-connectivity/$module.ko
	if [ -e "$path" ]; then
		insmod "$path"
	fi
}

for firmware in \
	connsys_wifi_mt6878_mt6631.bin \
	connsys_bt_mt6878_mt6631.bin \
	connsys_gnss_mt6878_mt6631.bin; do
	[ -s "/usr/lib/firmware/$firmware" ] ||
		log "missing packaged firmware: $firmware"
done

for module in \
	connadp \
	conninfra \
	connfem \
	wmt_drv \
	wmtWifi \
	wlan_drv_gen4m_6878 \
	bt_drv_6878; do
	load_module "$module" || log "failed to load $module"
done

ip link show wlan0 >/dev/null 2>&1 && log "wlan0 is present" || log "wlan0 is not present yet"
