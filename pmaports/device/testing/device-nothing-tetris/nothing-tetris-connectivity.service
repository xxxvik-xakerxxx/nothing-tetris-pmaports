[Unit]
Description=Nothing Tetris connectivity bring-up
Requires=nothing-tetris-wifi-nvram.service
After=local-fs.target nothing-tetris-wifi-nvram.service
Before=NetworkManager.service bluetooth.service iwd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/nothing-tetris-connectivity-setup all
TimeoutStartSec=30
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
