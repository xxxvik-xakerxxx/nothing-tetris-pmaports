#!/bin/sh
set -eu
umask 077

source_device=${1:-/dev/disk/by-partlabel/nvdata}
output=${2:-/run/nothing-tetris/BT_ADDR}
case "$output" in
	*/*) output_dir=${output%/*} ;;
	*) output_dir=. ;;
esac
record_temporary="$output.record.tmp.$$"
temporary="$output.tmp.$$"

cleanup() {
	rm -f "$record_temporary" "$temporary"
}
trap cleanup EXIT HUP INT TERM

[ -b "$source_device" ] || {
	echo "nothing-tetris: nvdata partition is unavailable" >&2
	exit 1
}

install -d -m 0700 "$output_dir"
if ! debugfs -R "dump /APCFG/APRDEB/BT_Addr $record_temporary" \
		"$source_device" >/dev/null 2>&1; then
	echo "nothing-tetris: failed to read Bluetooth address from nvdata" >&2
	exit 1
fi

[ -f "$record_temporary" ] || {
	echo "nothing-tetris: Bluetooth address record is missing from nvdata" >&2
	exit 1
}

size=$(stat -c %s "$record_temporary")
[ "$size" -eq 2416 ] || {
	echo "nothing-tetris: invalid Bluetooth address record size: $size" >&2
	exit 1
}

dd if="$record_temporary" of="$temporary" bs=1 count=6 2>/dev/null
[ "$(stat -c %s "$temporary")" -eq 6 ] || {
	echo "nothing-tetris: failed to extract Bluetooth address" >&2
	exit 1
}

chmod 0600 "$temporary"
mv -f "$temporary" "$output"
trap - EXIT HUP INT TERM
