# Co-Maintainer: xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>
maintainer="BotchedRPR <igor.belwon@mentallysanemainliners.org>"
pkgname=device-nothing-tetris
pkgdesc="Nothing CMF Phone 1"
pkgver=6
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	dtc
	firmware-nothing-tetris
	linux-postmarketos-mediatek-mt6878
	linux-postmarketos-mediatek-mt6878-audio
	linux-postmarketos-mediatek-mt6878-connectivity
	linux-postmarketos-mediatek-mt6878-pmic
	postmarketos-base
	u-boot-tools
"
makedepends="devicepkg-dev"
source="
	80-nothing-tetris-udisks.rules
	boot_image.its
	deviceinfo
	greetd-tetris-display.conf
	nothing-tetris-connectivity.service
	nothing-tetris-connectivity-setup
	phoc.ini
	phrog-greetd-config.toml
	tetris-phrog-greetd-session
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/greetd-tetris-display.conf \
		"$pkgdir"/etc/systemd/system/greetd.service.d/override.conf
	install -Dm644 "$srcdir"/phoc.ini \
		"$pkgdir"/etc/phosh/phoc.ini
	install -Dm644 "$srcdir"/phoc.ini \
		"$pkgdir"/etc/phrog/phoc.ini
	install -Dm644 "$srcdir"/phrog-greetd-config.toml \
		"$pkgdir"/etc/phrog/tetris-greetd-config.toml
	install -Dm755 "$srcdir"/tetris-phrog-greetd-session \
		"$pkgdir"/usr/libexec/tetris-phrog-greetd-session
	install -Dm644 "$srcdir"/boot_image.its \
		"$pkgdir"/usr/share/u-boot/nothing-tetris/boot_image.its
	install -Dm644 "$srcdir"/80-nothing-tetris-udisks.rules \
		"$pkgdir"/usr/lib/udev/rules.d/80-nothing-tetris-udisks.rules
	install -Dm755 "$srcdir"/nothing-tetris-connectivity-setup \
		"$pkgdir"/usr/libexec/nothing-tetris-connectivity-setup
	install -Dm644 "$srcdir"/nothing-tetris-connectivity.service \
		"$pkgdir"/etc/systemd/system/nothing-tetris-connectivity.service
	mkdir -p "$pkgdir"/etc/systemd/system/multi-user.target.wants
	ln -s ../nothing-tetris-connectivity.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/nothing-tetris-connectivity.service
}

