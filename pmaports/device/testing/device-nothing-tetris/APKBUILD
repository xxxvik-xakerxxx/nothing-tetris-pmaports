build() {
	devicepkg_build $startdir $pkgname

	$CC $CFLAGS $CPPFLAGS -std=c11 -Wall -Wextra -Werror \
		"$srcdir"/nothing-tetris-wifi-nvram-load.c \
		$LDFLAGS -o "$srcdir"/nothing-tetris-wifi-nvram-load
	$CC $CFLAGS $CPPFLAGS -std=c11 -Wall -Wextra -Werror \
		"$srcdir"/nothing-tetris-bluetooth-address.c \
		$LDFLAGS -o "$srcdir"/nothing-tetris-bluetooth-address
}

check() {
	sh -n "$srcdir"/nothing-tetris-bluetooth-address-extract
	sh -n "$srcdir"/nothing-tetris-connectivity-setup
	sh -n "$srcdir"/nothing-tetris-wifi-nvram-extract

	testdir=$(mktemp -d)
	trap 'rm -rf "$testdir"' EXIT

	dd if=/dev/zero of="$testdir"/WIFI bs=6146 count=1 2>/dev/null
	printf '\002\021\042\063\104\125' | \
		dd of="$testdir"/WIFI bs=1 seek=4 conv=notrunc 2>/dev/null
	: > "$testdir"/wmtWifi
	"$srcdir"/nothing-tetris-wifi-nvram-load \
		"$testdir"/WIFI "$testdir"/wmtWifi

	[ "$(wc -c < "$testdir"/wmtWifi)" -eq 6158 ]
	[ "$(dd if="$testdir"/wmtWifi bs=1 count=12 2>/dev/null)" = \
		"WR-BUF:NVRAM" ]
	dd if="$testdir"/wmtWifi bs=1 skip=12 2>/dev/null | \
		cmp - "$testdir"/WIFI

	cp "$testdir"/WIFI "$testdir"/WIFI.invalid
	printf '\001' | dd of="$testdir"/WIFI.invalid bs=1 seek=4 \
		conv=notrunc 2>/dev/null
	if "$srcdir"/nothing-tetris-wifi-nvram-load \
			"$testdir"/WIFI.invalid "$testdir"/wmtWifi 2>/dev/null; then
		return 1
	fi
	if "$srcdir"/nothing-tetris-wifi-nvram-load \
			/dev/null "$testdir"/wmtWifi 2>/dev/null; then
		return 1
	fi
	ln -s WIFI "$testdir"/WIFI.link
	if "$srcdir"/nothing-tetris-wifi-nvram-load \
			"$testdir"/WIFI.link "$testdir"/wmtWifi 2>/dev/null; then
		return 1
	fi

	dd if=/dev/zero of="$testdir"/BT_ADDR bs=6 count=1 2>/dev/null
	if "$srcdir"/nothing-tetris-bluetooth-address \
			"$testdir"/BT_ADDR 2>/dev/null; then
		return 1
	fi
	printf '\000\000\106\147\141\001' > "$testdir"/BT_ADDR
	if "$srcdir"/nothing-tetris-bluetooth-address \
			"$testdir"/BT_ADDR 2>/dev/null; then
		return 1
	fi
	ln -s BT_ADDR "$testdir"/BT_ADDR.link
	if "$srcdir"/nothing-tetris-bluetooth-address \
			"$testdir"/BT_ADDR.link 2>/dev/null; then
		return 1
	fi
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/greetd-tetris-display.conf \
		"$pkgdir"/etc/systemd/system/greetd.service.d/override.conf
	install -Dm644 "$srcdir"/phoc.ini \
		"$pkgdir"/etc/phosh/phoc.ini
	install -Dm644 "$srcdir"/phoc.ini \
		"$pkgdir"/etc/phrog/phoc.ini
	install -Dm644 "$srcdir"/phrog-greetd-config.toml \
		"$pkgdir"/etc/phrog/tetris-greetd-config.toml
	install -Dm755 "$srcdir"/tetris-phrog-greetd-session \
		"$pkgdir"/usr/libexec/tetris-phrog-greetd-session
	install -Dm644 "$srcdir"/boot_image.its \
		"$pkgdir"/usr/share/u-boot/nothing-tetris/boot_image.its
	install -Dm644 "$srcdir"/80-nothing-tetris-udisks.rules \
		"$pkgdir"/usr/lib/udev/rules.d/80-nothing-tetris-udisks.rules
	install -Dm644 "$srcdir"/72-nothing-tetris-feedbackd.rules \
		"$pkgdir"/usr/lib/udev/rules.d/72-nothing-tetris-feedbackd.rules
	install -Dm644 "$srcdir"/20-nothing-tetris-wifi-powersave.conf \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/20-nothing-tetris-wifi-powersave.conf
	install -Dm755 "$srcdir"/nothing-tetris-connectivity-setup \
		"$pkgdir"/usr/libexec/nothing-tetris-connectivity-setup
	install -Dm644 "$srcdir"/nothing-tetris-audio.conf \
		"$pkgdir"/usr/lib/modules-load.d/nothing-tetris-audio.conf
	install -Dm644 "$srcdir"/nothing-tetris-haptics.conf \
		"$pkgdir"/usr/lib/modules-load.d/nothing-tetris-haptics.conf
	install -Dm755 "$srcdir"/nothing-tetris-bluetooth-address-extract \
		"$pkgdir"/usr/libexec/nothing-tetris-bluetooth-address-extract
	install -Dm755 "$srcdir"/nothing-tetris-bluetooth-address \
		"$pkgdir"/usr/libexec/nothing-tetris-bluetooth-address
	install -Dm755 "$srcdir"/nothing-tetris-wifi-nvram-extract \
		"$pkgdir"/usr/libexec/nothing-tetris-wifi-nvram-extract
	install -Dm755 "$srcdir"/nothing-tetris-wifi-nvram-load \
		"$pkgdir"/usr/libexec/nothing-tetris-wifi-nvram-load
	install -Dm644 "$srcdir"/nothing-tetris-connectivity.service \
		"$pkgdir"/usr/lib/systemd/system/nothing-tetris-connectivity.service
	install -Dm644 "$srcdir"/nothing-tetris-bluetooth-address-extract.service \
		"$pkgdir"/usr/lib/systemd/system/nothing-tetris-bluetooth-address-extract.service
	install -Dm644 "$srcdir"/nothing-tetris-bluetooth-address.service \
		"$pkgdir"/usr/lib/systemd/system/nothing-tetris-bluetooth-address.service
	install -Dm644 "$srcdir"/nothing-tetris-wifi-nvram.service \
		"$pkgdir"/usr/lib/systemd/system/nothing-tetris-wifi-nvram.service
	install -Dm644 "$srcdir"/nothing-tetris-bluetooth.service.conf \
		"$pkgdir"/etc/systemd/system/bluetooth.service.d/10-nothing-tetris-address.conf
	install -Dm644 "$srcdir"/89-nothing-tetris.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/89-nothing-tetris.preset
}

