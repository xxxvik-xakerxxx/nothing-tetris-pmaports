options="!archcheck"
depends="
	dtc
	e2fsprogs-extra
	firmware-nothing-tetris
	iproute2
	kmod
	linux-postmarketos-mediatek-mt6878
	postmarketos-base
	u-boot-tools
"
makedepends="devicepkg-dev"
source="
	80-nothing-tetris-udisks.rules
	89-nothing-tetris.preset
	boot_image.its
	deviceinfo
	greetd-tetris-display.conf
	nothing-tetris-bluetooth-address.c
	nothing-tetris-bluetooth-address.service
	nothing-tetris-bluetooth.service.conf
	nothing-tetris-connectivity.service
	nothing-tetris-connectivity-setup
	nothing-tetris-wifi-nvram-extract
