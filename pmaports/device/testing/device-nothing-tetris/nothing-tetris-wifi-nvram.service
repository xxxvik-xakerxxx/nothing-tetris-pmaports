[Unit]
Description=Extract Nothing Tetris radio calibration data
Requires=dev-disk-by\x2dpartlabel-nvdata.device
After=dev-disk-by\x2dpartlabel-nvdata.device local-fs.target
Before=nothing-tetris-connectivity.service
Before=NetworkManager.service iwd.service

[Service]
Type=oneshot
RuntimeDirectory=nothing-tetris
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/usr/libexec/nothing-tetris-wifi-nvram-extract
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
