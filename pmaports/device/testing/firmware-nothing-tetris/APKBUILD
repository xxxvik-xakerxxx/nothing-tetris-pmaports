maintainer="xxxvik-xakerxxx <19531907+xxxvik-xakerxxx@users.noreply.github.com>"
pkgname=firmware-nothing-tetris
pkgver=1
pkgrel=2
pkgdesc="Connectivity firmware for Nothing CMF Phone 1"
url="https://github.com/NothingOSS"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
source="
	conninfra.cfg
	connsys_bt_mt6878_mt6631.bin
	connsys_gnss_mt6878_mt6631.bin
	connsys_wifi_mt6878_mt6631.bin
"

package() {
	_fwdir="$pkgdir/usr/lib/firmware"
	install -Dm644 "$srcdir"/conninfra.cfg "$_fwdir"/conninfra.cfg
	install -Dm644 "$srcdir"/connsys_wifi_mt6878_mt6631.bin \
		"$_fwdir"/connsys_wifi_mt6878_mt6631.bin
	install -Dm644 "$srcdir"/connsys_bt_mt6878_mt6631.bin \
		"$_fwdir"/connsys_bt_mt6878_mt6631.bin
	install -Dm644 "$srcdir"/connsys_gnss_mt6878_mt6631.bin \
		"$_fwdir"/connsys_gnss_mt6878_mt6631.bin

	for _name in \
		WIFI_RAM_CODE_soc7_0_1_1.bin \
		WIFI_RAM_CODE_soc7_0_1_1 \
		soc7_0_ram_wmmcu_1_1_hdr.bin \
		soc7_0_ram_mcu_1_1_hdr.bin; do
		ln -s connsys_wifi_mt6878_mt6631.bin "$_fwdir/$_name"
	done
	ln -s connsys_bt_mt6878_mt6631.bin \
		"$_fwdir"/soc7_0_ram_bt_1_1_hdr.bin
	for _name in connsys_gnss connsys_gnss.bin; do
		ln -s connsys_gnss_mt6878_mt6631.bin "$_fwdir/$_name"
	done
}

