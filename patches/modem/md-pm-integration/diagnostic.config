# Staged observation base; not shipping or activation.
# FIRST-OFF CI additionally merges first-off.config and its expected map.
CONFIG_ARM64=y
CONFIG_OF=y
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
# CONFIG_OF_DYNAMIC is not set
# CONFIG_MEMORY_HOTREMOVE is not set
# CONFIG_OF_OVERLAY is not set
# CONFIG_OF_UNITTEST is not set
# CONFIG_PCI_DYNAMIC_OF_NODES is not set
# CONFIG_I2C_DEMUX_PINCTRL is not set
# CONFIG_CHROMEOS_OF_HW_PROBER is not set
# CONFIG_VIDEO_QCOM_VENUS is not set
# CONFIG_STM32_FIREWALL is not set
# CONFIG_HOTPLUG_PCI_POWERNV is not set
# CONFIG_MPC885ADS is not set
# CONFIG_PPC_PSERIES is not set
