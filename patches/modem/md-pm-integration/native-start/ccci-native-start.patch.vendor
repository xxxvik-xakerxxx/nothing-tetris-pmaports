 #include <linux/kernel.h>
@@ -1872,8 +1875,13 @@
 		return ret;
 	}
 	ccci_ccif_ctrl = ccif_ctrl;
+#if IS_ENABLED(CONFIG_MTK_ECCCI_TETRIS_NATIVE_START)
+	return ccci_tetris_hif_register(ccif_ctrl->hif_id,
