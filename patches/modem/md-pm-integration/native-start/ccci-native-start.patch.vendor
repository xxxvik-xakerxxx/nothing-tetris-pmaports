+#include "ccci_tetris_native_start.h"
+#endif
 #include <linux/device.h>
 #include <linux/module.h>
 #include <linux/kernel.h>
@@ -3227,7 +3230,14 @@
 	mtk_ccci_md_spd_qos_init(dev);
 	mtk_ccci_spd_qos_method_init();
 
+#if IS_ENABLED(CONFIG_MTK_ECCCI_TETRIS_NATIVE_START)
+	ret = ccci_tetris_hif_register(DPMAIF_HIF_ID,
+		dpmaif_ctl, &g_dpmaif_ops, dev);
+	if (ret)
+		return ret;
+#else
 	ccci_hif_register(DPMAIF_HIF_ID, dpmaif_ctl, &g_dpmaif_ops);
+#endif
 
 	atomic_set(&dpmaif_ctl->suspend_flag, 0);
 
@@ -3247,6 +3257,11 @@
 
 static int dpmaif_probe(struct platform_device *pdev)
 {
+#if IS_ENABLED(CONFIG_MTK_ECCCI_TETRIS_NATIVE_START)
+	int error = ccci_tetris_hif_claim(pdev, DPMAIF_HIF_ID);
+	if (error)
+		return error;
+#endif
 	if (of_property_read_u32(pdev->dev.of_node,
 			"mediatek,dpmaif-ver", &g_dpmf_ver)) {
 		CCCI_ERROR_LOG(0, TAG,
@@ -3277,6 +3292,9 @@
 
 static int dpmaif_suspend_noirq(struct device *dev)
 {
+#if IS_ENABLED(CONFIG_MTK_ECCCI_TETRIS_NATIVE_START)
+	return -EOPNOTSUPP;
+#endif
 	CCCI_NORMAL_LOG(-1, TAG, "[%s] dev: %p\n", __func__, dev);
 
 	if ((!dpmaif_ctl) || (atomic_read(&dpmaif_ctl->suspend_flag) < 0))
@@ -3296,6 +3314,9 @@
 
 static int dpmaif_resume_noirq(struct device *dev)
 {
+#if IS_ENABLED(CONFIG_MTK_ECCCI_TETRIS_NATIVE_START)
+	return -EOPNOTSUPP;
+#endif
 	struct arm_smccc_res res;
 	int ret = 0;
 
diff --git a/drivers/misc/mediatek/eccci/hif/ccci_hif.c b/drivers/misc/mediatek/eccci/hif/ccci_hif.c
--- a/drivers/misc/mediatek/eccci/hif/ccci_hif.c
+++ b/drivers/misc/mediatek/eccci/hif/ccci_hif.c
@@ -15,6 +15,7 @@
 
 void *ccci_hif[CCCI_HIF_NUM];
 struct ccci_hif_ops *ccci_hif_op[CCCI_HIF_NUM];
+#include "native-hif-owner.h"
 
 int ccci_dpmaif_empty_query(int qno)
 {
@@ -515,6 +516,11 @@
 	CCCI_HISTORY_TAG_LOG(0, CORE,
 			"hif register: %d\n", hif_id);
 
+#if IS_ENABLED(CONFIG_MTK_ECCCI_TETRIS_NATIVE_START)
+	/* Native providers use the checked, sealed API only. */
+	CCCI_ERROR_LOG(0, CORE, "native HIF rejects legacy registration\n");
