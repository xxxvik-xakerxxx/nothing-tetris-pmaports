+	error = of_property_read_u32(pdev->dev.of_node, "mediatek,dpmaif-ver", &version);
+	if (error)
+		return error;
+	error = of_property_read_u32(pdev->dev.of_node, "mediatek,plat-info", &platform);
+	if (error)
+		return error;
+	error = of_property_read_u32(pdev->dev.of_node, "mediatek,dpmaif-cap", &capability);
+	if (error)
+		return error;
+	if (version != 3 || platform != 6878)
+		return -EOPNOTSUPP;
+	return tetris_hif_supplier_probe(pdev, DPMAIF_HIF_ID,
+		tetris_hif_clocks, ARRAY_SIZE(tetris_hif_clocks),
+		capability & (DPMAIF_CAP_LRO | DPMAIF_CAP_2RXQ) ? DPMAIF_RXQ_NUM : 1);
+#endif
 	if (of_property_read_u32(pdev->dev.of_node,
 			"mediatek,dpmaif-ver", &g_dpmf_ver)) {
 		CCCI_ERROR_LOG(0, TAG,
@@ -3343,21 +3373,37 @@
 
 static struct platform_driver g_dpmaif_driver = {
 	.driver = {
+#if IS_ENABLED(CONFIG_TETRIS_CCCI_HIF_RESOURCES)
+		.name = "tetris_dpmaif_resources",
+#else
 		.name = "ccci_dpmaif_driver",
+#endif
 #if IS_ENABLED(CONFIG_MTK_ECCCI_TETRIS_OWNER)
 		.suppress_bind_attrs = true,
 #endif
 		.of_match_table = g_dpmaif_of_ids,
+#if IS_ENABLED(CONFIG_TETRIS_CCCI_HIF_RESOURCES)
+		.pm = NULL,
+#else
 		.pm = &g_dpmaif_pm_ops,
+#endif
 	},
 
 	.probe = dpmaif_probe,
+#if IS_ENABLED(CONFIG_TETRIS_CCCI_HIF_RESOURCES)
+	.remove = tetris_hif_supplier_remove,
+#endif
 };
 
 static int __init ccci_dpmaif_init(void)
 {
 	int ret;
 
+#if IS_ENABLED(CONFIG_TETRIS_CCCI_HIF_RESOURCES)
+	ret = tetris_preflight_driver("mediatek,dpmaif");
+	if (ret)
+		return ret;
+#endif
 	ret = platform_driver_register(&g_dpmaif_driver);
 	if (ret) {
 		CCCI_ERROR_LOG(0, TAG, "ccci dpmaif driver init fail %d",
@@ -3369,6 +3415,9 @@
 
 static void __exit ccci_dpmaif_exit(void)
 {
+#if IS_ENABLED(CONFIG_TETRIS_CCCI_HIF_RESOURCES)
+	platform_driver_unregister(&g_dpmaif_driver);
+#endif
 }
 
 module_init(ccci_dpmaif_init);
