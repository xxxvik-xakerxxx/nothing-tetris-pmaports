 	struct ccci_modem *md = (struct ccci_modem *)device->platform_data;
 
 	/* set flag for next md_start */
@@ -1715,6 +1731,18 @@
 #if IS_ENABLED(CONFIG_MTK_ECCCI_TETRIS_OWNER)
 #include <linux/sizes.h>
 #include "ccci_tetris_dependencies.h"
+#include "ccci_tetris_prepare.h"
