diff --git a/arch/arm64/boot/dts/mediatek/mt6878-camisp-supplier-resources-disabled.dtsi b/arch/arm64/boot/dts/mediatek/mt6878-camisp-supplier-resources-disabled.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6878-camisp-supplier-resources-disabled.dtsi
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/* Review fixture only; no shipping board includes this file.
+ * Dormant supplier graph only; display IOMMU membership stays unchanged.
+ * Physical VMM ownership/policy remain unproven. Every device stays disabled.
+ */
+#include <dt-bindings/clock/mediatek,mt6878-clock.h>
+#include <dt-bindings/clock/mediatek,mt6878-camisp-clock.h>
+#include <dt-bindings/power/mediatek,mt6878-power.h>
+
+&soc {
+	cam_main: clock-controller@1a000000 {
+		compatible = "mediatek,mt6878-camsys";
+		reg = <0x1a000000 0x1000>;
+		#clock-cells = <1>;
+		status = "disabled";
+	};
+
+	cam_mraw: clock-controller@1a170000 {
+		compatible = "mediatek,mt6878-camsys_mraw";
+		reg = <0x1a170000 0x1000>;
+		#clock-cells = <1>;
+		status = "disabled";
+	};
+
+	cam_vcore: clock-controller@1b204000 {
+		compatible = "mediatek,mt6878-cam_vcore";
+		reg = <0x1b204000 0x1000>;
+		#clock-cells = <1>;
+		status = "disabled";
+	};
+
+	smi_cam_vcore_2x1_sub_comm0: smi@1b203000 {
+		compatible = "mediatek,mt6878-smi-common";
+		reg = <0x1b203000 0x1000>;
+		mediatek,common-id = <31>;
+		clocks = <&cam_vcore CLK_CAM_VCORE_MM0_DCM_DIS>;
+		clock-names = "apb";
+		mediatek,smi = <&smi_disp_common>;
+		mediatek,smi-supply = <&smi_disp_common>;
+		power-domains = <&spm MT6878_POWER_DOMAIN_CAM_VCORE>;
+		status = "disabled";
+	};
+
+	smi_cam_4x1_sub_comm0: smi@1a005000 {
+		compatible = "mediatek,mt6878-smi-common";
+		reg = <0x1a005000 0x1000>;
+		mediatek,common-id = <16>;
+		clocks = <&cam_main CLK_CAM_MAIN_CAM2MM0_GALS>,
+			 <&cam_main CLK_CAM_MAIN_LARB13>,
+			 <&cam_main CLK_CAM_MAIN_LARB14>,
+			 <&cam_main CLK_CAM_MAIN_LARB29>,
+			 <&cam_main CLK_CAM_MAIN_CAM_MRAW>,
+			 <&cam_mraw CLK_CAM_MR_GALS>,
+			 <&cam_mraw CLK_CAM_MR_LARBX>;
+		clock-names = "apb", "smi", "gals0", "gals1", "gals2", "gals3", "gals4";
+		mediatek,smi = <&smi_cam_vcore_2x1_sub_comm0>;
+		power-domains = <&spm MT6878_POWER_DOMAIN_CAM_MAIN>;
+		status = "disabled";
+	};
+
+	smi_cam_4x1_sub_comm1: smi@1a006000 {
+		compatible = "mediatek,mt6878-smi-common";
+		reg = <0x1a006000 0x1000>;
+		mediatek,common-id = <19>;
+		clocks = <&cam_main CLK_CAM_MAIN_CAM2MM1_GALS>,
+			 <&cam_main CLK_CAM_MAIN_LARB13>,
+			 <&cam_main CLK_CAM_MAIN_LARB14>,
+			 <&cam_main CLK_CAM_MAIN_LARB29>,
+			 <&cam_main CLK_CAM_MAIN_CAM_MRAW>,
+			 <&cam_mraw CLK_CAM_MR_GALS>,
+			 <&cam_mraw CLK_CAM_MR_LARBX>;
+		clock-names = "apb", "smi", "gals0", "gals1", "gals2", "gals3", "gals4";
+		mediatek,smi = <&smi_cam_vcore_2x1_sub_comm0>;
+		power-domains = <&spm MT6878_POWER_DOMAIN_CAM_MAIN>;
+		status = "disabled";
+	};
+
+	smi_larb13: smi@1a001000 {
+		compatible = "mediatek,mt6878-smi-larb";
+		reg = <0x1a001000 0x1000>;
+		mediatek,larb-id = <13>;
+		clocks = <&cam_main CLK_CAM_MAIN_LARB13>;
+		clock-names = "apb";
+		mediatek,smi = <&smi_cam_4x1_sub_comm0>;
+		power-domains = <&spm MT6878_POWER_DOMAIN_CAM_MAIN>;
+		status = "disabled";
+	};
+
+	smi_larb14: smi@1a002000 {
+		compatible = "mediatek,mt6878-smi-larb";
+		reg = <0x1a002000 0x1000>;
+		mediatek,larb-id = <14>;
+		clocks = <&cam_main CLK_CAM_MAIN_LARB14>;
+		clock-names = "apb";
+		mediatek,smi = <&smi_cam_4x1_sub_comm1>;
+		power-domains = <&spm MT6878_POWER_DOMAIN_CAM_MAIN>;
+		status = "disabled";
+	};
+
+	camisp_l13: camisp-l13-1 {
+		compatible = "mediatek,camisp-larb";
+		mediatek,larb-id = <13>;
+		iommus = <&disp_iommu 416>,
+			 <&disp_iommu 417>;
+		status = "disabled";
+	};
+
+	camisp_l14: camisp-l14-1 {
+		compatible = "mediatek,camisp-larb";
+		mediatek,larb-id = <14>;
+		iommus = <&disp_iommu 448>,
+			 <&disp_iommu 449>;
+		status = "disabled";
+	};
+
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6878-camisp-supplier-power-disabled.dtsi b/arch/arm64/boot/dts/mediatek/mt6878-camisp-supplier-power-disabled.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6878-camisp-supplier-power-disabled.dtsi
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/* Dormant supplier description, after the unchanged native-display and
+ * GPU-supplies. Extend the existing controller/USID6, never duplicate them.
+ * Source bounds are not an operating point. No rail/clock request is enabled.
+ */
+#include <dt-bindings/spmi/spmi.h>
+#include <dt-bindings/power/mediatek,mt6878-power.h>
+
+&mt6319_gpu {
+	status = "disabled";
+	regulators {
+		mt6319_6_vbuck1: vbuck1 {
+			regulator-name = "6_vbuck1";
+			regulator-min-microvolt = <300000>;
+			regulator-max-microvolt = <1193750>;
+			regulator-enable-ramp-delay = <256>;
+			status = "disabled";
+		};
+		mt6319_6_vbuck4: vbuck4 {
+			regulator-name = "6_vbuck4";
+			regulator-min-microvolt = <300000>;
+			regulator-max-microvolt = <1193750>;
+			regulator-enable-ramp-delay = <256>;
+			regulator-always-on;
+			status = "disabled";
+		};
+	};
+};
+
+&mm_infra {
+	cam_vcore_pd: power-domain@a {
+		reg = <MT6878_POWER_DOMAIN_CAM_VCORE>;
+		#power-domain-cells = <0>;
+		status = "disabled";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		cam_main_pd: power-domain@d {
+			reg = <MT6878_POWER_DOMAIN_CAM_MAIN>;
+			#power-domain-cells = <0>;
+			clocks = <&topckgen CLK_TOP_CAM_SEL>,
+				 <&cam_main CLK_CAM_MAIN_CAM2MM0_GALS>,
+				 <&cam_main CLK_CAM_MAIN_CAM2MM1_GALS>,
+				 <&cam_main CLK_CAM_MAIN_LARB13>,
+				 <&cam_main CLK_CAM_MAIN_LARB14>,
+				 <&cam_main CLK_CAM_MAIN_LARB29>,
+				 <&cam_main CLK_CAM_MAIN_CAM_MRAW>,
+				 <&cam_mraw CLK_CAM_MR_GALS>,
+				 <&cam_mraw CLK_CAM_MR_LARBX>;
+			clock-names = "cam", "cam_main-0", "cam_main-1", "cam_main-2", "cam_main-3", "cam_main-4", "cam_main-5", "cam_main-6", "cam_main-7";
+			status = "disabled";
+		};
+	};
+	isp_vcore_pd: power-domain@10 {
+		reg = <MT6878_POWER_DOMAIN_ISP_VCORE>;
+		#power-domain-cells = <0>;
+		status = "disabled";
+	};
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-camisp-supplier.dts b/arch/arm64/boot/dts/mediatek/mt6878-nothing-tetris-camisp-supplier.dts
