diff --git a/drivers/pmdomain/mediatek/native-vmm/mt6878-cam-power.h b/drivers/pmdomain/mediatek/native-vmm/mt6878-cam-power.h
new file mode 100644
--- /dev/null
+++ b/drivers/pmdomain/mediatek/native-vmm/mt6878-cam-power.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MT6878_CAM_POWER_H
+#define _MT6878_CAM_POWER_H
+
+#include <dt-bindings/power/mediatek,mt6878-power.h>
+#include <linux/regmap.h>
+
+#include "mtk-pm-domains.h"
+
+/* Sparse Linux descriptors for review, not a registered genpd provider. */
+extern const struct scpsys_domain_data
+mt6878_cam_domain_data[MT6878_POWER_DOMAIN_NR];
+
+/*
+ * Local transactions only; caller must own the shared SPM regmap and serialize
+ * them. Supplies, parent genpd, clocks, SRAM and bus protection are external.
+ * Failure can leave partial hardware state: retain suppliers and stop access.
+ */
+int mt6878_cam_ctl_set(struct regmap *spm, unsigned int domain, bool on);
+int mt6878_vmm_iso_set(struct regmap *spm, bool isolate);
+
+#endif
diff --git a/drivers/pmdomain/mediatek/native-vmm/mt6878-vmm-supplier.h b/drivers/pmdomain/mediatek/native-vmm/mt6878-vmm-supplier.h
new file mode 100644
--- /dev/null
+++ b/drivers/pmdomain/mediatek/native-vmm/mt6878-vmm-supplier.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MT6878_VMM_SUPPLIER_H
+#define _MT6878_VMM_SUPPLIER_H
+
+#include <linux/mutex.h>
+#include <linux/pm_domain.h>
+#include <linux/regulator/consumer.h>
+
+#include "mt6878-cam-power.h"
+
+/*
+ * Research integration API, not a platform driver. Zero-initialize once.
+ * Caller owns permanent storage, device and SPM lifetime, including on failure
+ * after exclusive acquisition. No devm cleanup, unbind or retry is safe there.
+ * Establish voltage/rate policy and exclusive firmware ownership BEFORE init.
+ */
+struct mt6878_vmm_supplier {
+	struct generic_pm_domain genpd;
+	struct mutex lock;
+	struct device *dev;
+	struct regulator *buck;
+	struct regmap *spm;
+	int first_error;
+	bool initialized;
+};
+
+struct mt6878_vmm_guard {
+	struct notifier_block nb;
+	struct mt6878_vmm_supplier *supplier;
+	unsigned long pending;
+	bool transitioning;
+	bool registered;
+	bool linked;
+};
+
+/*
+ * supply_id is the verified consumer supply name on dev, without "-supply".
+ * The provider owner must select it from matching board/release data and prove
+ * that all migrated CAM/ISP users share that rail. No default or alias probing.
+ */
+int mt6878_vmm_supplier_init(struct mt6878_vmm_supplier *vmm,
+			     struct device *dev, const char *supply_id,
+			     struct regmap *spm,
+			     struct generic_pm_domain *mm_infra);
+/* Check after acquiring a PM lease, even when genpd was already logically ON. */
+int mt6878_vmm_check(struct mt6878_vmm_supplier *vmm);
+/* Leaf callbacks must latch their original errno BEFORE genpd supplier unwind. */
+int mt6878_vmm_fail_child(struct mt6878_vmm_supplier *vmm, int error);
+/*
+ * Checked CAM_MAIN/CAM_VCORE control phase for sleeping genpd callbacks.
+ * Caller holds the guarded graph's parent references and serializes the leaf.
+ * ON: basic/LP clocks ready; follow with subsystem clocks, SRAM, bus release.
+ * OFF: buses protected, SRAM off and subsystem clocks disabled beforehand.
+ * Uses this owner's SPM and lock; any I/O error is latched before returning.
+ * Stop the callback on failure, retaining dependencies; no cleanup or retry.
+ * Other callback phases must still report errors with mt6878_vmm_fail_child().
+ */
+int mt6878_vmm_cam_ctl_set(struct mt6878_vmm_supplier *vmm,
+			   unsigned int domain, bool on);
+/*
+ * Call during quiescent provider construction, before publishing any children.
+ * guard_dev must already be attached directly to child; both persist forever.
+ * Every immediate child must use this function, including ISP and non-CAM users.
+ * MM_INFRA parents VMM; existing direct MM_INFRA edges may remain. Children OFF.
+ * Partial attach is retained on failure: inspect registered/linked; do not free.
+ */
+int mt6878_vmm_add_child(struct mt6878_vmm_supplier *vmm,
+			 struct generic_pm_domain *child, struct device *guard_dev,
+			 struct mt6878_vmm_guard *guard);
+
+#endif
diff --git a/drivers/pmdomain/mediatek/native-vmm/mt6878-cam-power.c b/drivers/pmdomain/mediatek/native-vmm/mt6878-cam-power.c
new file mode 100644
--- /dev/null
+++ b/drivers/pmdomain/mediatek/native-vmm/mt6878-cam-power.c
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* B4.1 MT6878 leaf transactions; no probe, genpd registration or activation. */
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/iopoll.h>
+
+#include "mt6878-cam-power.h"
+
+#define CAM_PWR_RST_B		BIT(0)
+#define CAM_PWR_ISO		BIT(1)
+#define CAM_PWR_ON		BIT(2)
+#define CAM_PWR_ON_2ND		BIT(3)
+#define CAM_PWR_CLK_DIS		BIT(4)
+#define CAM_PWR_ACK		BIT(30)
+#define CAM_PWR_ACK_2ND		BIT(31)
+#define CAM_POLL_DELAY_US		10
+#define CAM_POLL_TIMEOUT_US	1000000
+
+#define VMM_ISO_STA		0x0f28
+#define VMM_ISO_SET		0x0f2c
+#define VMM_ISO_CLR		0x0f30
+#define VMM_EXT_BUCK_ISO		BIT(24)
+#define VMM_SRAM_ISO_DIN		BIT(25)
+#define VMM_SRAM_LATCH_ENB	BIT(26)
+#define VMM_ISO_MASK		GENMASK(26, 24)
+
+const struct scpsys_domain_data
+mt6878_cam_domain_data[MT6878_POWER_DOMAIN_NR] = {
+	[MT6878_POWER_DOMAIN_CAM_VCORE] = {
+		.name = "cam-vcore",
+		.sta_mask = GENMASK(31, 30),
+		.ctl_offs = 0x0e5c,
+		.pwr_sta_offs = 0x0e5c,
+		.pwr_sta2nd_offs = 0x0e5c,
+		.bp_cfg = {
+			BUS_PROT_WR_IGN(INFRA, BIT(31),
+					0x0c14, 0x0c18, 0x0c1c),
+			BUS_PROT_WR_IGN(INFRA, BIT(9) | BIT(10),
+					0x0c24, 0x0c28, 0x0c2c),
+		},
+		.caps = MTK_SCPD_STATUS_IN_CTL | MTK_SCPD_DOMAIN_SUPPLY,
+	},
+	[MT6878_POWER_DOMAIN_CAM_MAIN] = {
+		.name = "cam-main",
+		.sta_mask = GENMASK(31, 30),
+		.ctl_offs = 0x0e48,
+		.pwr_sta_offs = 0x0e48,
+		.pwr_sta2nd_offs = 0x0e48,
+		.sram_pdn_bits = BIT(8),
+		.sram_pdn_ack_bits = BIT(12),
+		.bp_cfg = {
+			BUS_PROT_WR_IGN(INFRA, BIT(29),
+					0x0c14, 0x0c18, 0x0c1c),
+			BUS_PROT_WR_IGN(INFRA, BIT(30),
+				0x0c14, 0x0c18, 0x0c1c),
+		},
+		.caps = MTK_SCPD_STATUS_IN_CTL,
+	},
+};
+
+static int mt6878_cam_ack(struct regmap *spm, unsigned int offset,
+			  u32 mask, bool on)
+{
+	u32 val;
+
+	return regmap_read_poll_timeout(spm, offset, val,
+					(val & mask) == (on ? mask : 0),
+					CAM_POLL_DELAY_US, CAM_POLL_TIMEOUT_US);
+}
+
+static int mt6878_cam_switch(struct regmap *spm, unsigned int offset,
+			     u32 control, u32 ack, bool on)
+{
+	int ret;
+
+	ret = regmap_update_bits(spm, offset, control, on ? control : 0);
+	if (ret)
+		return ret;
+
+	return mt6878_cam_ack(spm, offset, ack, on);
+}
+
+int mt6878_cam_ctl_set(struct regmap *spm, unsigned int domain, bool on)
+{
+	unsigned int offset;
+	int ret;
+
+	if (!spm)
+		return -EINVAL;
+	if (domain != MT6878_POWER_DOMAIN_CAM_MAIN &&
+	    domain != MT6878_POWER_DOMAIN_CAM_VCORE)
+		return -EINVAL;
+	offset = mt6878_cam_domain_data[domain].ctl_offs;
+
+	if (on) {
+		ret = mt6878_cam_switch(spm, offset, CAM_PWR_ON, CAM_PWR_ACK, true);
+		if (ret)
+			return ret;
+		udelay(50);
+		ret = mt6878_cam_switch(spm, offset, CAM_PWR_ON_2ND,
+					CAM_PWR_ACK_2ND, true);
+		if (ret)
+			return ret;
+		ret = regmap_clear_bits(spm, offset, CAM_PWR_CLK_DIS);
+		if (ret)
+			return ret;
+		ret = regmap_clear_bits(spm, offset, CAM_PWR_ISO);
+		if (ret)
+			return ret;
+		return regmap_set_bits(spm, offset, CAM_PWR_RST_B);
+	}
+
+	/* Caller has already protected buses, disabled SRAM and subsystem clocks. */
+	ret = regmap_set_bits(spm, offset, CAM_PWR_ISO);
+	if (ret)
+		return ret;
+	ret = regmap_clear_bits(spm, offset, CAM_PWR_RST_B);
+	if (ret)
+		return ret;
+	ret = regmap_set_bits(spm, offset, CAM_PWR_CLK_DIS);
+	if (ret)
+		return ret;
+	ret = mt6878_cam_switch(spm, offset, CAM_PWR_ON, CAM_PWR_ACK, false);
+	if (ret)
+		return ret;
+	return mt6878_cam_switch(spm, offset, CAM_PWR_ON_2ND,
+				  CAM_PWR_ACK_2ND, false);
+}
+
+int mt6878_vmm_iso_set(struct regmap *spm, bool isolate)
+{
+	u32 status, offset = isolate ? VMM_ISO_SET : VMM_ISO_CLR;
+	int ret;
+
+	if (!spm)
+		return -EINVAL;
+
+	/* MT6878 uses W1S/W1C aliases, with the reverse order for isolation ON. */
+	ret = regmap_write(spm, offset,
+			   isolate ? VMM_SRAM_LATCH_ENB : VMM_EXT_BUCK_ISO);
+	if (ret)
+		return ret;
+	ret = regmap_write(spm, offset, VMM_SRAM_ISO_DIN);
+	if (ret)
+		return ret;
+	ret = regmap_write(spm, offset,
+			   isolate ? VMM_EXT_BUCK_ISO : VMM_SRAM_LATCH_ENB);
+	if (ret)
+		return ret;
+	ret = regmap_read(spm, VMM_ISO_STA, &status);
+	if (ret)
+		return ret;
+	if ((status & VMM_ISO_MASK) != (isolate ? VMM_ISO_MASK : 0))
+		return -EIO;
+
+	return 0;
+}
+
+#include "mt6878-native-vmm.h"
+
+int mt6878_isp_vcore_ctl_set(struct regmap *spm, unsigned int domain, bool on)
+{
+	unsigned int offset;
+	int ret;
+
+	if (!spm)
+		return -EINVAL;
+	if (domain != MT6878_POWER_DOMAIN_ISP_VCORE)
+		return -EINVAL;
+	offset = 0x0e34;
+
+	if (on) {
+		ret = mt6878_cam_switch(spm, offset, CAM_PWR_ON, CAM_PWR_ACK, true);
+		if (ret)
+			return ret;
+		udelay(50);
+		ret = mt6878_cam_switch(spm, offset, CAM_PWR_ON_2ND,
+					CAM_PWR_ACK_2ND, true);
+		if (ret)
+			return ret;
+		ret = regmap_clear_bits(spm, offset, CAM_PWR_CLK_DIS);
+		if (ret)
+			return ret;
+		ret = regmap_clear_bits(spm, offset, CAM_PWR_ISO);
+		if (ret)
+			return ret;
+		return regmap_set_bits(spm, offset, CAM_PWR_RST_B);
+	}
+
+	/* Caller has already protected buses, disabled SRAM and subsystem clocks. */
+	ret = regmap_set_bits(spm, offset, CAM_PWR_ISO);
+	if (ret)
+		return ret;
+	ret = regmap_clear_bits(spm, offset, CAM_PWR_RST_B);
+	if (ret)
+		return ret;
+	ret = regmap_set_bits(spm, offset, CAM_PWR_CLK_DIS);
+	if (ret)
+		return ret;
+	ret = mt6878_cam_switch(spm, offset, CAM_PWR_ON, CAM_PWR_ACK, false);
+	if (ret)
+		return ret;
+	return mt6878_cam_switch(spm, offset, CAM_PWR_ON_2ND,
+				  CAM_PWR_ACK_2ND, false);
+}
diff --git a/drivers/pmdomain/mediatek/native-vmm/mt6878-vmm-supplier.c b/drivers/pmdomain/mediatek/native-vmm/mt6878-vmm-supplier.c
new file mode 100644
--- /dev/null
+++ b/drivers/pmdomain/mediatek/native-vmm/mt6878-vmm-supplier.c
@@ -0,0 +1,328 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Shared VMM genpd supplier; deliberately not registered by any initcall. */
+#include <linux/bits.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/notifier.h>
+
+#include "mt6878-vmm-supplier.h"
+
+#define VMM_ISO_STATUS 0x0f28
+#define VMM_ISO_BITS GENMASK(26, 24)
+
+static int vmm_fail(struct mt6878_vmm_supplier *vmm, int ret)
+{
+	if (!vmm->first_error) {
+		vmm->first_error = ret;
+		dev_err(vmm->dev, "VMM first fault: %d; recovery required\n", ret);
+	}
+	return vmm->first_error;
+}
+
+static int vmm_check_isolation(struct mt6878_vmm_supplier *vmm, bool isolated)
+{
+	u32 value;
+	int ret;
+
+	ret = regmap_read(vmm->spm, VMM_ISO_STATUS, &value);
+	if (ret)
+		return ret;
+	return (value & VMM_ISO_BITS) == (isolated ? VMM_ISO_BITS : 0) ? 0 : -EIO;
+}
+
+static int vmm_check_rail(struct mt6878_vmm_supplier *vmm, bool on)
+{
+	int ret = regulator_is_enabled(vmm->buck);
+
+	if (ret < 0)
+		return ret;
+	return !!ret == on ? 0 : -EIO;
+}
+
+static int vmm_power_on(struct generic_pm_domain *genpd)
+{
+	struct mt6878_vmm_supplier *vmm =
+		container_of(genpd, struct mt6878_vmm_supplier, genpd);
+	int ret;
+
+	mutex_lock(&vmm->lock);
+	if (vmm->first_error) {
+		ret = vmm->first_error;
+		goto out;
+	}
+	ret = vmm_check_rail(vmm, false);
+	if (ret)
+		goto fault;
+	ret = vmm_check_isolation(vmm, true);
+	if (ret)
+		goto fault;
+	ret = regulator_enable(vmm->buck);
+	if (ret)
+		goto fault;
+	ret = vmm_check_rail(vmm, true);
+	if (ret)
+		goto fault;
+	ret = mt6878_vmm_iso_set(vmm->spm, false);
+	if (ret)
+		goto fault;
+	goto out;
+fault:
+	/* No disable unwind: a failed write may have changed hardware already. */
+	ret = vmm_fail(vmm, ret);
+out:
+	mutex_unlock(&vmm->lock);
+	return ret;
+}
+
+static int vmm_power_off(struct generic_pm_domain *genpd)
+{
+	struct mt6878_vmm_supplier *vmm =
+		container_of(genpd, struct mt6878_vmm_supplier, genpd);
+	int ret;
+
+	mutex_lock(&vmm->lock);
+	if (vmm->first_error) {
+		ret = vmm->first_error;
+		goto out;
+	}
+	ret = vmm_check_rail(vmm, true);
+	if (ret)
+		goto fault;
+	ret = vmm_check_isolation(vmm, false);
+	if (ret)
+		goto fault;
+	ret = mt6878_vmm_iso_set(vmm->spm, true);
+	if (ret)
+		goto fault;
+	ret = regulator_disable(vmm->buck);
+	if (ret)
+		goto fault;
+	/* always-on constraints must not masquerade as physical power-off. */
+	ret = vmm_check_rail(vmm, false);
+	if (ret)
+		goto fault;
+	goto out;
+fault:
+	/* Do not de-isolate on ABORT_DISABLE or presume the buck stayed enabled. */
+	ret = vmm_fail(vmm, ret);
+out:
+	mutex_unlock(&vmm->lock);
+	return ret;
+}
+
+int mt6878_vmm_fail_child(struct mt6878_vmm_supplier *vmm, int error)
+{
+	int ret;
+
+	if (!vmm || !vmm->initialized || error >= 0)
+		return -EINVAL;
+	mutex_lock(&vmm->lock);
+	ret = vmm_fail(vmm, error);
+	mutex_unlock(&vmm->lock);
+	return ret;
+}
+
+int mt6878_vmm_check(struct mt6878_vmm_supplier *vmm)
+{
+	int ret;
+
+	if (!vmm || !vmm->initialized)
+		return -EINVAL;
+	mutex_lock(&vmm->lock);
+	ret = vmm->first_error;
+	if (ret)
+		goto out;
+	ret = vmm_check_rail(vmm, true);
+	if (ret)
+		goto fault;
+	ret = vmm_check_isolation(vmm, false);
+	if (ret)
+		goto fault;
+	goto out;
+fault:
+	ret = vmm_fail(vmm, ret);
+out:
+	mutex_unlock(&vmm->lock);
+	return ret;
+}
+
+int mt6878_vmm_cam_ctl_set(struct mt6878_vmm_supplier *vmm,
+			   unsigned int domain, bool on)
+{
+	int ret;
+
+	if (!vmm || !vmm->initialized)
+		return -EINVAL;
+	if (domain != MT6878_POWER_DOMAIN_CAM_MAIN &&
+	    domain != MT6878_POWER_DOMAIN_CAM_VCORE)
+		return -EINVAL;
+
+	/* Hold the supplier lock through the leaf write and first-error handoff. */
+	mutex_lock(&vmm->lock);
+	ret = vmm->first_error;
+	if (ret)
+		goto out;
+	ret = vmm_check_rail(vmm, true);
+	if (ret)
+		goto fault;
+	ret = vmm_check_isolation(vmm, false);
+	if (ret)
+		goto fault;
+	ret = mt6878_cam_ctl_set(vmm->spm, domain, on);
+	if (ret)
+		goto fault;
+	goto out;
+fault:
+	/* Latch the actual leaf errno before genpd notifies/unwinds its parents. */
+	ret = vmm_fail(vmm, ret);
+out:
+	mutex_unlock(&vmm->lock);
+	return ret;
+}
+
+static int vmm_child_notify(struct notifier_block *nb,
+			    unsigned long event, void *data)
+{
+	struct mt6878_vmm_guard *guard =
+		container_of(nb, struct mt6878_vmm_guard, nb);
+	int ret;
+
+	/* A failed supplier OFF leaves genpd logically ON and skips power_on. */
+	if (event == GENPD_NOTIFY_PRE_ON || event == GENPD_NOTIFY_PRE_OFF) {
+		ret = mt6878_vmm_check(guard->supplier);
+		if (!ret) {
+			guard->pending = event;
+			guard->transitioning = true;
+		}
+		return notifier_from_errno(ret);
+	}
+
+	/* Robust notifier rollback also reaches here; block retries conservatively. */
+	if (event != GENPD_NOTIFY_ON && event != GENPD_NOTIFY_OFF)
+		return NOTIFY_DONE;
+	ret = 0;
+	if (guard->transitioning &&
+	    ((event == GENPD_NOTIFY_OFF && guard->pending == GENPD_NOTIFY_PRE_ON) ||
+	     (event == GENPD_NOTIFY_ON && guard->pending == GENPD_NOTIFY_PRE_OFF)))
+		ret = mt6878_vmm_fail_child(guard->supplier, -EIO);
+	guard->transitioning = false;
+	return notifier_from_errno(ret);
+}
+
+int mt6878_vmm_supplier_init(struct mt6878_vmm_supplier *vmm,
+			     struct device *dev, const char *supply_id,
+			     struct regmap *spm,
+			     struct generic_pm_domain *mm_infra)
+{
+	int ret, enabled;
+
+	if (!vmm || !dev || !supply_id || !*supply_id ||
+	    IS_ERR_OR_NULL(spm) || !mm_infra)
+		return -EINVAL;
+	if (mm_infra == &vmm->genpd || (mm_infra->flags & GENPD_FLAG_IRQ_SAFE))
+		return -EINVAL;
+	if (vmm->buck)
+		return vmm->first_error ? vmm->first_error : -EBUSY;
+
+	mutex_init(&vmm->lock);
+	vmm->dev = dev;
+	vmm->spm = spm;
+	/* No dummy fallback; reject existing CAM, ISP, notifier or DVFS handles. */
+	vmm->buck = regulator_get_exclusive(dev, supply_id);
+	if (IS_ERR(vmm->buck)) {
+		ret = PTR_ERR(vmm->buck);
+		vmm->buck = NULL;
+		return ret;
+	}
+	/*
+	 * Exclusive get can adopt an inherited enable reference. Do not guess
+	 * which inherited CAM/ISP users own it, or disable it during failed init.
+	 */
+	enabled = regulator_is_enabled(vmm->buck);
+	if (enabled < 0)
+		return vmm_fail(vmm, enabled);
+	if (enabled)
+		return vmm_fail(vmm, -EBUSY);
+	ret = vmm_check_isolation(vmm, true);
+	if (ret)
+		return vmm_fail(vmm, ret);
+
+	vmm->genpd.name = "mt6878-vmm";
+	vmm->genpd.power_on = vmm_power_on;
+	vmm->genpd.power_off = vmm_power_off;
+	ret = pm_genpd_init(&vmm->genpd, NULL, !enabled);
+	if (ret)
+		return vmm_fail(vmm, ret);
+	/* A faulted ON VMM must retain MM_INFRA during child failure unwind. */
+	ret = pm_genpd_add_subdomain(mm_infra, &vmm->genpd);
+	if (ret)
+		return vmm_fail(vmm, ret);
+	vmm->initialized = true;
+	return 0;
+}
+
+int mt6878_vmm_add_child(struct mt6878_vmm_supplier *vmm,
+			 struct generic_pm_domain *child, struct device *guard_dev,
+			 struct mt6878_vmm_guard *guard)
+{
+	int ret;
+
+	if (!vmm || !child || !guard_dev || !guard || !vmm->initialized)
+		return -EINVAL;
+	if (vmm->first_error)
+		return vmm->first_error;
+	if (guard->registered || guard->linked)
+		return -EBUSY;
+	if (child == &vmm->genpd || guard_dev->pm_domain != &child->domain ||
+	    child->status != GENPD_STATE_OFF || (child->flags & GENPD_FLAG_IRQ_SAFE))
+		return -EINVAL;
+
+	guard->supplier = vmm;
+	guard->nb.notifier_call = vmm_child_notify;
+	ret = dev_pm_genpd_add_notifier(guard_dev, &guard->nb);
+	if (ret)
+		return ret;
+	guard->registered = true;
+	ret = pm_genpd_add_subdomain(&vmm->genpd, child);
+	if (ret)
+		return vmm_fail(vmm, ret);
+	guard->linked = true;
+	return 0;
+}
+
+#include "mt6878-native-vmm.h"
+
+int mt6878_vmm_isp_vcore_ctl_set(struct mt6878_vmm_supplier *vmm,
+			   unsigned int domain, bool on)
+{
+	int ret;
+
+	if (!vmm || !vmm->initialized)
+		return -EINVAL;
+	if (domain != MT6878_POWER_DOMAIN_ISP_VCORE)
+		return -EINVAL;
+
+	/* Hold the supplier lock through the leaf write and first-error handoff. */
+	mutex_lock(&vmm->lock);
+	ret = vmm->first_error;
+	if (ret)
+		goto out;
+	ret = vmm_check_rail(vmm, true);
+	if (ret)
+		goto fault;
+	ret = vmm_check_isolation(vmm, false);
+	if (ret)
+		goto fault;
+	ret = mt6878_isp_vcore_ctl_set(vmm->spm, domain, on);
+	if (ret)
+		goto fault;
+	goto out;
+fault:
+	/* Latch the actual leaf errno before genpd notifies/unwinds its parents. */
+	ret = vmm_fail(vmm, ret);
+out:
+	mutex_unlock(&vmm->lock);
+	return ret;
+}
