diff --git a/drivers/media/platform/mediatek/tetris-cold/video-lifetime-test.inc b/drivers/media/platform/mediatek/tetris-cold/video-lifetime-test.inc
new file mode 100644
--- /dev/null
+++ b/drivers/media/platform/mediatek/tetris-cold/video-lifetime-test.inc
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Included in the owner TU so tests exercise its real private callbacks. */
+#include <kunit/test.h>
+#include <linux/kthread.h>
+
+static void native_video_queue_bounds(struct kunit *test)
+{
+	struct mt6878_native_video *v = kunit_kzalloc(test, sizeof(*v), GFP_KERNEL);
+	struct native_node *node;
+	unsigned int sizes[1] = { 0 }, count = 8, planes = 0;
+
+	KUNIT_ASSERT_NOT_NULL(test, v);
+	node = &v->nodes[1];
+	node->owner = v;
+	node->index = 1;
+	/* Explicit emitted DMA stride; not RAW10 wire length / four. */
+	v->suppliers.layout.pdaf_layout.sizeimage = 3000000;
+	KUNIT_EXPECT_EQ(test, queue_setup(&node->queue, &count, &planes, sizes, NULL), 0);
+	KUNIT_EXPECT_EQ(test, count, 1U);
+	KUNIT_EXPECT_EQ(test, planes, 1U);
+	KUNIT_EXPECT_EQ(test, sizes[0], 3000000U);
+	sizes[0]--;
+	KUNIT_EXPECT_EQ(test, queue_setup(&node->queue, &count, &planes, sizes, NULL), -EINVAL);
+	planes = 2;
+	KUNIT_EXPECT_EQ(test, queue_setup(&node->queue, &count, &planes, sizes, NULL), -EINVAL);
+}
+
+static void native_video_quarantine_no_reentry(struct kunit *test)
+{
+	struct mt6878_native_video *v = kunit_kzalloc(test, sizeof(*v), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, v);
+	v->quarantined = true;
+	/* No initialized queue/work/PM fields: any hardware/cleanup reentry would
+	 * fail this test rather than being represented by an always-success mock.
+	 */
+	KUNIT_EXPECT_EQ(test, retire(v), -EBUSY);
+	KUNIT_EXPECT_FALSE(test, v->retired);
+	KUNIT_EXPECT_FALSE(test, v->stopping);
+	v->quarantined = false;
+	v->retired = true;
+	KUNIT_EXPECT_EQ(test, retire(v), 0);
+}
+
+static void native_video_register_reject(struct kunit *test)
+{
+	struct mt6878_native_video *owner = (void *)1;
+
+	KUNIT_EXPECT_EQ(test, mt6878_native_video_register(NULL, &owner), -EINVAL);
+	KUNIT_EXPECT_PTR_EQ(test, owner, NULL);
+	KUNIT_EXPECT_EQ(test, mt6878_native_video_unregister(NULL), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt6878_native_video_wait_ready(NULL, 1), -EINVAL);
+}
+
+static void native_video_registration_result(struct kunit *test)
+{
+	struct mt6878_native_video *v = kunit_kzalloc(test, sizeof(*v), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, v);
+	mutex_init(&v->registration);
+	init_completion(&v->registration_done);
+	KUNIT_EXPECT_EQ(test, mt6878_native_video_wait_ready(v, 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt6878_native_video_wait_ready(v, 1), -ETIMEDOUT);
+	/* Registration failure is independent of a later frame/cleanup error.
+	 * No subdevice/provider is mocked or marked hardware-ready in this test.
+	 */
+	v->registration_error = -ENOLINK;
+	v->first_error = -EIO;
+	complete_all(&v->registration_done);
+	KUNIT_EXPECT_EQ(test, mt6878_native_video_wait_ready(v, 1), -ENOLINK);
+}
+
+static void native_video_preflight_reject(struct kunit *test)
+{
+	struct mt6878_native_video *v = kunit_kzalloc(test, sizeof(*v), GFP_KERNEL);
+	struct vb2_v4l2_buffer buffer = { 0 };
+	struct mt6878_camsv_buffer mapped = { 0 };
+
+	KUNIT_ASSERT_NOT_NULL(test, v);
+	KUNIT_EXPECT_EQ(test, preflight_buffer(v, NULL, 0, &mapped), -EINVAL);
+	buffer.vb2_buf.vb2_queue = &v->nodes[0].queue;
+	buffer.vb2_buf.num_planes = 1;
+	buffer.vb2_buf.state = VB2_BUF_STATE_QUEUED;
+	KUNIT_EXPECT_EQ(test, preflight_buffer(v, &buffer, 0, &mapped), -EINVAL);
+	buffer.vb2_buf.state = VB2_BUF_STATE_ACTIVE;
+	/* Wrong allocator / absent cookie must fail before interpreting mem_priv. */
+	KUNIT_EXPECT_EQ(test, preflight_buffer(v, &buffer, 0, &mapped), -EINVAL);
+	KUNIT_EXPECT_FALSE(test, v->capture.direct.pair.tx.hw_attempted);
+}
+
+static void native_video_partial_guard(struct kunit *test)
+{
+	struct mt6878_native_video *v = kunit_kzalloc(test, sizeof(*v), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, v);
+	mutex_init(&v->registration);
+	mutex_lock(&v->registration);
+	/* No resources/allocator/provider: the genuinely empty state is safe. */
+	KUNIT_EXPECT_EQ(test, retire_partial(v), 0);
+	v->capture.controller.requested = 1;
+	KUNIT_EXPECT_EQ(test, retire_partial(v), -EBUSY);
+	v->capture.controller.requested = 0;
+	v->capture.reset_attempted = true;
+	KUNIT_EXPECT_EQ(test, retire_partial(v), -EBUSY);
+	v->capture.reset_attempted = false;
+	v->capture.direct.pair.tx.attempted = 1;
+	KUNIT_EXPECT_EQ(test, retire_partial(v), -EBUSY);
+	mutex_unlock(&v->registration);
+}
+
+/* These fixtures register real V4L2 devices and use actual device krefs.
+ * No camera probe, provider, buffer allocation, PM or MMIO is performed.
+ */
+static struct mt6878_native_video *lifetime_root(struct kunit *test, unsigned int count)
+{
+	struct mt6878_native_video *v = kzalloc(sizeof(*v), GFP_KERNEL);
+	unsigned int i;
+	int ret;
+
+	if (!v)
+		return NULL;
+	mutex_init(&v->registration);
+	mutex_init(&v->capture.direct.lock);
+	init_completion(&v->registration_done);
+	strscpy(v->v4l2.name, "mt6878-video-lifetime", sizeof(v->v4l2.name));
+	ret = v4l2_device_register(NULL, &v->v4l2);
+	if (ret) {
+		kfree(v);
+		return NULL;
+	}
+	for (i = 0; i < count; i++) {
+		struct native_node *node = &v->nodes[i];
+
+		node->owner = v;
+		node->index = i;
+		node->queue.type = i ? V4L2_BUF_TYPE_META_CAPTURE : V4L2_BUF_TYPE_VIDEO_CAPTURE;
+		node->queue.io_modes = VB2_MMAP;
+		node->queue.lock = &v->capture.direct.lock;
+		node->queue.ops = &queue_ops;
+		node->queue.mem_ops = &vb2_dma_contig_memops;
+		node->queue.buf_struct_size = sizeof(struct vb2_v4l2_buffer);
+		ret = vb2_queue_init(&node->queue);
+		if (ret)
+			goto fail;
+		node->vdev = (struct video_device) {
+			.v4l2_dev = &v->v4l2, .fops = &file_ops,
+			.release = video_final_release, .queue = &node->queue,
+			.lock = &v->registration, .vfl_dir = VFL_DIR_RX,
+			.device_caps = V4L2_CAP_STREAMING |
+				(i ? V4L2_CAP_META_CAPTURE : V4L2_CAP_VIDEO_CAPTURE),
+		};
+		strscpy(node->vdev.name, "mt6878 lifetime fixture", sizeof(node->vdev.name));
+		node->pad.flags = MEDIA_PAD_FL_SINK;
+		ret = media_entity_pads_init(&node->vdev.entity, 1, &node->pad);
+		if (ret) {
+			vb2_queue_release(&node->queue);
+			goto fail;
+		}
+		node->initialized = true;
+		ret = register_node(node);
+		if (ret)
+			goto fail;
+	}
+	return v;
+fail:
+	KUNIT_FAIL(test, "actual V4L2 fixture registration failed: %d", ret);
+	detach_nodes(v);
+	if (!drain_nodes(v, msecs_to_jiffies(2000))) {
+		cleanup_nodes(v);
+		v4l2_device_unregister(&v->v4l2);
+		kfree(v);
+	} /* Failed drain deliberately retains callback storage. */
+	return NULL;
+}
+
+static void lifetime_root_free(struct kunit *test, struct mt6878_native_video *v)
+{
+	int ret;
+
+	detach_nodes(v);
+	ret = drain_nodes(v, msecs_to_jiffies(2000));
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	if (ret)
+		return;
+	cleanup_nodes(v);
+	v4l2_device_unregister(&v->v4l2);
+	kfree(v);
+}
+
+struct pending_open {
+	struct native_node *node;
+	struct completion entered, callback_done, allow_put;
+	int result;
+};
+
+static int pending_open_thread(void *context)
+{
+	struct pending_open *open = context;
+
+	complete(&open->entered);
+	open->result = node_open(open->node, NULL);
+	complete(&open->callback_done);
+	wait_for_completion_timeout(&open->allow_put, msecs_to_jiffies(2000));
+	put_device(&open->node->vdev.dev); /* Actual V4L2 open tail reference. */
+	return 0;
+}
+
+static void native_video_pending_open_race(struct kunit *test)
+{
+	struct mt6878_native_video *v = lifetime_root(test, 2);
+	struct pending_open open = { .result = -EINPROGRESS };
+	struct task_struct *task;
+	unsigned long done;
+
+	KUNIT_ASSERT_NOT_NULL(test, v);
+	open.node = &v->nodes[0];
+	init_completion(&open.entered);
+	init_completion(&open.callback_done);
+	init_completion(&open.allow_put);
+	mutex_lock(&v->registration);
+	get_device(&open.node->vdev.dev); /* Same actual ref as core video_get. */
+	task = kthread_run(pending_open_thread, &open, "mt6878-video-open-test");
+	if (IS_ERR(task)) {
+		put_device(&open.node->vdev.dev);
+		mutex_unlock(&v->registration);
+		KUNIT_FAIL(test, "pending-open thread creation failed");
+		lifetime_root_free(test, v);
+		return;
+	}
+	done = wait_for_completion_timeout(&open.entered, msecs_to_jiffies(1000));
+	KUNIT_EXPECT_NE(test, done, 0UL);
+	v->removing = true;
+	detach_nodes(v);
+	KUNIT_EXPECT_FALSE(test, completion_done(&open.node->released));
+	KUNIT_EXPECT_EQ(test, v->opens, 0U);
+	mutex_unlock(&v->registration);
+	done = wait_for_completion_timeout(&open.callback_done, msecs_to_jiffies(1000));
+	KUNIT_EXPECT_NE(test, done, 0UL);
+	if (done)
+		KUNIT_EXPECT_EQ(test, open.result, -ENODEV);
+	KUNIT_EXPECT_EQ(test, drain_nodes(v, 1), -ETIMEDOUT);
+	complete(&open.allow_put);
+	kthread_stop(task);
+	lifetime_root_free(test, v);
+}
+
+static void native_video_last_close_race(struct kunit *test)
+{
+	struct mt6878_native_video *v = lifetime_root(test, 2);
+	struct v4l2_fh *fh;
+	struct inode inode = { 0 };
+	struct file file = { .f_inode = &inode };
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, v);
+	fh = kzalloc(sizeof(*fh), GFP_KERNEL);
+	if (!fh) {
+		KUNIT_FAIL(test, "fh allocation failed");
+		lifetime_root_free(test, v);
+		return;
+	}
+	for (i = 0; i < 2; i++)
+		get_device(&v->nodes[i].vdev.dev);
+	v4l2_fh_init(fh, &v->nodes[0].vdev);
+	v4l2_fh_add(fh, &file);
+	file.private_data = fh;
+	inode.i_rdev = MKDEV(VIDEO_MAJOR, v->nodes[0].vdev.minor);
+	v->nodes[0].queue.owner = fh;
+	v->opens = 1;
+	v->retired = true; /* Post-retirement close: no hardware was created. */
+	KUNIT_EXPECT_EQ(test, mt6878_native_video_unregister(v), -EBUSY);
+	KUNIT_EXPECT_TRUE(test, v->nodes[0].registered);
+	KUNIT_EXPECT_TRUE(test, v->nodes[1].registered);
+	KUNIT_EXPECT_EQ(test, video_release(&file), 0); /* Actual native close callback. */
+	KUNIT_EXPECT_EQ(test, v->opens, 0U);
+	detach_nodes(v);
+	KUNIT_EXPECT_EQ(test, drain_nodes(v, 1), -ETIMEDOUT);
+	put_device(&v->nodes[0].vdev.dev); /* Core close tail, first node only. */
+	KUNIT_EXPECT_TRUE(test, completion_done(&v->nodes[0].released));
+	KUNIT_EXPECT_EQ(test, drain_nodes(v, 1), -ETIMEDOUT);
+	put_device(&v->nodes[1].vdev.dev);
+	lifetime_root_free(test, v);
+}
+
+static void native_video_partial_publication(struct kunit *test)
+{
+	struct mt6878_native_video *v = lifetime_root(test, 1);
+
+	KUNIT_ASSERT_NOT_NULL(test, v);
+	get_device(&v->nodes[0].vdev.dev);
+	detach_nodes(v);
+	KUNIT_EXPECT_FALSE(test, v->nodes[1].release_expected);
+	KUNIT_EXPECT_EQ(test, drain_nodes(v, 1), -ETIMEDOUT);
+	put_device(&v->nodes[0].vdev.dev);
+	lifetime_root_free(test, v);
+}
+
+static struct kunit_case native_video_cases[] = {
+	KUNIT_CASE(native_video_queue_bounds),
+	KUNIT_CASE(native_video_quarantine_no_reentry),
+	KUNIT_CASE(native_video_register_reject),
+	KUNIT_CASE(native_video_registration_result),
+	KUNIT_CASE(native_video_preflight_reject),
+	KUNIT_CASE(native_video_partial_guard),
+	KUNIT_CASE(native_video_pending_open_race),
+	KUNIT_CASE(native_video_last_close_race),
+	KUNIT_CASE(native_video_partial_publication),
+	{}
+};
+
+static struct kunit_suite native_video_suite = {
+	.name = "mt6878-native-video-lifetime",
+	.test_cases = native_video_cases,
+};
+kunit_test_suite(native_video_suite);
diff --git a/drivers/memory/camisp-smi-test.inc b/drivers/memory/camisp-smi-test.inc
new file mode 100644
--- /dev/null
+++ b/drivers/memory/camisp-smi-test.inc
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <kunit/test.h>
+
+static void camisp_no_iommu_component(struct kunit *test)
+{
+	struct mtk_smi_larb larb = { 0 };
+
+	KUNIT_EXPECT_EQ(test, camisp_translation_check(&larb), -ENODEV);
+}
+
+static void camisp_normal_domain_ports(struct kunit *test)
+{
+	u32 mask = BIT(0) | BIT(1);
+	u8 bank[32] = { 0 };
+	struct mtk_smi_larb larb = { .mmu = &mask, .bank = bank };
+
+	KUNIT_EXPECT_EQ(test, camisp_translation_check(&larb), 0);
+	mask |= BIT(2);
+	KUNIT_EXPECT_EQ(test, camisp_translation_check(&larb), -EBUSY);
+	mask = BIT(0);
+	KUNIT_EXPECT_EQ(test, camisp_translation_check(&larb), -EBUSY);
+}
+
+static void camisp_wrong_bank(struct kunit *test)
+{
+	u32 mask = BIT(0) | BIT(1);
+	u8 bank[32] = { 0 };
+	struct mtk_smi_larb larb = { .mmu = &mask, .bank = bank };
+	unsigned int i;
+
+	for (i = 0; i < 2; i++) {
+		bank[i] = 1;
+		KUNIT_EXPECT_EQ(test, camisp_translation_check(&larb), -EOPNOTSUPP);
+		bank[i] = 0;
+	}
+}
+
+static void camisp_no_array_padding(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, ARRAY_SIZE(camisp_larb13_bwl), (size_t)5);
+	KUNIT_EXPECT_EQ(test, ARRAY_SIZE(camisp_larb14_bwl), (size_t)4);
+	KUNIT_EXPECT_EQ(test, camisp_larb13_bwl[3], (u8)0x10);
+	KUNIT_EXPECT_EQ(test, camisp_larb14_bwl[3], (u8)0x1);
+}
+
+static void camisp_display_root_identity(struct kunit *test)
+{
+	char compatible[] = "mediatek,mt6878-smi-common";
+	char names[] = "apb\0smi";
+	__be32 id = cpu_to_be32(0);
+	struct property compat = {
+		.name = "compatible", .value = compatible, .length = sizeof(compatible)
+	};
+	struct property clocks = {
+		.name = "clock-names", .value = names, .length = sizeof(names), .next = &compat
+	};
+	struct property identity = {
+		.name = "mediatek,common-id", .value = &id, .length = sizeof(id), .next = &clocks
+	};
+	struct device_node node = { .properties = &clocks };
+
+	/* Stack-local properties, never an OF changeset or a registered device. */
+	KUNIT_EXPECT_TRUE(test, camisp_display_root(&node));
+	node.properties = &identity;
+	KUNIT_EXPECT_TRUE(test, camisp_display_root(&node));
+	id = cpu_to_be32(16);
+	KUNIT_EXPECT_FALSE(test, camisp_display_root(&node));
+	id = cpu_to_be32(0);
+	identity.length = 3;
+	KUNIT_EXPECT_FALSE(test, camisp_display_root(&node));
+	identity.name = "mediatek,smi";
+	KUNIT_EXPECT_FALSE(test, camisp_display_root(&node));
+}
+
+static struct kunit_case camisp_smi_cases[] = {
+	KUNIT_CASE(camisp_no_iommu_component),
+	KUNIT_CASE(camisp_normal_domain_ports),
+	KUNIT_CASE(camisp_wrong_bank),
+	KUNIT_CASE(camisp_no_array_padding),
+	KUNIT_CASE(camisp_display_root_identity),
+	{ }
+};
+
+static struct kunit_suite camisp_smi_suite = {
+	.name = "mt6878-camisp-smi",
+	.test_cases = camisp_smi_cases,
+};
+kunit_test_suite(camisp_smi_suite);
diff --git a/drivers/memory/mt6878-camisp-smi.inc b/drivers/memory/mt6878-camisp-smi.inc
new file mode 100644
--- /dev/null
+++ b/drivers/memory/mt6878-camisp-smi.inc
@@ -0,0 +1,345 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Private extension of the real mtk-smi provider, after its larb structure. */
+#include <linux/property.h>
+#include <soc/mediatek/camisp-dma.h>
+
+static struct platform_driver mtk_smi_larb_driver;
+
+static int camisp_id(struct device *dev, const char *compatible, const char *property)
+{
+	u32 id;
+
+	if (!of_device_is_compatible(dev->of_node, compatible) ||
+	    device_property_read_u32(dev, property, &id))
+		return -1;
+	return id <= (u32)INT_MAX ? (int)id : -1;
+}
+
+static int camisp_larb_id(struct device *dev)
+{
+	int id = camisp_id(dev, "mediatek,mt6878-smi-larb", "mediatek,larb-id");
+
+	return id == 13 || id == 14 ? id : -1;
+}
+
+static int camisp_common_id(struct device *dev)
+{
+	int id = camisp_id(dev, "mediatek,mt6878-smi-common", "mediatek,common-id");
+
+	return id == 16 || id == 19 || id == 31 ? id : -1;
+}
+
+static bool camisp_display_root(struct device_node *node)
+{
+	const char *name;
+	u32 id;
+
+	if (!node || !of_device_is_compatible(node, "mediatek,mt6878-smi-common") ||
+	    of_node_check_flag(node, OF_DYNAMIC) ||
+	    of_find_property(node, "mediatek,smi", NULL) ||
+	    of_find_property(node, "mediatek,smi-supply", NULL) ||
+	    of_property_count_strings(node, "clock-names") != 2 ||
+	    of_property_read_string_index(node, "clock-names", 0, &name) || strcmp(name, "apb") ||
+	    of_property_read_string_index(node, "clock-names", 1, &name) || strcmp(name, "smi"))
+		return false;
+	/* Packaged 0071 root has no common-id; a present value must parse as zero. */
+	if (!of_find_property(node, "mediatek,common-id", NULL))
+		return true;
+	return !of_property_read_u32(node, "mediatek,common-id", &id) && !id;
+}
+
+static int camisp_scope(struct device *dev, bool larb)
+{
+	const char *compatible = larb ? "mediatek,mt6878-smi-larb" : "mediatek,mt6878-smi-common";
+	const char *property = larb ? "mediatek,larb-id" : "mediatek,common-id";
+	u32 id;
+	int ret;
+
+	if (!of_device_is_compatible(dev->of_node, compatible))
+		return 0;
+	ret = device_property_read_u32(dev, property, &id);
+	/* Packaged common0 has no common-id. Its explicit root/two-clock shape
+	 * must not become a fallback for missing camera IDs or camera parents.
+	 */
+	if (!larb && !device_property_present(dev, property))
+		id = 0;
+	else if (ret)
+		return -EINVAL;
+	if (!id) {
+		if (larb) {
+			struct device_node *parent = of_parse_phandle(dev->of_node, "mediatek,smi", 0);
+			bool display = camisp_display_root(parent);
+
+			of_node_put(parent);
+			return display ? 0 : -EINVAL;
+		}
+		return camisp_display_root(dev->of_node) ? 0 : -EINVAL;
+	}
+	if (of_node_check_flag(dev->of_node, OF_DYNAMIC))
+		return -EOPNOTSUPP;
+	return (larb ? id == 13 || id == 14 : id == 16 || id == 19 || id == 31) ?
+		1 : -EOPNOTSUPP;
+}
+
+static int camisp_resource_check(struct platform_device *pdev,
+	const char * const *names, unsigned int count)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	const char *name;
+	unsigned int i;
+
+	if (!res || resource_size(res) != 0x1000 ||
+	    platform_get_resource(pdev, IORESOURCE_MEM, 1) || !dev->pm_domain ||
+	    of_count_phandle_with_args(dev->of_node, "power-domains", "#power-domain-cells") != 1 ||
+	    of_count_phandle_with_args(dev->of_node, "clocks", "#clock-cells") != (int)count ||
+	    device_property_string_array_count(dev, "clock-names") != (int)count)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		if (of_property_read_string_index(dev->of_node, "clock-names", i, &name) ||
+		    strcmp(name, names[i]))
+			return -EINVAL;
+	}
+	/* This scope owns no sensor regulator, reset or boot-state override. */
+	if (of_find_property(dev->of_node, "resets", NULL) ||
+	    device_property_read_bool(dev, "skip-rpm-cb") ||
+	    device_property_read_bool(dev, "skip-restore") ||
+	    device_property_read_bool(dev, "skip-busy-check") ||
+	    device_property_read_bool(dev, "init-power-on"))
+		return -EOPNOTSUPP;
+	return 0;
+}
+
+static int camisp_parent_check(struct device *dev, u32 expected)
+{
+	struct device_node *parent;
+	u32 id;
+	int ret;
+
+	if (of_count_phandle_with_args(dev->of_node, "mediatek,smi", NULL) != 1)
+		return -EINVAL;
+	parent = of_parse_phandle(dev->of_node, "mediatek,smi", 0);
+	if (!parent)
+		return -EINVAL;
+	if (!expected)
+		ret = of_device_is_available(parent) && camisp_display_root(parent) ? 0 : -EINVAL;
+	else
+		ret = of_device_is_available(parent) &&
+			!of_node_check_flag(parent, OF_DYNAMIC) &&
+			of_device_is_compatible(parent, "mediatek,mt6878-smi-common") &&
+			!of_property_read_u32(parent, "mediatek,common-id", &id) &&
+			id == expected ? 0 : -EINVAL;
+	of_node_put(parent);
+	return ret;
+}
+
+static int camisp_larb_prepare(struct platform_device *pdev, struct mtk_smi_larb *larb)
+{
+	static const char * const names[] = { "apb" };
+	int id = camisp_larb_id(&pdev->dev), ret;
+
+	ret = camisp_scope(&pdev->dev, true);
+	if (ret <= 0)
+		return ret;
+	ret = camisp_resource_check(pdev, names, ARRAY_SIZE(names));
+	if (!ret)
+		ret = camisp_parent_check(&pdev->dev, id == 13 ? 16 : 19);
+	if (ret)
+		return ret;
+	larb->smi.clks[0].id = names[0];
+	ret = devm_clk_bulk_get(&pdev->dev, 1, larb->smi.clks);
+	if (ret)
+		return ret;
+	larb->smi.clk_num = 1;
+	larb->larbid = id;
+	return 1;
+}
+
+static int camisp_larb_link_common(struct device *dev, struct device **result)
+{
+	struct device_node *parent = of_parse_phandle(dev->of_node, "mediatek,smi", 0);
+	struct platform_device *supplier;
+	int ret;
+
+	if (!parent)
+		return -EINVAL;
+	supplier = of_find_device_by_node(parent);
+	of_node_put(parent);
+	if (!supplier)
+		return -EPROBE_DEFER;
+	ret = device_is_bound(&supplier->dev) && pm_runtime_enabled(&supplier->dev) ?
+		0 : -EPROBE_DEFER;
+	if (!ret && !device_link_add(dev, &supplier->dev,
+		DL_FLAG_PM_RUNTIME | DL_FLAG_AUTOREMOVE_CONSUMER))
+		ret = -ENOMEM;
+	if (ret)
+		put_device(&supplier->dev);
+	else
+		*result = &supplier->dev;
+	return ret;
+}
+
+static int camisp_common_prepare(struct platform_device *pdev, struct mtk_smi *common)
+{
+	static const char * const names[] = {
+		"apb", "smi", "gals0", "gals1", "gals2", "gals3", "gals4"
+	};
+	int id = camisp_common_id(&pdev->dev), ret;
+	unsigned int i, count = id == 31 ? 1 : ARRAY_SIZE(names);
+
+	ret = camisp_scope(&pdev->dev, false);
+	if (ret <= 0)
+		return ret;
+	ret = camisp_resource_check(pdev, names, count);
+	if (ret)
+		return ret;
+	if (id == 31) {
+		struct device_node *parent, *legacy;
+
+		/* Existing reset owner links smi-supply; IOMMU discovery walks smi. */
+		ret = camisp_parent_check(&pdev->dev, 0);
+		if (ret)
+			return ret;
+		parent = of_parse_phandle(pdev->dev.of_node, "mediatek,smi", 0);
+		legacy = of_parse_phandle(pdev->dev.of_node, "mediatek,smi-supply", 0);
+		ret = parent == legacy ? 0 : -EINVAL;
+		of_node_put(legacy);
+		of_node_put(parent);
+		if (ret)
+			return ret;
+	} else {
+		struct device_node *parent;
+		struct platform_device *supplier;
+
+		ret = camisp_parent_check(&pdev->dev, 31);
+		if (ret)
+			return ret;
+		parent = of_parse_phandle(pdev->dev.of_node, "mediatek,smi", 0);
+		supplier = of_find_device_by_node(parent);
+		of_node_put(parent);
+		if (!supplier)
+			return -EPROBE_DEFER;
+		ret = device_is_bound(&supplier->dev) && pm_runtime_enabled(&supplier->dev) ?
+			0 : -EPROBE_DEFER;
+		if (!ret && !device_link_add(&pdev->dev, &supplier->dev,
+			DL_FLAG_PM_RUNTIME | DL_FLAG_AUTOREMOVE_CONSUMER))
+			ret = -ENOMEM;
+		put_device(&supplier->dev);
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < count; i++)
+		common->clks[i].id = names[i];
+	ret = devm_clk_bulk_get(&pdev->dev, count, common->clks);
+	if (ret)
+		return ret;
+	common->clk_num = count;
+	return 1;
+}
+
+/* B4.1 ee2be53: explicit larb13/14 bandwidth and nonzero misc entries.
+ * Zero-filled C-array padding is not a register description.
+ */
+static const u8 camisp_larb13_bwl[] = { 0xc, 0x34, 0x20, 0x10, 0x1 };
+static const u8 camisp_larb14_bwl[] = { 0xc, 0x34, 0x20, 0x1 };
+
+static int camisp_translation_check(struct mtk_smi_larb *larb)
+{
+	unsigned int i;
+
+	if (!larb->mmu || !larb->bank)
+		return -ENODEV;
+	/* Only CQI/WDMA ports 0/1 in NORMAL_DOM, bank0; no foreign owner. */
+	if (READ_ONCE(*larb->mmu) != (BIT(0) | BIT(1)))
+		return -EBUSY;
+	for (i = 0; i < 2; i++)
+		if (READ_ONCE(larb->bank[i]))
+			return -EOPNOTSUPP;
+	return 0;
+}
+
+static int camisp_larb_resume(struct mtk_smi_larb *larb)
+{
+	int id = camisp_larb_id(larb->smi.dev), ret;
+	const u8 *bwl = id == 13 ? camisp_larb13_bwl : camisp_larb14_bwl;
+	unsigned int count = id == 13 ? ARRAY_SIZE(camisp_larb13_bwl) : ARRAY_SIZE(camisp_larb14_bwl);
+	u32 value;
+	unsigned int i;
+
+	ret = camisp_translation_check(larb);
+	if (ret)
+		return ret;
+	for (i = 0; i < 2; i++) {
+		value = readl(larb->base + SMI_LARB_NONSEC_CON(i));
+		/* Do not inherit a SYSRAM route or a nonzero bank from vendor boot. */
+		if (value & (GENMASK(19, 16) | BANK_SEL(3)))
+			return -ESTALE;
+	}
+	for (i = 0; i < 2; i++) {
+		value = readl(larb->base + SMI_LARB_NONSEC_CON(i));
+		writel(value | F_MMU_EN, larb->base + SMI_LARB_NONSEC_CON(i));
+	}
+	for (i = 0; i < count; i++)
+		writel(bwl[i], larb->base + SMI_LARB_OSTDL_PORTx(i));
+	writel(0x370256, larb->base + SMI_LARB_CMD_THRT_CON);
+	writel(1, larb->base + SMI_LARB_SW_FLAG);
+	wmb();
+	return 0;
+}
+
+static int camisp_larb_idle(struct mtk_smi_larb *larb)
+{
+	/* ee2 mtk_smi_larb_suspend tests both external/internal status banks. */
+	return readl(larb->base) || readl(larb->base + 0x500) ? -EBUSY : 0;
+}
+
+int mt6878_camisp_dma_idle(struct device *dev)
+{
+	struct mtk_smi_larb *larb;
+	int ret;
+
+	if (!dev)
+		return -EINVAL;
+	/* Exclude remove only across these synchronous reads. Long-lived DMA
+	 * teardown still requires the parent's cooperative supplier exclusion.
+	 */
+	if (!device_trylock(dev))
+		return -EBUSY;
+	if (dev->driver != &mtk_smi_larb_driver.driver ||
+	    !device_is_bound(dev) || !pm_runtime_active(dev) || camisp_larb_id(dev) < 0)
+		ret = -ENODEV;
+	else {
+		larb = dev_get_drvdata(dev);
+		ret = !larb || IS_ERR_OR_NULL(larb->base) ? -EHOSTDOWN : camisp_larb_idle(larb);
+	}
+	device_unlock(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6878_camisp_dma_idle);
+
+static void camisp_common_resume(struct mtk_smi *common)
+{
+	int id = camisp_common_id(common->dev);
+	unsigned int i;
+
+	/* ee2 common16/19/31: eight explicit zero bandwidth entries, three misc. */
+	for (i = 0; i < 8; i++)
+		writel(0, common->base + 0x104 + i * 4);
+	writel(0xa, common->base + 0x100);
+	writel(id == 19 ? 0x2105 : 0x2146, common->base + 0x244);
+	writel(1, common->base + 0x444);
+	wmb();
+}
+
+static int camisp_system_suspend(struct device *dev)
+{
+	/* Force-suspend must not cut power to a held capture/DMA supplier. */
+	if ((camisp_larb_id(dev) >= 0 || camisp_common_id(dev) >= 0) &&
+	    atomic_read(&dev->power.usage_count))
+		return -EBUSY;
+	return pm_runtime_force_suspend(dev);
+}
+
+#if IS_ENABLED(CONFIG_KUNIT)
+#include "camisp-smi-test.inc"
+#endif
diff --git a/drivers/memory/mt6878-smi-camera-reset.inc b/drivers/memory/mt6878-smi-camera-reset.inc
new file mode 100644
--- /dev/null
+++ b/drivers/memory/mt6878-smi-camera-reset.inc
@@ -0,0 +1,189 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included only inside drivers/memory/mtk-smi.c, after struct mtk_smi. Uses
+ * that provider's actual base/clock/PM state, never consumer ioremap/regmap.
+ */
+#include <linux/mutex.h>
+#include <linux/property.h>
+#include <soc/mediatek/smi-camera-reset.h>
+
+#define MT6878_CAMERA_CLAMP_STATE 0x03c0
+#define MT6878_CAMERA_CLAMP_SET 0x03c4
+#define MT6878_CAMERA_CLAMP_CLEAR 0x03c8
+
+static struct platform_driver mtk_smi_common_driver;
+
+static int mtk_smi_camera_ports(struct device *dev, u32 *ports, int *count, u32 *mask)
+{
+	u32 id;
+	int ret, i;
+
+	if (!of_device_is_compatible(dev->of_node, "mediatek,mt6878-smi-common"))
+		return -EOPNOTSUPP;
+	ret = device_property_read_u32(dev, "mediatek,common-id", &id);
+	if (ret || id != 31)
+		return ret ? ret : -EOPNOTSUPP;
+	*count = device_property_count_u32(dev, "mediatek,comm-port-id");
+	if (*count <= 0 || *count > 32)
+		return -EINVAL;
+	ret = device_property_read_u32_array(dev, "mediatek,comm-port-id", ports, *count);
+	if (ret)
+		return ret;
+	*mask = 0;
+	for (i = 0; i < *count; i++) {
+		if (ports[i] == U32_MAX)
+			continue;
+		if (ports[i] >= 32 || (*mask & BIT(ports[i])))
+			return -EINVAL;
+		*mask |= BIT(ports[i]);
+	}
+	return *mask ? 0 : -EINVAL;
+}
+
+static int mtk_smi_camera_probe_prepare(struct platform_device *pdev,
+	struct mtk_smi *common, int *required_clocks)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *node;
+	struct platform_device *parent;
+	struct resource *resource;
+	u32 id, ports[32], mask;
+	const char *name;
+	int count, ret;
+
+	mutex_init(&common->camera_reset_lock);
+	if (!of_device_is_compatible(dev->of_node, "mediatek,mt6878-smi-common") ||
+	    device_property_read_u32(dev, "mediatek,common-id", &id) || id != 31)
+		return 0; /* No changed behavior for DISP or other common providers. */
+	ret = mtk_smi_camera_ports(dev, ports, &count, &mask);
+	if (ret)
+		return ret;
+	resource = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!resource || resource_size(resource) != 0x1000 ||
+	    of_count_phandle_with_args(dev->of_node, "clocks", "#clock-cells") != 1 ||
+	    device_property_string_array_count(dev, "clock-names") != 1 ||
+	    device_property_read_string(dev, "clock-names", &name) || strcmp(name, "apb") ||
+	    of_count_phandle_with_args(dev->of_node, "power-domains", "#power-domain-cells") != 1)
+		return -EINVAL;
+	/* ee2 MT6878 common31 has one CAM_VCORE APB clock, not gen2 APB+SMI. */
+	*required_clocks = 1;
+	node = of_parse_phandle(dev->of_node, "mediatek,smi-supply", 0);
+	if (!node)
+		return -EINVAL;
+	parent = of_find_device_by_node(node);
+	of_node_put(node);
+	if (!parent)
+		return -EPROBE_DEFER;
+	ret = device_is_bound(&parent->dev) ? 0 : -EPROBE_DEFER;
+	if (!ret && !device_link_add(dev, &parent->dev,
+		DL_FLAG_PM_RUNTIME | DL_FLAG_AUTOREMOVE_CONSUMER))
+		ret = -ENOMEM;
+	put_device(&parent->dev);
+	return ret;
+}
+
+int mtk_smi_camera_reset_clamp(struct device *dev, struct device *consumer, bool on)
+{
+	struct mtk_smi *common;
+	u32 ports[32], mask, state;
+	int count, i, ret;
+
+	if (!dev || !consumer || dev == consumer || !dev->of_node)
+		return -EINVAL;
+	/* Provider binding/devres is stable during this operation. Never wait
+	 * behind supplier remove while holding the camera's queue/reset mutex.
+	 */
+	if (!device_trylock(dev))
+		return -EBUSY;
+	if (dev->driver != &mtk_smi_common_driver.driver || !device_is_bound(dev)) {
+		ret = -ENODEV;
+		goto unlock_device;
+	}
+	common = dev_get_drvdata(dev);
+	if (!common || common->dev != dev || IS_ERR_OR_NULL(common->base)) {
+		ret = -ENODEV;
+		goto unlock_device;
+	}
+	if (!mutex_trylock(&common->camera_reset_lock)) {
+		ret = -EBUSY;
+		goto unlock_device;
+	}
+	ret = mtk_smi_camera_ports(dev, ports, &count, &mask);
+	if (ret)
+		goto unlock_reset;
+	if (on) {
+		if (!pm_runtime_enabled(dev)) {
+			ret = -EHOSTDOWN;
+			goto unlock_reset;
+		}
+		if (common->camera_reset_consumer) {
+			ret = common->camera_reset_consumer == consumer ? -EALREADY : -EBUSY;
+			goto unlock_reset;
+		}
+		if (!device_is_bound(consumer) ||
+		    !device_link_add(consumer, dev, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+			ret = -ENODEV;
+			goto unlock_reset;
+		}
+		if (!try_module_get(THIS_MODULE)) {
+			ret = -ENODEV;
+			goto unlock_reset;
+		}
+		ret = pm_runtime_resume_and_get(dev);
+		if (ret < 0) {
+			module_put(THIS_MODULE);
+			goto unlock_reset;
+		}
+		state = readl(common->base + MT6878_CAMERA_CLAMP_STATE);
+		if (state & mask) {
+			ret = -EBUSY; /* Never clear a pre-existing foreign clamp. */
+			pm_runtime_put_sync(dev);
+			module_put(THIS_MODULE);
+			goto unlock_reset;
+		}
+		common->camera_reset_consumer = get_device(consumer);
+		common->camera_reset_mask = mask;
+		common->camera_reset_error = 0;
+	} else if (common->camera_reset_consumer != consumer ||
+		   common->camera_reset_mask != mask) {
+		ret = -EPERM;
+		goto unlock_reset;
+	}
+	if (common->camera_reset_error) {
+		ret = common->camera_reset_error;
+		goto unlock_reset;
+	}
+	if (!pm_runtime_active(dev)) {
+		common->camera_reset_error = -EHOSTDOWN;
+		ret = -EHOSTDOWN;
+		goto unlock_reset;
+	}
+	/* Preserve vendor per-membership write/read order, not an all-port mask. */
+	for (i = 0; i < count; i++) {
+		if (ports[i] == U32_MAX)
+			continue;
+		writel(BIT(ports[i]), common->base +
+			(on ? MT6878_CAMERA_CLAMP_SET : MT6878_CAMERA_CLAMP_CLEAR));
+		state = readl(common->base + MT6878_CAMERA_CLAMP_STATE);
+		if (!!(state & BIT(ports[i])) != on) {
+			common->camera_reset_error = -EIO;
+			ret = -EIO;
+			goto unlock_reset; /* Retain PM/module/consumer and actual clamp. */
+		}
+	}
+	ret = 0;
+	if (!on) {
+		put_device(common->camera_reset_consumer);
+		common->camera_reset_consumer = NULL;
+		common->camera_reset_mask = 0;
+		ret = pm_runtime_put_sync(dev);
+		module_put(THIS_MODULE);
+		if (ret > 0)
+			ret = 0;
+	}
+unlock_reset:
+	mutex_unlock(&common->camera_reset_lock);
+unlock_device:
+	device_unlock(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_smi_camera_reset_clamp);
diff --git a/drivers/memory/mtk-smi.c b/drivers/memory/mtk-smi.c
--- a/drivers/memory/mtk-smi.c
+++ b/drivers/memory/mtk-smi.c
