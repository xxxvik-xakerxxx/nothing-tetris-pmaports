+#define SV_DMA_FMT_BAYER8 0
+#define SV_DMA_FMT_BAYER10 1
+#define SV_DMA_FMT_BAYER10_MIPI 80
+#define SV_CQ_SIZE 0x0158
+#define SV_CQ_MSB 0x0150
+#define SV_CQ_LSB 0x014c
+#define SV_CQ_START 0x0014
+#define SV_CQ_EN 0x0100
+#define SV_CQ_SUB_EN 0x0130
+#define SV_DMA_RESET 0x0020
+#define SV_CQ_RESET 0x0010
