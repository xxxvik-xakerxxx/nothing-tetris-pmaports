From: GNSS offline audit
Subject: [PATCH] gps: terminate DSP FSM records before userspace waits on them

The status macros do not append a newline. A final unterminated printk
record is committed but not finalized, so /dev/kmsg cannot read it until
another record is reserved. A supervisor waiting for RESET_DONE before
allowing close can therefore depend on unrelated kernel logging.

Terminate only the two FSM records. Keep event ordering, severity, state
changes and the message body consumed by the observer unchanged.

Base: android_kernel_modules_nothing_mt6878
e96f60dc081ae3525ef43d4bcf0ee5ee97e53835
Offline candidate only; not integrated or device-tested.

diff --git a/connectivity/gps/data_link/hal/gps_dsp_fsm.c b/connectivity/gps/data_link/hal/gps_dsp_fsm.c
--- a/connectivity/gps/data_link/hal/gps_dsp_fsm.c
+++ b/connectivity/gps/data_link/hal/gps_dsp_fsm.c
@@ -340,12 +340,12 @@ _last_check:
 	if (abnormal_flag) {
-		GDL_LOGXW_STA(link_id, "gps_dsp_fsm: old_st=%s, evt=%s, new_st=%s, is_err=%d",
+		GDL_LOGXW_STA(link_id, "gps_dsp_fsm: old_st=%s, evt=%s, new_st=%s, is_err=%d\n",
 			gps_dl_dsp_state_name(last_state), gps_dl_dsp_event_name(evt),
 			gps_dl_dsp_state_name(gps_dsp_state_get(link_id)), abnormal_flag);
 	} else {
-		GDL_LOGXI_STA(link_id, "gps_dsp_fsm: old_st=%s, evt=%s, new_st=%s",
+		GDL_LOGXI_STA(link_id, "gps_dsp_fsm: old_st=%s, evt=%s, new_st=%s\n",
 			gps_dl_dsp_state_name(last_state), gps_dl_dsp_event_name(evt),
 			gps_dl_dsp_state_name(gps_dsp_state_get(link_id)));
 	}
 	return;
 #endif
 }
