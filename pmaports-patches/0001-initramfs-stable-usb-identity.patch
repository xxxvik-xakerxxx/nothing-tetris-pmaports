+# Print a stable, locally administered unicast MAC pair derived from a trusted
+# binary device-tree property. The raw seed and digest never leave this helper.
+derive_usb_network_mac_pair() {
+	local digest device_first device_mac host_first host_mac seed_path seed_size
+
+	seed_path="$1"
+	case "$seed_path" in
+		"$USB_MAC_SEED_ROOT"/*)
+			;;
+		*)
+			return 1
+			;;
+	esac
+	case "$seed_path" in
+		*//*|*/./*|*/../*|*/.|*/..)
+			return 1
+			;;
+	esac
+	[ -f "$seed_path" ] && [ ! -L "$seed_path" ] && [ -r "$seed_path" ] || return 1
+
+	seed_size="$(wc -c < "$seed_path" 2>/dev/null)" || return 1
+	case "$seed_size" in
+		''|*[!0-9]*)
+			return 1
+			;;
+	esac
+	[ "$seed_size" -ge 8 ] && [ "$seed_size" -le 4096 ] || return 1
+
+	digest="$(sha256sum "$seed_path" 2>/dev/null)" || return 1
+	digest="${digest%% *}"
+	[ "${#digest}" -eq 64 ] || return 1
+	case "$digest" in
+		*[!0-9a-fA-F]*)
+			return 1
+			;;
+	esac
+
+	# Bit 1 marks both addresses locally administered and bit 0 remains clear.
+	# Bit 2 is role-separated, guaranteeing host and device addresses differ.
+	host_first=$(( (0x$(printf '%s' "$digest" | cut -c 1-2) & 0xf8) | 0x02 ))
+	device_first=$(( (0x$(printf '%s' "$digest" | cut -c 13-14) & 0xf8) | 0x06 ))
+	host_mac="$(printf '%02x' "$host_first"):$(printf '%s' "$digest" | cut -c 3-4):$(printf '%s' "$digest" | cut -c 5-6):$(printf '%s' "$digest" | cut -c 7-8):$(printf '%s' "$digest" | cut -c 9-10):$(printf '%s' "$digest" | cut -c 11-12)"
+	device_mac="$(printf '%02x' "$device_first"):$(printf '%s' "$digest" | cut -c 15-16):$(printf '%s' "$digest" | cut -c 17-18):$(printf '%s' "$digest" | cut -c 19-20):$(printf '%s' "$digest" | cut -c 21-22):$(printf '%s' "$digest" | cut -c 23-24)"
+
+	printf '%s %s\n' "$host_mac" "$device_mac"
+}
+
+# Apply both generated addresses as one operation. Restore configfs defaults if
+# either write fails so a bad seed or unsupported function never blocks USB.
+set_usb_network_mac_pair() {
+	local device_addr function_path host_addr old_device_addr old_host_addr
+
+	function_path="$1"
+	host_addr="$2"
+	device_addr="$3"
+	old_host_addr="$(cat "$function_path/host_addr" 2>/dev/null)" || return 1
+	old_device_addr="$(cat "$function_path/dev_addr" 2>/dev/null)" || return 1
+
+	if printf '%s\n' "$host_addr" > "$function_path/host_addr" &&
+		printf '%s\n' "$device_addr" > "$function_path/dev_addr"; then
+		return 0
+	fi
+
+	printf '%s\n' "$old_host_addr" > "$function_path/host_addr" 2>/dev/null || true
+	printf '%s\n' "$old_device_addr" > "$function_path/dev_addr" 2>/dev/null || true
+	return 1
+}
+
 # $1: if set, skip writing to the UDC
 setup_usb_network_configfs() {
 	# See: https://www.kernel.org/doc/Documentation/usb/gadget_configfs.txt
@@ -849,6 +920,7 @@ setup_usb_network_configfs() {
 	usb_network_function="${deviceinfo_usb_network_function:-ncm.usb0}"
 	usb_network_function_fallback="rndis.usb0"
 	usb_network_host_addr="${deviceinfo_usb_network_host_addr:-}"
+	usb_network_mac_seed_path="${deviceinfo_usb_network_mac_seed_path:-}"
 
 	echo "  Setting up USB gadget through configfs"
 	# Create an usb gadet configuration
@@ -883,6 +955,19 @@ setup_usb_network_configfs() {
 	if [ -n "$usb_network_host_addr" ]; then
 		echo "$usb_network_host_addr" > $CONFIGFS/g1/functions/"$usb_network_function"/host_addr \
 			|| echo "  Couldn't write host addr"
+	elif [ -n "$usb_network_mac_seed_path" ]; then
+		stable_mac_pair="$(derive_usb_network_mac_pair "$usb_network_mac_seed_path")" ||
+			stable_mac_pair=""
+		if [ -n "$stable_mac_pair" ]; then
+			stable_host_addr="${stable_mac_pair%% *}"
+			stable_device_addr="${stable_mac_pair#* }"
+			set_usb_network_mac_pair \
+				"$CONFIGFS/g1/functions/$usb_network_function" \
+				"$stable_host_addr" "$stable_device_addr" ||
+				echo "  Stable USB network identity unavailable; using function defaults"
+		else
+			echo "  Stable USB network identity unavailable; using function defaults"
+		fi
 	fi
 
 
diff --git a/main/postmarketos-initramfs/tests/03-usb-stable-mac.sh b/main/postmarketos-initramfs/tests/03-usb-stable-mac.sh
new file mode 100755
index 000000000..8be389bd2
--- /dev/null
+++ b/main/postmarketos-initramfs/tests/03-usb-stable-mac.sh
@@ -0,0 +1,93 @@
+#!/bin/sh
+set -eu
+
+srcdir="${1:-$(dirname "$(realpath "$0")")/..}"
+fixture_root="${2:-$(dirname "$(realpath "$0")")/fixtures}"
+testdir="$(mktemp -d)"
+trap 'rm -rf "$testdir"' EXIT
+trusted_root="$testdir/trusted"
+mkdir -p "$trusted_root"
+cp "$fixture_root/seed-a.bin" "$fixture_root/seed-b.bin" "$trusted_root/"
+
+USB_MAC_SEED_ROOT="$trusted_root"
+. "$srcdir/init_functions.sh"
+
+fail() {
+	printf 'FAIL: %s\n' "$*" >&2
+	exit 1
+}
+
+assert_valid_local_unicast() {
+	mac="$1"
+	case "$mac" in
+		[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f])
+			;;
+		*)
+			fail "invalid MAC format"
+			;;
+	esac
+	first="${mac%%:*}"
+	[ $((0x$first & 0x03)) -eq 2 ] || fail "MAC is not local unicast"
+}
+
+pair_a="$(derive_usb_network_mac_pair "$trusted_root/seed-a.bin")"
+pair_a_repeat="$(derive_usb_network_mac_pair "$trusted_root/seed-a.bin")"
+pair_b="$(derive_usb_network_mac_pair "$trusted_root/seed-b.bin")"
+[ "$pair_a" = "$pair_a_repeat" ] || fail "same seed was not deterministic"
+[ "$pair_a" != "$pair_b" ] || fail "different fixtures produced the same pair"
+
+host_a="${pair_a%% *}"
+device_a="${pair_a#* }"
+[ "$host_a" != "$device_a" ] || fail "host and device MACs are equal"
+assert_valid_local_unicast "$host_a"
+assert_valid_local_unicast "$device_a"
+
+[ "$pair_a" = "5a:4b:f2:e1:f9:5b 46:53:3b:ab:01:ec" ] ||
+	fail "fixture A output changed"
+[ "$pair_b" = "ba:a2:cf:df:9b:8b be:30:c8:a5:10:56" ] ||
+	fail "fixture B output changed"
+
+if derive_usb_network_mac_pair "$trusted_root/missing.bin" >/dev/null 2>&1; then
+	fail "missing seed accepted"
+fi
+if derive_usb_network_mac_pair /etc/passwd >/dev/null 2>&1; then
+	fail "seed outside trusted root accepted"
+fi
+
+ln -s seed-a.bin "$trusted_root/seed-link.bin"
+if derive_usb_network_mac_pair "$trusted_root/seed-link.bin" >/dev/null 2>&1; then
+	fail "symlink seed accepted"
+fi
+
+dd if=/dev/zero of="$trusted_root/too-large.bin" bs=4097 count=1 2>/dev/null
+if derive_usb_network_mac_pair "$trusted_root/too-large.bin" >/dev/null 2>&1; then
+	fail "oversized seed accepted"
+fi
+
+(
+	sha256sum() { return 1; }
+	if derive_usb_network_mac_pair "$trusted_root/seed-a.bin" >/dev/null 2>&1; then
+		exit 1
+	fi
+) || fail "hash failure did not fall back"
+
+function_root="$testdir/ncm.usb0"
+mkdir -p "$function_root"
+printf '%s\n' '6e:11:22:33:44:55' > "$function_root/host_addr"
+printf '%s\n' '2a:66:77:88:99:aa' > "$function_root/dev_addr"
+set_usb_network_mac_pair "$function_root" "$host_a" "$device_a" ||
+	fail "valid pair was not written"
+[ "$(cat "$function_root/host_addr")" = "$host_a" ] || fail "host write mismatch"
+[ "$(cat "$function_root/dev_addr")" = "$device_a" ] || fail "device write mismatch"
+
+# A failed preflight must leave the function defaults untouched.
+printf '%s\n' '6e:11:22:33:44:55' > "$function_root/host_addr"
+rm "$function_root/dev_addr"
+mkdir "$function_root/dev_addr"
+if set_usb_network_mac_pair "$function_root" "$host_a" "$device_a" 2>/dev/null; then
+	fail "invalid configfs attributes accepted"
+fi
+[ "$(cat "$function_root/host_addr")" = '6e:11:22:33:44:55' ] ||
+	fail "failed preflight changed the random host default"
+
+printf 'usb stable identity tests passed\n'
