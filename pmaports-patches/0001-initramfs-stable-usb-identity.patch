+# Print a stable, locally administered unicast MAC pair derived from a trusted
+# binary device-tree property. The raw seed and digest never leave this helper.
+derive_usb_network_mac_pair() {
+	local digest device_first device_mac host_first host_mac seed_path seed_size
+
+	seed_path="$1"
+	case "$seed_path" in
+		"$USB_MAC_SEED_ROOT"/chosen/*)
+			;;
+		*)
+			return 1
+			;;
+	esac
+	case "$seed_path" in
+		*//*|*/./*|*/../*|*/.|*/..)
+			return 1
+			;;
+	esac
+	[ -f "$seed_path" ] && [ ! -L "$seed_path" ] && [ -r "$seed_path" ] || return 1
+
+	seed_size="$(wc -c < "$seed_path" 2>/dev/null)" || return 1
+	case "$seed_size" in
+		''|*[!0-9]*)
+			return 1
+			;;
+	esac
+	[ "$seed_size" -ge 8 ] && [ "$seed_size" -le 4096 ] || return 1
+
+	digest="$(sha256sum "$seed_path" 2>/dev/null)" || return 1
+	digest="${digest%% *}"
+	[ "${#digest}" -eq 64 ] || return 1
+	case "$digest" in
+		*[!0-9a-fA-F]*)
+			return 1
+			;;
+	esac
+
+	# Bit 1 marks both addresses locally administered and bit 0 remains clear.
+	# Bit 2 is role-separated, guaranteeing host and device addresses differ.
+	host_first=$(( (0x$(printf '%s' "$digest" | cut -c 1-2) & 0xf8) | 0x02 ))
+	device_first=$(( (0x$(printf '%s' "$digest" | cut -c 13-14) & 0xf8) | 0x06 ))
+	host_mac="$(printf '%02x' "$host_first"):$(printf '%s' "$digest" | cut -c 3-4):$(printf '%s' "$digest" | cut -c 5-6):$(printf '%s' "$digest" | cut -c 7-8):$(printf '%s' "$digest" | cut -c 9-10):$(printf '%s' "$digest" | cut -c 11-12)"
+	device_mac="$(printf '%02x' "$device_first"):$(printf '%s' "$digest" | cut -c 15-16):$(printf '%s' "$digest" | cut -c 17-18):$(printf '%s' "$digest" | cut -c 19-20):$(printf '%s' "$digest" | cut -c 21-22):$(printf '%s' "$digest" | cut -c 23-24)"
+
+	printf '%s %s\n' "$host_mac" "$device_mac"
+}
+
+# Apply both generated addresses as one operation. Restore configfs defaults if
+# either write fails so a bad seed or unsupported function never blocks USB.
+set_usb_network_mac_pair() {
+	local device_addr function_path host_addr old_device_addr old_host_addr
+
+	function_path="$1"
+	host_addr="$2"
+	device_addr="$3"
+	old_host_addr="$(cat "$function_path/host_addr" 2>/dev/null)" || return 1
+	old_device_addr="$(cat "$function_path/dev_addr" 2>/dev/null)" || return 1
+
+	if printf '%s\n' "$host_addr" > "$function_path/host_addr" &&
+		printf '%s\n' "$device_addr" > "$function_path/dev_addr"; then
+		return 0
+	fi
+
+	printf '%s\n' "$old_host_addr" > "$function_path/host_addr" 2>/dev/null || true
+	printf '%s\n' "$old_device_addr" > "$function_path/dev_addr" 2>/dev/null || true
+	return 1
+}
+
+# Leave the function-generated random addresses untouched unless an explicitly
+# configured seed passes every validation check.
+apply_usb_network_mac_seed() {
+	local function_path stable_device_addr stable_host_addr stable_mac_pair
+
+	function_path="$1"
+	[ -n "${deviceinfo_usb_network_mac_seed_path:-}" ] || return 0
+
+	stable_mac_pair="$(derive_usb_network_mac_pair \
+		"$deviceinfo_usb_network_mac_seed_path")" || return 1
+	stable_host_addr="${stable_mac_pair%% *}"
+	stable_device_addr="${stable_mac_pair#* }"
+	set_usb_network_mac_pair "$function_path" \
+		"$stable_host_addr" "$stable_device_addr"
+}
+
 # $1: if set, skip writing to the UDC
 setup_usb_network_configfs() {
 	# See: https://www.kernel.org/doc/Documentation/usb/gadget_configfs.txt
@@ -883,6 +970,9 @@ setup_usb_network_configfs() {
 	if [ -n "$usb_network_host_addr" ]; then
 		echo "$usb_network_host_addr" > $CONFIGFS/g1/functions/"$usb_network_function"/host_addr \
 			|| echo "  Couldn't write host addr"
+	elif ! apply_usb_network_mac_seed \
+		"$CONFIGFS/g1/functions/$usb_network_function"; then
+		echo "  Stable USB network identity unavailable; using function defaults"
 	fi
 
 
diff --git a/main/postmarketos-initramfs/tests/03-usb-stable-mac-testlib.sh b/main/postmarketos-initramfs/tests/03-usb-stable-mac-testlib.sh
new file mode 100755
index 000000000..4f9186078
--- /dev/null
+++ b/main/postmarketos-initramfs/tests/03-usb-stable-mac-testlib.sh
@@ -0,0 +1,147 @@
+#!/bin/sh
+
+testlib_path="$1"
+shift
+# Used by testlib.sh
+# shellcheck disable=SC2034
+results_dir="$1"
+shift
+# shellcheck source=/dev/null
+. "$testlib_path"
+
+srcdir="$(dirname "$(realpath "$0")")/.."
+testdir="$(mktemp -d)"
+trusted_root="$testdir/trusted"
+mkdir -p "$trusted_root/chosen"
+cp "$srcdir/tests/fixtures/seed-a.bin" \
+	"$srcdir/tests/fixtures/seed-b.bin" "$trusted_root/chosen/"
+
+USB_MAC_SEED_ROOT="$trusted_root"
+# shellcheck source=/dev/null
+. "$srcdir/init_functions.sh"
+
+fail_assertion() {
+	_test_assert_failed="$1"
+}
+
+assert_valid_local_unicast() {
+	mac="$1"
+	case "$mac" in
+		[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f])
+			;;
+		*)
+			fail_assertion "invalid MAC format: $mac"
+			return
+			;;
+	esac
+	first="${mac%%:*}"
+	[ $((0x$first & 0x03)) -eq 2 ] ||
+		fail_assertion "MAC is not local unicast: $mac"
+}
+
+start_test "A validated seed deterministically creates distinct local addresses"
+pair_a="$(derive_usb_network_mac_pair "$trusted_root/chosen/seed-a.bin")"
+pair_a_repeat="$(derive_usb_network_mac_pair "$trusted_root/chosen/seed-a.bin")"
+pair_b="$(derive_usb_network_mac_pair "$trusted_root/chosen/seed-b.bin")"
+[ "$pair_a" = "$pair_a_repeat" ] || fail_assertion "same seed changed output"
+[ "$pair_a" != "$pair_b" ] || fail_assertion "different seeds produced one pair"
+host_a="${pair_a%% *}"
+device_a="${pair_a#* }"
+[ "$host_a" != "$device_a" ] || fail_assertion "host and device MACs are equal"
+assert_valid_local_unicast "$host_a"
+assert_valid_local_unicast "$device_a"
+[ "$pair_a" = "5a:4b:f2:e1:f9:5b 46:53:3b:ab:01:ec" ] ||
+	fail_assertion "fixture A output changed"
+[ "$pair_b" = "ba:a2:cf:df:9b:8b be:30:c8:a5:10:56" ] ||
+	fail_assertion "fixture B output changed"
+end_test
+
+start_test "Missing, untrusted, malformed, and unreadable seeds are rejected"
+if derive_usb_network_mac_pair "$trusted_root/chosen/missing.bin" >/dev/null 2>&1; then
+	fail_assertion "missing seed accepted"
+fi
+if derive_usb_network_mac_pair /etc/passwd >/dev/null 2>&1; then
+	fail_assertion "seed outside trusted root accepted"
+fi
+cp "$trusted_root/chosen/seed-a.bin" "$trusted_root/not-chosen.bin"
+if derive_usb_network_mac_pair "$trusted_root/not-chosen.bin" >/dev/null 2>&1; then
+	fail_assertion "seed outside /chosen accepted"
+fi
+ln -s seed-a.bin "$trusted_root/chosen/seed-link.bin"
+if derive_usb_network_mac_pair "$trusted_root/chosen/seed-link.bin" >/dev/null 2>&1; then
+	fail_assertion "symlink seed accepted"
+fi
+printf 'short\n' > "$trusted_root/chosen/too-small.bin"
+if derive_usb_network_mac_pair "$trusted_root/chosen/too-small.bin" >/dev/null 2>&1; then
+	fail_assertion "undersized seed accepted"
+fi
+dd if=/dev/zero of="$trusted_root/chosen/too-large.bin" bs=4097 count=1 2>/dev/null
+if derive_usb_network_mac_pair "$trusted_root/chosen/too-large.bin" >/dev/null 2>&1; then
+	fail_assertion "oversized seed accepted"
+fi
+(
+	sha256sum() { return 1; }
+	if derive_usb_network_mac_pair "$trusted_root/chosen/seed-a.bin" >/dev/null 2>&1; then
+		exit 1
+	fi
+) || fail_assertion "hash failure accepted"
+end_test
+
+start_test "No opt-in preserves configfs-generated random addresses"
+function_root="$testdir/ncm-default"
+mkdir -p "$function_root"
+printf '%s\n' '6e:11:22:33:44:55' > "$function_root/host_addr"
+printf '%s\n' '2a:66:77:88:99:aa' > "$function_root/dev_addr"
+unset deviceinfo_usb_network_mac_seed_path
+apply_usb_network_mac_seed "$function_root" ||
+	fail_assertion "default-off path returned failure"
+[ "$(cat "$function_root/host_addr")" = '6e:11:22:33:44:55' ] ||
+	fail_assertion "default-off path changed host address"
+[ "$(cat "$function_root/dev_addr")" = '2a:66:77:88:99:aa' ] ||
+	fail_assertion "default-off path changed device address"
+end_test
+
+start_test "A validated configured seed replaces both random addresses"
+function_root="$testdir/ncm-valid"
+mkdir -p "$function_root"
+printf '%s\n' '6e:11:22:33:44:55' > "$function_root/host_addr"
+printf '%s\n' '2a:66:77:88:99:aa' > "$function_root/dev_addr"
+deviceinfo_usb_network_mac_seed_path="$trusted_root/chosen/seed-a.bin"
+apply_usb_network_mac_seed "$function_root" ||
+	fail_assertion "valid seed was not applied"
+[ "$(cat "$function_root/host_addr")" = '5a:4b:f2:e1:f9:5b' ] ||
+	fail_assertion "stable host address mismatch"
+[ "$(cat "$function_root/dev_addr")" = '46:53:3b:ab:01:ec' ] ||
+	fail_assertion "stable device address mismatch"
+end_test
+
+start_test "An invalid configured seed preserves both random addresses"
+function_root="$testdir/ncm-invalid"
+mkdir -p "$function_root"
+printf '%s\n' '6e:11:22:33:44:55' > "$function_root/host_addr"
+printf '%s\n' '2a:66:77:88:99:aa' > "$function_root/dev_addr"
+deviceinfo_usb_network_mac_seed_path="$trusted_root/chosen/missing.bin"
+if apply_usb_network_mac_seed "$function_root" 2>/dev/null; then
+	fail_assertion "invalid seed reported success"
+fi
+[ "$(cat "$function_root/host_addr")" = '6e:11:22:33:44:55' ] ||
+	fail_assertion "invalid seed changed host address"
+[ "$(cat "$function_root/dev_addr")" = '2a:66:77:88:99:aa' ] ||
+	fail_assertion "invalid seed changed device address"
+end_test
+
+start_test "A configfs write failure restores function defaults"
+function_root="$testdir/ncm-write-failure"
+mkdir -p "$function_root"
+printf '%s\n' '6e:11:22:33:44:55' > "$function_root/host_addr"
+mkdir "$function_root/dev_addr"
+if set_usb_network_mac_pair "$function_root" \
+	'5a:4b:f2:e1:f9:5b' '46:53:3b:ab:01:ec' 2>/dev/null; then
+	fail_assertion "invalid configfs attributes accepted"
+fi
+[ "$(cat "$function_root/host_addr")" = '6e:11:22:33:44:55' ] ||
+	fail_assertion "failed preflight changed random host default"
+end_test
+
+rm -rf "$testdir"
+end_testsuite
