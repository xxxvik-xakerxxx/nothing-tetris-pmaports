# Experimental opt-in transport adapter; not a replacement for calibration.
pkgname=iio-sensor-proxy-tetris
pkgver=3.9
pkgrel=0
pkgdesc="MediaTek HF backend for standard sensor-proxy on Nothing Tetris"
url="https://github.com/xxxvik-xakerxxx/nothing-tetris-pmaports"
arch="aarch64"
license="GPL-3.0-or-later"
depends="iio-sensor-proxy device-nothing-tetris>=8-r17"
makedepends="glib-dev libgudev-dev meson polkit-dev libssc-dev linux-headers"
source="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/-/archive/$pkgver/iio-sensor-proxy-$pkgver.tar.gz
	0001-register-hf-backend.patch
	drv-mtk-hf.c
	hf-abi.h
	test-hf-abi.c
	80-tetris-hf.rules
	90-tetris-hf.conf
	90-sensor-proxy.conf
	"
builddir="$srcdir/iio-sensor-proxy-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/drv-mtk-hf.c" "$srcdir/hf-abi.h" src/
}

build() {
	abuild-meson -Dssc-support=enabled \
		-Dudevrulesdir=/usr/lib/udev/rules.d \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system . output
	meson compile -C output
	${CC:-cc} -std=gnu11 -Wall -Wextra -Werror "$srcdir/test-hf-abi.c" -o output/test-hf-abi
}

check() {
	meson test --print-errorlogs -C output
	output/test-hf-abi
}

package() {
	install -Dm755 output/src/iio-sensor-proxy "$pkgdir/usr/libexec/nothing-tetris-sensor-proxy"
	install -Dm644 "$srcdir/90-tetris-hf.conf" \
		"$pkgdir/usr/lib/systemd/system/iio-sensor-proxy.service.d/90-tetris-hf.conf"
	install -Dm644 "$srcdir/90-sensor-proxy.conf" \
		"$pkgdir/usr/lib/systemd/system/nothing-tetris-sensors.service.d/90-sensor-proxy.conf"
	install -Dm644 "$srcdir/80-tetris-hf.rules" "$pkgdir/usr/lib/udev/rules.d/80-tetris-hf.rules"
}

