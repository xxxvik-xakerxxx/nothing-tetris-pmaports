[Unit]
Description=Nothing Tetris HF backend for the standard sensor proxy
Requires=nothing-tetris-sensors.service
After=nothing-tetris-sensors.service
Conflicts=iio-sensor-proxy.service

[Service]
Type=dbus
BusName=net.hadess.SensorProxy
ExecStartPre=/usr/libexec/nothing-tetris-sensors preflight
ExecStartPre=/usr/libexec/nothing-tetris-sensors status
ExecStart=/usr/libexec/nothing-tetris-sensor-proxy
Environment=TETRIS_HF_BACKEND=1
Restart=no
TimeoutStartSec=15
TimeoutStopSec=5
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_LOCAL AF_NETLINK AF_QIPCRTR
MemoryDenyWriteExecute=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
